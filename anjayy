    end

    task.spawn(function()
        while sgui.Parent do
            local win
            pcall(function() win = findInvWindow() end)
            if win then
                local n, val = calcInvTotal()
                lab.Text = string.format('$ %s  .  %d buah', Farm.abbrev(val), n)
                local ax, ay, aw = win.AbsolutePosition.X, win.AbsolutePosition.Y, win.AbsoluteSize.X
                box.Position = UDim2.fromOffset(ax + aw - box.AbsoluteSize.X, ay - box.AbsoluteSize.Y - 6)
                box.Visible = true
            else
                box.Visible = false
            end
            task.wait(1)
        end
    end)
end
