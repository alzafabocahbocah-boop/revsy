        local gardens = workspace:FindFirstChild("Gardens")
        if not gardens then return end
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                local sx, sy, sz, cnt = 0, 0, 0, 0
                for _, pl in ipairs(plants:GetChildren()) do
                    if tonumber(pl.Name:match("^(%d+)_")) == player.UserId then
                        local pos = nil
                        pcall(function()
                            if pl:IsA("Model") and pl.PrimaryPart then pos = pl.PrimaryPart.Position
                            else pos = pl:GetPivot().Position end
                        end)
                        if not pos then
                            for _, p in ipairs(pl:GetDescendants()) do
                                if p:IsA("BasePart") and not p.Name:lower():find("fruit") then pos = p.Position; break end
                            end
                        end
                        if pos then sx=sx+pos.X; sy=sy+pos.Y; sz=sz+pos.Z; cnt=cnt+1 end
                    end
                end
                if cnt > 0 then
                    out[plot.Name] = Vector3.new(sx/cnt, sy/cnt, sz/cnt)
                end
            end
        end
    end)
    return out
end

