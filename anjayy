    sw.MouseButton1Click:Connect(function()
        state[key] = not state[key]; saveState(); apply()
        print("[StarFarm] "..(extraLabel or key).." -> "..(state[key] and "ON" or "OFF"))
    end)
    apply()
    return apply
end

