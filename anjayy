        -- update loop
        task.spawn(function()
            -- v4.4 FIX: loop IKUT GENERASI. dulu cuma `while og.Parent` -> pas execute ulang, panel
            -- LAMA tetep jalan pakai logika LAMA & nimpa tampilan -> angka "kecil" ngaco/basi
            -- (mis. panel bilang kecil=120 padahal instance baru ngitung 1).
            while og.Parent and isCurrentGen() do
                pcall(function()
                    -- v44.62: pas ANTI-LEG TOTAL nyala, panel berhenti nyusurin kebun (biang scan konstan)
                    if Farm._overlayPaused and overlayMode == "counter" then
                        vPohon.Text="off"; vKecil.Text="off"; vBesar.Text="off"
                        vGift.Text="off"; vTotal.Text="off"; vSprWC.Text="off"
                        return
                    end
                    if overlayMode == "counter" then
                        -- v44.61: SATU kali keliling kebun buat SEMUA counter (dulu 6x scan terpisah tiap detik
                        -- -> berat pas tanaman banyak). pohon/kecil/besar/value/total dihitung sekalian di 1 loop.
                        pcall(Farm.updateBaseW)   -- kalibrasi rasio kg (throttled 3s, murah)
                        -- v11.7: panel refresh 0.5 detik (dulu 2s) - permintaan user, yg penting
                        -- kecil/besar gesit. tapi value (fruitPrice per buah) tetep tiap 2 detik
                        -- biar ongkosnya gak naik 4x lipat percuma.
                        Farm._ovTick = (Farm._ovTick or 0) + 1
                        local hitungValue = (Farm._ovTick % 4 == 1)
                        local thr = math.abs(state.c2WeightF or 50)
                        local dragonN, smallN, bigN, totalN, valN = 0, 0, 0, 0, 0
                        local gardens = workspace:FindFirstChild("Gardens")
                        if gardens then
                            local myUid = player.UserId
                            for _, plot in ipairs(gardens:GetChildren()) do
                                local plantsF = plot:FindFirstChild("Plants")
                                if plantsF then
                                    for _, plant in ipairs(plantsF:GetChildren()) do
                                        if tonumber(plant.Name:match("^(%d+)_")) == myUid then
                                            local sn = plant:GetAttribute("SeedName") or plant.Name
                                            if tostring(sn):lower():find("dragon", 1, true) then dragonN = dragonN + 1 end
                                            local fruits = plant:FindFirstChild("Fruits")
                                            if fruits then
                                                for _, fruit in ipairs(fruits:GetChildren()) do
                                                    totalN = totalN + 1
                                                    -- v3.1: kecil/besar cuma buah MATANG (Age>=MaxAge).
                                                    -- buah mentah gak bisa dipanen -> jangan dihitung
                                                    -- (dulu kehitung -> "kecil" palsu -> WC keblokir).
                                                    if Farm.isFruitRipe(fruit) then
                                                        local kg = Farm.gardenKg(fruit, sn) or 0
                                                        if kg > 0 and kg < thr then smallN = smallN + 1
                                                        elseif kg >= thr then bigN = bigN + 1 end
                                                    end
                                                    -- v11.7: fruitPrice() itu yg PALING MAHAL di loop ini
                                                    -- (dipanggil PER BUAH: lookup harga + pengali mutasi).
                                                    -- user cuma butuh KECIL/BESAR yg gesit, value gak.
                                                    -- jadi value cuma dihitung tiap tick ke-4 (= 2 detik,
                                                    -- sama kayak dulu). tick lain di-skip -> kecil/besar
                                                    -- bisa 0.5s tanpa ngeborong ongkos value 4x.
                                                    if hitungValue then
                                                        local v = Farm.fruitPrice and Farm.fruitPrice(fruit, true)
                                                        if type(v) == "number" then valN = valN + v end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        Farm._af2SmallCount = smallN; Farm._af2BigCount = bigN   -- share ke loop lain
                        vPohon.Text = tostring(dragonN)
                        vKecil.Text = tostring(smallN)
                        vBesar.Text = tostring(bigN).."/"..tostring(state.af2BigCap or 500)
                        -- v11.7: tick yg gak ngitung value -> pakai angka terakhir, jangan tampil 0
                        -- (kalau nggak, value bakal kedip 0 tiap 3 dari 4 tick).
                        if hitungValue then Farm._ovValLast = valN end
                        vGift.Text = Farm.abbrev(Farm._ovValLast or 0)
                        -- v7.8: baris GLOW - jumlah Glow di KEBUN / ambang gate. ijo = gate kebuka
                        -- (Glow lagi dipanen & dikirim). ini yg paling perlu dipantau, bukan total buah.
                        do
                            local gn  = Farm._glowGardenLast or 0
                            local gmn = state.glowCollectMin or 20
                            vTotal.Text = tostring(gn).."/"..tostring(gmn)
                            if state.sfGlowGate then
                                local buka = (gn >= gmn) and Farm._glowAdaYgMinta
                                vTotal.TextColor3 = buka and Color3.fromRGB(120,255,160)
                                    or (Farm._glowAdaYgMinta and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,150,150))
                            else
                                vTotal.TextColor3 = Color3.fromRGB(255,255,255)
                            end
                        end
                        local ns, nw = countSprWC()
                        -- v8.9: + hitung mundur "WC tunggu" di panel kanan atas (permintaan user).
                        -- ijo = lagi nunggu 10s sebelum nyiram. angka utama tetep stok spr/wc.
                        local wcSisa = nil
                        if Farm._af2WCSince then
                            local d = (tonumber(state.af2WCDelay) or 10) - (os.clock() - Farm._af2WCSince)
                            if d > 0 then wcSisa = math.ceil(d) end
                        end
                        if wcSisa then
                            vSprWC.Text = ns.." / "..nw.."  "..wcSisa.."s"
                            vSprWC.TextColor3 = Color3.fromRGB(120,255,160)
                        else
                            vSprWC.Text = ns.." / "..nw
                            vSprWC.TextColor3 = Color3.fromRGB(255,255,255)
                        end
                    else
                        -- v43.3: AMBIL SEKALI, countdown LOKAL, refetch pas ada moon habis (hemat request).
                        -- akun sumber (WeatherUI keisi) push tiap ~5s. akun lain pull sekali -> itung sendiri.
                        local snap = Farm._moonSnap
                        local nowc = os.clock()
                        -- perlu ambil data baru? (belum ada / ada moon yg habis / snapshot basi > 5 menit)
                        local needFetch = false
                        if not snap then needFetch = true
                        else
                            local elapsed = nowc - snap.at
                            -- cek ada moon yg udah habis (sisa <= 0) -> jadwal berubah, refetch
                            for i = 1, 5 do
                                local base = snap.sec[i]
                                if base and (base - elapsed) <= 0 then needFetch = true; break end
                            end
                            if elapsed > 300 then needFetch = true end   -- 5 menit refresh paksa
                        end
                        if needFetch then
                            -- v44.0: ambil dari API gag2.gg (detik sampai tiap moon terdekat)
                            local data = Farm.fetchMoonAPI and Farm.fetchMoonAPI()
                            local secs = {}
                            if data then
                                for i = 1, 5 do
                                    secs[i] = data[moonList[i][3]]   -- udah detik
                                end
                            end
                            Farm._moonSnap = { sec = secs, at = nowc }
                            snap = Farm._moonSnap
                        end
                        -- tampilin countdown lokal (snapshot - elapsed)
                        local elapsed = nowc - snap.at
                        for i = 1, 5 do
                            local base = snap.sec[i]
                            if base then
                                local left = base - elapsed
                                counterRows[i][2].Text = (left > 0) and Farm.fmtMoonTime(left) or "now"
                            else
                                counterRows[i][2].Text = "-"
                            end
                        end
                    end
                end)
                task.wait(0.5)  -- v11.7: refresh 0.5s (dulu 2s) - permintaan user, kecil/besar mesti gesit.
                -- ongkos value (fruitPrice per buah) TETEP 2s - lihat hitungValue di atas.
            end
        end)
    end
    makeOverlay()
end
