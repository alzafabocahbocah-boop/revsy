-- "kapasitas max" - coba beberapa sumber dari data game. kalau gagal -> fallback.
Farm._invMaxCache = nil
local function getInvMax()
    local plr = Players.LocalPlayer
    if not plr then return state.sellMaxFallback end
    -- 1) attribute di player (nama-nama umum)
    for _, key in ipairs({"MaxInventory","InventoryLimit","BackpackLimit","MaxBackpack",
                          "InventorySize","MaxItems","ItemLimit","MaxSlots"}) do
        local v = plr:GetAttribute(key)
        if type(v) == "number" and v > 0 then return v end
    end
    -- 2) leaderstats / folder nilai (mis "Inventory" = "45/200")
    -- 3) scan PlayerGui cari teks pola "X/Y" yg Y-nya kelihatan kayak kapasitas
    local pg = plr:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") then
                local _, mx = tostring(d.Text):match("(%d+)%s*/%s*(%d+)")
                if mx then
                    local m = tonumber(mx)
                    -- kapasitas masuk akal: 10..5000 (buang angka acak kecil/besar)
                    if m and m >= 10 and m <= 5000 then return m end
                end
            end
        end
    end
    -- 4) fallback manual
    return state.sellMaxFallback
end
function Farm.sellOnce()
    -- v3.7: JANGAN jual pas gift Glow lagi jalan (buah lagi di-unfav buat dikirim -> rawan kejual)
    -- v5.7: + hormati BATAS WAKTU kunci (max 15s). kalau kunci nyangkut gara2 error, sell tetep
    -- jalan lagi sendiri -> gak bikin tas penuh & macet total.
    if Farm._giftBusy then
        if os.clock() < (Farm._giftBusyUntil or 0) then
            return
        else
            Farm._giftBusy = false   -- kunci basi -> lepas paksa
            print("[StarFarm] kunci gift NYANGKUT >15s -> dilepas paksa (sell jalan lagi)")
        end
    end
    Farm.updateBaseW()  -- v10.8: kalibrasi base weight dari buah di tas
    -- v10.9: kalau filter berat aktif, SellAll gak bisa (jual semua sekaligus) -> pakai per-fruit
    -- v5.6 FIX: kalau di tas ADA Glow >= glowKgMin & anti-sell nyala -> JANGAN pakai SellAll.
    -- alasan: SellAll = 1 remote yg jual SELURUH tas, dan ternyata FAVORITE GAK NGELINDUNGIN
    -- (Glow tetep kejual walau udah di-fav duluan - v3.6 gagal). satu2nya cara aman = jual
    -- PER-BUAH (jalur di bawah), krn di situ tiap buah dicek filter anti-sell dulu.
    local _adaGlowDilindungi = false
    if state.sfGlowAntiSell then
        pcall(function()
            for _, holder in ipairs(getFruitHolders()) do
                for _, o in ipairs(holder:GetChildren()) do
                    if o:GetAttribute("Id") and getMutation(o) == "Glow" then
                        local w = o:GetAttribute("Weight")
                        if type(w) == "number" and w >= (state.glowKgMin or 30) then
                            _adaGlowDilindungi = true; return
                        end
                    end
                end
            end
        end)
    end
    -- v6.3: cek priority "kirim kesini" DICABUT dari sell. dulu (v5.8) buah >= 3M ditahan biar
    -- dikirim - tapi sekarang yg dikirim CUMA Glow 50kg+ (udah dilindungi anti-sell sendiri),
    -- jadi buah lain BOLEH dijual normal. (v5.8 bikin Aurora/Frozen ikut kekirim + tas numpuk)
    if _adaGlowDilindungi then
        dprint("[StarFarm] ada Glow dilindungi di tas -> SellAll di-SKIP, jual per-buah biar Glow aman")
    end
    if state.sellAll and state.sellWeightF == 0 and not _adaGlowDilindungi then
        local p = pkt("NPCS", "SellAll")
        if not p or not p.Fire then print("[StarFarm] SellAll packet gak ada"); return end
        -- v3.6 FIX: SellAll = 1 remote yg jual SELURUH tas -> filter "Anti-Sell Glow" (yg kerjanya
        -- per-buah) KELEWAT -> Glow ikut kejual. yg nyelametin cuma FAVORITE (game gak jual buah fav).
        -- jadi: FAV Glow >= glowKgMin DULU, tunggu bentar, BARU SellAll.
        if state.sfGlowAntiSell or state.sfGlowFav then
            local nFav = 0
            for _, holder in ipairs(getFruitHolders()) do
                for _, o in ipairs(holder:GetChildren()) do
                    local id = o:GetAttribute("Id")
                    if id and getMutation(o) == "Glow" then
                        local w = o:GetAttribute("Weight")
                        local favNow = o:GetAttribute("Favorite") or o:GetAttribute("Favorited")
                        if type(w) == "number" and w >= (state.glowKgMin or 30) and not favNow then
                            pcall(function() Farm.setFruitFav(id, true) end)
                            nFav = nFav + 1
                            task.wait()
                        end
                    end
                end
            end
            if nFav > 0 then
                print(string.format("[StarFarm] fav %d Glow dulu sebelum SellAll (biar gak kejual)", nFav))
                task.wait(0.6)   -- kasih waktu server nandain favorite
            end
        end
        -- v10.8: jumlahin berat semua buah di inventory SEBELUM dijual
        local kg = 0
        for _, holder in ipairs(getFruitHolders()) do
            for _, o in ipairs(holder:GetChildren()) do
                if o:GetAttribute("Id") then
                    local w = o:GetAttribute("Weight")
                    if type(w) == "number" then kg = kg + w end
                end
            end
        end
        Farm._sellKg = Farm._sellKg + kg
        pcall(function() p:Fire() end)
        print(string.format("[StarFarm] SellAll fired (%.2f kg)", kg))
        return
    end
    -- per-jenis (atau semua jenis kalau sellAll + filter berat aktif)
    local p = pkt("NPCS", "SellFruit")
    if not p or not p.Fire then print("[StarFarm] SellFruit packet gak ada"); return end
    local sold, types = 0, {}
    for _, holder in ipairs(getFruitHolders()) do
        for _, o in ipairs(holder:GetChildren()) do
            local id = o:GetAttribute("Id")
            if id then
                local jenis = fruitObjType(o.Name)
                local okMut = passMutation(o, state.selectedSellMut, "sellMutAll")
                -- v33.9: toggle "Tanpa Mutasi" ON -> buah polos ikut kejual walau ga kepilih di filter mutasi
                if not okMut and state.sellNoMut and getMutation(o) == nil then okMut = true end
                local w = o:GetAttribute("Weight") or 0
                local okW = passWeight(w, state.sellWeightF)  -- v10.9 filter berat
                -- sellAll=true -> semua jenis lolos; else cuma jenis terpilih
                local okType = state.sellAll or state.selectedSell[jenis]
                -- STAR FARM: anti-sell buah Glow >= glowKgMin (dilindungi, jangan dijual)
                if state.sfGlowAntiSell and getMutation(o) == "Glow" and (w or 0) >= (state.glowKgMin or 30) then okType = false end
                if okType and okMut and okW then
                    if type(w) == "number" then Farm._sellKg = Farm._sellKg + w end  -- v10.8
                    pcall(function() p:Fire(tostring(id)) end)
                    sold = sold + 1
                    types[jenis] = (types[jenis] or 0) + 1
                    if sold % 5 == 0 then task.wait() end
                end
            end
        end
    end
    if sold > 0 then
        local tl = {}; for n, c in pairs(types) do tl[#tl+1] = n.."("..c..")" end
        dprint("[StarFarm] sell per-jenis: "..table.concat(tl, ", "))
    end
end

-- v39.9: JUAL SEMUA BUAH NON-MUTASI (per-buah). toggle mandiri, ga perlu autoSell.
