    local function plotInfoOf(plotId)
        local seed, nSeed, nOther = nil, 0, 0
        pcall(function()
            local g = workspace:FindFirstChild("Gardens")
            local plot = g and g:FindFirstChild(plotId)
            local plants = plot and plot:FindFirstChild("Plants")
