        -- v44.72: crop di-DESTROY (bukan hide) -> GAK bisa dibalikin tanpa REJOIN. OFF cuma stop destroy yg baru.
        pcall(function() Farm.hideShopsNow(true) end)        -- balikin toko (ini masih hide, bisa balik)
        pcall(function()   -- balikin dekorasi terrain
            local ter = workspace:FindFirstChildOfClass("Terrain")
            if ter then ter.Decoration = true end
