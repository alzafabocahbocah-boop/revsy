-- ===== v43.4: AUTO BLOOD HOP - di PS, 2 menit sblm Bloodmoon hop ke PUBLIC =====
-- alasan: Bloodlit di PS (sepi) cuma kena dikit; di public (rame) kena lebih banyak.
-- cuma jalan kalau lagi di PRIVATE server. udah di public -> jangan hop.
-- pas Bloodmoon SELESAI -> kick (user masukin ke PS sendiri).
-- countdown Bloodmoon dibaca dari relay Pantry (Farm.pullMoon) atau WeatherUI lokal.
staggerSpawn(function()
    local BLOOD_LEAD = 180   -- v44.20: hop 3 menit sblm bloodmoon
    while isCurrentGen() do
        pcall(function()
            if not state.autoBloodHop then Farm._bloodHopSnap = nil; return end
            -- v44.20: syarat hop = server cuma 1 player (lo sendiri/sepi). ga pakai deteksi PS.
            local nPlayers = #game:GetService("Players"):GetPlayers()
            local sendirian = nPlayers <= 1
            -- debug sekali per 30s
            if (os.clock() - (Farm._bloodDbgAt or 0)) > 30 then
                Farm._bloodDbgAt = os.clock()
                local d = Farm.fetchMoonAPI and Farm.fetchMoonAPI()
                local bs = d and d.Bloodmoon
                print("[StarFarm] BLOOD HOP cek: player="..nPlayers.." sendirian="..tostring(sendirian).." Bloodmoon="..tostring(bs).."s lead="..BLOOD_LEAD.." waitEnd="..tostring(Farm._bloodHopWaitEnd))
            end
            -- FASE 1: sendirian + bloodmoon deket + belum hop -> hop ke PUBLIC
            if sendirian and not Farm._bloodHopWaitEnd then
                local data = Farm.fetchMoonAPI and Farm.fetchMoonAPI()
                local bloodSec = data and data.Bloodmoon
                if bloodSec and bloodSec <= BLOOD_LEAD and bloodSec > 0 then
                    print("[StarFarm] BLOOD HOP: sendirian + Bloodmoon "..bloodSec.."s lagi -> hop ke PUBLIC")
                    Farm._bloodHopWaitEnd = true   -- tandai: nunggu bloodmoon selesai buat kick
                    Farm._bloodSeenActive = false
                    pcall(function() Farm.simpleRejoin(true) end)   -- ke public acak
                    task.wait(12)
                    return
                end
            end
            -- FASE 2: udah hop (waitEnd) -> tunggu bloodmoon BENER2 selesai -> kick
            if Farm._bloodHopWaitEnd then
                local ph = tostring(workspace:GetAttribute("ActivePhase") or ""):lower()
                local aw = tostring(workspace:GetAttribute("ActiveWeather") or ""):lower()
                local bloodNow = ph:find("blood") or aw:find("blood")
                if bloodNow then
                    Farm._bloodSeenActive = true   -- bloodmoon lagi aktif (kejadian)
                elseif Farm._bloodSeenActive then
                    -- tadi aktif, sekarang engga = bloodmoon SELESAI -> kick
                    print("[StarFarm] BLOOD HOP: Bloodmoon selesai -> KICK (masukin ke PS lagi)")
                    Farm._bloodHopWaitEnd = false; Farm._bloodSeenActive = false
                    pcall(function() player:Kick("bloodlit selesai - masukin ke server sendiri lagi") end)
                end
            end
        end)
        task.wait(3)
    end
end)

-- ===== ANTI-BOT: deteksi player auto-sell (Sheckles berubah >=5x dalam 2s) -> hop =====
-- pantau Sheckles cepat (0.2s). hitung perubahan per window 2 detik.
-- bot = >=5 perubahan/2s (sell beberapa item beruntun). player normal: sell 1-1 (jarang).
-- hop kalau 2 window berturut kedeteksi (biar gak false-positive).
do
    local lastSheck = {}    -- userId -> nilai Sheckles terakhir
    local changes = {}      -- userId -> jumlah perubahan di window berjalan
    local hitStreak = {}    -- userId -> berapa window berturut yg >=5 perubahan
    local MY_ID = player.UserId
    local WINDOW = 2          -- detik per window
    local TICK = 0.2          -- cek tiap 0.2s
    local THRESHOLD = 5       -- >=5 perubahan dalam window = mencurigakan
    local NEED_WINDOWS = 2    -- 2 window berturut baru hop

    -- loop hitung perubahan (cepat)
    task.spawn(function()
        while isCurrentGen() do
            task.wait(TICK)
            if isCurrentGen() and state.antiBot then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.UserId ~= MY_ID then
                        local ls = p:FindFirstChild("leaderstats")
                        local sv = ls and ls:FindFirstChild("Sheckles")
                        if sv then
                            local now = sv.Value
                            local prev = lastSheck[p.UserId]
                            if prev ~= nil and now ~= prev then
                                changes[p.UserId] = (changes[p.UserId] or 0) + 1
                            end
                            lastSheck[p.UserId] = now
                        end
                    end
                end
            else
                if next(changes) then changes={}; lastSheck={}; hitStreak={} end
            end
        end
    end)
    -- loop evaluasi window (tiap 2 detik)
    task.spawn(function()
        while isCurrentGen() do
            task.wait(WINDOW)
            if isCurrentGen() and state.antiBot then
                for uid, cnt in pairs(changes) do
                    if cnt >= THRESHOLD then
                        hitStreak[uid] = (hitStreak[uid] or 0) + 1
                    else
                        hitStreak[uid] = 0
                    end
                    if (hitStreak[uid] or 0) >= NEED_WINDOWS then
                        local nm = uid
                        local pp = Players:GetPlayerByUserId(uid)
                        if pp then nm = pp.Name end
                        print("[StarFarm] BOT terdeteksi: "..nm.." (Sheckles berubah "..cnt.."x/2s, 2 window) -> HOP")
                        -- v5.5: hop dulu; cuma matiin Anti-Bot kalau hop BERHASIL.
                        -- kalau hop gagal (gak nemu server lain), biarin Anti-Bot tetap ON
                        -- biar nyoba lagi nanti - daripada mati percuma tanpa pindah.
                        task.spawn(function()
                            local ok = doHop()
                            if ok then state.antiBot = false end
                        end)
                        break
                    end
                end
                changes = {}  -- reset window
            end
        end
    end)
end

