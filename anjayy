                                    if id and fj then
                                        local okv = noFilter   -- v44.52: noFilter -> ambil tanpa hitung value
                                        if not okv then
                                            local pr = Farm.fruitPrice(o) or 0
                                            okv = (pr >= minVal and pr <= maxVal)
                                        end
                                        if okv then
                                            local dup = false
                                            for _, e in ipairs(tools) do if e.obj == o then dup = true break end end
                                            if not dup then tools[#tools+1] = {obj=o, id=id} end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- v44.53: EQUIP pelan + SPAM fire drop. equip 1 buah -> tunggu equip nempel ->
                -- SPAM fire drop bbrp kali -> jeda -> pindah buah berikut. fix: dulu equip cepet
                -- tapi fire kurang -> ganti2 tanpa drop.
                for _, e in ipairs(tools) do
                    if not state.dropAuto then break end
                    if (state.dropDone or 0) >= (state.dropTarget or 0) then break end
                    if hum and e.obj:IsA("Tool") then
                        pcall(function() hum:EquipTool(e.obj) end)
                    end
                    task.wait(0.15)   -- tunggu equip nempel dulu (equip dilemotkan)
                    -- SPAM fire drop 5x (dipercepat, biar pasti ke-drop)
