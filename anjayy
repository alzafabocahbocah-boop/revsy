function Farm.isBadWeatherNow()
    -- v35.4 (HASIL BONGKAR DATA): game punya DUA kanal terpisah -
    --   ActiveWeather = weather (Rain/Lightning/Rainbow/Snowfall/Starfall/Aurora/Sunburst)
    --   ActivePhase   = FASE (siklus harian + fase bulan merah/besar/gold)
    -- dua-duanya dicek. nilai non-netral yg belum ditandai bagus = BURUK.
    -- nama fase ga perlu diketahui di muka: nilai baru otomatis didaftarin ke picker.
    local cands = {}
    local aw = workspace:GetAttribute("ActiveWeather"); if aw ~= nil then cands[#cands+1] = aw end
    local ap = workspace:GetAttribute("ActivePhase");   if ap ~= nil then cands[#cands+1] = ap end
    -- v44.12 (HASIL DECOMPILE WeatherController): weather kayak Rain/Lightning/Snowfall dll
    -- NGGAK ganti ActiveWeather (tetap "Day"). game tandain lewat atribut di
    -- ReplicatedStorage.WeatherValues: "<Weather>_Playing" = true pas aktif.
    -- cek semua weather, yg _Playing=true masuk kandidat.
    pcall(function()
        local wv = game:GetService("ReplicatedStorage"):FindFirstChild("WeatherValues")
        if wv then
            for _, wname in ipairs({ "Rain","Lightning","Rainbow","Snowfall","Starfall","Aurora","Sunburst",
                                     "Goldmoon","RainbowMoon","Bloodmoon","Mega","Moon" }) do
                if wv:GetAttribute(wname .. "_Playing") == true then
                    cands[#cands+1] = wname
                end
            end
        end
    end)
    -- v44.32: DAFTAR WEATHER BURUK (whitelist) - CUMA 4 ini yg dianggap buruk (kick).
    -- sisanya (Rain/Snowfall/Starfall/Aurora/Sunburst/Bloodmoon/Mega/dll) AMAN semua.
    local function norm(s) return tostring(s):lower():gsub("[^%w]", "") end
    local BAD = {
        goldmoon = true, gold = true,
        lightning = true,
        -- v1.2: Rainbow & RainbowMoon DIKELUARIN dari BAD (permintaan user - itu cuaca bagus, jgn di-hop)
    }
    for _, w in ipairs(cands) do
        if BAD[norm(w)] then
            return true, w
        end
    end
    return false, aw
end

