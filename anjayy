-- list plot milik player di garden
-- label = "SeedName - PlotX" kalau ada tanaman, "PlotX (kosong)" kalau kosong
function Farm.af2PlotList()
    local list = {}
    pcall(function()
        local gardens = workspace:FindFirstChild("Gardens")
        if not gardens then return end
        local myUid = player.UserId  -- number
        for _, plot in ipairs(gardens:GetChildren()) do
            -- v44.54: deteksi SEMUA plot milik sendiri (termasuk KOSONG) via OwnerUserId.
            -- dulu cuma plot yg ADA tanaman (hasMine) -> plot kosong ke-skip.
            local seedName = nil
            local hasMine = false
            pcall(function()
                local plants = plot:FindFirstChild("Plants")
                if plants then
                    for _, plant in ipairs(plants:GetChildren()) do
                        if tonumber(plant.Name:match("^(%d+)_")) == myUid then
                            hasMine = true
                            seedName = plant:GetAttribute("SeedName")
                            break
                        end
                    end
                end
            end)
            -- plot punya sendiri kalau: ada tanaman sendiri ATAU OwnerUserId == myUid
            local isMine = hasMine or (plot:GetAttribute("OwnerUserId") == myUid)
            if isMine then
                local label = seedName and (seedName.." - "..plot.Name) or (plot.Name.." (kosong)")
                list[#list+1] = label
            end
        end
    end)
    return list
end

-- label -> posisi plot (prioritas dari tanaman dulu - posisi valid di area tanam)
function Farm.af2LabelToPos(label)
    local plotName = label:match(" %- (.+)$") or label:match("^(.+) %(kosong%)$") or label
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return nil end
    local plot = gardens:FindFirstChild(plotName)
    if not plot then return nil end
    local pos
    pcall(function()
        -- 1) posisi dari tanaman MILIK SENDIRI (v39.8: prefix userId, bukan tanaman pertama)
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                if tonumber(plant.Name:match("^(%d+)_")) == player.UserId then
                    if plant:IsA("Model") and plant.PrimaryPart then
                        pos = plant.PrimaryPart.Position; return
                    end
                    for _, p in ipairs(plant:GetDescendants()) do
                        if p:IsA("BasePart") and not p.Name:lower():find("fruit") then
                            pos = p.Position; return
                        end
                    end
                end
            end
        end
        -- 2) PlotSizeReference (tengah plot)
        if not pos then
            local ref = plot:FindFirstChild("PlotSizeReference")
            if ref and ref:IsA("BasePart") then pos = ref.Position; return end
        end
        -- 3) SpawnPoint (fallback terakhir)
        if not pos then
            local sp = plot:FindFirstChild("SpawnPoint")
            if sp and sp:IsA("BasePart") then pos = sp.Position end
        end
    end)
    return pos
end

-- auto-detect posisi garden: 1 posisi per PLOT (bukan per tanaman) + filter UserId milik player
function Farm.af2GetPlantPositions(seedFilter)
    -- v29.2: pakai plot picker (af2SelectedPlots) kalau ada, ignore seedFilter
    local plotList = Farm.af2PlotList()
    local useAll = state.af2AllPlots
    if not useAll then
        local any = false
        for _ in pairs(state.af2SelectedPlots or {}) do any=true; break end
        if not any then useAll = true end
    end
    local positions = {}
    for _, label in ipairs(plotList) do
