-- v12.8: PANEL WEB — lapor kebun ke Cloudflare Worker + terima setelan.
--
-- Kenapa nempel di sini, bukan file terpisah:
--   * Farm.relayReq udah ada (baris ~5591) & dia cuma pembungkus request().
--     Bukan barang Pantry. Jadi bisa dipake ke mana aja.
--   * Ikut toggle Farm 2 -> gak ada request dari akun yang lagi nganggur.
--   * Gak perlu patch/loadstring kedua yang gampang kelupaan.
--
-- gfRelayUrl (Pantry) SENGAJA gak disentuh. Relay Glow/prio/moon tetep di
-- Pantry, panel di Cloudflare. Beban Pantry gak nambah.
--
-- HEMAT: cek tiap 15 detik (murah, gak ada request), tapi cuma KIRIM kalau
-- ada yang beneran berubah + denyut tiap 5 menit. ~2.880 -> ~400 request/hari.
-- Ini bukan cuma soal kuota: tiap request makan CPU RedFinger yang lagi
-- nanggung 6-10 client.
-- ============================================================
local PANEL_CEK    = 15    -- detik: cek perubahan
local PANEL_DENYUT = 300   -- detik: lapor walau gak berubah (biar panel tau masih idup)
local PANEL_CFG    = 30    -- detik: ambil setelan dari panel

Farm._panelGen = Farm._panelGen or 0
local panelLamaData, panelLamaKirim, panelCfgTs = nil, 0, 0
Farm._panelKirim, Farm._panelLewat = 0, 0

local function panelAktif()
    return state.farm2On
        and type(state.panelUrl) == "string" and state.panelUrl ~= ""
        and type(state.panelKunci) == "string" and state.panelKunci ~= ""
end

local function panelReq(jalur, metode, isi)
    local o = {
        Url = state.panelUrl .. jalur,
        Method = metode,
        Headers = { ["Content-Type"] = "application/json", ["X-Kunci"] = state.panelKunci },
    }
    if isi then
        local ok, body = pcall(function() return HS:JSONEncode(isi) end)
        if not ok then return nil end
        o.Body = body
    end
    return Farm.relayReq(o)
end

-- baca kebun sendiri. pola sama kayak ESP Garden (~baris 2216).
local function panelBacaKebun()
    local d = { tot = 0, kecil = 0, besar = 0, matang = 0, glow = 0, nilai = 0 }
    local ok = pcall(function()
        local g = workspace:FindFirstChild("Gardens"); if not g then return end
        local thr = math.abs(state.c2WeightF or 50)
        for _, plot in ipairs(g:GetChildren()) do
            local pf = plot:FindFirstChild("Plants")
            if pf then
                for _, pl in ipairs(pf:GetChildren()) do
                    if tonumber(tostring(pl.Name):match("^(%d+)_")) == player.UserId then
                        local seed = pl:GetAttribute("SeedName") or "?"
                        local fs = pl:FindFirstChild("Fruits")
                        if fs then
                            for _, f in ipairs(fs:GetChildren()) do
                                local kg = Farm.gardenKg(f, seed) or 0
                                if kg > 0 then
                                    d.tot = d.tot + 1
                                    if kg < thr then d.kecil = d.kecil + 1 else d.besar = d.besar + 1 end
                                    if Farm.isFruitRipe(f) then d.matang = d.matang + 1 end
                                    if Farm.getMutation(f) == "Glow" then d.glow = d.glow + 1 end
                                    d.nilai = d.nilai + (Farm.fruitPrice(f) or 0)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    if not ok then return nil end
    return d
end

