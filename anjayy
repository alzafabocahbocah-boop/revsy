function Farm.buyPetOnce()
    local p = pkt("Pets", "WildPetTame")
    if not p or not p.Fire then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local wpr = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("WildPetRef")
    local list = wpr and wpr:GetChildren() or {}
    for _, o in ipairs(list) do
        if o:IsA("BasePart") and o.Name:sub(1,8) == "WildPet_" then
            local uuid = o.Name:sub(9)
            local petName = o:GetAttribute("PetName")
            local rarity  = o:GetAttribute("Rarity")
            local okType = state.allPetType or (petName and state.selectedPetType[petName])
            local okRare = state.allPetRare or (rarity and state.selectedPetRare[rarity])
            -- v25.2: batas harga MIN & MAX (0=bebas). berlaku ke SEMUA pet (spesial ikut).
            local prNow = petPriceOf(o)
            local okMin = (not state.petMinPrice) or state.petMinPrice <= 0 or (prNow and prNow >= state.petMinPrice)
            local okMax = (not state.petMaxPrice) or state.petMaxPrice <= 0 or (not prNow) or prNow <= state.petMaxPrice
            local okPrice = okMin and okMax
            -- v17.3: cek DUIT - kalau harga > sheckles, gak usah dicoba (biar gak tp doang gagal)
            local sheck = 0
            pcall(function()
                local ls = player:FindFirstChild("leaderstats")
                local sv = ls and ls:FindFirstChild("Sheckles")
                if sv then sheck = sv.Value end
            end)
            local affordable = (not prNow) or prNow <= sheck
            local st = petStateStr(o)
            local tier = Farm.petSizeTier(uuid, petName)   -- buat label notif webhook aja
            local isRb = Farm.isRainbowPet(o, petName)
            local passFilter = okType and okRare and okPrice
            -- cuma klaim pet yg PUNYA HARGA (prNow) & MAMPU BAYAR & lolos filter
            if passFilter and prNow and affordable and st ~= "mine" and Farm._petClaimed[uuid] ~= st then
                if Farm._petAttempt[uuid] ~= st then Farm._petAttempt[uuid] = st; Farm._petFail[uuid] = 0 end
                local cnt = Farm._petCount[uuid] or 0
                local maxR = state.petMaxRebuy or 3
                local within = Farm._petLastTry[uuid] and (os.clock() - Farm._petLastTry[uuid] < PET_RETRY_CD)
                if cnt < maxR and (Farm._petFail[uuid] or 0) < PET_MAX_FAIL and not within then
                    Farm._petLastTry[uuid] = os.clock()
                    -- chase: teleport ngikutin pet, CEK beneran deket (anti rubber-band),
                    -- ulang teleport kalau ketarik balik, baru fire. ulang max 4x.
                    local got = false
                    if hrp then
                        -- LENGKET ke pet: pin HRP ke posisi pet TIAP FRAME (Heartbeat) sambil nembak.
                        local stuck = true
                        local hb = game:GetService("RunService").Heartbeat:Connect(function()
                            if stuck and o.Parent and hrp and hrp.Parent then
                                pcall(function()
                                    hrp.CFrame = o.CFrame + Vector3.new(0, 2.5, 0)
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                end)
                            end
                        end)
                        task.wait(0.2)  -- v17.7: settle dulu biar posisi nempel ke-register server SEBELUM fire
                        dprint("[StarFarm] coba beli "..tostring(petName).." | st="..st.." dist="..tostring(o.Parent and math.floor((hrp.Position-o.Position).Magnitude) or "-"))
                        for i = 1, 6 do
                            if not o.Parent then got = true; break end
                            pcall(function() p:Fire(o) end)
                            task.wait(0.22)
                            if (not o.Parent) or petOwnedByMe(o) or petStateStr(o) ~= st then got = true; break end
                        end
                        stuck = false
                        pcall(function() hb:Disconnect() end)
                        dprint("[StarFarm] hasil "..tostring(petName).." -> "..(got and "OK" or "gagal").." | owner="..tostring(o.Parent and o:GetAttribute("OwnerUserId") or "gone"))
                    else
                        for _ = 1, 3 do
                            pcall(function() p:Fire(o) end)
                            task.wait(0.25)
                            if (not o.Parent) or petOwnedByMe(o) or petStateStr(o) ~= st then got = true; break end
                        end
                    end
                    if got then
                        local pr = petPriceOf(o) or tonumber((st:gsub("^p", "")))
                        Farm._petClaimed[uuid] = st
                        Farm._petCount[uuid] = cnt + 1
                        Farm._petFail[uuid] = 0
                        Farm._petInfo[uuid] = { name = petName, price = pr }  -- simpan buat notif nanti
                        print("[StarFarm] "..(cnt==0 and "beli" or "ambil balik").." pet: "..tostring(petName).." ("..st..")")
                    else
                        Farm._petFail[uuid] = (Farm._petFail[uuid] or 0) + 1
                        if Farm._petFail[uuid] >= PET_MAX_FAIL then Farm._petClaimed[uuid] = st end
                    end
                end
            end
            -- v16.9: catat pemilik terakhir pet yg pernah kita beli (buat deteksi masuk garden)
            if Farm._petCount[uuid] then
                Farm._petLastOwner[uuid] = o:GetAttribute("OwnerUserId")
                if petName then Farm._petInfo[uuid] = Farm._petInfo[uuid] or {}; Farm._petInfo[uuid].name = petName
                    Farm._petInfo[uuid].tier = Farm.petSizeTier(uuid, petName); Farm._petInfo[uuid].rb = Farm.isRainbowPet(o, petName) end
            end
        end
    end
    -- bersihin data uuid yg udah ilang; kalau pemilik terakhir = KITA -> masuk garden -> webhook
    local present = {}
    for _, o in ipairs(list) do if o.Name:sub(1,8) == "WildPet_" then present[o.Name:sub(9)] = true end end
    for uuid in pairs(Farm._petAttempt) do
        if not present[uuid] then
            -- pet ilang dari wild. kalau terakhir punya kita = masuk garden kita
            if Farm._petLastOwner[uuid] == player.UserId then
                local info = Farm._petInfo[uuid] or {}
                print("[StarFarm] pet MASUK GARDEN: "..tostring(info.name)..(info.tier and info.tier~="Normal" and (" ["..info.tier.."]") or "")..(info.rb and " [RAINBOW]" or ""))
                pcall(function() Farm.sendPetWebhook(info.name, info.price, info.tier, info.rb) end)
            end
            Farm._petClaimed[uuid]=nil; Farm._petAttempt[uuid]=nil; Farm._petFail[uuid]=nil
            Farm._petCount[uuid]=nil; Farm._petLastTry[uuid]=nil
            Farm._petLastOwner[uuid]=nil; Farm._petInfo[uuid]=nil
        end
