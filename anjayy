-- webhook Discord: kirim pas berhasil beli pet (username, sheckles, pet)
local function execRequest()
    return (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request)
end
function Farm.sendPetWebhook(petName, price, tier, rb)
    local url = state.petWebhook
    if not url or url == "" then return end
    local req = execRequest()
    if not req then return end
    local sheck = 0
    pcall(function()
        local ls = player:FindFirstChild("leaderstats")
        local sv = ls and ls:FindFirstChild("Sheckles")
        if sv then sheck = sv.Value end
    end)
    local special = ""
    if rb then special = special.." [pelangi]RAINBOW" end
    if tier == "Mega" then special = special.." *MEGA" elseif tier == "Big" then special = special.." [o]BIG" end
    local isSpecial = (rb or tier == "Mega" or tier == "Big")
    local body = HS:JSONEncode({
        embeds = {{
            title = isSpecial and ("[!] PET SPESIAL!"..special) or "[paw] Pet Dibeli",
            color = isSpecial and 16766720 or 5763719,
            fields = {
                { name = "Username", value = player.Name, inline = true },
                { name = "Sheckles", value = Farm.abbrev(sheck), inline = true },
                { name = "Buy Pet", value = tostring(petName)..(tier and tier~="Normal" and (" ["..tier.."]") or "")..(rb and " [Rainbow]" or "")..(price and (" (c"..Farm.abbrev(price)..")") or ""), inline = false },
            },
        }},
    })
    pcall(function()
        req({ Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
    end)
end
-- v25.4: deteksi tier dari RootPart.Size (STABIL, ga ke-animasi) - bounding box dulu goyang +-12%.
-- Big=2x, Mega=4x nge-scale seluruh model jadi RootPart ikut gede. baseline = root terkecil per jenis.
Farm._petBase = Farm._petBase or {}
function Farm.petSizeTier(uuid, petName)
    if not petName then return "Normal", 1 end
    local map = workspace:FindFirstChild("Map")
    local spawns = map and map:FindFirstChild("WildPetSpawns")
    if not spawns then return "Normal", 1 end
    local model
    for _, m in ipairs(spawns:GetChildren()) do
        if m.Name:find(uuid, 1, true) then model = m; break end
    end
    if not model then return "Normal", 1 end
    -- patokan utama: RootPart.Size (stabil). fallback: bounding box.
    local lin
    local rp = model:FindFirstChild("RootPart", true)
    if rp and rp:IsA("BasePart") then
        lin = math.max(rp.Size.X, rp.Size.Y, rp.Size.Z)
    else
        local sz
        pcall(function()
            if model:IsA("Model") then local _, s = model:GetBoundingBox(); sz = s
            elseif model:IsA("BasePart") then sz = model.Size end
        end)
        if sz then lin = math.max(sz.X, sz.Y, sz.Z) end
    end
    if not lin or lin <= 0 then return "Normal", 1 end
    local base = Farm._petBase[petName]
    if not base or lin < base then Farm._petBase[petName] = lin; base = lin end
    local scale = lin / base
    if scale >= 2.8 then return "Mega", scale
    elseif scale >= 1.4 then return "Big", scale
    else return "Normal", scale end
end
