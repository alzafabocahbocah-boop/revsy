-- cek apakah sprinkler milik player masih aktif di garden
function Farm.af2IsSprinklerActive()
    local found = false
    pcall(function()
        local gardens = workspace:FindFirstChild("Gardens")
        if not gardens then return end
        local myUid = player.UserId
        for _, plot in ipairs(gardens:GetChildren()) do
            if plot:GetAttribute("OwnerUserId") == myUid then
                local sprs = plot:FindFirstChild("Sprinklers")
                if sprs then
                    for _, s in ipairs(sprs:GetChildren()) do
                        -- nama format: {UserId}_{SprinklerId}, cek UserId attr
                        local uid = s:GetAttribute("UserId")
                        if uid == myUid then found = true; return end
                        -- fallback: cek nama mengandung UserId
                        if tostring(s.Name):sub(1, #tostring(myUid)) == tostring(myUid) then found = true; return end
                    end
                end
            end
        end
    end)
    return found
end

-- place sprinkler: auto-detect posisi dari PlotSizeReference plot milik player
-- v35.2: TP ke SAMPING titik seed sebelum place/siram - remote place/water punya batas jarak
-- server-side, kejauhan = fire ketolak diam-diam. offset 5 stud DI SAMPING (bukan pas di titik)
-- biar ga nyangkut di badan tanaman; ngadep ke arah seed.
-- v44.69: jarak berdiri dari seed pas Farm 2 naruh Sprinkler/WC (dulu 5). makin gede makin jauh.
-- CATATAN: remote place ada BATAS jarak - kalau kejauhan, place GAGAL. turunin lagi kalau ga ke-place.
local AF2_PLACE_OFFSET = 20
function Farm.af2GotoNear(pos, range)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    range = range or 25
    -- v4.1: TITIK TELEPORT TERSIMPAN (dari tombol "Simpan titik teleport" - posisi karakter lo).
    -- dulu teleport-nya HARDCODE: offset X dari pohon -> sering mendarat nabrak/numpuk tanaman.
    -- sekarang kalau ada titik simpan, karakter TELEPORT KE SITU pas mau naruh sprinkler/WC.
    local sp = state.af2SavePos
    if sp and type(sp) == "table" and sp.x then
        local tp = Vector3.new(sp.x, sp.y + 3, sp.z)
        if (hrp.Position - tp).Magnitude <= 6 then return true end   -- udah di titik simpan
        pcall(function() hrp.CFrame = CFrame.new(tp, pos) end)       -- berdiri di titik simpan, hadap tanaman
        task.wait(0.25)
        return true
    end
    -- v1.2: kalau udah cukup deket, JANGAN teleport (dulu selalu TP walau udah deket)
    if (hrp.Position - pos).Magnitude <= range then return true end
    pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(AF2_PLACE_OFFSET, 8, 0), pos + Vector3.new(0, 3, 0)) end)  -- v1.1: lebih tinggi (8) biar di atas buah, jauh (offset) biar gak numpuk tanaman lain
    task.wait(0.25)
    return true
end
function Farm.af2PlaceSuperSprinkler()
    local p = pkt("Place", "PlaceSprinkler")
    if not p or not p.Fire then print("[AF2] PlaceSprinkler remote gak ada"); return false end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char then return false end
    -- cari sprinkler sesuai pilihan user (state.af2SprTool) atau auto
    local tool = nil
    local wantName = state.af2SprTool and state.af2SprTool ~= "" and state.af2SprTool:lower() or nil
    for _, h in ipairs({char, player:FindFirstChildOfClass("Backpack")}) do
        if h then for _, t in ipairs(h:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("sprinkler",1,true) then
                if not wantName or t.Name:lower():find(wantName,1,true) then tool=t; break end
            end
        end end
        if tool then break end
    end
    if not tool then print("[AF2] Sprinkler ga ada di backpack (pilihan: "..(state.af2SprTool or "auto")..")"); return false end
    -- v39.8: posisi dari PICKER PLOT (af2SelectedPlots). tiap plot terpilih -> 1 posisi.
    local positions = {}
    local picks = Farm.af2GetPlantPositions()
    for _, e in ipairs(picks) do
        local p0 = e.pos
        local py = p0.Y
        -- v40.9: patok Y ke TANAH - exclude pohon/tanaman + sprinkler biar raycast ga kena pohon
        -- (pohon kadang tinggi -> place ikut pohon -> melayang). exclude semua kecuali tanah.
        pcall(function()
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local ex = {}
            if player.Character then ex[#ex+1] = player.Character end
            -- exclude folder tanaman + sprinkler biar ga jadi patokan Y
            local gardens = workspace:FindFirstChild("Gardens")
            if gardens then ex[#ex+1] = gardens end
            local sp = workspace:FindFirstChild("Sprinklers")
            if sp then ex[#ex+1] = sp end
            rp.FilterDescendantsInstances = ex
            local hit = workspace:Raycast(Vector3.new(p0.X, p0.Y + 50, p0.Z), Vector3.new(0, -300, 0), rp)
            if hit then py = hit.Position.Y end
        end)
        positions[#positions+1] = Vector3.new(p0.X, py, p0.Z)
        print(string.format("[AF2] plot '%s': (%.1f,%.1f,%.1f)", tostring(e.label), p0.X, py, p0.Z))
    end
    if #positions == 0 then print("[AF2] Sprinkler: ga ada posisi"); return false end
    if tool.Parent ~= char and hum then pcall(function() hum:EquipTool(tool) end); task.wait(0.2) end
    local placed = 0
    local hrp0 = char:FindFirstChild("HumanoidRootPart")
    local origCF = hrp0 and hrp0.CFrame   -- v35.2: inget posisi semula
    for _, pos in ipairs(positions) do
        Farm.af2GotoNear(pos, 40)   -- v1.2: sprinkler toleransi jarak longgar (40) - gak perlu deket, gak selalu TP
        local ok, err = pcall(function() p:Fire(pos, tool.Name, tool, 1) end)
        print(string.format("[AF2] place sprinkler pos=(%.1f,%.1f,%.1f) ok=%s err=%s", pos.X, pos.Y, pos.Z, tostring(ok), tostring(err)))
        if ok then placed = placed + 1 end
        task.wait(0.2)
    end
    -- v36.6: JANGAN balik ke posisi asal (user mau tetep di plot). dulu: h.CFrame = origCF
    -- if origCF then pcall(function() local h = char:FindFirstChild("HumanoidRootPart"); if h then h.CFrame = origCF end end) end
    print(string.format("[AF2] Sprinkler: %d/%d placed (tool=%s)", placed, #positions, tool.Name))
    -- v34.3: LEPAS tool habis place - biar ga kepencet/ke-place lagi gak sengaja
    if hum then task.wait(0.1); pcall(function() hum:UnequipTools() end) end
    return placed > 0
end

-- place Super Watering Can di posisi tanaman (remote Place.PlaceWateringCan, sama pola sprinkler)
function Farm.af2PlaceWateringCan()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum then return false end
    -- cari WC sesuai pilihan user (state.af2WCTool) atau auto
    local tool
    local wantWC = state.af2WCTool and state.af2WCTool ~= "" and state.af2WCTool:lower() or nil
    for _, h in ipairs({char, player:FindFirstChildOfClass("Backpack")}) do
        if h then for _, t in ipairs(h:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("watering",1,true) then
                if not wantWC or t.Name:lower():find(wantWC,1,true) then tool=t; break end
            end
        end end
        if tool then break end
    end
    if not tool then print("[AF2] WC: ga ada di backpack (pilihan: "..(state.af2WCTool or "auto")..")"); return false end
    -- v34.1 HASIL SPY (bukti log user): remote asli = WateringCan.UseWateringCan
    --   :Fire( Vector3 posisi, string namaTool, Instance tool yg di-equip )
    -- BUKAN Place.PlaceWateringCan kayak dugaan komentar author. discovery tetep ada sbg cadangan.
    local rem = pkt("WateringCan", "UseWateringCan")
    local remName = "WateringCan.UseWateringCan"
    if not rem then
        -- scan NET nyari remote yg namanya ngandung "water" - hasilnya di-print sbg BUKTI debug
        pcall(function()
            for gk, g in pairs(NET or {}) do
                if type(g) == "table" then
                    for k, v in pairs(g) do
                        if tostring(k):lower():find("water") then
                            print("[AF2][debug] kandidat remote: "..tostring(gk).."."..tostring(k))
                            if not rem then
                                local okF = pcall(function() return v.Fire ~= nil end)
                                if okF and v.Fire then rem = v; remName = tostring(gk).."."..tostring(k) end
                            end
                        end
                    end
                end
            end
        end)
    end
    -- posisi target = titik seed hasil scan (Y udah dipatok tanah - sama kayak fire manual di spy)
    local positions = {}
    -- v39.8: posisi dari PICKER PLOT (sama kayak sprinkler)
    -- v40.9: raycast Y ke TANAH (exclude pohon) biar siram di tanah, ga ikut tinggi pohon
    for _, e in ipairs(Farm.af2GetPlantPositions()) do
        local p0 = e.pos
        local py = p0.Y
        pcall(function()
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local ex = {}
            if player.Character then ex[#ex+1] = player.Character end
            local gardens = workspace:FindFirstChild("Gardens")
            if gardens then ex[#ex+1] = gardens end
            local sp = workspace:FindFirstChild("Sprinklers")
            if sp then ex[#ex+1] = sp end
            rp.FilterDescendantsInstances = ex
            local hit = workspace:Raycast(Vector3.new(p0.X, p0.Y + 50, p0.Z), Vector3.new(0, -300, 0), rp)
            if hit then py = hit.Position.Y end
        end)
        positions[#positions+1] = Vector3.new(p0.X, py, p0.Z)
    end
    if #positions == 0 then print("[AF2] WC: ga ada posisi target - pencet [pin] Scan dulu"); return false end
    if tool.Parent ~= char then pcall(function() hum:EquipTool(tool) end); task.wait(0.3) end
    if tool.Parent ~= char then print("[AF2] WC: gagal equip "..tool.Name); return false end
    local placed = 0
    if rem then
        print("[AF2] WC: pakai remote "..remName)
        local hrpW = char:FindFirstChild("HumanoidRootPart")
        local origW = hrpW and hrpW.CFrame   -- v35.2
        for _, pos in ipairs(positions) do
            Farm.af2GotoNear(pos)   -- v35.2: TP ke samping seed (remote siram ada batas jarak - kejauhan gagal)
            -- signature persis hasil spy: (pos, nama, instance tool). 1x per titik (WC consumable xN)
            local ok, err = pcall(function() rem:Fire(pos, tool.Name, tool) end)
            print(string.format("[AF2] use WC pos=(%.1f,%.1f,%.1f) ok=%s err=%s", pos.X, pos.Y, pos.Z, tostring(ok), tostring(err)))
            if ok then
                placed = placed + 1
                -- v12.5: hitung TIAP SIRAMAN Super WC -> dipakai buat auto-rejoin (lihat baris ~13660).
                -- ditaruh DI SINI (titik Fire beneran), bukan di loop luar - biar yg kehitung cuma
                -- siraman yg BENERAN kekirim ke server.
                Farm._wcCount = (Farm._wcCount or 0) + 1
            end
            task.wait(0.3)
        end
        -- v36.6: JANGAN balik ke asal (tetep di plot). dulu: h.CFrame = origW
        -- if origW then pcall(function() local h = char:FindFirstChild("HumanoidRootPart"); if h then h.CFrame = origW end end) end
    else
        -- fallback terakhir: berdiri di titik seed + tool:Activate() (API resmi, niru pencet layar)
        print("[AF2] WC: remote place GA KETEMU -> fallback Activate (cek log [debug] di atas)")
        if not hrp then return false end
        local origCF = hrp.CFrame
        for _, pos in ipairs(positions) do
            pcall(function()
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                task.wait(0.25)
                for _ = 1, 3 do
                    local ok = pcall(function() tool:Activate() end)
                    if ok then placed = placed + 1 end
                    task.wait(0.2)
                end
            end)
        end
        -- v36.6: JANGAN balik ke asal (tetep di plot). dulu: hrp.CFrame = origCF
        -- pcall(function() hrp.CFrame = origCF end)
    end
    print(string.format("[AF2] WC: %d fire di %d titik (tool=%s)", placed, #positions, tool.Name))
    -- v34.3: LEPAS tool habis pakai - biar ga kepencet/kesiram lagi gak sengaja (WC consumable!)
    task.wait(0.1); pcall(function() hum:UnequipTools() end)
    return placed > 0
end

