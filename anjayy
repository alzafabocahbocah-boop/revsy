-- ====== AUTO FARM 2: logic loop ======
-- Super WC   : place pas buah < threshKg di garden tinggal <= 50 (hampir abis dicolect)
-- Super Sprinkler: place tiap 2 menit (independen, ikut durasinya)
-- Collect2 + Sell2: jalan di loop sendiri (terpisah)

function Farm.af2CountSmallFruits(threshKg)
    threshKg = threshKg or math.abs(state.c2WeightF or 50)
    pcall(Farm.updateBaseW)   -- v44.60: kalibrasi rasio kg dari buah di tas dulu (biar gardenKg gak balik nil -> counter gak mentok 0)
    local count = 0
    pcall(function()
        local gardens = workspace:FindFirstChild("Gardens")
        if not gardens then return end
        for _, plot in ipairs(gardens:GetChildren()) do
            local plantsF = plot:FindFirstChild("Plants")
            if plantsF then
            for _, plant in ipairs(plantsF:GetChildren()) do
                -- v39.6: filter KETAT - cuma plant dgn prefix userId SENDIRI. plot bisa campur
                -- (beberapa owner 1 plot), jadi filter per-PLANT lebih akurat drpd per-plot.
                local ownerId = tonumber(plant.Name:match("^(%d+)_"))
                if ownerId == player.UserId then
                local seedName = plant:GetAttribute("SeedName") or plant.Name
                local fruits = plant:FindFirstChild("Fruits")
                if fruits then
                    for _, fruit in ipairs(fruits:GetChildren()) do
                        -- v1.1: cuma buah ASLI (punya FruitId UUID valid). skip Model HANTU (sisa kepanen)
                        -- biar counter kecil gak palsu -> Super WC gak keblokir "kecil 204 hantu"
                        local fid = fruit:GetAttribute("FruitId") or fruit.Name:match("_([%x%-]+)$")
                        -- v2.6: + cuma buah MATANG (Age>=MaxAge). buah mentah gak bisa dipanen ->
                        -- jangan dihitung "kecil" (dulu kehitung -> angka nyesatin & WC keblokir)
                        if fid and #tostring(fid) >= 30 and Farm.isFruitRipe(fruit) then
                            local kg = Farm.gardenKg(fruit, seedName) or 0
                            if kg > 0 and kg < threshKg then count = count + 1 end
                        end
                    end
                end
                end
            end
            end
        end
    end)
    return count
end

-- v28.9: hitung buah BESAR (>= threshKg) di garden - buat cek batas stop
function Farm.af2CountBigFruits(threshKg)
    threshKg = threshKg or math.abs(state.c2WeightF or 50)
    pcall(Farm.updateBaseW)   -- v44.60: kalibrasi rasio kg dari buah di tas dulu (biar gardenKg gak balik nil -> counter gak mentok 0)
    local count = 0
    pcall(function()
        local gardens = workspace:FindFirstChild("Gardens")
