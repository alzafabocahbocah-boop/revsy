        for _, plot in ipairs(gardens:GetChildren()) do
            local plantsF = plot:FindFirstChild("Plants")
            if plantsF then
            for _, plant in ipairs(plantsF:GetChildren()) do
                -- v39.6: filter KETAT per-plant (prefix userId sendiri)
                local ownerId = tonumber(plant.Name:match("^(%d+)_"))
                if ownerId == player.UserId then
                local seedName = plant:GetAttribute("SeedName") or plant.Name
                local fruits = plant:FindFirstChild("Fruits")
                if fruits then
                    for _, fruit in ipairs(fruits:GetChildren()) do
                        local fid = fruit:GetAttribute("FruitId") or fruit.Name:match("_([%x%-]+)$")
                        if fid and #tostring(fid) >= 30 and Farm.isFruitRipe(fruit) then   -- v2.6: cuma buah MATANG
                            local kg = Farm.gardenKg(fruit, seedName) or 0
                            if kg >= threshKg then count = count + 1 end
                        end
                    end
                end
                end
            end
            end
