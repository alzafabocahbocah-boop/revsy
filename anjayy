    while isCurrentGen() do
        task.wait(0.2)  -- v6.5: 4s -> 0.2s (plant brutal/cepat)
        if isCurrentGen() and state.autoPlant then pcall(Farm.plantOnce) end
    end
end)

-- ===== AUTO BUY PET: tame pet liar + auto ambil-balik (buy-back) + webhook =====
-- pet liar = Part "WildPet_<uuid>" di Workspace.Map.WildPetRef.
-- atribut: PetName, Price, Rarity, OwnerUserId(0=blm ada yg punya), OwnerName, State.
-- state pet: "mine"(punya kita), "p<harga>"(bisa di-bid), "free"(baru blm berharga).
-- klaim kalau bukan punya kita & state berubah. buy-back tiap harga/owner baru (batas petMaxRebuy).
Farm._petClaimed = {}; Farm._petAttempt = {}; Farm._petFail = {}
Farm._petCount = {}; Farm._petLastTry = {}
Farm._petLastOwner = {}; Farm._petInfo = {}   -- v16.9: buat deteksi "masuk garden"
local PET_RETRY_CD = 1.2
local PET_MAX_FAIL = 5
local function petOwnedByMe(o)
    local oid = o:GetAttribute("OwnerUserId")
    if oid ~= nil and oid == player.UserId then return true end
    local onm = o:GetAttribute("OwnerName")
    if onm and onm ~= "" and (onm == player.Name or onm == player.DisplayName) then return true end
    return false
end
local function petPriceOf(o)
    local v = o:GetAttribute("Price")
    if type(v) == "number" and v > 0 then return v end
    return nil
end
local function petStateStr(o)
    if petOwnedByMe(o) then return "mine" end
    local pr = petPriceOf(o)
    if pr then return "p"..tostring(pr) end
    return "free"
end
