        local moonList = {
            {"Bloodmoon", "PW_Bloodmoon", "Bloodmoon"}, {"Goldmoon", "PW_Goldmoon", "Goldmoon"},
            {"Rainbow", "PW_RainbowMoon", "Rainbow"}, {"Mega", "PW_MegaMoon", "Mega"}, {"Moon", "PW_Moon", "Moon"},
