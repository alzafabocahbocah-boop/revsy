Farm.trowelPlotCenter = function()
    -- v40.7: tengah plot = RATA-RATA posisi tanaman sendiri (Y valid = tanah).
    -- dulu pakai PlotSizeReference -> Y salah/melayang -> server nolak MovePlant.
    local out = {}
