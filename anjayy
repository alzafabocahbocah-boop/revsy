-- Apa yang dianggap "berubah"?
-- Kebun gak berubah tiap 15 detik. Yang bikin lo gerak itu KEJADIAN.
-- Selisih 1-2 buah gak ngubah keputusan lo, jadi gak usah dilaporin.
local function panelBerubah(baru, lama)
    if not lama then return true end
    -- kejadian: laporin persis
    if baru.glow ~= lama.glow then return true end          -- gate Glow = angka pasti
    if baru.farm2On ~= lama.farm2On then return true end
    if baru.kg ~= lama.kg then return true end
    if baru.gate ~= lama.gate then return true end
    if baru.wcTrig ~= lama.wcTrig then return true end
    if baru.prio ~= lama.prio then return true end
    if baru.job ~= lama.job then return true end            -- job baru = abis rejoin
    -- buah kecil: penting pas deket trigger WC, cuek pas masih banyak
    local trig = baru.wcTrig or 30
    if (baru.kecil <= trig) ~= (lama.kecil <= trig) then return true end
    if baru.kecil <= trig and baru.kecil ~= lama.kecil then return true end
    -- angka gerombolan: cuma kalau gesernya lumayan
    if math.abs(baru.besar - lama.besar) >= 5 then return true end
    if math.abs(baru.matang - lama.matang) >= 5 then return true end
    if math.abs(baru.tot - lama.tot) >= 5 then return true end
    if lama.nilai > 0 and math.abs(baru.nilai - lama.nilai) / lama.nilai > 0.10 then return true end
    if lama.nilai == 0 and baru.nilai > 0 then return true end
    return false
end

local function panelPasang(c)
    local ubah = {}
    if type(c.glowCollectMin) == "number" and c.glowCollectMin >= 1 then
        state.glowCollectMin = math.floor(c.glowCollectMin)
        ubah[#ubah + 1] = "gate Glow=" .. state.glowCollectMin
    end
    if type(c.af2WCTrigger) == "number" and c.af2WCTrigger >= 0 then
        state.af2WCTrigger = math.floor(c.af2WCTrigger)
        ubah[#ubah + 1] = "trigger WC=" .. state.af2WCTrigger
    end
    if type(c.antiCollectHeavyKg) == "number" and c.antiCollectHeavyKg >= 1 then
        state.antiCollectHeavyKg = math.floor(c.antiCollectHeavyKg)
        ubah[#ubah + 1] = "buah besar=" .. state.antiCollectHeavyKg
    end
    if #ubah > 0 then
        pcall(function() if Farm._refreshAllToggles then Farm._refreshAllToggles() end end)
        saveState()
        panelLamaData = nil   -- paksa lapor balik, biar panel liat hasilnya
        print("[Panel] setelan dari web: " .. table.concat(ubah, ", "))
    end
end

-- CATATAN: farm2On SENGAJA gak diterima dari panel.
-- Panel matiin Farm 2 -> panel ikut mati -> gak bisa dinyalain lagi dari web.
-- Buka-tutup Farm 2 tetep lewat tombol -50/-60 di HP.

function Farm.startPanelLoop()
    Farm._panelGen = Farm._panelGen + 1
    local gen = Farm._panelGen
    local function hidup() return Farm._panelGen == gen and panelAktif() end

    task.spawn(function()
        print(("[Panel] jalan | %s | tim/game ditugasin dari web"):format(player.Name))
        while hidup() do
            pcall(function()
                local baru = panelPetik()
                if baru then
                    local skrg = os.time()
                    local wajib = (skrg - panelLamaKirim) >= PANEL_DENYUT
                    if wajib or panelBerubah(baru, panelLamaData) then
                        local r = panelReq("/stat", "POST", baru)
                        if r and (r.StatusCode == 200 or r.Success) then
                            panelLamaData, panelLamaKirim = baru, skrg
                            Farm._panelKirim = Farm._panelKirim + 1
                        end
                    else
                        Farm._panelLewat = Farm._panelLewat + 1
                    end
                end
            end)
            task.wait(PANEL_CEK)
        end
        print("[Panel] lapor berhenti.")
    end)

    task.spawn(function()
        while hidup() do
            pcall(function()
                local r = panelReq("/cfg?akun=" .. player.Name, "GET")
                local body = r and (r.Body or r.body)
                if body and body ~= "" then
                    local ok, d = pcall(function() return HS:JSONDecode(body) end)
                    if ok and type(d) == "table" and type(d.cfg) == "table" then
                        local ts = tonumber(d.ts) or 0
                        if ts > panelCfgTs then
                            panelCfgTs = ts
                            panelPasang(d.cfg)
                        end
                    end
                end
            end)
            task.wait(PANEL_CFG)
        end
    end)
end

function Farm.stopPanelLoop()
    Farm._panelGen = Farm._panelGen + 1   -- generasi lama otomatis berhenti
end

