-- v6.6: BLOCK "tiba-tiba kepental ke server lain".
-- game/anti-cheat kadang maksa TeleportService:Teleport(...) buat mental-in kita ke
-- server publik lain. kita HOOK TeleportService biar teleport yg BUKAN dari kita
-- diblokir. teleport dari tombol HOP kita tetap jalan (ditandai flag ZenxAllowTP).
-- catatan jujur: gak semua kepentalan bisa diblok dari client (kalau server bener2
-- shutdown/migrate, itu di luar kuasa script). tapi ini nangkis mayoritas kasus.
local genvTP = (typeof(getgenv) == "function") and getgenv() or _G
genvTP.ZenxAllowTP = false   -- default: teleport diblok
if genvTP.ZenxAntiKepental == nil then genvTP.ZenxAntiKepental = false end  -- v10.1: default OFF (gak ngeblok kecuali dinyalain)
-- helper buat HOP kita sendiri: buka izin sebentar lalu teleport
local function zenxTeleport(fn)
    genvTP.ZenxAllowTP = true
    local ok = pcall(fn)
    task.delay(5, function() genvTP.ZenxAllowTP = false end)  -- tutup lagi stlh 5s
    return ok
end
genvTP.ZenxTeleport = zenxTeleport  -- biar doHop bisa akses
do
    local TS = game:GetService("TeleportService")
    local blocked = 0
    -- hook lewat hookmetamethod kalau ada (paling bersih); fallback ke replace fungsi
    local function shouldBlock()
        -- v10.0: cuma blok kalau anti-kepental ON. matiin pas main di private server orang
        -- (server bisa shutdown -> Roblox teleport balik = normal, jangan diblok).
        return genvTP.ZenxAntiKepental and not genvTP.ZenxAllowTP
    end
    if hookmetamethod and getnamecallmethod then
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if self == TS and (method == "Teleport" or method == "TeleportToPlaceInstance"
               or method == "TeleportToPrivateServer") then
                if shouldBlock() then
                    blocked = blocked + 1
                    warn("[StarFarm] teleport DIBLOK (kepental dicegah) #"..blocked.." method="..method)
                    return  -- gak diteruskan -> teleport gak jalan
                end
            end
            return old(self, ...)
        end)
        print("[StarFarm] anti-kepental hook terpasang (status: "..(genvTP.ZenxAntiKepental and "ON-ngeblok" or "OFF-bebas")..")")
    else
        -- fallback: replace fungsi TeleportService langsung (kalau executor support)
        pcall(function()
            local origTP = TS.Teleport
            TS.Teleport = function(self, ...)
                if shouldBlock() then
                    blocked = blocked + 1
                    warn("[StarFarm] teleport DIBLOK (fallback) #"..blocked)
                    return
                end
                return origTP(self, ...)
            end
        end)
        print("[StarFarm] anti-kepental aktif (fallback replace)")
    end
end

