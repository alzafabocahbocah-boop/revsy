function Farm.giftPetOnce()
    local target = state.gpTarget
    if not target or target == "" then Farm._gpStatus = "notarget"; return end
    local sb = pkt("Mailbox", "SendBatch")
    if not sb or not sb.Fire then Farm._gpStatus = "nosend"; return end
    if not Farm._gpId or Farm._gpIdName ~= target then
        Farm._gpId = resolveTargetId(target); Farm._gpIdName = target
        if not Farm._gpId then Farm._gpStatus = "notfound"; print("[StarFarm] gift pet: user '"..tostring(target).."' gak ketemu"); return end
        print("[StarFarm] gift pet target: "..target.." (id "..tostring(Farm._gpId)..")")
    end
    local uid = Farm._gpId
    if not uid then return end
    local batch, total = {}, 0
    local function flush()
        if #batch > 0 then
            local items = batch; batch = {}
            pcall(function() sb:Fire(uid, items, "") end)
            total = total + #items; task.wait(0.5)
        end
    end
    -- v20.6: scan BACKPACK doang. pet aktif/dipasang (PetVisualController) gak keikut -> aman.
    for _, holder in ipairs({ player:FindFirstChildOfClass("Backpack") }) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") then
                    -- pet: atribut Pet (jenis) + PetId (UUID). buah pakai Id+Fruit, gear pakai MainCategory.
                    local petName = t:GetAttribute("Pet") or t:GetAttribute("PetName") or t:GetAttribute("PetType")
                    local petId = t:GetAttribute("PetId") or t:GetAttribute("Id")
                    local isFruit = t:GetAttribute("Fruit") or t:GetAttribute("FruitName")
                    local isPet = petId and petName and (not isFruit)
                    if isPet then
                        local pn = petName
                        local okType = state.gpAllPet or state.gpPets[pn]
                        if okType then
                            dprint("[StarFarm] gift pet calon: "..tostring(pn).." id="..tostring(petId))
                            batch[#batch+1] = { ItemKey = tostring(petId), Count = 1, Category = "Pets" }
                            if #batch >= 8 then flush() end
                        end
                    end
                end
            end
        end
    end
    flush()
    if total > 0 then Farm._gpStatus = "ok"; print("[StarFarm] gift pet ke "..target..": "..total.." pet")
    else Farm._gpStatus = "empty" end
end
