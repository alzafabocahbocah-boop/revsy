    return false
end

-- v36.5: cari 1 buah yg value-nya masuk range [minM,maxM] juta. return tool,id.
function Farm.pickFruitInRange(minVal, maxVal)
    for _, holder in ipairs(getFruitHolders()) do
        for _, o in ipairs(holder:GetChildren()) do
            local id = o:GetAttribute("Id")
            local fj = o:GetAttribute("Fruit") or o:GetAttribute("FruitName")
            -- v37.4: baca SEMUA buah (id + fruit attr), ga cuma Tool/hotbar.
            -- buah inventory penuh di GAG kadang non-Tool -> dulu ke-skip. sekarang kebaca.
            if id and fj then
                local pr = Farm.fruitPrice(o) or 0
                if pr >= minVal and pr <= maxVal then
                    return o, id, pr
                end
            end
        end
    end
    return nil
end
-- v36.5: LOOP auto drop. jalan sampai state.dropAuto=false atau target tercapai.
-- tiap cycle: cari buah in-range -> equip (WAJIB dipegang) -> RequestDrop -> unequip.
-- ga ada buah cocok -> nunggu (cycle ga mati). counter dropDone nyampe target -> auto OFF.
function Farm.startDropLoop()
    -- v44.45: guard anti-dobel. tiap start naikin gen; loop lama (gen beda) mati sendiri.
    Farm._dropGen = (Farm._dropGen or 0) + 1
    local myGen = Farm._dropGen
    task.spawn(function()
        local p = pkt("DroppedItem", "RequestDrop")
        if not (p and p.Fire) then print("[StarFarm] RequestDrop packet gak ada"); state.dropAuto=false; return end
        print("[StarFarm] DROP FRUIT auto: ON (target "..tostring(state.dropTarget)..")")
        while state.dropAuto and myGen == Farm._dropGen do
            -- target tercapai -> mati sendiri
            if (state.dropDone or 0) >= (state.dropTarget or 0) then
                print("[StarFarm] DROP FRUIT: target "..tostring(state.dropTarget).." tercapai -> OFF")
                state.dropAuto = false
                pcall(function() if Farm._syncDropToggle then Farm._syncDropToggle() end end)
                break
            end
            local minVal = (tonumber(state.dropMinM) or 0) * 1e6
            local maxVal = (tonumber(state.dropMaxM) or 999999) * 1e6
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            -- v44.52: kalau filter value NOL (min 0 + max tanpa batas) -> SISTEM A: drop SEMUA
            -- buah langsung tanpa hitung value/promote (cepat, ga "mikir" di awal).
            local noFilter = (minVal <= 0) and (maxVal >= 999999 * 1e6)
            local tools, configs = {}, {}
            local needPromote = {}
            if noFilter then
                -- ambil SEMUA Tool buah langsung (skip hitung value + promote)
                for _, holder in ipairs(getFruitHolders()) do
                    for _, o in ipairs(holder:GetChildren()) do
                        local id = o:GetAttribute("Id")
                        local fj = o:GetAttribute("Fruit") or o:GetAttribute("FruitName")
                        if id and fj and o:IsA("Tool") then
                            tools[#tools+1] = {obj=o, id=id}
                        elseif id and fj then
                            configs[#configs+1] = tostring(id)   -- non-Tool: promote dulu (ringan)
                        end
                    end
                end
            else
            -- v42.0: buah value-nya belum kebaca (SizeMultiplier belum sync) di-PROMOTE dulu,
            -- baru cek filter. dulu: value nil -> pr=0 -> ke-skip filter min (drop ga konsisten).
            for _, holder in ipairs(getFruitHolders()) do
                for _, o in ipairs(holder:GetChildren()) do
                    local id = o:GetAttribute("Id")
                    local fj = o:GetAttribute("Fruit") or o:GetAttribute("FruitName")
                    if id and fj then
                        local pr = Farm.fruitPrice(o)
                        if pr == nil then
                            -- value belum kebaca -> promote dulu (kalau non-Tool), cek ulang nanti
                            if not o:IsA("Tool") then needPromote[#needPromote+1] = tostring(id) end
                        elseif pr >= minVal and pr <= maxVal then
                            if o:IsA("Tool") then tools[#tools+1] = {obj=o, id=id}
                            else configs[#configs+1] = tostring(id) end
                        end
                    end
                end
            end
            end
            -- v44.36: DROP CEPAT - kalau ada Tool yg UDAH siap, DROP DULUAN (ga nunggu promote).
            if #tools > 0 then
                local hum0 = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                for _, e in ipairs(tools) do
                    if not state.dropAuto then break end
                    if (state.dropDone or 0) >= (state.dropTarget or 0) then break end
                    if hum0 and e.obj:IsA("Tool") then pcall(function() hum0:EquipTool(e.obj) end) end
                    task.wait(0.15)   -- v44.53: equip nempel dulu
                    for _ = 1, 5 do   -- spam fire drop 5x
