function Farm.startSellNonMutLoop()
    if Farm._sellNonMutOn then return end
    Farm._sellNonMutOn = true
    task.spawn(function()
        local myGen = Farm._espGen  -- ikut generasi biar mati pas gen ganti
        while state.sellNonMutOnly and isCurrentGen() do
            -- v44.35: kalau collect lagi recover (watchdog), pause sell biar ga rebutan buah
