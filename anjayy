                        local fr = plant:FindFirstChild("Fruits")
                        if fr then for _, f in ipairs(fr:GetChildren()) do
                            if getMutation(f) == "Glow" then _glowGardenN = _glowGardenN + 1 end
                        end end
                    end
                end end
            end
        end)
    end
    local _glowMin = state.glowCollectMin or 20
    if state.sfGlowGate then Farm._glowGardenLast = _glowGardenN end   -- expose buat UI progres
    -- v6.0: ADA YANG MINTA? ("Kirim Semua Kesini Dulu" / priority nyala di akun lain).
    -- Glow cuma dipanen kalau ADA yg minta. gak ada yg minta -> biarin numpuk di KEBUN
    -- (lebih aman kesimpen di pohon daripada numpuk di tas & rawan kejual/kepenuhan).
    -- dihitung SEKALI per siklus (getPriorityTarget ada cache 6s, jadi murah).
    local _adaYgMinta = false
    pcall(function()
        local prio = Farm.getPriorityTarget()
        if prio and prio ~= player.Name then _adaYgMinta = true end
    end)
    Farm._glowAdaYgMinta = _adaYgMinta   -- buat status di UI
    -- v10.6 FIX: kalau collectAll=false TAPI gak ada jenis yg dipilih, anggap SEMUA.
    -- (dulu bisa kejadian collectAll jadi false tapi selectedCollect kosong -> okType
    --  false buat semua -> collect DIAM TOTAL walau toggle nyala. ini jaring pengaman.)
    local effAll = state.collectAll
    if not effAll then
        local any = false
        for _ in pairs(state.selectedCollect) do any = true; break end
        if not any then effAll = true end  -- gak ada yg dipilih = ambil semua
    end

    -- proses 1 tanaman (fire buahnya). dipakai dua jalur di bawah.
    -- v9.4: jeda KONSISTEN tiap fire (~0.02s, niru pola sc temen yg gacor).
    -- tiap fire dikasih jeda kecil -> server gak nge-drop -> collect mulus & rapi.
    local function processPlant(plant, plantId, seedName)
        typesFired[seedName or "?"] = (typesFired[seedName or "?"] or 0) + 1
        local fruits = plant:FindFirstChild("Fruits")
        local fruitCount = 0
        if fruits and state.collectMulti then
            for _, fruit in ipairs(fruits:GetChildren()) do
                local fruitUUID = fruit:GetAttribute("FruitId") or fruit.Name:match("_([%x%-]+)$")
                local okMut = passMutation(fruit, state.selectedCollectMut, "collectMutAll", true)
                -- v22.6: toggle "Tanpa Mutasi" ON -> ikut ambil buah polos
                if not okMut and state.collectNoMut and getMutation(fruit) == nil then okMut = true end
                -- v34.7: mode KECUALI ON -> buah BERMUTASI dinilai ulang: SEMUA mutasi ke-collect
                -- KECUALI yg ada di daftar kecuali. buah polos tetep ikut aturan "Tanpa Mutasi".
                if state.collectMutExcept then
                    local m = getMutation(fruit)
                    if m ~= nil then okMut = not ((state.selectedCollectMutEx or {})[m]) end
                end
                local _gkg = Farm.gardenKg(fruit, seedName)
                local okW = passWeight(_gkg, state.collectWeightF)  -- v10.9
                -- v1.2 FIX: buah baru lahir kg-nya sering NIL (SizeMulti blm replikasi ke klien) -> filter -N
                -- nolak -> buah kecil ke-skip sampai Super WC maksa update. Sekarang: filter -N (collect
                -- kecil) + kg NIL = anggap buah baru/kecil -> TETEP collect (gak nunggu WC lagi).
                if not okW and _gkg == nil and (state.collectWeightF or 0) < 0 then okW = true end
                -- v23.1: anti-collect buah berat (>=100kg) - kalau ON, buah segede itu di-skip
                local okHeavy = true
                if state.antiCollectHeavy then
                    local kg = Farm.gardenKg(fruit, seedName)
                    if kg and kg >= (state.antiCollectHeavyKg or 100) then okHeavy = false end
                end
                -- v15.4: skip buah BASI (decay > batas) kalau collectFreshOnly ON.
                local okFresh = true
                if state.collectFreshOnly then
                    local dec = fruit:GetAttribute("DecayAlpha")
                    if type(dec) == "number" and dec > (state.collectFreshMax or 0.5) then okFresh = false end
                end
                -- v34.9: GOLD kg berapapun - mutasi Gold nembus filter mutasi + kg + anti-heavy
                -- (aturan Fresh Only tetep berlaku). aktif cuma pas siklus Collect 2 dgn toggle ON.
                if state.collectGoldAnyKg and getMutation(fruit) == "Gold" then
                    okMut = true; okW = true; okHeavy = true
                end
                -- v38.7: ELECTRIC/RAINBOW kg berapapun - sama kayak Gold, nembus filter kg+heavy.
                if state.collectElecRainAnyKg then
                    local mut = getMutation(fruit)
                    if mut == "Electric" or mut == "Rainbow" then
                        okMut = true; okW = true; okHeavy = true
                    end
                end
                -- v2.3 (STAR): SEMUA MUTASI kg berapapun KECUALI GLOW - nembus filter kg+heavy.
                -- Glow SENGAJA dikecualiin: dia diatur sendiri lewat Glow Settings (gate/fav/gift),
                -- jadi jangan nembus filter di sini. (dulu: kecuali Bloodlit)
                if state.collectAllMutAnyKg then
                    local mut = getMutation(fruit)
                    if mut ~= nil and mut ~= "Glow" then
                        okMut = true; okW = true; okHeavy = true
                    end
                end
                -- STAR FARM: gate Glow - Glow cuma dipanen kalau (1) numpuk >= ambang DAN (2) ADA YG MINTA.
                local okGlowGate = true
                local _isGlow = (getMutation(fruit) == "Glow")
                -- v6.0: + syarat "ada yg minta". gak ada yg minta -> Glow GAK DIPANEN sama sekali,
                -- biarin numpuk di kebun (nunggu akun simpanan nyalain "Kirim Semua Kesini Dulu").
                local _gateBuka = (_glowGardenN >= _glowMin) and _adaYgMinta
                if state.sfGlowGate and _isGlow and not _gateBuka then okGlowGate = false end
                -- v5.5 FIX: gate KEBUKA -> Glow NEMBUS filter kg + anti-heavy.
                -- BUG dulu: gate cuma nge-set okGlowGate, tapi Glow gede (>=50kg) tetep ketahan filter
                -- "-50kg" (okW=false) -> gate kebuka tapi Glow GAK PERNAH KEPANEN. inti gate kan emang
                -- "numpuk dulu sampai N, baru panen SEMUA" - jadi pas kebuka ya harus nembus filter berat.
                if state.sfGlowGate and _isGlow and _gateBuka then
                    okMut = true; okW = true; okHeavy = true
                end
                -- STAR FARM: Collect Glow KECIL (<glowKgMin) - override gate, Glow kecil SELALU diambil (yg gede numpuk)
                if state.sfGlowCollectSmall and getMutation(fruit) == "Glow" then
                    local gkg = Farm.gardenKg(fruit, seedName)
                    -- v2.3: + okHeavy (dulu kelewat -> Glow kecil bisa ketahan anti-heavy)
                    if gkg and gkg < (state.glowKgMin or 30) then okGlowGate = true; okMut = true; okW = true; okHeavy = true end
                end
                -- v5.3: catat ALASAN buah gak kefire (dari kode ASLI, bukan tiruan DIAG).
                -- biar ketauan kenapa selalu nyisain beberapa buah kecil matang.
                local _ripe = Farm.isFruitRipe(fruit)
                local _fidOk = fruitUUID and #tostring(fruitUUID) >= 30
                if _fidOk and _ripe and okMut and okW and okFresh and okHeavy and okGlowGate then
                    pcall(function() p:Fire(tostring(plantId), tostring(fruitUUID)) end)
                    Farm._collectKg = Farm._collectKg + (Farm.gardenKg(fruit, seedName) or 0)  -- v10.8 (v1.2: or 0 - buah kg nil gak bikin ERROR -> collect gak crash)
                    fired = fired + 1; fruitCount = fruitCount + 1
                    task.wait()  -- jeda konsisten tiap fire (pola temen yg gacor)
                else
                    local R = Farm._skipWhy
                    if R then
                        local kgx = Farm.gardenKg(fruit, seedName) or 0
                        local kecilMatang = (_ripe and kgx > 0 and kgx < math.abs(state.collectWeightF or 50))
                        if kecilMatang then   -- cuma catat yg "mestinya kepanen"
                            if not _fidOk then R.nofid = (R.nofid or 0) + 1
                            elseif not okMut then R.mut = (R.mut or 0) + 1
                            elseif not okW then R.berat = (R.berat or 0) + 1
                            elseif not okFresh then R.basi = (R.basi or 0) + 1
                            elseif not okHeavy then R.heavy = (R.heavy or 0) + 1
                            elseif not okGlowGate then R.glowgate = (R.glowgate or 0) + 1
                            end
                        end
                    end
                end
            end
        end
        -- v2.5 FIX PERFORMA: dulu single-harvest ke-fire tiap tanaman yg fruitCount==0 - padahal
        -- fruitCount==0 sering karena buahnya SENGAJA di-skip filter (mis. buah gede >50kg).
        -- akibatnya ~175 tanaman nembak remote sia-sia + task.wait() -> 1 siklus collect 9.8 DETIK
        -- -> cuma manen 25 buah/10s -> kalah cepet sama buah tumbuh -> "kecil" gak turun.
        -- sekarang: single cuma buat tanaman yg BENERAN gak punya Model buah sama sekali.
        local nFruitModels = fruits and #fruits:GetChildren() or 0
        if fruitCount == 0 and nFruitModels == 0 and state.collectSingle then
            if plant:GetAttribute("PlantGrowthReady") == true then
                local pid = tostring(plantId)
                pcall(function() p:Fire(pid, pid) end)
                pcall(function() p:Fire(pid, "") end)
                fired = fired + 1
                task.wait()  -- jeda konsisten tiap fire
            end
        end
    end

    if state.collectMostFirst then
        -- v9.7: mode FOKUS anti-kejar-regrowth.
        -- collect 1 jenis (terbanyak) SEKALI LEWAT, lalu LEPAS (tandai _focusDone) ->
        -- pindah ke jenis terbanyak berikutnya. JANGAN balik ngejar buah yg numpuk lagi
        -- (dulu strawberry 400 turun 390 tumbuh 420 -> stuck terus -> lemot & jenis lain
        -- gak kebagian). stlh SEMUA jenis kebagian 1x / stlh sell -> ronde baru.
        Farm._focusDone = Farm._focusDone or {}
        local byType = {}
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, plant in ipairs(plants:GetChildren()) do
                    local plantId = plant:GetAttribute("PlantId")
                    local seedName = plant:GetAttribute("SeedName")
                    local okType = effAll or (seedName ~= nil and state.selectedCollect[seedName] == true)
                    if plantId and not okType then skipped = skipped + 1 end
                    if plantId and okType then
                        local e = byType[seedName or "?"]
                        if not e then e = { list = {}, fruits = 0 }; byType[seedName or "?"] = e end
                        e.list[#e.list+1] = { plant, plantId, seedName }
                        -- v10.4 FIX: hitung cuma buah yg BISA dikoleksi sesuai toggle.
                        -- dulu (v10.3) single-ready selalu dihitung -> kalau Single Harvest
                        -- OFF, fokus nyangkut di jenis single (gak kekoleksi) -> buah multi
                        -- gak kebagian giliran. sekarang ngitung niru processPlant:
                        --   multi (folder Fruits) cuma kalau Multi Harvest ON
                        --   single-ready cuma kalau Single Harvest ON
                        local fr = plant:FindFirstChild("Fruits")
                        local nf = fr and #fr:GetChildren() or 0
                        if nf > 0 and state.collectMulti then
                            e.fruits = e.fruits + nf
                        elseif nf == 0 and state.collectSingle and plant:GetAttribute("PlantGrowthReady") == true then
                            e.fruits = e.fruits + 1
                        end
                    end
                end
            end
        end
        -- pilih jenis terbanyak yg BELUM kebagian ronde ini (_focusDone)
        local focus, bestN
        for sn, e in pairs(byType) do
            if e.fruits > 0 and not Farm._focusDone[sn] and (not bestN or e.fruits > bestN) then
                bestN = e.fruits; focus = sn
            end
        end
        -- semua jenis udah kebagian / gak ada yg punya buah -> mulai ronde baru
        if not focus then
            Farm._focusDone = {}
            for sn, e in pairs(byType) do
                if e.fruits > 0 and (not bestN or e.fruits > bestN) then bestN = e.fruits; focus = sn end
            end
        end
        -- collect jenis fokus SEKALI LEWAT, lalu tandai selesai (lepas, gak ngejar regrowth)
        if focus and byType[focus] then
            dprint("[StarFarm] collect fokus: "..focus.." ("..byType[focus].fruits.." buah)")
            for _, t in ipairs(byType[focus].list) do
                -- v2.4 FIX: dulu cuma cek state.autoCollect -> di STAR FARM autoCollect (Farm 1)
                -- dipaksa OFF, jadi loop ini BREAK di buah pertama -> Collect 2 GAK MANEN APAPUN
                -- pas mode "Terbanyak Dulu" nyala. sekarang cek autoCollect2 juga.
                if not (state.autoCollect or state.autoCollect2) then break end
                processPlant(t[1], t[2], t[3])
            end
            Farm._focusDone[focus] = true
        end
    elseif not state.collectExpensiveFirst then
        -- v7.8: JALUR CEPAT (default) - fire langsung tanpa bangun tabel.
        -- ini balikin performa: gak ada alokasi tabel tiap siklus -> gak bikin lemot.
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, plant in ipairs(plants:GetChildren()) do
                    local plantId = plant:GetAttribute("PlantId")
                    local seedName = plant:GetAttribute("SeedName")
                    local okType = effAll or (seedName ~= nil and state.selectedCollect[seedName] == true)
                    if plantId and not okType then skipped = skipped + 1 end
                    if plantId and okType then processPlant(plant, plantId, seedName) end
                end
            end
        end
    else
        -- JALUR TERMAHAL DULU - bangun tabel + sort (cuma pas fitur ON, jadi
        -- beban sort cuma dibayar kalau kamu emang mau prioritas mahal).
        local todo = {}
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, plant in ipairs(plants:GetChildren()) do
                    local plantId = plant:GetAttribute("PlantId")
                    local seedName = plant:GetAttribute("SeedName")
                    local okType = effAll or (seedName ~= nil and state.selectedCollect[seedName] == true)
                    if plantId and not okType then skipped = skipped + 1 end
                    if plantId and okType then
                        todo[#todo+1] = { plant, plantId, seedName, Farm.cropValue(seedName) }
                    end
                end
            end
        end
        table.sort(todo, function(a, b) return a[4] > b[4] end)  -- termahal dulu
        for _, e in ipairs(todo) do processPlant(e[1], e[2], e[3]) end
    end
    if fired > 0 then
        local tlist = {}
        for nm, c in pairs(typesFired) do tlist[#tlist+1] = nm.."("..c..")" end
        -- v6.8: tambah DURASI siklus - biar ketahuan collect makan waktu berapa detik
        local _dur = tick() - _t0
        dprint(string.format("[StarFarm] collect fired=%d skipped=%d durasi=%.2fs | jenis: %s",
            fired, skipped, _dur, (#tlist>0 and table.concat(tlist,", ") or "-")))
    end
    -- v3.3: rekam buat diagnostik (_diagKecil) - tau collectOnce beneran jalan & nembak berapa
    Farm._collectBeat = (Farm._collectBeat or 0) + 1
    Farm._lastFired = fired
    Farm._lastDur = _dur
end

-- ===== SELL: SellAll (semua) / SellFruit per-jenis =====
-- buah inventory = objek di Workspace.<karakter> / Backpack, nama "Jenis [0.71kg]", attr .Id = UUID.
-- sell per-jenis: scan objek, fire SellFruit(.Id) utk jenis yg dipilih.
local function fruitObjType(name)
    -- nama "Green Bean [0.71kg]" -> "Green Bean"
    return (name:gsub("%s*%[.-%]%s*$", ""))
end
local function getFruitHolders()
    local holders = {}
    local plr = Players.LocalPlayer
    if plr then
        local char = plr.Character
        if char then holders[#holders+1] = char end
        local bp = plr:FindFirstChildOfClass("Backpack")
        if bp then holders[#holders+1] = bp end
    end
    return holders
end

-- ===== v24.7: FAVORITE buah - packet Backpack.SetFruitFavorite:Fire(id, bool) =====
function Farm.setFruitFav(id, b)
    local p = pkt("Backpack", "SetFruitFavorite")
    if not (p and p.Fire) or not id then return false end
    pcall(function() p:Fire(tostring(id), b and true or false) end)
    return true
end
-- fav/unfav SEMUA buah di inventory (set favorit = b). return jumlah buah yg diproses.
function Farm.favAllFruits(b)
    local p = pkt("Backpack", "SetFruitFavorite")
    if not (p and p.Fire) then print("[StarFarm] SetFruitFavorite packet gak ada"); return 0 end
    local n = 0
    for _, holder in ipairs(getFruitHolders()) do
        for _, o in ipairs(holder:GetChildren()) do
            local id = o:GetAttribute("Id")
            if id then
                pcall(function() p:Fire(tostring(id), b and true or false) end)
                n = n + 1
                if n % 8 == 0 then task.wait() end
            end
        end
    end
    print("[StarFarm] "..(b and "FAV" or "UNFAV").." semua buah -> "..n)
    return n
end

-- ===== v36.4: DROP buah ke tanah (buat diambil orang). format ASLI hasil capture:
-- DroppedItem.RequestDrop:Fire("HarvestedFruits", UUID)  -- UUID TANPA kurung kurawal!
function Farm.dropFruit(id)
    local p = pkt("DroppedItem", "RequestDrop")
    if not (p and p.Fire) or not id then return false end
    pcall(function() p:Fire("HarvestedFruits", tostring(id)) end)
    return true
end
-- drop SEMUA buah di inventory (kecuali yg favorit, biar ga ke-drop ga sengaja).
-- return jumlah buah yg di-drop.
function Farm.dropAllFruits(skipFav)
    local p = pkt("DroppedItem", "RequestDrop")
    if not (p and p.Fire) then print("[StarFarm] RequestDrop packet gak ada"); return 0 end
    local n = 0
    for _, holder in ipairs(getFruitHolders()) do
        for _, o in ipairs(holder:GetChildren()) do
            local id = o:GetAttribute("Id")
            if id then
                -- skip favorit kalau diminta (favorit ditandai attr .Favorite / .Favorited)
                local fav = o:GetAttribute("Favorite") or o:GetAttribute("Favorited")
                if not (skipFav and fav) then
                    pcall(function() p:Fire("HarvestedFruits", tostring(id)) end)
                    n = n + 1
                    if n % 6 == 0 then task.wait(0.1) end   -- throttle: server ga nge-drop packet
                end
            end
        end
    end
    print("[StarFarm] DROP "..n.." buah ke tanah"..(skipFav and " (favorit di-skip)" or ""))
    return n
end
-- v36.4: tes cepet drop 1 buah (ambil buah pertama di tas). buat uji dari console:
--   getgenv().StarFarm.dropOneFruit()   ATAU panggil dari tombol nanti.
function Farm.dropOneFruit()
