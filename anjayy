                    end
                end
            end

            if #tools == 0 and #configs == 0 then
                task.wait(0.3)   -- v44.46: ga ada buah - scan lagi cepat (dulu 1s)
            else
                -- v44.36: promote configs BATCH (ga nunggu tiap frame) + delay lebih cepat.
                -- tools yg UDAH siap bakal di-drop di bawah (ga nunggu promote kelar dulu).
                if #configs > 0 then
                    local pp = pkt("Backpack", "PromoteFruit")
                    if pp and pp.Fire then
                        for _, uuid in ipairs(configs) do
                            if not state.dropAuto then break end
