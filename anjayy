-- v43.3: parse teks countdown "2h 55m 28s" / "56m 14s" / "44s" -> total detik
function Farm.parseMoonTime(txt)
    if not txt or txt == "" or txt == "-" then return nil end
    local total = 0
    local h = tostring(txt):match("(%d+)%s*h")
    local m = tostring(txt):match("(%d+)%s*m")
    local s = tostring(txt):match("(%d+)%s*s")
    if h then total = total + tonumber(h) * 3600 end
    if m then total = total + tonumber(m) * 60 end
    if s then total = total + tonumber(s) end
    if total <= 0 then return nil end
    return total
end
-- v43.3: format detik -> "2h 55m 28s" / "56m 14s" / "44s"
function Farm.fmtMoonTime(sec)
    if not sec or sec <= 0 then return "now" end
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = math.floor(sec % 60)
    if h > 0 then return string.format("%dh %dm %ds", h, m, s)
    elseif m > 0 then return string.format("%dm %ds", m, s)
    else return string.format("%ds", s) end
end
