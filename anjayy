-- v44.4: SEARCH username Roblox (buat autocomplete penerima gift). return array {name, id} atau nil.
Farm._usernameCache = Farm._usernameCache or {}
function Farm.searchUsername(keyword)
    if not keyword or keyword == "" then return nil end
    local kw = tostring(keyword):lower()
    -- v44.13: CACHE - keyword sama, pakai hasil lama (ga request ulang, ngurangin rate-limit)
    if Farm._usernameCache[kw] ~= nil then
        return Farm._usernameCache[kw]
    end
    local url = "https://users.roblox.com/v1/users/search?keyword=" .. keyword .. "&limit=25"
    -- v44.13: auto-retry sampai 3x kalau gagal (rate-limit), jeda naik tiap coba
    local out = nil
    for attempt = 1, 3 do
        local resp = Farm.relayReq({ Url = url, Method = "GET" })
        local body = resp and (resp.Body or resp.body)
        local status = resp and (resp.StatusCode or resp.Status or resp.status)
        if body then
            local ok, data = pcall(function() return HS:JSONDecode(body) end)
            if ok and type(data) == "table" and type(data.data) == "table" then
                out = {}
                for _, u in ipairs(data.data) do
                    if u.name then out[#out+1] = { name = u.name, id = u.id, display = u.displayName } end
                end
                break   -- sukses
            end
        end
        -- gagal (rate-limit / kosong) -> tunggu lalu coba lagi
        if attempt < 3 then task.wait(attempt * 1.5) end   -- 1.5s, 3s
    end
    -- simpan ke cache cuma kalau SUKSES (biar gagal bisa dicoba ulang nanti)
    if out ~= nil then Farm._usernameCache[kw] = out end
    return out
end
