                    local sn = plant:GetAttribute("SeedName") or "?"
                    per[sn] = (per[sn] or 0) + 1
                end
            end
            local total = 0
            for sn, c in pairs(per) do
                total = total + c
                if c > nSeed then seed = sn; nSeed = c end   -- seed dominan (jumlah tanaman terbanyak)
