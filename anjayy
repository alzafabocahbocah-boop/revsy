-- sementara Age naik 0.07 -> 0.71. jadi kg buah FIX PAS LAHIR, gak pernah tumbuh.
local function cacheFruitModel(m)
    pcall(function()
        if not (m:IsA("Model") and m.Parent and m.Parent.Name == "Fruits") then return end
        local plant = m.Parent.Parent
        if not plant then return end
        if tonumber(tostring(plant.Name):match("^(%d+)_")) ~= player.UserId then return end
        local fid = m:GetAttribute("FruitId")
        local pid = m:GetAttribute("PlantId") or plant:GetAttribute("PlantId")
        if not (fid and pid and #tostring(fid) >= 30) then return end
        local key = tostring(fid)
        local lama = Farm._fruitCache[key]
        local seed = plant:GetAttribute("SeedName")
        local e = lama or { at = os.clock() }
        e.plantId = tostring(pid)
        e.seed    = seed
        e.maxAge  = m:GetAttribute("MaxAge")
        e.kg      = Farm.gardenKg and Farm.gardenKg(m, seed) or nil
        -- catatan: getMutation() dideklarasi jauh DI BAWAH (baris ~2474), jadi gak kejangkau dari
        -- sini (lexical scope). pakai atribut mentahnya aja - isinya sama.
        e.mut     = m:GetAttribute("Mutation")
        e.model   = m
        Farm._fruitCache[key] = e
    end)
end
