        local function applyModeLabels()
            if overlayMode == "counter" then
                lPohon.Text = "pohon"; lKecil.Text = "kecil"; lBesar.Text = "besar"
                lGift.Text = "value"; lTotal.Text = "total buah"; lSprWC.Text = "spr/wc"
                for _, r in ipairs(counterRows) do r[1].Visible = true; r[2].Visible = true end
                for _, r in ipairs(counterRows) do r[1].TextSize = 12; r[2].TextSize = 18 end
