                    local _, totSeed = seedDiTas()
                    local r = panelReq("/stat", "POST", {
                        akun  = player.Name,
                        -- v3.3: PENANDA SCRIPT. Panel butuh ini buat misahin
                        -- akun GAG 2 yang jalanin star_seed dari yang jalanin
                        -- star_farm -- tampilan kartunya beda (yang ini gak
                        -- punya kebun, yang itu gak punya stok seed).
