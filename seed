                            end
                            return table.concat(t, ",")
                        end)(),
                        -- v3.4: buah nunggu jual + isi mailbox. Panel pakai ini
                        -- buat "sheckles tertunda" -- akun yang barangnya udah
                        -- dateng tapi belum kejual (nunggu pengali nyampe ambang).
                        -- Tanpa ini, auto-suplai bakal ngirim terus ke akun yang
