end

-- v4.14: SEARCH username Roblox (autocomplete penerima gift, dari star_farm).
-- Pakai users.roblox.com search API -> return array {name, id, display}. Retry
-- 3x kalau rate-limit. Seed._searchErr = pesan error terakhir (buat debug GUI).
Seed._usernameCache = Seed._usernameCache or {}
Seed._searchErr = ""
function Seed.searchUsername(keyword)
    if not keyword or keyword == "" then Seed._searchErr = "keyword kosong"; return nil end
    local kw = tostring(keyword):lower()
    if Seed._usernameCache[kw] ~= nil then return Seed._usernameCache[kw] end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request)
    if not req then Seed._searchErr = "executor gak punya HTTP request"; return nil end
    local url = "https://users.roblox.com/v1/users/search?keyword=" .. HS:UrlEncode(keyword) .. "&limit=25"
    local out = nil
    for attempt = 1, 3 do
        local ok, resp = pcall(function() return req({ Url = url, Method = "GET" }) end)
        if not ok then
            Seed._searchErr = ("percobaan %d: request error (%s)"):format(attempt, tostring(resp):sub(1,50))
        else
            local body = resp and (resp.Body or resp.body)
            local status = resp and (resp.StatusCode or resp.Status or resp.status)
            if status == 429 then
                Seed._searchErr = ("percobaan %d: rate-limit (429), tunggu..."):format(attempt)
            elseif status and status ~= 200 then
                Seed._searchErr = ("percobaan %d: HTTP %s"):format(attempt, tostring(status))
            elseif body then
                local okJ, data = pcall(function() return HS:JSONDecode(body) end)
                if okJ and type(data) == "table" and type(data.data) == "table" then
                    out = {}
                    for _, u in ipairs(data.data) do
                        if u.name then out[#out+1] = { name = u.name, id = u.id, display = u.displayName } end
                    end
                    if #out == 0 then Seed._searchErr = "user gak ketemu (0 hasil)"
                    else Seed._searchErr = "" end
                    break
                else
                    Seed._searchErr = ("percobaan %d: balasan gak valid (JSON gagal)"):format(attempt)
                end
            else
                Seed._searchErr = ("percobaan %d: balasan kosong"):format(attempt)
            end
        end
        if attempt < 3 then task.wait(attempt * 1.5) end   -- 1.5s, 3s
    end
    if out ~= nil then Seed._usernameCache[kw] = out end
    return out
end

local function panelAktif()
    return type(state.panelUrl) == "string" and state.panelUrl ~= ""
