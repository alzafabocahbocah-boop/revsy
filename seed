local function lblGiftPick(btn, tbl)
    -- v4.18: tampil NAMA + JUMLAH stok tiap seed yg dipilih (bukan cuma "N dipilih").
    -- Contoh: "Gold: 250, Carrot: 50". Biar keliatan stok pas mau kirim.
    local jml = {}
    for _, e in ipairs(seedDiTas()) do jml[e.n] = e.j end
    for _, e in ipairs(Seed.gearDiTas()) do jml[e.n] = e.j end   -- gear juga
    local bagian = {}
    for nm in pairs(tbl) do
        local stok = jml[nm]
        bagian[#bagian+1] = stok and (nm .. ": " .. stok) or (nm .. ": 0")
    end
    table.sort(bagian)
    if #bagian == 0 then
        btn.Text = "Pilih"
    elseif #bagian <= 2 then
        btn.Text = table.concat(bagian, ", ")
    else
        btn.Text = ("%s +%d lagi"):format(table.concat(bagian, ", ", 1, 2), #bagian - 2)
    end
end
