function Seed.terimaGiftSekali()
    -- v1.9: game punya Mailbox.ClaimAll (kekonfirmasi dari star_debug).
    -- Satu tembakan buat semua, jauh lebih enteng daripada claim satu-satu
    -- (yang tiap gift-nya pakai task.wait(0.1)).
    local semua = pkt("Mailbox", "ClaimAll")
    if semua and semua.Fire then
        local n = Seed.jumlahGift()
        if n > 0 then
            pcall(function() semua:Fire() end)
            Seed.statGift = Seed.statGift + n
            print("[StarSeed] terima gift (ClaimAll): " .. n)
            return n
        end
        return 0
    end

    -- cadangan: claim satu-satu
    local cl = pkt("Mailbox", "Claim")
    if not cl or not cl.Fire then return 0 end
    local pg = player:FindFirstChildOfClass("PlayerGui")
    local mb = pg and pg:FindFirstChild("MailboxUI")
    local frame = mb and mb:FindFirstChild("Frame")
    local recv = frame and frame:FindFirstChild("RecieveFrame")
    if not recv then return 0 end

    local n = 0
    for _, g in ipairs(recv:GetChildren()) do
        if not (state.terimaGift and isCurrentGen()) then break end
        local id = tostring(g.Name):match("^Gift_(.+)$")
        if id and g:IsA("GuiObject") then
            pcall(function() cl:Fire(id) end)
            n = n + 1
            task.wait(0.1)
        end
    end
    if n > 0 then
        Seed.statGift = Seed.statGift + n
        print("[StarSeed] terima gift: " .. n)
    end
    return n
end

