-- GIFT MAIL (v3.18) -- kirim seed/gear ke akun lain via mailbox
-- remote: pkt("Mailbox","SendBatch"):Fire(userId, items, "")
--   Seed: { ItemKey=namaSeed, Count=n, Category="Seeds" }
--   Gear: { ItemKey=namaGear, Count=n, Category="Gear" }
-- sekali kirim, jumlah bisa gede (Count sesuai giftMailQty).
-- ============================================================
-- v3.18: tasHolders dipindah ke atas (dipakai gift mail + ESP + collect).
-- Definisi lokal HARUS sebelum pemakaian (upvalue order).
local function tasHolders()
    local t = {}
    local bp = player:FindFirstChildOfClass("Backpack"); if bp then t[#t+1] = bp end
    local ch = player.Character; if ch then t[#t+1] = ch end
