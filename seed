function Seed.autoGiftMailOnce()
    if not state.autoGiftMail then return end
    local target, kurang, alasan = Seed.giftTargetKu()
    if not target then Seed._logGiftPk = alasan or "gak ada target"; return end
    -- v7.14: TANDAI "udah di-gift" (bukan cooldown waktu). Setelah gift, skip target
    -- ini + LAPOR ke backend -> panel exclude dari broadcast. Skip diclear otomatis
    -- kalau target keluar dari giftPkList (recover) ATAU safety 10 menit (kalau
    -- gak recover, retry). Cegah over-gift TANPA cooldown 4 menit.
    Seed._giftDone = Seed._giftDone or {}
    local pk = target:lower()
    -- v7.15: cek dari _giftDone (memory) DAN RIWAYAT (persist) -- biar abis rejoin
    -- gak re-gift akun yg udah dikirimin (memory ilang, riwayat gak).
    if Seed.giftSudah(target) then
        Seed._logGiftPk = ("udah di-gift cukup -> %s (cek riwayat, nunggu recover)"):format(target)
        return
    end
    if Seed._giftDone[pk] then Seed._giftDone[pk] = nil end   -- kelewat 10 menit -> boleh retry
    -- kumpulin buah pumpkin + VALUE (harga NORMAL, v7.4)
    local elig, totalVal = {}, 0
    for _, holder in ipairs(tasHolders()) do
        for _, t in ipairs(holder:GetChildren()) do
            -- Tool (hotbar) + Configuration FruitProxy (inventory)
            if (t:IsA("Tool") or t:IsA("Configuration"))
               and (t:GetAttribute("Fruit") or t:GetAttribute("FruitName")) and t:GetAttribute("Id") then
                local fn = tostring(t:GetAttribute("FruitName") or t.Name):lower()
                if fn:find("pumpkin") then
                    local v = 0
                    pcall(function()
                        local jn = t:GetAttribute("FruitName") or "Atlantic Giant Pumpkin"
                        local sm = t:GetAttribute("SizeMultiplier") or t:GetAttribute("SizeMulti")
                        if type(sm) == "number" then v = Seed._hargaPk(tostring(jn), sm) or 0 end
                    end)
                    elig[#elig+1] = { t = t, val = tonumber(v) or 0 }
                    totalVal = totalVal + (tonumber(v) or 0)
                end
            end
        end
    end
    local N = #elig
    Seed._giftPkQueue = {}
    for i = 1, N do Seed._giftPkQueue[i] = "buah" end
    if N == 0 then Seed._logGiftPk = "antre 0 -- gak ada buah pumpkin"; return end
    if not (kurang and kurang > 0) then Seed._logGiftPk = "target sheck cukup: " .. target; return end

    -- v7.9: PICK secukupnya buat NUTUP kurang (overshoot minimal, algoritma gag2).
    -- 1. urut value TERBESAR dulu, ambil sampe sum >= kurang.
    table.sort(elig, function(a, b) return a.val > b.val end)
    local picked, sum = {}, 0
    for _, e in ipairs(elig) do
        if sum >= kurang then break end
        picked[#picked+1] = e; sum = sum + e.val
    end
    if sum < kurang then
        -- belum cukup buah buat nutup -> NUNGGU (jangan kirim setengah)
        Seed._logGiftPk = ("nunggu: %d buah = %s / butuh %s -> %s"):format(
            N, Seed._singkat(totalVal), Seed._singkat(kurang), target)
        return
    end
    -- 2. buang buah redundan (value <= overage) biar LEWAT setipis mungkin
    while true do
        local overage = sum - kurang
        local bestIdx, bestVal
        for i, e in ipairs(picked) do
            if e.val <= overage and (not bestVal or e.val > bestVal) then bestVal = e.val; bestIdx = i end
        end
        if bestIdx then sum = sum - picked[bestIdx].val; table.remove(picked, bestIdx) else break end
    end

    -- LIMIT harian 50 mail (EscrowCap). Count by ACTUAL gift (buah hilang), bukan fire.
    local hariIni = os.date("%Y-%m-%d")
    if Seed._giftHari ~= hariIni then Seed._giftHari = hariIni; Seed._giftCountHari = 0 end
    if (Seed._giftCountHari or 0) >= 50 then
        Seed._logGiftPk = ("LIMIT 50/50 mail hari ini -- antre %d nunggu besok"):format(N); return
    end

    local uid = resolveTargetId(target)
    if not uid then Seed._logGiftPk = "target gak ketemu: " .. target; return end
    local sb = pkt("Mailbox", "SendBatch")
    if not (sb and sb.Fire) then Seed._logGiftPk = "SendBatch gak ada"; return end

    -- v7.13: kirim + AUTO-COBA Category. Mailbox format bisa beda; pake yg terakhir
    -- sukses (Seed._giftCat), kalau belum ketemu coba daftar sampe buah HILANG.
    -- Kalau SEMUA cat 0 hilang -> mailbox target PENUH (bounce) / format salah.
    local CATS = { "HarvestedFruits", "Holdables", "Fruits", "Harvested", "HarvestedFruit" }
    local terkirim, nmail, valTerkirim, idx = 0, 0, 0, 1
    while idx <= #picked and (Seed._giftCountHari or 0) < 50 do
        local chunk = {}
        while idx <= #picked and #chunk < 20 do chunk[#chunk+1] = picked[idx]; idx = idx + 1 end
        if #chunk == 0 then break end
        -- urutan cat: yg udah kekonfirmasi dulu, baru sisanya
        local coba = {}
        if Seed._giftCat then coba[1] = Seed._giftCat end
        for _, c in ipairs(CATS) do if c ~= Seed._giftCat then coba[#coba+1] = c end end
        local nHilang, valHilang = 0, 0
        for _, cat in ipairs(coba) do
            local items, sentIds = {}, {}
            for _, e in ipairs(chunk) do
                if e.t.Parent then   -- skip yg udah hilang dari percobaan cat sebelumnya
                    local key = tostring(e.t:GetAttribute("Id") or e.t.Name)
                    items[#items+1] = { ItemKey = key, Count = 1, Category = cat }
                    sentIds[key] = e.val
                end
            end
            if #items == 0 then break end
            pcall(function() sb:Fire(uid, items, "") end)
            nmail = nmail + 1
            task.wait(0.6)
            local masihAda = {}
            for _, holder in ipairs(tasHolders()) do
                for _, t in ipairs(holder:GetChildren()) do
                    local id = t:GetAttribute("Id")
                    if id and sentIds[tostring(id)] ~= nil then masihAda[tostring(id)] = true end
                end
            end
            local h2, v2 = 0, 0
            for key, val in pairs(sentIds) do if not masihAda[key] then h2 = h2 + 1; v2 = v2 + val end end
            if h2 > 0 then
                nHilang = nHilang + h2; valHilang = valHilang + v2
                Seed._giftCat = cat   -- inget format yg JALAN
                break
            end
        end
        terkirim = terkirim + nHilang
        valTerkirim = valTerkirim + valHilang
        if nHilang > 0 then Seed._giftCountHari = (Seed._giftCountHari or 0) + 1 end
        if nHilang == 0 then break end   -- gak ada cat jalan -> stop (mailbox penuh/format)
    end

    if terkirim > 0 then
        Seed._giftStat = Seed._giftStat or {}
        local k = target:lower()
        Seed._giftStat[k] = Seed._giftStat[k] or { buah = 0, mail = 0 }
        Seed._giftStat[k].buah = Seed._giftStat[k].buah + terkirim
        Seed._giftStat[k].mail = Seed._giftStat[k].mail + nmail
        Seed._giftPkTotal = (Seed._giftPkTotal or 0) + terkirim
        Seed._giftDone[pk] = os.time()   -- tandai udah di-gift (skip + lapor)
        pcall(Seed.gfHistAdd, { target = target, buah = terkirim, nilai = valTerkirim, mail = nmail })
        Seed._logGiftPk = ("gift %d buah (%s) [%s] -> %s | limit %d/50"):format(
            terkirim, Seed._singkat(valTerkirim), tostring(Seed._giftCat), target, Seed._giftCountHari or 0)
    else
        -- 0 hilang -> COOLDOWN biar gak spam fire. Kemungkinan mailbox target PENUH.
        Seed._giftDone[pk] = os.time()   -- mailbox penuh -> skip juga (retry nanti)
        Seed._logGiftPk = ("FIRE %dx 0 buah hilang -> %s (mailbox PENUH? cek dia claim gift dulu)"):format(nmail, target)
    end
end


