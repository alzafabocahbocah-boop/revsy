    if not state.espInvOn then espInvBersih(); return end
    task.spawn(function()
        while state.espInvOn and Seed._espInvGen == myGen and isCurrentGen() do
            -- v4.87: tiru gag2 -- lookup jenis -> list {w, p, dec}. cocokin sel pake
            -- nama + BERAT TERDEKAT (dari ToolCount), bukan nama doang (harga akurat).
            local byNama = {}
            for _, holder in ipairs(tasHolders()) do
                for _, t in ipairs(holder:GetChildren()) do
                    local fj = t:GetAttribute("Fruit") or t:GetAttribute("FruitName")
                    local w = t:GetAttribute("Weight")
                    if fj and type(w) == "number" then
                        local pr = hargaBuah(t, true)   -- v4.89: ESP inv = harga NORMAL (tanpa pasar)
                        if pr then
                            byNama[fj] = byNama[fj] or {}
                            byNama[t.Name] = byNama[t.Name] or {}
                            local e = { w = w, p = pr, dec = t:GetAttribute("DecayAlpha") or 0 }
                            table.insert(byNama[fj], e)
                            if t.Name ~= fj then table.insert(byNama[t.Name], e) end
                        end
