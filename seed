-- BRIDGE PANEL -- biar akun ini kebaca idup di panel STAR
-- ============================================================
local function relayReq(opts)
    local req = (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request)
    if not req then return nil end
    local ok, resp = pcall(function() return req(opts) end)
    if ok then return resp end
    return nil
end

local function panelAktif()
    return type(state.panelUrl) == "string" and state.panelUrl ~= ""
        and type(state.panelKunci) == "string" and state.panelKunci ~= ""
end

local function panelReq(jalur, metode, isi)
    local o = {
        Url = state.panelUrl .. jalur,
        Method = metode,
        Headers = { ["Content-Type"] = "application/json", ["X-Kunci"] = state.panelKunci },
    }
    if isi then
        local ok, body = pcall(function() return HS:JSONEncode(isi) end)
        if not ok then return nil end
        o.Body = body
    end
    return relayReq(o)
end

-- hitung seed di tas. Seed di tas namanya LANGSUNG "Bamboo"/"Tulip" -- tanpa
-- atribut SeedName, tanpa akhiran "Seed". Jadi patokannya: Tool yang namanya
-- ada di SeedData. Gear (Trowel, Sprinkler) otomatis keskip karena gak ada di situ.
local function tasHolders()
    local t = {}
    local bp = player:FindFirstChildOfClass("Backpack"); if bp then t[#t+1] = bp end
    local ch = player.Character; if ch then t[#t+1] = ch end
    return t
end

-- v1.9 FIX: deteksi seed di tas TIDAK BOLEH ngandelin Seed.rarity().
-- Bukti lapangan (star_debug): SharedModules.SeedData isinya FUNGSI doang,
-- bukan data -- jadi rarity SELALU nil dan semua seed di tas kebaca 0.
-- Sekarang patokannya daftar seed gabungan (sumber utamanya stok SeedShop,
-- 64 jenis). Gear/pet gak ada di daftar itu, jadi otomatis keskip.
local function namaSeedValid(nm)
    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    if not Seed._setSeed then
        Seed._setSeed = {}
        for _, n in ipairs(Seed.daftar) do Seed._setSeed[n] = true end
    end
    return Seed._setSeed[nm] == true
end

local function seedDiTas()
    local hitung, total = {}, 0
    pcall(function()
        for _, holder in ipairs(tasHolders()) do
            for _, tool in ipairs(holder:GetChildren()) do
                if tool:IsA("Tool") and namaSeedValid(tool.Name) then
                    local n = tool:GetAttribute("Count") or 1
                    if n == 0 then n = 1 end   -- pet/seed kadang Count=0, artinya 1
                    hitung[tool.Name] = (hitung[tool.Name] or 0) + n
                    total = total + n
                end
            end
        end
    end)
    local arr = {}
    for nm, n in pairs(hitung) do
        local rar = Seed.rarity(nm) or "?"
        arr[#arr+1] = { n = nm, j = n, r = rar, rank = RARITY_RANK[rar] or 0 }
    end
    table.sort(arr, function(a, b)
        if a.rank ~= b.rank then return a.rank > b.rank end
        return a.n < b.n
    end)
    return arr, total
end

-- v1.2: hitung Super Watering Can & Super Sprinkler di tas. Panel punya kolom
-- khusus buat dua ini di ringkasan fleet (superWC / superSpr), jadi sekalian
-- dilapor -- biar keliatan stok gear se-armada tanpa buka satu-satu.
local function gearDiTas()
    local wc, spr = 0, 0
    pcall(function()
        for _, holder in ipairs(tasHolders()) do
            for _, tool in ipairs(holder:GetChildren()) do
                if tool:IsA("Tool") then
                    local ln = tostring(tool.Name):lower()
                    local n = tool:GetAttribute("Count") or 1
                    if ln:find("super", 1, true) then
                        if ln:find("watering", 1, true) then wc = wc + n
                        elseif ln:find("sprinkler", 1, true) then spr = spr + n end
                    end
                end
            end
        end
    end)
    return wc, spr
end

