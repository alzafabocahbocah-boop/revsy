-- v3.18: singkat angka gede (1240500 -> 1.2M, 8500 -> 8.5K)
local function ringkasAngka(n)
    n = tonumber(n) or 0
    if n >= 1e12 then return ("%.1fT"):format(n/1e12):gsub("%.0T","T")
    elseif n >= 1e9 then return ("%.1fB"):format(n/1e9):gsub("%.0B","B")
    elseif n >= 1e6 then return ("%.1fM"):format(n/1e6):gsub("%.0M","M")
    elseif n >= 1e3 then return ("%.1fK"):format(n/1e3):gsub("%.0K","K")
    else return tostring(math.floor(n)) end
end

