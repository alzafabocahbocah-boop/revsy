-- v3.1: ringkasan filter pet yang BENERAN lagi dipakai. Perlu ditampilin
-- karena kalau setelan panel gak nyampe, script diam-diam jalan pakai setelan
-- lokal -- dan dari luar keliatannya kayak panel-nya diabaikan.
-- v3.9: ringkasan isi mailbox buat baris status. Dipisah dari isiMailbox()
-- biar yang baca datanya gak kecampur yang nyusun teksnya.
function Seed.ringkasMailbox()
    local isi = Seed.isiMailbox()
    if #isi == 0 then return nil end

    -- gabung barang yang sama dari SEMUA gift -- yang penting totalnya,
    -- bukan pecahan per surat
    local total, urut = {}, {}
    local pengirim = {}
    for _, e in ipairs(isi) do
        if e.dari and e.dari ~= "" then pengirim[e.dari] = true end
        for _, b in ipairs(e.barang) do
            if not total[b.n] then total[b.n] = 0; urut[#urut+1] = b.n end
            total[b.n] = total[b.n] + b.j
        end
    end
    table.sort(urut, function(a, b) return total[a] > total[b] end)

    local t = {}
    for i, nm in ipairs(urut) do
        if i > 4 then t[#t+1] = "+" .. (#urut - 4) .. " lain" break end
        t[#t+1] = nm .. " x" .. total[nm]
    end

    local dari = {}
    for nm in pairs(pengirim) do dari[#dari+1] = nm end

    return {
        surat = #isi,
        barang = t,
        dari = dari,
        -- kalau barangnya GAK kebaca, itu penting diketahui: berarti bentuk
        -- isinya beda dari dugaan, dan `mentah` yang perlu diliat
        adaBarang = #urut > 0,
    }
end

function Seed.ringkasFilterPet()
    if state.petSemua then return "SEMUA jenis" end
    local t = {}
    for k in pairs(state.petPilih or {}) do t[#t+1] = k end
    table.sort(t)
    if #t == 0 then return "(kosong -- gak ada yang diburu)" end
    if #t <= 4 then return table.concat(t, ", ") end
    return table.concat({t[1], t[2], t[3]}, ", ") .. " +" .. (#t - 3)
end

-- ============================================================
-- v3.7: TERIMA SETELAN dari jawaban HTTP apa pun.
--
-- Dipisah dari "narik" biar bisa dipakai dua jalur:
--   1. nebeng di jawaban POST /stat  <- jalur utama sekarang, nol permintaan
--   2. GET /seed-cfg sendiri          <- cadangan, kalau panel versi lama
--
-- Bentuk yang diterima sama: { cfg = {...} }. Jawaban /stat nyelipin field
-- `cfg` yang isinya persis sama kayak yang dulu dikasih /seed-cfg.
-- ============================================================
function Seed.pakaiCfgPanel(r)
    if not state.ikutPanel then return end
    local body = r and (r.Body or r.body)
    if not body then
        Seed._cfgLog = "GAGAL: panel gak jawab"
        if not Seed._cfgWarn then Seed._cfgWarn = true
            warn("[StarSeed] setelan panel GAK KEBACA: panel gak jawab") end
        return
    end

    local ok, d = pcall(function() return HS:JSONDecode(body) end)
    if not ok or type(d) ~= "table" then
        Seed._cfgLog = "GAGAL: jawaban gak kebaca"
        return
    end
    -- v3.1: kalau backend belum di-deploy, CF balikin {"error":"jalur gak
    -- dikenal: /seed-cfg"}. Dulu ini diem-diem dianggap "gak ada perubahan"
    -- -- makanya setelan panel keliatan diabaikan tanpa ada tanda apa pun.
    if type(d.error) == "string" then
        Seed._cfgLog = "GAGAL: " .. d.error
        if not Seed._cfgWarn then
            Seed._cfgWarn = true
            warn("[StarSeed] SETELAN PANEL GAK KEPAKAI -> " .. d.error)
            warn("[StarSeed] Backend Cloudflare kemungkinan belum di-deploy.")
            warn("[StarSeed] Sementara ini script pakai setelan LOKAL (GUI).")
        end
        return
    end
    if type(d.cfg) ~= "table" then
        Seed._cfgLog = "GAGAL: jawaban tanpa cfg"
        return
    end
    local c = d.cfg
    local ubah = {}

    for _, k in ipairs(BOOL_PANEL) do
        if type(c[k]) == "boolean" and state[k] ~= c[k] then
            state[k] = c[k]; ubah[#ubah+1] = k .. "=" .. tostring(c[k])
            -- v3.32: ringanOn TIDAK LAGI maksa noclip + hilangin visual (itu
            -- bikin ProximityPrompt E ke NPC/mailbox gak jalan). Sekarang
            -- hideVisual + noclip toggle SENDIRI dari panel (hideVisualOn,
            -- noclipOn), gak nempel ke ringanOn.
            if k == "hideVisualOn" then pcall(Seed.jalanHideVisual) end
            -- v3.28: ESP pakai gen-loop -> harus dipicu pas dinyalain/dimatiin
            if k == "espInvOn" then pcall(Seed.jalanEspInv) end
            if k == "espGardenOn" then pcall(Seed.jalanEspGarden) end
        end
    end
    for _, k in ipairs(NUM_PANEL) do
        local n = tonumber(c[k])
        if n and state[k] ~= n then state[k] = n; ubah[#ubah+1] = k .. "=" .. n end
    end
    -- v3.2: field TEKS dari panel. Dulu cuma giftTarget yang ditangani; minRarity
    -- kelewat, jadi "Ikut samber seed bagus" bisa dinyalain dari panel tapi
    -- ambangnya gak bisa diubah -- nyangkut di nilai lokal.
    if type(c.giftTarget) == "string" and state.giftTarget ~= c.giftTarget then
        state.giftTarget = c.giftTarget
        Seed._uidCache = {}          -- tujuan ganti -> cache id lama gak berlaku
        ubah[#ubah+1] = "giftTarget=" .. c.giftTarget
    end
    -- v3.31: gift mail target dari panel
    if type(c.giftMailTarget) == "string" and state.giftMailTarget ~= c.giftMailTarget then
        state.giftMailTarget = c.giftMailTarget
        Seed._giftUidCache = {}
        ubah[#ubah+1] = "giftMailTarget=" .. c.giftMailTarget
    end
    if type(c.minRarity) == "string" and c.minRarity ~= "" then
        -- cuma terima yang beneran ada di daftar rarity, biar gak nyetel ke
        -- nilai ngawur yang bikin saringan diam-diam gak pernah kena
        local sah = false
        for _, r in ipairs(RARITY_ORDER) do
            if r:lower() == c.minRarity:lower() then
                if state.minRarity ~= r then
                    state.minRarity = r
                    ubah[#ubah+1] = "minRarity=" .. r
                end
                sah = true
                break
            end
        end
        if not sah then
            Seed._cfgLog = "minRarity '" .. c.minRarity .. "' gak dikenal"
        end
    end
    -- daftar jenis: dikirim panel sebagai array nama
    if type(c.seedPilih) == "table" then
        local baru = {}
        for _, nm in ipairs(c.seedPilih) do if type(nm) == "string" then baru[nm] = true end end
