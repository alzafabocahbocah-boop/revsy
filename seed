function Seed.rerollPumpkinOnce()
    if not state.pumpkinRerollOn then return 0 end
    local p = pkt("Shovel", "UseShovel")
    if not (p and p.Fire) then Seed._logPumpkin = "remote Shovel.UseShovel gak ada"; return 0 end
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return 0 end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    -- cari + equip Shovel
    local shovelTool
    for _, h in ipairs({ char, player:FindFirstChildOfClass("Backpack") }) do
        if h then
            for _, t in ipairs(h:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("shovel") then shovelTool = t; break end
            end
        end
        if shovelTool then break end
    end
    if not shovelTool then Seed._logPumpkin = "Tool Shovel gak ada di tas"; return 0 end
    if shovelTool.Parent ~= char and hum then
        pcall(function() hum:EquipTool(shovelTool) end); task.wait(0.1)
    end

    local MY = player.UserId
    local minKg = tonumber(state.sprStopKg) or 80   -- v4.75: pake Goal kg (satu setting)
    Seed.kalibrasiPkRatio()
    local function smToKg(sm) return sm * (Seed._pkRatio or 8.055) end

    Seed._pkQueue = Seed._pkQueue or {}
    Seed._pkPending = Seed._pkPending or {}
    Seed._pkCd = Seed._pkCd or {}
    Seed._pkRerollTotal = Seed._pkRerollTotal or 0

    -- v5.5: ANTRIAN -- scan garden CUMA pas antrian kosong (habisin bekas dulu).
    -- jadi gak re-scan tiap 2s; buah yg udah ke-scan diproses sampe habis dulu.
    if #Seed._pkQueue == 0 then
        local totalPk, siapPk = 0, 0
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, plant in ipairs(plants:GetChildren()) do
                    local ownerId = tonumber(plant.Name:match("^(%d+)_"))
                    local sn = (plant:GetAttribute("SeedName") or ""):lower()
                    if (not ownerId or ownerId == MY) and sn:find("pumpkin") then
                        totalPk = totalPk + 1
                        local fr = plant:FindFirstChild("Fruits")
                        if fr and #fr:GetChildren() > 0 then
                            siapPk = siapPk + 1
                            -- v5.7: cooldown DIBUANG (bikin lemot). skip-pending aja
                            -- cukup buat gak dobel-nembak buah yg sama.
                            for _, fruit in ipairs(fr:GetChildren()) do
                                local kg = Seed.buahKg(fruit)   -- v6.1: Weight asli
                                if not Seed._pkPending[fruit.Name]
                                   and kg > 0 and kg < minKg
                                   and #plant.Name >= 30 then
                                    Seed._pkQueue[#Seed._pkQueue+1] = { plant = plant.Name, fruit = fruit.Name }
                                end
                            end
                        end
                    end
                end
            end
        end
        Seed._pkScanTot = totalPk
        Seed._pkScanSiap = siapPk
    end

    -- v5.8: shovel dari ANTRIAN, serial 0.05s apart (test buktiin: tembak cepet/all
    -- = server DROP; 0.05s spaced yg paling banyak keproses). batch 40.
    local n = 0
    while #Seed._pkQueue > 0 and n < 25 do
        if not (state.pumpkinRerollOn and isCurrentGen()) then break end
        local t = table.remove(Seed._pkQueue, 1)
        if t and not Seed._pkPending[t.fruit] then
            if shovelTool.Parent ~= char and hum then
                pcall(function() hum:EquipTool(shovelTool) end); task.wait(0.05)
            end
            pcall(function() p:Fire(t.plant, t.fruit, shovelTool.Name, shovelTool) end)
            Seed._pkPending[t.fruit] = { plant = t.plant, fruit = t.fruit, t = os.clock() }
            n = n + 1
            task.wait(0.14)   -- v6.0: steady ~7/s (match script cepet); 0.05s kegasak = server drop
        end
    end
    Seed._logPumpkin = ("pumpkin: %d total, %d siap | %d ditembak, antre %d | total reroll: %d"):format(
        Seed._pkScanTot or 0, Seed._pkScanSiap or 0, n, #Seed._pkQueue, Seed._pkRerollTotal)
    return n
end

