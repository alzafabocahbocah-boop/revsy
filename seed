            if k == "destroyDaunOn" then pcall(Seed.jalanDestroyDaun) end
            -- v4.46: ringanOn diubah dari panel -> destroy daun IKUT start/stop
            if k == "ringanOn" then
                if state.ringanOn then
                    if state.destroyDaunOn then pcall(Seed.jalanDestroyDaun) end
                else
                    Seed._destroyDaunGen = (Seed._destroyDaunGen or 0) + 1   -- stop loop
                end
            end
            -- v3.28: ESP pakai gen-loop -> harus dipicu pas dinyalain/dimatiin
            if k == "espInvOn" then pcall(Seed.jalanEspInv) end
            if k == "espGardenOn" then pcall(Seed.jalanEspGarden) end
        end
    end
    for _, k in ipairs(NUM_PANEL) do
        local n = tonumber(c[k])
