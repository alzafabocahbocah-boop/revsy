-- v3.6: SAKLAR LAMA GAK BOLEH NGALAHIN BAWAAN BARU.
--
-- v3.5 matiin semua saklar di BAWAAN, tapi berkas simpanan di HP masih ditulis
-- versi lama (borongSemua=true, seedBaruAuto=true, dst). Dan muat() nimpa
-- SEMUA field dari berkas -- jadi bawaan barunya kalah, dan client tetep beli
-- walau kodenya udah v3.5.
--
-- Persis jebakan yang sama kayak auto_key di worker dan gfRelayUrl di gag2:
-- "ganti bawaan" gak ngefek apa-apa selama ada simpanan lama yang nimpa.
--
-- Perbaikannya: berkas dikasih CAP VERSI. Kalau capnya kurang dari 3.6 (atau
-- gak ada sama sekali = tulisan versi lama), SAKLAR-nya dilewat -- yang dimuat
-- cuma data hasil belajar & isian teks, yang emang sayang kalau ilang.
-- ============================================================
local function muat()
    pcall(function()
        if not (isfile and isfile(FILE_CFG) and readfile) then return end
        local ok, d = pcall(function() return HS:JSONDecode(readfile(FILE_CFG)) end)
        if not ok or type(d) ~= "table" then return end

        local capLama = tonumber(d.cfgVersi) or 0
        local usang = capLama < CFG_VERSI

        local lewat = {}
        if usang then
            for _, k in ipairs(SAKLAR_RESET) do lewat[k] = true end
            -- petPilih ikut dikosongin: v3.5 mulai dari kosong, tapi simpanan
            -- lama isinya Raccoon dan itu bakal kebawa terus.
            lewat.petPilih = true
        end

        local nLewat = 0
        for k, v in pairs(d) do
            if lewat[k] then
                nLewat = nLewat + 1
            elseif state[k] ~= nil and type(v) == type(state[k]) then
                state[k] = v
            end
        end

        if usang then
            print(("[StarSeed] config lama (v%s) -> %d saklar direset ke MATI."):format(
                capLama > 0 and tostring(capLama) or "?", nLewat))
            print("[StarSeed] Nyalain yang dibutuhin dari panel.")
        end
    end)
end
