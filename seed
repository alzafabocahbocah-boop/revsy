-- ============================================================
-- v1.3: PENGALI PASAR ("Stok Harga Buah")
--
-- Sumbernya GUI: PlayerGui.FruitStockPrice -> tiap kartu Name="FruitCard"
-- punya atribut SeedToolTip (nama buah) + child "Multiplier" (TextLabel "Xn").
--
-- MASALAHNYA: kartu itu cuma keisi kalau panelnya PERNAH DIBUKA. Di akun AFK
-- gak ada yang buka -> pengali kebaca 1 terus -> syarat 4x gak pernah kena.
-- Penanganan di sini:
--   1) coba baca apa adanya
--   2) kalau kosong, ScreenGui-nya dipaksa nyala SEBENTAR biar kartunya kebangun,
--      dibaca, terus dibalikin ke keadaan semula
--   3) hasilnya di-cache per SIKLUS RESTOCK (UnixLastRestock) -- pengali cuma
--      ganti tiap restock, jadi gak perlu baca ulang terus
-- Kalau tetep gak kebaca -> pengali dianggap NIL (bukan 1). Bedanya penting:
-- nil = "gak tau" -> buah GAK dijual. Kalau dianggap 1, nanti dikira murah
-- padahal belum tentu.
-- ============================================================
Seed._mktMap   = nil
Seed._mktCycle = nil
Seed._mktAt    = 0
local MKT_FILE = "star_seed_mkt.json"

local function siklusRestock()
    local n = nil
    pcall(function()
        local sv = RS:FindFirstChild("StockValues")
        local v = sv and sv:FindFirstChild("UnixLastRestock")
        if v then n = v.Value end
    end)
    return n
end

-- Cache ke file: pengali cuma ganti tiap restock (~5 menit). Kalau client
-- rejoin di tengah siklus, nilai lama masih sah -- gak usah nunggu kartunya
-- kebangun ulang. Dicap pakai nomor siklus, jadi otomatis basi pas restock baru.
local function simpanCachePasar(cyc, map)
    if type(writefile) ~= "function" then return end
    pcall(function() writefile(MKT_FILE, HS:JSONEncode({ cycle = cyc, map = map })) end)
end

local function muatCachePasar(cyc)
    if type(readfile) ~= "function" or type(isfile) ~= "function" or not isfile(MKT_FILE) then return nil end
    local ok, d = pcall(function() return HS:JSONDecode(readfile(MKT_FILE)) end)
    if ok and type(d) == "table" and type(d.map) == "table" then
        if not cyc or d.cycle == cyc then return d.map end
    end
    return nil
end

-- v1.9: JALUR PACKET buat harga pasar. Bukti lapangan (star_debug) nunjukin
-- ada grup packet "FruitStock" dengan Request & Snapshot -- itu sumber ASLI
-- angka pengali, GUI cuma nampilinnya. Baca dari sini lebih tahan daripada
-- ngintip PlayerGui (yang bergantung kartunya udah kebangun apa belum).
-- Kalau packet-nya gak jawab, tetep jatuh balik ke cara baca GUI.
Seed._snapPasar = nil
do
    local snap = pkt("FruitStock", "Snapshot")
    if snap and snap.OnClientEvent then
        pcall(function()
            snap.OnClientEvent:Connect(function(data)
                if type(data) ~= "table" then return end
                local map = {}
                -- bentuk datanya belum pasti -> tangani dua kemungkinan umum:
                --   { ["Carrot"] = 0.82, ... }   atau   { {Name=..., Multiplier=...}, ... }
                for k, v in pairs(data) do
                    if type(k) == "string" and tonumber(v) then
                        map[k] = tonumber(v)
                    elseif type(v) == "table" then
                        local nm = v.Name or v.Fruit or v.SeedToolTip
                        local m = tonumber(v.Multiplier or v.Mult or v.Value)
                        if nm and m then map[tostring(nm)] = m end
                    end
                end
                if next(map) ~= nil then
                    Seed._snapPasar = map
                    Seed._snapPasarAt = os.time()
                end
            end)
        end)
    end
end

local function mintaSnapshotPasar()
    local req = pkt("FruitStock", "Request")
    if req and req.Fire then pcall(function() req:Fire() end) end
end

local function bacaKartuHarga()
    local map = {}
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local sgui = pg and pg:FindFirstChild("FruitStockPrice")
        if not sgui then return end
        for _, card in ipairs(sgui:GetDescendants()) do
            if card:IsA("GuiObject") and card.Name == "FruitCard" then
                local buah = card:GetAttribute("SeedToolTip")
                local ml = card:FindFirstChild("Multiplier", true)
                if buah and ml and ml:IsA("TextLabel") then
                    local m = tostring(ml.Text):match("[xX]%s*([%d%.]+)")
                    if m then map[buah] = tonumber(m) end
                end
            end
        end
    end)
    return map
end

-- paksa GUI nyala sebentar biar kartunya kebangun, terus balikin
local function bacaPaksa()
    local map = {}
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local sgui = pg and pg:FindFirstChild("FruitStockPrice")
        if not sgui then return end
        local target = sgui:IsA("ScreenGui") and sgui or sgui:FindFirstAncestorOfClass("ScreenGui")
        if not target then return end
        local semula = target.Enabled
        if semula then return end          -- lagi kebuka user -> jangan disenggol
        target.Enabled = true
        task.wait(0.4)                     -- kasih waktu kartunya dibangun
        map = bacaKartuHarga()
        target.Enabled = semula            -- balikin, jangan ninggalin panel kebuka
    end)
    return map
end

function Seed.refreshPasar()
    local cyc = siklusRestock()
    if cyc and Seed._mktCycle and cyc ~= Seed._mktCycle then
        Seed._mktMap = nil                 -- restock baru -> pengali lama basi
    end
    if cyc then Seed._mktCycle = cyc end

    -- 1) jalur packet duluan -- paling andal, gak bergantung GUI
    mintaSnapshotPasar()
    if Seed._snapPasar and next(Seed._snapPasar) ~= nil then
        Seed._mktMap = Seed._snapPasar
        Seed._mktAt = os.time()
        Seed._sumberPasar = "packet"
        simpanCachePasar(cyc, Seed._mktMap)
        return Seed._mktMap
    end

    -- 2) cadangan: baca kartu di GUI
    local fresh = bacaKartuHarga()
    if next(fresh) == nil then fresh = bacaPaksa() end
    if next(fresh) ~= nil then
        Seed._mktMap = fresh
        Seed._mktAt = os.time()
        Seed._sumberPasar = "gui"
        simpanCachePasar(cyc, fresh)       -- simpen biar tahan rejoin
    elseif not Seed._mktMap then
        -- kartu belum kebangun sama sekali -> pakai cache siklus ini kalau ada
        Seed._mktMap = muatCachePasar(cyc)
        Seed._sumberPasar = Seed._mktMap and "cache" or nil
    end
    return Seed._mktMap
end

-- balik ANGKA kalau kebaca, NIL kalau gak tau
function Seed.pengali(jenis)
    if not Seed._mktMap then return nil end
    return Seed._mktMap[jenis]
end

-- pengali paling tinggi yang lagi ada (buat ditampilin di GUI)
function Seed.pengaliTertinggi()
    if not Seed._mktMap then return nil, nil end
    local nm, best = nil, 0
    for k, v in pairs(Seed._mktMap) do
        if v > best then nm, best = k, v end
    end
    if not nm then return nil, nil end
    return best, nm
end

-- refresh pasar tiap 30 detik
task.spawn(function()
    task.wait(6)
    while isCurrentGen() do
        pcall(Seed.refreshPasar)
        task.wait(30)
    end
end)

