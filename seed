    end)
    return n
end

-- v3.18: HILANGIN VISUAL POHON/BUAH + TEMBUS (noclip tanaman)
-- Ringanin RF: sembunyiin visual tanaman+buah (Transparency=1) + matiin
-- collision (CanCollide=false) di Plants -> karakter tembus, gak ketahan.
-- Cuma sentuh folder Plants (lantai/pagar plot aman).
-- ============================================================
Seed._hideVisGen = 0
local function sapuTanaman(sembunyi, tembus)
    local n = 0
    pcall(function()
        local g = workspace:FindFirstChild("Gardens")
        if not g then return end
        local uid = player.UserId
        -- posisi karakter (buat fallback: kebun kita pasti deket)
        local myPos = nil
        pcall(function()
            local ch = player.Character
            local h = ch and ch:FindFirstChild("HumanoidRootPart")
            if h then myPos = h.Position end
        end)
        for _, plot in ipairs(g:GetChildren()) do
            -- v3.24: kebun KITA = OwnerUserId cocok, ATAU (fallback) kebun paling
            -- deket karakter kalau owner gak kebaca. Kebun lain di-destroy ringan.
            local own = plot:GetAttribute("OwnerUserId")
            local ownNm = plot:GetAttribute("Owner")
            local kita = (own == uid or ownNm == player.Name)
            -- fallback: kalau owner GAK kebaca sama sekali, pakai jarak
            if not kita and own == nil and ownNm == nil and myPos then
                local ok2, jarak = pcall(function()
                    local pr = plot:IsA("Model") and plot.PrimaryPart
                    if not pr then
                        for _, d in ipairs(plot:GetDescendants()) do
                            if d:IsA("BasePart") then pr = d; break end
                        end
                    end
                    return pr and (pr.Position - myPos).Magnitude or 9999
                end)
                if ok2 and jarak and jarak < 120 then kita = true end
            end
            if kita then
                local plants = plot:FindFirstChild("Plants")
                if plants then
                    for _, d in ipairs(plants:GetDescendants()) do
                        if d:IsA("BasePart") then
                            -- tembus: matiin collision
                            if tembus and d.CanCollide then d.CanCollide = false end
                            -- sembunyi: transparansi (simpen asli buat balikin)
                            if sembunyi then
                                if d:GetAttribute("StarOrigT") == nil then
                                    d:SetAttribute("StarOrigT", d.Transparency)
                                end
                                d.Transparency = 1
                            end
                            n = n + 1
                        elseif sembunyi and (d:IsA("Decal") or d:IsA("Texture")) then
                            if d:GetAttribute("StarOrigT") == nil then
                                d:SetAttribute("StarOrigT", d.Transparency)
                            end
                            d.Transparency = 1
                        end
                    end
                end
            end
        end
    end)
    return n
end
local function balikinTanaman()
    pcall(function()
        local g = workspace:FindFirstChild("Gardens")
        if not g then return end
        for _, plot in ipairs(g:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, d in ipairs(plants:GetDescendants()) do
                    if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
                        local o = d:GetAttribute("StarOrigT")
                        if type(o) == "number" then
                            d.Transparency = o
                            d:SetAttribute("StarOrigT", nil)
                        end
                        -- collision balik (cuma BasePart)
                        if d:IsA("BasePart") then d.CanCollide = true end
                    end
                end
            end
        end
    end)
end
function Seed.jalanHideVisual()
    Seed._hideVisGen = Seed._hideVisGen + 1
    local myGen = Seed._hideVisGen
    if not state.hideVisualOn then balikinTanaman(); return end
    task.spawn(function()
        while state.hideVisualOn and Seed._hideVisGen == myGen and isCurrentGen() do
            sapuTanaman(true, true)   -- sembunyi + tembus
            task.wait(2)   -- ulang berkala (tanaman baru tumbuh ikut kena)
        end
    end)
end

