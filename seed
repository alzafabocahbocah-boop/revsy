                    if Seed.pakaiCfgPanel then Seed.pakaiCfgPanel(r) end

                    -- ============================================================
                    -- v3.13: PERIKSA JAWABAN /stat. Dulu ditembak lalu dilupain.
                    --
                    -- Kejadian nyata yang bikin ini perlu: backend di-deploy
                    -- pakai kolom baru (tunda/buah/mail/kick), tapi ALTER TABLE-nya
