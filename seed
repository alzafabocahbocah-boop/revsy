-- v3.11: TANGKEP ISI DARI EVENT KLAIM.
--
-- Latar: UI mailbox gak nyebut barangnya (ukur star_mail v1.0), dan packet
-- List gak bisa dipakai -- satu-satunya cara nangkep jawabannya itu
-- Response(handler), dan itu NIMPA handler bawaan game (kekonfirmasi v2.8 pas
-- nyelidiki packet guild; ResponseWrites/Reads jadi kosong sesudah dipanggil).
--
-- Yang AMAN: dengerin event yang game tembak SENDIRI. Connect cuma nambah
-- pendengar, gak nimpa apa pun. Tiga yang relevan:
--   Updated           -> nembak pas ada gift masuk
--   ClaimAllProgress  -> nembak per barang selama ClaimAll jalan
--   ClaimAllFinished  -> nembak pas selesai
--
-- Jadi isinya ketauan SETELAH diklaim, bukan sebelum. Itu lebih terbatas dari
-- yang diharepin, tapi tetep jawab pertanyaan intinya: "tadi dikirimin apa".
-- Dan buat auto-suplai itu cukup -- yang perlu dipastiin cuma farm ngirim
-- barang berharga, bukan sampah.
--
-- Argumen event bentuknya BELUM PASTI, jadi disimpen apa adanya (diratakan
-- jadi teks) dan ditampilin mentah. Begitu bentuknya ketauan dari lapangan,
-- baru diurai lebih rapi -- bukan sebaliknya.
-- ============================================================
Seed.mailMasuk = {}      -- riwayat barang yang keklaim, terbaru di depan

-- v3.11: NAMANYA sengaja gak "ratakan" -- udah ada fungsi lain dengan nama
-- itu di bawah (buat nyeragamkan nama pet). Secara lingkup Lua dua-duanya
-- jalan, tapi dua nama sama dengan tugas beda total itu jebakan buat yang
-- baca nanti.
local function ratakanNilai(v, dalam)
    dalam = dalam or 0
    if dalam > 3 then return "..." end
    if type(v) ~= "table" then return tostring(v):sub(1, 60) end
    local bagian, n = {}, 0
    for k, vv in pairs(v) do
        n = n + 1
        if n > 6 then bagian[#bagian+1] = "..." break end
        bagian[#bagian+1] = tostring(k) .. "=" .. ratakanNilai(vv, dalam + 1)
    end
    return "{" .. table.concat(bagian, " ") .. "}"
end

local function catatMail(sumber, ...)
    local arg = { ... }
    if #arg == 0 then return end
    local bagian = {}
    for _, v in ipairs(arg) do bagian[#bagian+1] = ratakanNilai(v) end
    table.insert(Seed.mailMasuk, 1, {
        ts = os.time(), sumber = sumber, isi = table.concat(bagian, " | "),
    })
    -- simpen 20 terakhir aja -- ini buat lihat pola, bukan pembukuan
    while #Seed.mailMasuk > 20 do table.remove(Seed.mailMasuk) end
    print(("[StarSeed] mail[%s]: %s"):format(sumber, Seed.mailMasuk[1].isi))
end

