-- ============================================================
-- v3.18: POPUP PICKER reusable -- daftar item + centang + tombol "All"
--   judul     : teks judul popup
--   ambilList : fungsi -> array nama item
--   pilihTbl  : state tabel { [nama]=true }
--   getSemua  : fungsi -> bool (mode "semua" lagi nyala?)
--   setSemua  : fungsi(bool) -- set mode semua
--   onTutup   : fungsi (opsional) dipanggil pas tutup (buat update label)
-- ============================================================
local function bukaPicker(judul, ambilList, pilihTbl, getSemua, setSemua, onTutup, getKanan)
    -- overlay gelap
    local ov = mk("Frame", { Parent = sg, Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.4,
        BorderSizePixel = 0, ZIndex = 50, Active = true })
    local pop = mk("Frame", { Parent = ov, Size = UDim2.new(0, 300, 0, 340),
        Position = UDim2.new(0.5, -150, 0.5, -170), BackgroundColor3 = WARNA.kartu,
        BorderSizePixel = 0, ZIndex = 51, Active = true, Draggable = true })
    mk("UICorner", { CornerRadius = UDim.new(0, 10), Parent = pop })
    mk("UIStroke", { Color = WARNA.aksen, Thickness = 1, Parent = pop })
    mk("TextLabel", { Parent = pop, BackgroundTransparency = 1, ZIndex = 52,
        Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -90, 0, 22),
        Font = Enum.Font.GothamBold, TextSize = 21, TextColor3 = WARNA.teks,
        TextXAlignment = Enum.TextXAlignment.Left, Text = judul })
    -- tombol All (centang/lepas semua)
    local tblAll = mk("TextButton", { Parent = pop, ZIndex = 52,
        Position = UDim2.new(1, -128, 0, 8), Size = UDim2.new(0, 58, 0, 26),
        BackgroundColor3 = WARNA.aksenBg, BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 19, TextColor3 = WARNA.aksenMuda, Text = "All" })
    mk("UICorner", { CornerRadius = UDim.new(0, 6), Parent = tblAll })
    mk("UIStroke", { Color = WARNA.aksen, Thickness = 1, Parent = tblAll })
    -- tombol tutup
    local tblX = mk("TextButton", { Parent = pop, ZIndex = 52,
        Position = UDim2.new(1, -62, 0, 8), Size = UDim2.new(0, 52, 0, 26),
        BackgroundColor3 = WARNA.garis, BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 19, TextColor3 = WARNA.teks, Text = "OK" })
    mk("UICorner", { CornerRadius = UDim.new(0, 6), Parent = tblX })
    -- scroll daftar
    local sc = mk("ScrollingFrame", { Parent = pop, ZIndex = 52,
        Position = UDim2.new(0, 10, 0, 42), Size = UDim2.new(1, -20, 1, -52),
        BackgroundColor3 = WARNA.bg, BorderSizePixel = 0, ScrollBarThickness = 4,
        ScrollBarImageColor3 = WARNA.garis, CanvasSize = UDim2.new(0, 0, 0, 0) })
    mk("UICorner", { CornerRadius = UDim.new(0, 7), Parent = sc })
    local ly = mk("UIListLayout", { Parent = sc, Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder })
    mk("UIPadding", { Parent = sc, PaddingTop = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) })

    local baris = {}
    local function warnaBaris(nm)
        -- kalau mode semua nyala -> semua keliatan aktif
        local aktif = getSemua() or pilihTbl[nm] == true
        return aktif and WARNA.aksen or WARNA.redup
    end
    local function refreshSemua()
        tblAll.BackgroundColor3 = getSemua() and WARNA.aksen or WARNA.aksenBg
        tblAll.TextColor3 = getSemua() and WARNA.bg or WARNA.aksenMuda
    end
    local function gambar()
        for _, b in pairs(baris) do b:Destroy() end
        baris = {}
        local list = ambilList() or {}
        for i, nm in ipairs(list) do
            local b = mk("TextButton", { Parent = sc, LayoutOrder = i, ZIndex = 52,
                Size = UDim2.new(1, -4, 0, 26), BackgroundColor3 = WARNA.kartu,
                BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextSize = 19,
                TextColor3 = warnaBaris(nm), TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  " .. nm })
            mk("UICorner", { CornerRadius = UDim.new(0, 5), Parent = b })
            -- teks kanan (jumlah/rarity) kalau ada
            if getKanan then
                local kn = getKanan(nm)
                if kn and kn ~= "" then
                    mk("TextLabel", { Parent = b, BackgroundTransparency = 1, ZIndex = 53,
                        Position = UDim2.new(1, -82, 0, 0), Size = UDim2.new(0, 76, 1, 0),
                        Font = Enum.Font.GothamMedium, TextSize = 19, TextColor3 = WARNA.samar,
                        TextXAlignment = Enum.TextXAlignment.Right, Text = kn .. "  " })
                end
            end
            b.MouseButton1Click:Connect(function()
                -- ketuk item -> matiin mode "semua", toggle item ini
                if getSemua() then
                    setSemua(false)
                    refreshSemua()
                    for _, bb in pairs(baris) do end   -- warna di-refresh di bawah
                end
                pilihTbl[nm] = (not pilihTbl[nm]) or nil
                b.TextColor3 = warnaBaris(nm)
                simpan()
            end)
            baris[nm] = b
        end
        sc.CanvasSize = UDim2.new(0, 0, 0, ly.AbsoluteContentSize.Y + 8)
    end
    tblAll.MouseButton1Click:Connect(function()
        setSemua(not getSemua())
        refreshSemua()
        for nm, b in pairs(baris) do b.TextColor3 = warnaBaris(nm) end
        simpan()
    end)
    tblX.MouseButton1Click:Connect(function()
        ov:Destroy()
        if onTutup then pcall(onTutup) end
    end)
    refreshSemua()
    gambar()
end

