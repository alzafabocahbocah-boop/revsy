-- v1.2: PEMINDAI SEED BARU
-- Daftar seed di-refresh berkala. Nama yang belum pernah keliat = SEED BARU
-- -> langsung dicentang biar kebeli, tanpa nunggu diurus manual.
--
-- Kenapa perlu: di mode "Pilih jenis", seed yang baru rilis gak akan pernah
-- kecentang -> kelewat total. Mode "Borong semua" aman, tapi daftarnya sendiri
-- tetep harus di-refresh biar seed baru masuk hitungan.
--
-- Pertama kali jalan (seedDikenal masih kosong) SEMUA seed dianggap "udah
-- dikenal" -- kalau nggak, semua langsung kecentang dan itu bukan maunya user.
-- ============================================================
Seed.seedBaru = {}     -- nama seed baru yang kedeteksi sesi ini (buat ditampilin)

local function pindaiSeedBaru(pertamaKali)
    local baru = {}
    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    for _, nm in ipairs(Seed.daftar) do
        if not state.seedDikenal[nm] then
            state.seedDikenal[nm] = true
            if not pertamaKali then baru[#baru+1] = nm end
        end
    end
    if #baru > 0 then
        for _, nm in ipairs(baru) do
            Seed.seedBaru[#Seed.seedBaru + 1] = nm
            if state.seedBaruAuto then state.seedPilih[nm] = true end
        end
        print(("[StarSeed] SEED BARU (%d): %s%s"):format(
            #baru, table.concat(baru, ", "),
            state.seedBaruAuto and " -> langsung dibeli" or " (auto-beli MATI, centang manual)"))
    end
    if #baru > 0 or pertamaKali then simpan() end
    return baru
end

