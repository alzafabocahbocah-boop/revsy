-- v1.9 FIX: deteksi seed di tas TIDAK BOLEH ngandelin Seed.rarity().
-- Bukti lapangan (star_debug): SharedModules.SeedData isinya FUNGSI doang,
-- bukan data -- jadi rarity SELALU nil dan semua seed di tas kebaca 0.
-- Sekarang patokannya daftar seed gabungan (sumber utamanya stok SeedShop,
-- 64 jenis). Gear/pet gak ada di daftar itu, jadi otomatis keskip.
local function namaSeedValid(nm)
    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    if not Seed._setSeed then
        Seed._setSeed = {}
        for _, n in ipairs(Seed.daftar) do Seed._setSeed[n] = true end
    end
    return Seed._setSeed[nm] == true
end

-- v3.18: cek apakah Tool ini SEED (biar SELALU kedetect, walau SeedData gagal
-- load / map baru beda). Urutan cek:
--   1. atribut seed-ish (SeedName / Seed / SeedTool / SeedType) -> pasti seed
--   2. nama Tool cocok di SeedData (namaSeedValid)
--   3. nama diakhiri "Seed" (contoh "Carrot Seed")
-- BUKAN seed (di-skip): Tool gear (Trowel/Sprinkler/Shovel/Watering/Wrench).
local function toolItuSeed(tool)
    if not (tool and tool:IsA("Tool")) then return false end
    local nm = tool.Name
    -- v3.18b (map baru fall world): seed asli punya MainCategory="Seed" atau
    -- atribut SeedTool. BUAH punya SizeMultiplier (contoh "Maple Carrot [Gold]
    -- [0.80kg]") -> BUKAN seed, skip. Gear (Shovel/Build) gak punya SeedTool.
    if tool:GetAttribute("SizeMultiplier") then return false end   -- itu BUAH
    local cat = tool:GetAttribute("MainCategory")
    if cat and tostring(cat):lower():find("seed") then return true end
    if tool:GetAttribute("SeedTool") then return true end
    -- skip gear jelas
    local low = nm:lower()
    if low:find("trowel") or low:find("sprinkler") or low:find("shovel")
       or low:find("build") or low:find("watering") or low:find("wrench")
       or low:find("can") or low:find("gear") then
        return false
    end
    -- fallback lama: atribut seed-ish / SeedData / akhiran "Seed"
    if tool:GetAttribute("SeedName") or tool:GetAttribute("Seed")
       or tool:GetAttribute("SeedType") then
        return true
    end
    if namaSeedValid(nm) then return true end
    if nm:match("[Ss]eed%s*$") then return true end
    return false
end

local function seedDiTas()
    local hitung, total = {}, 0
    Seed._seedDbg = {}   -- v4.28: debug SEMUA tool (nama + seed? + atribut)
    pcall(function()
        for _, holder in ipairs(tasHolders()) do
            for _, tool in ipairs(holder:GetChildren()) do
                if tool:IsA("Tool") then
                    -- catat tiap tool: nama, kedeteksi seed?, atribut kunci
                    local isSeed = toolItuSeed(tool)
                    local low = tool.Name:lower()
                    -- cuma catat yang MIRIP fall (Maple/Conifer/dll) atau gak kedeteksi
                    if low:find("maple") or low:find("conifer") or low:find("cranberry")
                       or low:find("honeysuckle") or low:find("amber") then
                        local sz = tool:GetAttribute("SizeMultiplier")
                        local cat = tool:GetAttribute("MainCategory")
                        Seed._seedDbg[#Seed._seedDbg+1] = tool.Name
                            .. " [seed=" .. tostring(isSeed)
                            .. " sz=" .. tostring(sz ~= nil)
                            .. " cat=" .. tostring(cat or "-") .. "]"
                    end
                end
                if toolItuSeed(tool) then
                    -- nama seed: pakai atribut SeedName kalau ada, else nama Tool
                    -- (map baru: nama Tool langsung "Carrot", tanpa " Seed")
                    local nm = tool:GetAttribute("SeedName") or tool.Name
                    nm = tostring(nm):gsub("%s*[Ss]eed%s*$", "")   -- buang " Seed" kalau ada
                    if nm == "" then nm = tool.Name end
                    local n = tool:GetAttribute("Count") or 1
                    if n == 0 then n = 1 end   -- pet/seed kadang Count=0, artinya 1
                    hitung[nm] = (hitung[nm] or 0) + n
                    total = total + n
                end
            end
        end
    end)
    local arr = {}
    for nm, n in pairs(hitung) do
        local rar = Seed.rarity(nm) or "?"
        arr[#arr+1] = { n = nm, j = n, r = rar, rank = RARITY_RANK[rar] or 0 }
    end
    table.sort(arr, function(a, b)
        -- v3.48: urut by JUMLAH terbanyak dulu (paling atas), baru rarity/nama
        if a.j ~= b.j then return a.j > b.j end
        if a.rank ~= b.rank then return a.rank > b.rank end
        return a.n < b.n
    end)
    return arr, total
end

-- v3.18: list NAMA seed di tas (buat picker Auto Plant -- cuma seed sendiri)
local function namaSeedDiTas()
    local arr = seedDiTas()
    local out = {}
    for _, e in ipairs(arr) do out[#out+1] = e.n end
    return out
end

-- v4.11: hitung gear di tas -- PISAH biasa vs syrup. Balikin 4 angka:
