-- v4.34: BLOCK REJOIN -- DIKERASIN (5 lapis). Debug nunjukin: rejoin di PS JUGA
-- (bukan server shutdown public), TeleportService per-method GAK ke-hook pas
-- rejoin kejadian -> berarti rejoin lewat jalur LAIN. Kemungkinan: __namecall
-- Teleport, RemoteEvent FireServer (game suruh server mindahin), Kick, atau
-- DisconnectFromServer. Sekarang block SEMUA jalur + logger catat tiap percobaan.
--   L1: hookfunction TeleportService method
--   L2: __namecall (nangkep :Teleport, :Kick, :FireServer ke remote teleport)
--   L3: LocalPlayer:Kick
--   L4: TeleportService:SetTeleportGui / DisconnectFromServer (via namecall)
--   L5: __namecall FireServer ke RemoteEvent yg namanya bau teleport/rejoin
-- KUNCI: izinin teleport SCRIPT KITA (flag Seed._teleSendiri).
Seed._teleSendiri = false
Seed._rejoinLog = {}   -- riwayat percobaan rejoin (buat debug)
do
    local ok = pcall(function()
        if getgenv().ZenxTeleHooked then return end
        local TS = game:GetService("TeleportService")
        local function bolehTele()
            if not (state and state.blockRejoin) then return true end
            return Seed._teleSendiri == true
        end
        local function catatBlok(sumber)
            Seed._logBlockTele = "BLOCK " .. sumber .. " (" .. os.date("%H:%M:%S") .. ")"
            table.insert(Seed._rejoinLog, 1, Seed._logBlockTele)
            while #Seed._rejoinLog > 8 do table.remove(Seed._rejoinLog) end
            warn("[StarSeed] " .. Seed._logBlockTele)
        end
        -- method teleport/rejoin yang di-block
        local namaBlok = {
            Teleport = true, TeleportToPlaceInstance = true,
            TeleportToPrivateServer = true, TeleportPartyAsync = true,
            TeleportToSpawnByName = true, TeleportToPrivateServerAsync = true,
        }
        -- kata kunci remote yg kalau di-FireServer = minta server rejoin/teleport
        local remoteBau = { "teleport", "rejoin", "kick", "hop", "serverhop", "reconnect", "leave", "boot" }

        -- LAPIS 1: hookfunction TeleportService method
        for m in pairs(namaBlok) do
            local asli = TS[m]
            if type(asli) == "function" and hookfunction then
                local baru
                baru = hookfunction(asli, function(...)
                    if bolehTele() then return asli(...) end
                    catatBlok("L1 " .. m)
                    return nil
                end)
            end
        end

        -- LAPIS 2+3+4+5: __namecall -- nangkep SEMUA :Method() call
        if hookmetamethod and getnamecallmethod then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                if not bolehTele() then
                    local metode = getnamecallmethod()
                    if metode then
                        -- L2/L4: teleport/disconnect method
                        if namaBlok[metode] or metode == "DisconnectFromServer" then
                            catatBlok("L2 namecall " .. metode)
                            return nil
                        end
                        -- L3: Kick
                        if metode == "Kick" then
                            catatBlok("L3 namecall Kick")
                            return nil
                        end
                        -- L5: FireServer ke RemoteEvent yg namanya bau teleport/rejoin
                        if metode == "FireServer" or metode == "InvokeServer" then
                            local ok2, nm = pcall(function() return self.Name:lower() end)
                            if ok2 and nm then
                                for _, k in ipairs(remoteBau) do
                                    if nm:find(k) then
                                        catatBlok("L5 " .. metode .. " -> " .. self.Name)
                                        return nil
                                    end
                                end
                            end
                        end
                    end
                end
                return oldNamecall(self, ...)
            end)
        end

        -- LAPIS 3 (backup, kalau namecall gak dukung): hookfunction Kick langsung
        pcall(function()
            local lpp = game:GetService("Players").LocalPlayer
            if lpp and hookfunction then
                local kickAsli
                kickAsli = hookfunction(lpp.Kick, function(...)
                    if bolehTele() then return kickAsli(...) end
                    catatBlok("L3 Kick(fn)")
                    return nil
                end)
            end
        end)

        getgenv().ZenxTeleHooked = true
        warn("[StarSeed] Hook block rejoin PASANG (5 lapis: method+namecall+kick+disconnect+FireServer)")
    end)
    if not ok then warn("[StarSeed] Hook block rejoin gagal (executor gak dukung hook?)") end
end

