        if win and Seed.nilaiTas then
            local val, n = Seed.nilaiTas()
            lab.Text = string.format("$ %s  .  %d buah", Seed._singkatHarga(val), n)
            local ax, ay, aw = win.AbsolutePosition.X, win.AbsolutePosition.Y, win.AbsoluteSize.X
            box.Position = UDim2.fromOffset(ax + aw - box.AbsoluteSize.X, ay - box.AbsoluteSize.Y - 6)
            box.Visible = true
        else
            box.Visible = false
        end
        task.wait(1)
    end
end)

