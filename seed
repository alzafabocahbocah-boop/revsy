                            elseif bestKg >= 100 then r100 = r100 + 1
                            elseif bestKg >= 80 then r80 = r80 + 1
                            elseif bestKg >= 50 then r50 = r50 + 1 end
                        end
                    end
                end
            end
        end
    end)
    return total, berbuah, gGoal, r50, r80, r100, r120, r150, nilai
end

