                :format(Seed.statTerbeli, Seed.statSiklus, Seed._logAkhir ~= "" and Seed._logAkhir or "-")
            lblGear.Text  = ("Gear kebeli: %d  ·  %s")
                :format(Seed.statGear, Seed._logGear ~= "" and Seed._logGear or "nunggu restock")

            -- status pasar + gift/jual
            local best, nmBest = Seed.pengaliTertinggi()
            local bagian = {}
            if best then
                bagian[#bagian+1] = ("pasar tertinggi %.2fx (%s)"):format(best, nmBest or "?")
            else
                bagian[#bagian+1] = "pasar belum kebaca -- buka panel Stok Harga Buah sekali"
            end
            bagian[#bagian+1] = ("gift %d"):format(Seed.statGift)
            if state.jualOn then
                bagian[#bagian+1] = ("jual %d · %s"):format(Seed.statJual,
                    Seed._logJual ~= "" and Seed._logJual or "-")
            end
            lblPasar.Text = table.concat(bagian, "  ·  ")

            -- v3.1: tampilin filter pet yang BENERAN kepakai + dari mana
            -- asalnya. Kalau setelan panel gagal nyampe, ini yang bakal
            -- ngasih tau -- dulu gagalnya diem doang.
            local asal = (Seed._cfgLog or ""):find("^GAGAL") and " [PANEL GAGAL]"
                or ((Seed._cfgTs or 0) > 0 and " [dari panel]" or " [lokal]")
            lblFilter.Text = "filter: " .. Seed.ringkasFilterPet() .. asal
            lblFilter.TextColor3 = (asal == " [PANEL GAGAL]") and WARNA.aksen or WARNA.samar

            if state.ringanOn then
                lblRingan.Text = ("dibuang: %d suara, %d objek kebun")
                    :format(Seed.statRingan.suara, Seed.statRingan.kebun)
                lblRingan.TextColor3 = WARNA.aksen
            else
                lblRingan.Text = "mati -- suara & kebun dibiarin"
                lblRingan.TextColor3 = WARNA.samar
            end
            lblPasar.TextColor3 = (best and best >= (tonumber(state.jualMinMult) or 4))
                and WARNA.aksen or WARNA.samar
            if state.beliOn then
                lblStatus.Text = "jalan -- seed tiap " .. (state.jedaSiklus or 3) .. "s, gear pas restock"
                lblStatus.TextColor3 = WARNA.aksen
            else
                lblStatus.Text = "mati"
                lblStatus.TextColor3 = WARNA.samar
            end
        end)
        task.wait(2)
    end
end)

-- ============================================================
-- v1.4: HUD PENGALI di POJOK KANAN BAWAH
-- Mandiri dari GUI utama (GUI bisa di-minimize, HUD tetep keliatan). Gunanya
-- BUKAN hiasan: ini bukti mata kalau pembacaan pasar beneran jalan. Kalau HUD
-- nunjukin angka yang cocok sama panel "Stok Harga Buah" di game, berarti
-- syarat jual juga baca angka yang bener.
-- Ijo = udah lewat ambang jual. Abu = belum. Merah = gak kebaca sama sekali.
-- ============================================================
do
    local host = (gethui and gethui()) or CoreGui
    pcall(function()
        local old = host:FindFirstChild("StarSeedHUD")
        if old then old:Destroy() end
    end)
    local hg = Instance.new("ScreenGui")
    hg.Name = "StarSeedHUD"; hg.ResetOnSpawn = false
    hg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    hg.IgnoreGuiInset = true
    hg.Parent = host

    local box = Instance.new("Frame")
    box.AnchorPoint = Vector2.new(1, 1)
    box.Position = UDim2.new(1, -12, 1, -12)
    box.Size = UDim2.new(0, 236, 0, 34)
    box.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    box.BackgroundTransparency = 0.1
    box.BorderSizePixel = 0
    box.Parent = hg
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = box
    local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(38, 38, 38); st.Thickness = 1; st.Parent = box

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 1, 0); lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.RichText = true
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Text = "pasar ..."
    lbl.Parent = box

    task.spawn(function()
        while hg.Parent and isCurrentGen() do
            pcall(function()
                local ambang = tonumber(state.jualMinMult) or 4
                local best, nama = Seed.pengaliTertinggi()
                if not best then
                    lbl.Text = '<font color="#E65B5B">pasar gak kebaca</font>'
                else
                    local warna = (best >= ambang) and "#5BE36A" or "#9AA0AA"
                    local tanda = (best >= ambang) and "  JUAL" or ""
                    lbl.Text = string.format(
                        '%s <font color="%s">x%.2f%s</font>',
                        tostring(nama):sub(1, 18), warna, best, tanda)
                end
            end)
            task.wait(5)
        end
        pcall(function() hg:Destroy() end)
    end)
end

