-- paksa GUI nyala sebentar biar kartunya kebangun, terus balikin
local function bacaPaksa()
    local map = {}
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local sgui = pg and pg:FindFirstChild("FruitStockPrice")
        if not sgui then return end
        local target = sgui:IsA("ScreenGui") and sgui or sgui:FindFirstAncestorOfClass("ScreenGui")
        if not target then return end
        local semula = target.Enabled
        if semula then return end          -- lagi kebuka user -> jangan disenggol
        target.Enabled = true
        task.wait(0.4)                     -- kasih waktu kartunya dibangun
        map = bacaKartuHarga()
        target.Enabled = semula            -- balikin, jangan ninggalin panel kebuka
    end)
    return map
end

function Seed.refreshPasar()
    local cyc = siklusRestock()
    if cyc and Seed._mktCycle and cyc ~= Seed._mktCycle then
        Seed._mktMap = nil                 -- restock baru -> pengali lama basi
    end
    if cyc then Seed._mktCycle = cyc end

    -- 1) jalur packet duluan -- paling andal, gak bergantung GUI
    mintaSnapshotPasar()
    if Seed._snapPasar and next(Seed._snapPasar) ~= nil then
        Seed._mktMap = Seed._snapPasar
        Seed._mktAt = os.time()
        Seed._sumberPasar = "packet"
        simpanCachePasar(cyc, Seed._mktMap)
        return Seed._mktMap
    end

    -- 2) cadangan: baca kartu di GUI
    local fresh = bacaKartuHarga()
    if next(fresh) == nil then fresh = bacaPaksa() end
    if next(fresh) ~= nil then
        Seed._mktMap = fresh
        Seed._mktAt = os.time()
        Seed._sumberPasar = "gui"
        simpanCachePasar(cyc, fresh)       -- simpen biar tahan rejoin
    elseif not Seed._mktMap then
        -- kartu belum kebangun sama sekali -> pakai cache siklus ini kalau ada
        Seed._mktMap = muatCachePasar(cyc)
        Seed._sumberPasar = Seed._mktMap and "cache" or nil
    end
    return Seed._mktMap
end

-- balik ANGKA kalau kebaca, NIL kalau gak tau
function Seed.pengali(jenis)
    if not Seed._mktMap then return nil end
    return Seed._mktMap[jenis]
end

-- pengali paling tinggi yang lagi ada (buat ditampilin di GUI)
function Seed.pengaliTertinggi()
    if not Seed._mktMap then return nil, nil end
    local nm, best = nil, 0
    for k, v in pairs(Seed._mktMap) do
        if v > best then nm, best = k, v end
    end
    if not nm then return nil, nil end
    return best, nm
end

