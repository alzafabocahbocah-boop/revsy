-- v3.16: JANGAN hapus kebun SENDIRI. Tiap plot di Gardens biasanya punya penanda
-- pemilik (attribute Owner/OwnerUserId/OwnerName, atau nama plot = userId). Kita
-- SKIP plot milik pemain ini. Cuma hapus isi plot ORANG LAIN (yang bikin RAM
-- berat tapi gak kita butuhin). Kalau owner gak kebaca, plot itu DILEWATI (aman:
-- lebih baik gak ngapus daripada ngapus kebun sendiri).
local function plotMilikKita(plot)
    local uid = player.UserId
    local nm = player.Name
    local okA = false
    pcall(function()
        for _, key in ipairs({"OwnerUserId", "Owner", "OwnerId", "UserId", "OwnerName"}) do
            local v = plot:GetAttribute(key)
            if v ~= nil then
                if (type(v) == "number" and v == uid)
                   or (type(v) == "string" and (v == nm or v == tostring(uid))) then
                    okA = true; return
                end
            end
        end
    end)
    if okA then return true end
    local pn = tostring(plot.Name)
    if pn:find(tostring(uid), 1, true) or pn:find(nm, 1, true) then return true end
    local okV = false
    pcall(function()
        local ownVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("OwnerName")
                       or plot:FindFirstChild("OwnerUserId")
        if ownVal and ownVal:IsA("ValueBase") then
            local v = ownVal.Value
            if v == uid or v == nm or tostring(v) == tostring(uid) then okV = true end
        end
    end)
    if okV then return true end
    return false
end

