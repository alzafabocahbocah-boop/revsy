Seed._el.pickShovel.MouseButton1Click:Connect(function()
    -- jenis seed dari tanaman di kebun. PISAHIN: bermutasi (Gold/Rainbow/Mega/dll)
    -- vs biasa. mutasi dibaca dari atribut Mutation/Variant tanaman. nama tampil:
    -- "[MUT] <jenis>" buat yg bermutasi, "<jenis>" buat biasa. jumlah per grup.
    Seed._shovelJml = {}
    bukaPicker("Jenis seed shovel",
        function()
            local hitung = {}
            local MUT_KEYS = { "Mutation", "Mutations", "Variant", "Variants" }
            pcall(function()
                local g = workspace:FindFirstChild("Gardens")
                local uid = player.UserId
                if g then
                    for _, plot in ipairs(g:GetChildren()) do
                        local own = plot:GetAttribute("OwnerUserId")
                        local ownNm = plot:GetAttribute("Owner")
                        if own == uid or ownNm == player.Name then
                            local pls = plot:FindFirstChild("Plants")
                            if pls then
                                for _, pl in ipairs(pls:GetChildren()) do
                                    local sn = pl:GetAttribute("SeedName")
                                    if sn then
                                        -- deteksi mutasi tanaman
                                        local mut = nil
                                        for _, k in ipairs(MUT_KEYS) do
                                            local v = pl:GetAttribute(k)
                                            if type(v) == "string" and v ~= ""
                                               and v:lower() ~= "none" and v:lower() ~= "normal" then
                                                mut = v; break
                                            end
                                        end
                                        -- nama seed juga bisa nunjukin mutasi (Gold/Rainbow/Mega)
                                        local low = tostring(sn):lower()
                                        if not mut and (low:find("gold") or low:find("rainbow")
                                           or low:find("mega")) then mut = "Mutasi" end
                                        local key = mut and ("[MUT] " .. sn) or sn
                                        hitung[key] = (hitung[key] or 0) + 1
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            Seed._shovelJml = hitung
            -- urut: bermutasi ([MUT]) dulu, terus by jumlah terbanyak
            local arr = {}
            for nm in pairs(hitung) do arr[#arr+1] = nm end
            table.sort(arr, function(a, b)
                local am = a:find("^%[MUT%]") ~= nil
                local bm = b:find("^%[MUT%]") ~= nil
                if am ~= bm then return am end          -- bermutasi di atas
                if hitung[a] ~= hitung[b] then return hitung[a] > hitung[b] end
                return a < b
            end)
            return arr
        end,
        state.shovelPilih,
        function() return state.shovelSemua end,
        function(v) state.shovelSemua = v end,
        function() lblPickSeed(Seed._el.pickShovel, state.shovelSemua, state.shovelPilih) end,
        function(nm) return (Seed._shovelJml[nm] and tostring(Seed._shovelJml[nm])) or "" end)
end)
