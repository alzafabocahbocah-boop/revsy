                local cw = cntLbl and tonumber(tostring(cntLbl.Text):match("([%d%.]+)"))
                local harga, decay = nil, 0
                if nm and byNama[nm] then
                    if cw then
                        local best, bestD
                        for _, e in ipairs(byNama[nm]) do
                            local d = math.abs(e.w - cw)
                            if not bestD or d < bestD then bestD = d; best = e end
                        end
                        if best and bestD and bestD < 0.5 then harga = best.p; decay = best.dec end
                    end
                    if not harga then harga = byNama[nm][1] and byNama[nm][1].p; decay = byNama[nm][1] and byNama[nm][1].dec or 0 end
                end
                local lbl = cell:FindFirstChild("StarEspPrice")
                if harga then
                    if not lbl then
