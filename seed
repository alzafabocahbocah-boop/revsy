-- AUTO GRAB SEED (Gold Moon: gold seed + random seed jatuh) -- v3.15
-- Item jatuh di workspace.DroppedItems.DroppedItem_*.PromptAnchor.PickupPrompt
-- (ActionText "Pick Up"). Ambil SEMUA seed jatuh: TP karakter ke tiap seed
-- (biar prompt ke-fire walau jauh) -> fireproximityprompt -> kepungut.
-- Ketemu dari scan ProximityPrompt map baru. fireproximityprompt kebukti ada.
-- ============================================================
-- v3.84: DETEKSI KEAMBIL PAKAI LOKASI (ide user). Kita TAU posisi seed
-- (o.Position). Kunci posisi -> gerak kesitu -> fire. Cek keambil = di
-- posisi itu masih ada seed gak (scan folder, radius <3 stud). HILANG dari
-- posisi = keambil -> pindah. Lebih robust dari cek o.Parent (part bisa
-- pindah/reset, tapi "posisi kosong" = pasti keambil).
local function seedDiPosisi(folder, pos, radius)
    -- true kalau MASIH ada seed di sekitar pos (belum keambil)
    for _, o in ipairs(folder:GetDescendants()) do
        if o:IsA("BasePart") then
            local isSeed = o:GetAttribute("GoldSeed") or o:GetAttribute("RainbowSeed")
                or o:GetAttribute("MegaSeed")
            if isSeed and (o.Position - pos).Magnitude < (radius or 3) then
                return true
            end
        end
    end
    return false
end

function Seed.grabSeed()
    -- FAKTA user: fire prompt BISA kalau karakter DEKET via GERAK (bukan TP).
    -- Deteksi keambil PAKAI LOKASI: kunci posisi seed, kalau posisi itu kosong
    -- = keambil -> pindah. + PASS 0 ClickPack (dari decompile) buat bantu jauh.
    local map = workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("SeedPackSpawnServerLocations")
    if not folder then return 0, nil end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return 0, "karakter belum siap" end

    -- kumpulin posisi seed (KUNCI lokasi -- simpan Vector3, bukan cuma part ref)
    local titik = {}
    for _, o in ipairs(folder:GetDescendants()) do
        if o:IsA("BasePart") then
            local isSeed = o:GetAttribute("GoldSeed") or o:GetAttribute("RainbowSeed")
                or o:GetAttribute("MegaSeed")
            if isSeed and o.Position.Magnitude > 1 then
                titik[#titik+1] = o.Position   -- KUNCI posisi
            end
        end
    end
    if #titik == 0 then return 0, nil end

    -- v3.86: ClickPack DIBUANG. M1 (fireproximityprompt) yang KEBUKTI works
    -- (fakta user: deket via gerak + fire prompt = keambil). ClickPack (remote
    -- Fire("1") dari decompile) belum kebukti di kasus ini -- fokus prompt aja.
    -- Murni: kunci 1 lokasi -> gerak -> fire prompt -> pastiin kosong -> pindah.

    local diambil = 0
    for _, pos in ipairs(titik) do
        if not state.ambilSeedOn then break end
        -- cek lokasi ini masih ada seed gak (mungkin udah keambil orang lain)
        if seedDiPosisi(folder, pos, 5) then
            -- v3.95: SETTING user (tes debug): STEP 55, durasi lerp 0.3s, jeda
            -- antar segmen 5s. Kombinasi ini yg GAK ke-SNAP (anti-teleport server).
            local tujuan = Vector3.new(pos.X, pos.Y + 3, pos.Z)
            local STEP = 55   -- jarak per segmen (tes: 55 aman)
            for _langkah = 1, 20 do   -- maks 20 segmen
                if not seedDiPosisi(folder, pos, 5) then break end  -- keburu diambil
                local kini = root.Position
                local keTujuan = tujuan - kini
                local sisa = keTujuan.Magnitude
                if sisa <= 8 then break end   -- udah deket, stop
                -- target segmen: max STEP ke arah tujuan
                local langkah = math.min(STEP, sisa)
                local targetSeg = kini + keTujuan.Unit * langkah
                -- GERAK HALUS (lerp) ke target segmen, durasi 0.3s
                local awalSeg = root.Position
                local durasi = 0.3
                local t = 0
                while t < durasi do
                    if not seedDiPosisi(folder, pos, 5) then break end
                    local dt = task.wait()
                    t = t + dt
                    local a = math.min(t / durasi, 1)
                    pcall(function() root.CFrame = CFrame.new(awalSeg:Lerp(targetSeg, a)) end)
                end
                pcall(function() root.CFrame = CFrame.new(targetSeg) end)
                -- JEDA 5s antar segmen (server register posisi -- kunci gak snap)
                if sisa - langkah > 8 then task.wait(5) end   -- jeda kalau masih ada segmen lagi
            end
            -- pastiin sampai persis di titik (biar prompt kebaca)
            pcall(function() root.CFrame = CFrame.new(tujuan) end)
            -- v3.90: VERIFIKASI karakter BENERAN deket + server update posisi
            -- SEBELUM fire. Insight user: mungkin fire SEBELUM sampai (masih gerak)
            -- -> prompt gagal (butuh deket). Tunggu sampai jarak < 6 (server ngakuin
            -- posisi), maks 1 detik. Kayak tame pet (v3.23: bener2 deket sebelum fire).
            local sampai = false
            for _ = 1, 12 do
                task.wait(0.08)
                local ok, jarak = pcall(function()
                    return (root.Position - Vector3.new(pos.X, pos.Y + 3, pos.Z)).Magnitude
                end)
                if ok and jarak and jarak < 6 then sampai = true break end
                -- pin lagi kalau kegeser (kecemplung/kedorong)
                pcall(function() root.CFrame = CFrame.new(tujuan) end)
            end
            task.wait(0.2)   -- settle ekstra (server replikasi posisi)
            -- ambil: fire prompt + CEK tiap 0.15s. Begitu LOKASI KOSONG -> pindah.
            -- maks ~2.5 detik (16x) per pack. TETEP DI SINI sampai keambil/kosong
            -- (JANGAN pindah kalau belum -- itu bug "balik padahal belum keambil").
            for _ = 1, 16 do
                if not seedDiPosisi(folder, pos, 5) then break end  -- KOSONG -> cabut
                -- pin ke pack tiap fire (biar tetep deket, prompt aktif)
                pcall(function() root.CFrame = CFrame.new(tujuan) end)
                for _, o in ipairs(folder:GetDescendants()) do
                    if o:IsA("BasePart") and (o.Position - pos).Magnitude < 5 then
                        local pp = o:FindFirstChildWhichIsA("ProximityPrompt")
                            or (o.Parent and o.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                        if pp and fireproximityprompt then
                            -- v3.99: FIRE samain M1 (kebukti works pas debug):
                            -- fireproximityprompt(pp) BIASA, tanpa hold. Berkali
                            -- (bukan 1x) biar keambil.
                            pcall(function() fireproximityprompt(pp) end)
                        end
                    end
                end
                task.wait(0.15)
            end
            -- konfirmasi: lokasi kosong = keambil
            if not seedDiPosisi(folder, pos, 5) then
                diambil = diambil + 1
            end
        end
    end
    return diambil, nil
end

-- v3.20: daftar jenis seed event yg lagi jatuh (buat picker filter grab).
-- baca ObjectText prompt di Map.SeedPackSpawnClient.
function Seed.jenisSeedJatuh()
    local set = {}
    pcall(function()
        local map = workspace:FindFirstChild("Map")
        local folder = map and map:FindFirstChild("SeedPackSpawnClient")
        if not folder then return end
        for _, o in ipairs(folder:GetDescendants()) do
            if o:IsA("ProximityPrompt") and o.ObjectText ~= "" then
                local nm = tostring(o.ObjectText):match("^([^%[]+)")
                if nm then nm = nm:gsub("%s+$", ""); set[nm] = true end
            end
            local it = o:GetAttribute("ItemName") or o:GetAttribute("SeedName")
            if it then set[tostring(it)] = true end
        end
    end)
    set["Gold"] = true; set["Rainbow"] = true
    local arr = {}
    for nm in pairs(set) do arr[#arr+1] = nm end
    table.sort(arr)
    return arr
end

-- ============================================================
-- AUTO PLANT SEED (v3.18) -- tanam semua seed di tas ke kebun
-- remote: pkt("Plant","PlantSeed"):Fire(posisi, namaSeed, toolSeed)
-- arg: posisi Vector3 (sekitar karakter, sebar radius plantSpread),
--      namaSeed string, toolSeed Tool (dari Backpack/Character).
-- ============================================================
function Seed.plantOnce()
    local p = pkt("Plant", "PlantSeed")
    if not (p and p.Fire) then return 0 end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hrp) then return 0 end
    local bp = player:FindFirstChildOfClass("Backpack")
    -- kumpulin Tool seed dari Backpack + Character
    local seeds = {}
    for _, holder in ipairs({ char, bp }) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") then
                    -- v3.39: CUMA Tool yg BENERAN seed (punya attribute SeedTool
                    -- atau SeedName). Shovel/pet/gear/crate GAK punya attr ini ->
                    -- gak ikut ketanam. Dulu fallback ke t.Name -> semua Tool
                    -- (Shovel, Dog, Trowel dll) dianggap seed = salah tanam.
                    local seedName = t:GetAttribute("SeedTool") or t:GetAttribute("SeedName")
                    if seedName then
                        -- v3.51: PENGAMAN. Kalau user udah milih jenis (plantPilih ada
                        -- isi), ABAIKAN plantSemua -> cuma tanam yg dipilih. Dulu
                        -- plantSemua nyangkut true di panel -> pilih Gold tapi tetep
                        -- nanam semua. Sekarang begitu ada jenis dipilih, plantSemua
                        -- gak ngefek. plantSemua cuma kepakai kalau plantPilih KOSONG.
                        local adaPilihan = next(state.plantPilih) ~= nil
                        local ok
                        if adaPilihan then
                            ok = (state.plantPilih[seedName] == true)
                        else
                            ok = state.plantSemua
                        end
                        if ok then seeds[#seeds+1] = { tool = t, name = seedName } end
                    end
                end
            end
        end
    end
    if #seeds == 0 then return 0 end
    -- v3.48: GRUP TIPE. Gold/Rainbow/Mega itu seed fase-bulan (mutasi) -- user
    -- mau dihitung SATU GRUP gabungan buat batas 200. Contoh: kebun 160 Gold +
    -- tas 100 Rainbow -> grup "moon" udah 160, batas 200 -> cuma tanam 40.
    -- Seed biasa (Maple Apple dll) tetep per-jenis sendiri.
    -- v3.55: FIX grup batas 200. TEMUAN dari debug: seed Gold/Rainbow/Mega pas
    -- ditanam jadi tanaman dgn SeedName=jenis ACAK (mis "Maple Blueberry") +
    -- atribut Mutation=Rainbow/Gold. Jadi:
    --   - seed di TAS: nama Tool = "Gold"/"Rainbow"/"Mega" -> grup "_moon"
    --   - tanaman di KEBUN: cek atribut MUTATION (bukan SeedName!) -> grup "_moon"
    -- grup buat nama seed di tas (Gold/Rainbow/Mega -> _moon)
    local function grupTipe(nama)
        local low = tostring(nama):lower()
        if low:find("gold") or low:find("rainbow") or low:find("mega") then
            return "_moon"
        end
        return nama
    end
    -- grup buat TANAMAN di kebun: pakai atribut Mutation
    local function grupTanaman(plant)
        local mut = nil
        for _, k in ipairs({ "Mutation", "Mutations", "Variant" }) do
            local v = plant:GetAttribute(k)
            if type(v) == "string" and v ~= "" and v:lower() ~= "none"
               and v:lower() ~= "normal" then mut = v; break end
        end
        if mut then
            local low = mut:lower()
            if low:find("gold") or low:find("rainbow") or low:find("mega") then
                return "_moon"   -- tanaman mutasi Gold/Rainbow/Mega
            end
        end
        -- gak ada mutasi moon -> grup = SeedName (seed biasa)
        return plant:GetAttribute("SeedName") or "?"
    end
    -- v3.18e: DETECT DARI KEBUN -- hitung tanaman per GRUP (pakai Mutation).
    local kebunPerTipe = {}
    pcall(function()
        local g = workspace:FindFirstChild("Gardens")
        if not g then return end
        local uid = player.UserId
        for _, plot in ipairs(g:GetChildren()) do
            local own = plot:GetAttribute("OwnerUserId")
            local ownNm = plot:GetAttribute("Owner")
            if own == uid or ownNm == player.Name then
                local plants = plot:FindFirstChild("Plants")
                if plants then
                    for _, plant in ipairs(plants:GetChildren()) do
                        if plant:GetAttribute("PlantId") then
                            local grp = grupTanaman(plant)
                            kebunPerTipe[grp] = (kebunPerTipe[grp] or 0) + 1
                        end
                    end
                end
            end
        end
    end)
    local BATAS_TIPE = 200
    -- v3.18: AUTO TP KE TANAH -- tiap tanam, TP karakter ke titik di area kebun
    -- (plot milik kita), lalu tanam DI POSISI KARAKTER. Jadi karakter yang
    -- pindah ke tanah, seed ditanam pas di posisi kita. Nyebar karena tiap seed
    -- TP ke titik acak. Simpen posisi asli, balik setelah selesai.
    -- v3.18c: dari debug -- BoundingBox Y ketinggian (642, ada objek tinggi).
    -- Pakai PlotSizeReference (area tanam asli: center + size X/Z) + Y tanah
    -- dari SpawnPoint / tanaman yg ada (~143-146). BUKAN bounding box.
    -- v3.56: AREA KEBUN SELALU DI-DETECT ULANG tiap plantOnce (dipanggil tiap
    -- 0.5s). areaC/areaX/areaZ dihitung FRESH dari PlotSizeReference tiap kali,
    -- GAK di-cache. Jadi pas kebun tiba-tiba DIBESARIN, ref.Size baru langsung
    -- kebaca loop berikutnya (max 0.5s) -> area otomatis nyesuain.
    local areaC, areaX, areaZ, yTanah = nil, nil, nil, nil
    pcall(function()
        local g = workspace:FindFirstChild("Gardens")
        if not g then return end
        local uid = player.UserId
        local plot = nil
        for _, pl in ipairs(g:GetChildren()) do
            local own = pl:GetAttribute("OwnerUserId")
            local ownNm = pl:GetAttribute("Owner")
            if own == uid or ownNm == player.Name then plot = pl; break end
        end
        if not plot then return end
        -- v3.68: AREA TANAM dari PlantAreaColumn (bukan PlotSizeReference yg SALAH).
        -- Dari debug: ada 2 petak PlantAreaColumn1/2 (Y=143.6 permukaan asli),
        -- terpisah (ada celah di tengah). PlotSizeReference nunjuk 1 area gabungan
        -- 115x18 Y=147 -> center di CELAH kosong + Y kegedean 3.4 stud -> nanam di
        -- atas + deteksi kebalik. Sekarang: pilih PlantArea TERDEKAT dari karakter,
        -- pakai center + size + Y permukaan petak itu.
        local petakArr = {}
        for _, o in ipairs(plot:GetDescendants()) do
            if o.Name:find("PlantArea") and o:IsA("BasePart") then
                petakArr[#petakArr+1] = o
            end
        end
        if #petakArr > 0 then
            -- pilih petak terdekat dari karakter (biar tanam di petak yg kita berdiri)
            local terdekat, bestD
            for _, pk in ipairs(petakArr) do
                local d = math.abs(hrp.Position.X - pk.Position.X)
                    + math.abs(hrp.Position.Z - pk.Position.Z)
                if not bestD or d < bestD then bestD, terdekat = d, pk end
            end
            areaC = terdekat.Position
            areaX = terdekat.Size.X * 0.45
            areaZ = terdekat.Size.Z * 0.45
            yTanah = terdekat.Position.Y + (terdekat.Size.Y / 2)  -- permukaan atas petak
        end
        -- fallback: PlotSizeReference kalau PlantArea gak ada
        if not areaC then
            local ref = plot:FindFirstChild("PlotSizeReference")
            if ref and ref:IsA("BasePart") then
                areaC = ref.Position; areaX = ref.Size.X * 0.45
                areaZ = ref.Size.Z * 0.45; yTanah = ref.Position.Y
            end
        end
        -- fallback area: SpawnPoint
        if not areaC then
            local sp = plot:FindFirstChild("SpawnPoint")
            if sp and sp:IsA("BasePart") then
                areaC = sp.Position; areaX = 40; areaZ = 15
                yTanah = yTanah or sp.Position.Y
            end
        end
    end)
    -- v4.19: DEBUG plant + FALLBACK. Kalau areaC/yTanah gak ketemu (PlantArea nama
    -- beda di fall world), plant CUMA DIEM (yTanah nil -> skip tanam). Fallback:
    -- pakai POSISI KARAKTER sebagai pusat + Y karakter sebagai tanah. Biar tetep
    -- nanem walau petak gak ke-detect. Debug ke GUI biar tau kenapa.
    do
        local g = workspace:FindFirstChild("Gardens")
        local adaGarden = g ~= nil
        local plotKetemu = false
        if g then
            local uid = player.UserId
            for _, pl in ipairs(g:GetChildren()) do
                local own = pl:GetAttribute("OwnerUserId")
                local ownNm = pl:GetAttribute("Owner")
                if own == uid or ownNm == player.Name then plotKetemu = true; break end
            end
        end
        Seed._plantDbg = ("garden=%s plot=%s areaC=%s yTanah=%s seeds=%d"):format(
            tostring(adaGarden), tostring(plotKetemu),
            areaC and "ADA" or "NIL", yTanah and tostring(math.floor(yTanah)) or "NIL", #seeds)
    end
    -- FALLBACK: areaC/yTanah nil -> pakai posisi karakter (biar tetep nanem)
    if not areaC then
        areaC = hrp.Position
        areaX = 30; areaZ = 30
    end
    if not yTanah then
        -- Y tanah = kaki karakter (turun dikit dari HRP center)
        yTanah = hrp.Position.Y - 2.5
    end
    -- v3.18d: TP SEKALI ke tanah, NETEP di situ. Tanam sebar pakai KOORDINAT
    -- (fire pos + offset spread), BUKAN mindahin karakter tiap seed (dulu bikin
    -- bolak-balik terus tiap loop). Karakter diem di tanah, gak balik ke asal.
    -- v3.53: FIX LONCAT-LONCAT. Dulu tiap loop TP ke areaC (center kebun). Kebun
    -- bisa DIBESARIN -> center geser tiap kali -> TP ke titik baru terus = loncat.
    -- Sekarang: cek apakah karakter UDAH DI DALAM area kebun (pakai PlotSizeReference
    -- size). Kalau udah di dalam -> tanam DI POSISI SEKARANG (gak TP, gak loncat).
    -- Cuma TP masuk kalau bener-bener DI LUAR kebun.
    local diDalamKebun = false
    local avatar = hrp.Position   -- v4.23: deklarasi awal, diupdate kalau TP
    if areaC and areaX and areaZ then
        local dx = math.abs(hrp.Position.X - areaC.X)
        local dz = math.abs(hrp.Position.Z - areaC.Z)
        -- di dalam kalau posisi X/Z masih dalam setengah-ukuran area (+ toleransi)
        if dx <= (areaX + 10) and dz <= (areaZ + 10) then diDalamKebun = true end
    end
    -- v4.23: FIX GAK NANEM. Masalah user: karakter di DEPAN garden (agak di luar
    -- area), TAPI syarat TP lama "jauh > areaX+30" gak kepenuhi -> karakter NYANGKUT
    -- (gak dianggap di dalam, gak TP juga) -> Fire dari depan garden -> game NOLAK.
    -- Sekarang: kalau GAK di dalam kebun -> LANGSUNG TP ke tengah petak (tanah).
    -- Karakter napak tanah dulu, baru nanem. Ini yg user maksud "TP ke tanah".
    if not diDalamKebun and areaC and yTanah then
        local titikMasuk = Vector3.new(areaC.X, yTanah + 5, areaC.Z)
        pcall(function() hrp.CFrame = CFrame.new(titikMasuk) end)
        task.wait(0.2)
        -- update posisi avatar setelah TP (biar tanam dari posisi baru di tanah)
        avatar = hrp.Position
    end
    -- v3.71: RADIUS = lingkaran ngelilingi KARAKTER (setting plantSpread).
    -- User mau tanam melingkar di sekitar karakter, radius = plantSpread.
    -- BUKAN kotak petak. Karakter DIEM di posisinya, tanaman muter ngelilingi.
    local RADIUS = state.plantSpread or 4
    local RAPET = 1   -- jarak antar tanaman (rapet)
    local ditanam = 0
    local titik_dbg = 0   -- v4.21: jumlah titik tanam (debug)
    local hitungTipe = {}
    for tipe, n in pairs(kebunPerTipe) do hitungTipe[tipe] = n end

    -- kumpulin posisi tanaman yg UDAH ada (biar titik yg keisi di-skip, gak dobel)
    local adaTanaman = {}
    pcall(function()
        local gw = workspace:FindFirstChild("Gardens")
        if gw then
            local uid = player.UserId
            for _, plot in ipairs(gw:GetChildren()) do
                local own = plot:GetAttribute("OwnerUserId")
                local ownNm = plot:GetAttribute("Owner")
                if own == uid or ownNm == player.Name then
                    local pls = plot:FindFirstChild("Plants")
                    if pls then
                        for _, pl in ipairs(pls:GetChildren()) do
                            if pl:GetAttribute("PlantId") then
                                local ok, piv = pcall(function() return pl:GetPivot().Position end)
                                if ok and piv then
                                    local kx = math.floor(piv.X / RAPET + 0.5)
                                    local kz = math.floor(piv.Z / RAPET + 0.5)
                                    adaTanaman[kx .. "," .. kz] = true
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    -- v3.60: TANAM MUTER ngelilingi AVATAR. Pusat = posisi karakter. Titik
    -- rapet (grid RAPET stud) dalam radius MAX (setting user, default 4 stud).
    -- Urut: RING TERJAUH dulu (deket radius max) -> muter penuh -> ring lebih
    -- deket -> makin rapet ke avatar terakhir. Karakter DIEM.
    -- v3.64: FIX nanam di ATAS karakter. Dulu yPakai = yTanah + 3 (naik 3 stud)
    -- + karakter mungkin MELAYANG (gak di tanah) -> game tanam di posisi karakter
    -- yg melayang. Sekarang: TP karakter TURUN ke yTanah dulu (napak tanah),
    -- terus tanam pas di yTanah (tanpa +3).
    -- v3.69: TANAM MUTER dari TENGAH PETAK terdekat (bukan posisi karakter).
    -- User mau tanam di tengah petak. Karakter TP ke tengah petak (areaC) dulu,
    -- terus sebar muter dari situ. Pusat = areaC (center PlantArea terdekat),
    -- Y = yTanah (permukaan petak, dari PlantArea.Y+size/2).
    -- Urut titik: RING TERJAUH dulu -> muter -> makin rapet ke tengah terakhir.
    -- v3.71: TANAM MELINGKAR ngelilingi KARAKTER. Pusat = posisi karakter (DIEM,
    -- gak TP ke tengah petak). Titik dalam LINGKARAN radius plantSpread. Urut:
    -- ring terjauh dulu -> muter -> makin rapet ke karakter terakhir.
    if yTanah then
        local yPakai = yTanah
        local pusat = avatar   -- pusat = posisi karakter, karakter DIEM
        -- generate titik grid rapet dalam LINGKARAN radius (pusat karakter)
        local titik = {}
        local n = math.floor(RADIUS / RAPET)
        for ix = -n, n do
            for iz = -n, n do
                local px = pusat.X + ix * RAPET
                local pz = pusat.Z + iz * RAPET
                local dx = ix * RAPET
                local dz = iz * RAPET
                local jarak = math.sqrt(dx*dx + dz*dz)
                -- cuma titik DALAM lingkaran radius (bukan kotak)
                if jarak <= RADIUS + 0.01 then
                    local kunci = math.floor(px / RAPET + 0.5) .. "," .. math.floor(pz / RAPET + 0.5)
                    if not adaTanaman[kunci] then
                        local sudut = math.atan2(dz, dx)
                        titik[#titik+1] = { x = px, z = pz, r = jarak, a = sudut, k = kunci }
                    end
                end
            end
        end
        -- urut: RING terjauh dulu (r besar->kecil), dalam ring sama muter by sudut
        table.sort(titik, function(a, b)
            if math.abs(a.r - b.r) > 0.01 then return a.r > b.r end
            return a.a < b.a
        end)
        titik_dbg = #titik   -- v4.22: buat debug (berapa titik kosong)

        -- tanam tiap titik, terjauh dulu. v3.61: FIRE LANGSUNG tanpa wait per
        -- seed (kayak gag2 "brutal") biar CEPET. task.wait cuma tiap 20 seed
        -- (napas dikit biar gak freeze). Dulu wait 0.05 tiap seed -> super lambat.
        for _, t in ipairs(titik) do
            if not state.autoPlantOn then break end
            if #seeds == 0 then break end
            local dipakai = nil
            for si = #seeds, 1, -1 do
                local s = seeds[si]
                local grp = grupTipe(s.name)
                if (hitungTipe[grp] or 0) < BATAS_TIPE then
                    dipakai = s; break
                else
                    table.remove(seeds, si)
                end
            end
            if not dipakai then break end
            local pos = Vector3.new(t.x, yPakai, t.z)
            pcall(function() p:Fire(pos, dipakai.name, dipakai.tool) end)
            local grp = grupTipe(dipakai.name)
            hitungTipe[grp] = (hitungTipe[grp] or 0) + 1
            adaTanaman[t.k] = true
            ditanam = ditanam + 1
            if ditanam % 20 == 0 then task.wait() end   -- napas tiap 20, bukan tiap 1
        end
    end
    -- v4.22: debug hasil (berapa ketanam, titik kosong, nama seed, count seed)
    do
        local totCount = 0
        for _, s in ipairs(seeds) do
            local c = s.tool and (s.tool:GetAttribute("Count") or s.tool:GetAttribute("Amount") or 1) or 1
            totCount = totCount + (tonumber(c) or 1)
        end
        Seed._plantDbg = (Seed._plantDbg or "") ..
            (" | tanam=%d titik=%d nama=%s cnt=%d"):format(
                ditanam, titik_dbg, seeds[1] and tostring(seeds[1].name) or "-", totCount)
    end
    return ditanam
end

-- ============================================================
-- AUTO COLLECT (Collect All) + AUTO SELL (Sell All) -- v3.18
-- Struktur map baru (fall world):
--   workspace.Gardens.<Plot>  (attr OwnerUserId = userId kita)
--     .Plants.<userId_uuid>    (PlantId, SeedName)
--       .Fruits.<fruit>        (FruitId, PlantGrowthReady)
-- Collect: Garden.CollectFruit:Fire(plantId, fruitId)  -- panen SEMUA buah
-- Sell   : NPCS.SellAll:Fire()                          -- jual SELURUH tas
-- ============================================================
-- baca mutasi buah (dari atribut). nil = polos/normal.
local MUT_ATTR = { "Mutation", "Mutations", "Variant", "Type", "Modifier" }
local function getMutasiBuah(obj)
    for _, k in ipairs(MUT_ATTR) do
        local v = obj:GetAttribute(k)
        if type(v) == "string" and v ~= "" and v:lower() ~= "none" and v:lower() ~= "normal" then
            return v
        end
    end
    return nil
end

function Seed.collectAllOnce()
    local p = pkt("Garden", "CollectFruit")
    if not (p and p.Fire) then return 0 end
    local g = workspace:FindFirstChild("Gardens")
    if not g then return 0 end
    local uid = player.UserId
    local difire = 0
    for _, plot in ipairs(g:GetChildren()) do
        -- cuma plot MILIK KITA (OwnerUserId / Owner = kita)
        local own = plot:GetAttribute("OwnerUserId")
        local ownNm = plot:GetAttribute("Owner")
        if own == uid or ownNm == player.Name then
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, plant in ipairs(plants:GetChildren()) do
                    local plantId = plant:GetAttribute("PlantId")
                    -- filter jenis seed (nama tanaman)
                    local seedName = plant:GetAttribute("SeedName")
                    local okSeed = state.collectSemuaSeed
                        or (seedName and state.collectSeedPilih[seedName] == true)
                    if plantId and okSeed then
                        local fruits = plant:FindFirstChild("Fruits")
                        if fruits then
                            for _, fruit in ipairs(fruits:GetChildren()) do
                                local fid = fruit:GetAttribute("FruitId")
                                if fid ~= nil then
                                    -- filter mutasi
                                    local mut = getMutasiBuah(fruit)
                                    local okMut = state.collectSemuaMut
                                        or (mut and state.collectMutPilih[mut] == true)
                                    -- filter kg (threshold)
                                    local kg = fruit:GetAttribute("Weight")
                                        or fruit:GetAttribute("SizeMultiplier") or 0
                                    local okKg = (state.collectKgMin or 0) <= 0
                                        or (tonumber(kg) or 0) >= state.collectKgMin
                                    if okMut and okKg then
                                        pcall(function() p:Fire(tostring(plantId), tostring(fid)) end)
                                        difire = difire + 1
                                        task.wait()
                                    end
                                end
                            end
                        end
                        -- single-harvest (tanpa filter kg/mutasi -- gak ada buah dibaca)
                        if plant:GetAttribute("PlantGrowthReady") == true then
                            local pid = tostring(plantId)
                            pcall(function() p:Fire(pid, pid) end)
                            difire = difire + 1
                            task.wait()
                        end
                    end
                end
            end
        end
    end
    return difire
end

function Seed.sellAllOnce()
    local p = pkt("NPCS", "SellAll")
    if not (p and p.Fire) then return false end
    pcall(function() p:Fire() end)
    return true
end

-- v3.39: JADWAL FASE BULAN dari API WEB (kapan moon bakal TERJADI, bukan berhenti).
-- Niru star_farm: GET https://api.gag2.gg/api/live/weather -> data.weather.upcomingMoons
-- = [{name, boundary}]. boundary = timestamp UNIX kapan moon muncul. sisa = boundary-now.
-- Fetch pakai request executor (syn.request/http_request/request). cache 30s.
Seed._moonAPIUrl = "https://api.gag2.gg/api/live/weather"
Seed._moonCache = nil
Seed._moonAt = 0
function Seed.fetchMoonAPI()
    local now = os.clock()
    if Seed._moonCache ~= nil and (now - Seed._moonAt) < 30 then
        return Seed._moonCache or nil
    end
    local res = nil
    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
            or (fluxus and fluxus.request)
        if not req then return end
        local ok0, resp = pcall(function() return req({ Url = Seed._moonAPIUrl, Method = "GET" }) end)
        if not ok0 then return end
        local body = resp and (resp.Body or resp.body)
        if not body then return end
        local HS = game:GetService("HttpService")
        local ok, data = pcall(function() return HS:JSONDecode(body) end)
        if not ok or type(data) ~= "table" then return end
        local w = data.weather
        if not w or type(w.upcomingMoons) ~= "table" then return end
        local nowTime = os.time()
        local map = {
            ["bloodmoon"]="Bloodmoon", ["blood moon"]="Bloodmoon",
            ["goldmoon"]="Goldmoon", ["gold moon"]="Goldmoon",
            ["rainbow moon"]="Rainbow", ["rainbow_moon"]="Rainbow",
            ["mega moon"]="Mega", ["mega_moon"]="Mega", ["moon"]="Moon",
        }
        local nearest = {}
        for _, mn in ipairs(w.upcomingMoons) do
            local nm = tostring(mn.name or ""):lower()
            local key = map[nm]
            local bnd = tonumber(mn.boundary)
            if key and bnd then
                local left = bnd - nowTime
                if left > 0 and (not nearest[key] or left < nearest[key]) then
                    nearest[key] = left
                end
            end
        end
        if next(nearest) then res = nearest end
    end)
    Seed._moonCache = res or false; Seed._moonAt = now
    return res
end

-- format sisa waktu (detik -> "5m 03s" / "1j 20m")
function Seed.fmtSisa(sec)
    if sec == nil then return "-" end
    if sec < 0 then sec = 0 end
    local m = math.floor(sec / 60); local s = math.floor(sec % 60)
    if m > 60 then
        local h = math.floor(m/60); m = m % 60
        return string.format("%dj %dm", h, m)
    end
    return string.format("%dm %02ds", m, s)
end

-- v3.38: AUTO SHOVEL SEED (cabut tanaman). Niru star_farm:
--   remote Shovel.UseShovel(plantId, "", "Shovel", tool)  -- arg2 "" = cabut tanaman
--   butuh Tool Shovel di tas (equip dulu). SISAIN min 1 per jenis (game nolak
--   cabut tanaman TERAKHIR: "You can't remove your only carrot!").
--   plantId = plant.Name (userId_uuid, panjang >= 30). filter jenis via SeedName.
function Seed.shovelSeedOnce()
    local p = pkt("Shovel", "UseShovel")
    if not (p and p.Fire) then Seed._logShovel = "remote Shovel.UseShovel gak ada"; return 0 end
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return 0 end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    -- cari Tool Shovel
    local shovelTool
    for _, h in ipairs({ char, player:FindFirstChildOfClass("Backpack") }) do
        if h then
            for _, t in ipairs(h:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("shovel") then shovelTool = t; break end
            end
        end
        if shovelTool then break end
    end
    if not shovelTool then Seed._logShovel = "Tool Shovel gak ada di tas"; return 0 end
    if shovelTool.Parent ~= char and hum then
        pcall(function() hum:EquipTool(shovelTool) end); task.wait(0.1)
    end

    local MY = player.UserId
    -- hitung tanaman KITA per jenis (buat aturan sisain 1)
    local typeCount = {}
    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                local ownerId = tonumber(plant.Name:match("^(%d+)_"))
                if (not ownerId or ownerId == MY) then
                    local sn = plant:GetAttribute("SeedName") or "?"
                    typeCount[sn] = (typeCount[sn] or 0) + 1
                end
            end
        end
    end

    -- v4.47: METODE 1-1 (tunggu-ilang). Dulu fire semua barengan -> banyak kebuang
    -- (server drop / blm cukup umur), lemot + gak efektif. Sekarang: KUMPULIN daftar
    -- dulu (filter sisain-1 + jenis + mutasi), terus fire SATU-SATU, tiap fire TUNGGU
    -- sampai plant ilang baru lanjut. Gak buang fire, tiap cabut dipastiin berhasil.

    -- helper: plant masih ada gak (udah kecabut belum)
    local function plantMasihAda(pid)
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants and plants:FindFirstChild(pid) then return true end
        end
        return false
    end

    -- PASS 1: kumpulin daftar plantId yg boleh dicabut (filter lengkap)
    local target = {}
    local galiPerType = {}
    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                local ownerId = tonumber(plant.Name:match("^(%d+)_"))
                local plantId = plant.Name
                local seedName = plant:GetAttribute("SeedName") or "?"
                -- deteksi mutasi -> key "[MUT] <jenis>" atau "<jenis>"
                local mut = nil
                for _, k in ipairs({ "Mutation", "Mutations", "Variant", "Variants" }) do
                    local v = plant:GetAttribute(k)
                    if type(v) == "string" and v ~= ""
                       and v:lower() ~= "none" and v:lower() ~= "normal" then mut = v; break end
                end
                local low = tostring(seedName):lower()
                if not mut and (low:find("gold") or low:find("rainbow") or low:find("mega")) then
                    mut = "Mutasi"
                end
                local keyPilih = mut and ("[MUT] " .. seedName) or seedName
                local okType = state.shovelSemua or (state.shovelPilih[keyPilih] == true)
                -- sisain min 1 per jenis
                local sisa = (typeCount[seedName] or 0) - (galiPerType[seedName] or 0)
                local bolehGali = sisa > 1
                if (not ownerId or ownerId == MY) and okType and #plantId >= 30 and bolehGali then
                    target[#target+1] = plantId
                    galiPerType[seedName] = (galiPerType[seedName] or 0) + 1
                end
            end
        end
    end

    -- PASS 2: fire SATU-SATU, tunggu tiap plant ilang baru lanjut
    local removed = 0
    for _, plantId in ipairs(target) do
        if not (state.shovelOn and isCurrentGen()) then break end
        pcall(function() p:Fire(plantId, "", shovelTool.Name, shovelTool) end)
        -- tunggu sampai ilang (maks ~2 detik, cek tiap 0.05s). Begitu ilang -> lanjut
        -- (biasanya <0.3s, jadi jauh lebih cepet dari nunggu full 2s).
        local ilang = false
        for _ = 1, 40 do
            task.wait(0.05)
            if not plantMasihAda(plantId) then ilang = true; break end
            if not (state.shovelOn and isCurrentGen()) then break end
        end
        if ilang then removed = removed + 1 end
        -- kalau GAK ilang 2s (blm cukup umur / server nolak) -> skip, lanjut berikutnya
    end
    Seed._logShovel = removed > 0 and (removed .. " tanaman dicabut (1-1)") or "gak ada yg dicabut"
    return removed
end

