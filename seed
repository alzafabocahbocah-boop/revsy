-- ============================================================
Seed.statTerbeli = 0     -- total fire sejak script jalan
Seed.statSiklus  = 0
Seed._logAkhir   = ""

local function daftarTarget()
    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    if state.borongSemua then return Seed.daftar end

    local sel, seen = {}, {}
    for _, nm in ipairs(Seed.daftar) do
        if state.seedPilih[nm] then sel[#sel+1] = nm; seen[nm] = true end
    end
    -- "seed bagus": ikut samber yang rarity-nya tinggi walau gak dicentang.
    -- Seed baru / tier baru (rarity gak dikenal) ikut dibeli -- lebih baik
    -- kebeli lalu dibuang daripada kelewat pas rilis seed baru.
    if state.beliBagus then
        local minRank = RARITY_RANK[state.minRarity or "Mythic"] or 6
        for _, nm in ipairs(Seed.daftar) do
            if not seen[nm] then
                local rar = Seed.rarity(nm)
                local rank = (rar and RARITY_RANK[rar]) or 0
                local gakDikenal = (rar == nil) or (RARITY_RANK[rar] == nil)
                if rank >= minRank or gakDikenal then sel[#sel+1] = nm; seen[nm] = true end
            end
        end
    end
    return sel
end

function Seed.beliSekali()
    local p = pkt("SeedShop", "PurchaseSeed")
    if not p or not p.Fire then
        Seed._logAkhir = "packet PurchaseSeed gak ketemu"
        return 0
    end

    -- rem sheckles: berhenti kalau saldo udah mepet
    if (state.sisaSheck or 0) > 0 and sheckles() <= state.sisaSheck then
        Seed._logAkhir = "sheckles mepet, beli ditahan"
        return 0
    end

    local list = daftarTarget()
    if #list == 0 then Seed._logAkhir = "gak ada seed yang dipilih"; return 0 end

    local fired = 0
    for _, nama in ipairs(list) do
        if not (state.beliOn and isCurrentGen()) then break end
        -- nama stok TANPA akhiran "Seed" ("Carrot", bukan "Carrot Seed") --
        -- tapi gak semua begitu, jadi dicoba dua bentuk.
        local pendek = nama:gsub("%s*Seed$", "")
        local stok = Seed.stok(pendek)
        if stok == nil then stok = Seed.stok(nama) end
        if stok and stok > 0 then
            if stok > (state.maxPerSiklus or 20) then stok = state.maxPerSiklus or 20 end
            for _ = 1, stok do
                if not (state.beliOn and isCurrentGen()) then break end
                pcall(function() p:Fire(nama) end)
                fired = fired + 1
                -- jeda tiap 5 fire: tanpa ini, borong 30 jenis sekaligus bikin
                -- lonjakan packet yang kerasa banget di RedFinger.
                if fired % 5 == 0 then task.wait() end
            end
        end
    end

    if fired > 0 then
        Seed.statTerbeli = Seed.statTerbeli + fired
        Seed._logAkhir = fired .. " fire"
    else
        Seed._logAkhir = "semua stok kosong"
    end
    return fired
end

-- loop utama
