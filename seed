-- v4.88: pengali mutasi LIVE dari MutationData.ReturnPriceMultiplier (port gag2)
function Seed._getMutMult(mut)
    if not mut then return 1 end
    if Seed._mutData == nil then
        Seed._mutData = false
        pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local m = sm and sm:FindFirstChild("MutationData")
            if m then local ok, d = pcall(require, m); if ok and type(d) == "table" then Seed._mutData = d end end
        end)
    end
    local d = Seed._mutData
    if not d or type(d.ReturnPriceMultiplier) ~= "function" then return 1 end
    for _, args in ipairs({ { mut }, { d, mut }, { { mut } }, { d, { mut } } }) do
        local ok, v = pcall(function() return d.ReturnPriceMultiplier(table.unpack(args)) end)
        if ok and type(v) == "number" and v > 0 then return v end
    end
    return 1
end
-- jenis buah dari nama Tool "Maple Blueberry [1.44kg]" -> "Blueberry"
-- (buang prefix "Maple " + suffix "[...]"), atau atribut Fruit/FruitName
local function jenisBuah(tool)
    local j = tool:GetAttribute("Fruit") or tool:GetAttribute("FruitName")
        or tool:GetAttribute("CorePartName")
    if j and j ~= "" then return tostring(j) end
    -- fallback: dari nama Tool
    local nm = tostring(tool.Name)
    nm = nm:gsub("%s*%[.-%]", "")   -- buang semua [xxx]
    nm = nm:gsub("^Maple%s+", "")   -- buang prefix Maple
    nm = nm:gsub("^%s+", ""):gsub("%s+$", "")
    return nm
end
local function hargaBuah(tool, noMarket)
    local jenis = jenisBuah(tool)
    local sm = tool:GetAttribute("SizeMultiplier") or tool:GetAttribute("SizeMulti")
    if not jenis or type(sm) ~= "number" then return nil end
    local mut = getMutasiBuah(tool)
    -- v4.89: harga NORMAL (noMarket) atau PASAR (× pengali). ESP inv = normal, badge = pasar.
    local mkt = noMarket and 1 or ((Seed.pengali and Seed.pengali(jenis)) or 1)
    if type(mkt) ~= "number" or mkt <= 0 then mkt = 1 end
    -- coba FruitValueCalc (eksak)
    local fvc = getFVC()
    if fvc then
        local ok, v = pcall(fvc, jenis, sm, mut, tool, tool:GetAttribute("DecayAlpha"))
        if ok and type(v) == "number" and v > 0 then return math.floor(v * mkt) end
    end
    -- fallback: SellValueData × sm^2.5 × mutMult × decay × mkt (PERSIS gag2)
    local base = getSellBase()
    local b = base[jenis]
    if type(b) == "number" then
        local price = b * (sm ^ 2.5)
        price = price * Seed._getMutMult(mut)
        local decay = tool:GetAttribute("DecayAlpha")
        if type(decay) == "number" and decay > 0 then
            price = price * (1 - math.clamp(decay, 0, 1) * 0.8)
        end
        return math.floor(price * mkt)
    end
    return nil
end

-- v3.18: singkat harga (5.2M, 1.9B)
local function singkatHarga(n)
    if not n then return "?" end
    if n >= 1e12 then return ("%.2fT"):format(n/1e12)
    elseif n >= 1e9 then return ("%.2fB"):format(n/1e9)
    elseif n >= 1e6 then return ("%.2fM"):format(n/1e6)
    elseif n >= 1e3 then return ("%.1fK"):format(n/1e3)
    else return tostring(math.floor(n)) end
end

