        local ok, mod = pcall(require, m)
        if not ok or type(mod) ~= "table" then return end
        for k, v in pairs(mod) do
            if type(k) == "string" and tonumber(v) then
                Seed._nilaiJual[k] = tonumber(v)
            end
        end
    end)
    return Seed._nilaiJual
end

-- ============================================================
-- v3.4: SHECKLES TERTUNDA -- nilai buah di tas yang BELUM kejual.
--
-- Kenapa bukan ngitung jumlah mail di mailbox: terimaGift ngosongin mailbox
-- tiap siklus, jadi mail gak pernah numpuk -- begitu masuk langsung diklaim
-- dan buahnya pindah ke TAS. Yang nunggu di tas itu yang sebenernya
-- "sheckles tertunda": barangnya udah ada, tinggal nunggu pengali pasar
-- nyampe ambang jual.
--
-- Nilainya dari SellValueData x jumlah. Ini PERKIRAAN KASAR -- harga jual
-- asli masih dikali pengali pasar dan ukuran buah. Dipakai buat mutusin
-- "akun ini udah dikirimin, jangan dikirimin lagi", bukan buat pembukuan.
-- ============================================================
function Seed.nilaiTertunda()
    local nilai, jumlah = 0, 0
    local hargaMap = muatNilaiJual()
    pcall(function()
        for _, holder in ipairs(pemegangBuah()) do
            for _, o in ipairs(holder:GetChildren()) do
                if o:GetAttribute("Id") then          -- penanda buah
                    jumlah = jumlah + 1
                    local jenis = jenisBuah(o.Name)
                    local h = jenis and hargaMap[jenis]
                    if h then nilai = nilai + h end
                end
            end
        end
    end)
    return nilai, jumlah
end


function Seed.jualSekali()
    local p = pkt("NPCS", "SellFruit")
    if not p or not p.Fire then Seed._logJual = "packet SellFruit gak ada"; return 0 end

    local ambang = tonumber(state.jualMinMult) or 4
    local terjual, dilewat, takTau = 0, 0, 0

    for _, holder in ipairs(pemegangBuah()) do
        for _, o in ipairs(holder:GetChildren()) do
            if not (state.jualOn and isCurrentGen()) then break end
            local id = o:GetAttribute("Id")
            if id then
                local jenis = jenisBuah(o.Name)
                local mult = Seed.pengali(jenis)
                local boleh
                if mult == nil then
                    -- pengali gak kebaca. Bawaan: JANGAN jual -- nunggu mahal itu
                    -- inti fiturnya, jual tanpa tau harga malah ngebuang buah.
                    takTau = takTau + 1
                    boleh = state.jualTanpaMult and true or false
                else
                    boleh = (mult >= ambang)
                    if not boleh then dilewat = dilewat + 1 end
                end
                if boleh then
                    pcall(function() p:Fire(id) end)
                    terjual = terjual + 1
                    if terjual % 5 == 0 then task.wait() end
                end
            end
        end
    end

    if terjual > 0 then
        Seed.statJual = Seed.statJual + terjual
        Seed._logJual = terjual .. " buah dijual (>=" .. ambang .. "x)"
        print("[StarSeed] jual: " .. terjual .. " buah pada pengali >= " .. ambang .. "x")
    elseif takTau > 0 and not state.jualTanpaMult then
        Seed._logJual = "pengali gak kebaca -> ditahan (" .. takTau .. " buah)"
    elseif dilewat > 0 then
        Seed._logJual = "harga belum " .. ambang .. "x (" .. dilewat .. " buah nunggu)"
    else
        Seed._logJual = "gak ada buah di tas"
    end
    return terjual
end

task.spawn(function()
    while isCurrentGen() do
        task.wait(5)
        if isCurrentGen() and state.jualOn then pcall(Seed.jualSekali) end
    end
end)

