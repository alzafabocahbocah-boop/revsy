    while isCurrentGen() do
        task.wait(state.jedaSiklus or 3)
        if isCurrentGen() and state.beliOn then
            Seed.statSiklus = Seed.statSiklus + 1
            pcall(Seed.beliSekali)
        end
    end
end)

