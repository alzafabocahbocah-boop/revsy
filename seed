local function catSaklar(tbl, nyala, teksOn, teksOff)
    tbl.Text = nyala and (teksOn or "ON") or (teksOff or "OFF")
    -- gaya C4: nyala = bg coklat gelap + border oren + teks oren muda; mati = gelap + border samar
    tbl.BackgroundColor3 = nyala and WARNA.aksenBg or WARNA.garis
    tbl.TextColor3 = nyala and WARNA.aksenMuda or WARNA.redup
    -- atur UIStroke (border) kalau ada -> oren pas nyala
    local st = tbl:FindFirstChildOfClass("UIStroke")
    if st then
        st.Color = nyala and WARNA.aksen or WARNA.garis
        st.Transparency = 0
    end
    -- v4.48: TITIK indikator on/off kecil di pojok kiri tombol. Ijo = on, abu = off.
    -- Simpel, langsung keliatan tiap fitur mana yg nyala tanpa baca teks.
    local dot = tbl:FindFirstChild("SaklarDot")
    if not dot then
        dot = Instance.new("Frame")
        dot.Name = "SaklarDot"
        dot.Size = UDim2.new(0, 8, 0, 8)
        dot.Position = UDim2.new(0, 7, 0.5, -4)
        dot.BorderSizePixel = 0
        dot.ZIndex = (tbl.ZIndex or 1) + 2
        local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(1, 0); dc.Parent = dot
        dot.Parent = tbl
    end
    dot.BackgroundColor3 = nyala and Color3.fromRGB(78, 214, 122) or Color3.fromRGB(110, 110, 118)
end

