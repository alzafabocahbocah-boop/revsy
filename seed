Seed._giftUidCache = {}
local function resolveTargetId(nama)
    if Seed._giftUidCache[nama] then return Seed._giftUidCache[nama] end
    -- v4.13: GetUserIdFromNameAsync itu WEB REQUEST -- sering rate-limit/timeout,
    -- makanya kadang "user gak ketemu" (padahal username bener), kadang baru
    -- ketemu setelah nunggu. Fix: RETRY 3x dgn jeda naik (1s, 2s, 3s). Sekali
    -- dapet -> cache permanen (gak request lagi). Gagal semua -> nil (coba lagi
    -- nanti, gak di-cache negatif).
    for percobaan = 1, 3 do
        local ok, id = pcall(function()
            return Players:GetUserIdFromNameAsync(nama)
        end)
        if ok and id and id > 0 then
            Seed._giftUidCache[nama] = id
            return id
        end
        -- gagal (rate-limit/timeout) -> jeda sebelum coba lagi
        if percobaan < 3 then task.wait(percobaan) end
    end
    return nil
end

-- cek Tool = gear (bukan seed/buah/pet). gear: MainCategory=Gear, atau
-- nama gear umum (Sprinkler/Watering/Trowel/Shovel/dll).
local function toolItuGear(tool)
    if not (tool and tool:IsA("Tool")) then return false end
    if tool:GetAttribute("SizeMultiplier") then return false end   -- buah
    local cat = tool:GetAttribute("MainCategory")
    if cat and tostring(cat):lower():find("gear") then return true end
    -- atribut gear khas (dari debug: gear punya .<TipeGear>=nama)
    if tool:GetAttribute("Sprinkler") or tool:GetAttribute("WateringCan")
       or tool:GetAttribute("Trowel") or tool:GetAttribute("Shovel")
       or tool:GetAttribute("Build") then return true end
    local low = tool.Name:lower()
    if low:find("sprinkler") or low:find("watering") or low:find("trowel")
       or low:find("shovel") or low:find("can") then return true end
    return false
end

-- list gear di tas (buat picker)
function Seed.gearDiTas()
    local hitung = {}
    pcall(function()
        for _, holder in ipairs(tasHolders()) do
            for _, t in ipairs(holder:GetChildren()) do
                if toolItuGear(t) then
                    local nm = t.Name
                    local n = t:GetAttribute("Count") or 1
                    if n == 0 then n = 1 end
                    hitung[nm] = (hitung[nm] or 0) + n
                end
            end
        end
    end)
    local arr = {}
    for nm, n in pairs(hitung) do arr[#arr+1] = { n = nm, j = n } end
    table.sort(arr, function(a, b) return a.n < b.n end)
    return arr
end
