Seed._giftUidCache = {}
local function resolveTargetId(nama)
    if Seed._giftUidCache[nama] then return Seed._giftUidCache[nama] end
    local ok, id = pcall(function()
        return Players:GetUserIdFromNameAsync(nama)
    end)
    if ok and id then Seed._giftUidCache[nama] = id; return id end
    return nil
end

-- cek Tool = gear (bukan seed/buah/pet). gear: MainCategory=Gear, atau
-- nama gear umum (Sprinkler/Watering/Trowel/Shovel/dll).
local function toolItuGear(tool)
    if not (tool and tool:IsA("Tool")) then return false end
    if tool:GetAttribute("SizeMultiplier") then return false end   -- buah
    local cat = tool:GetAttribute("MainCategory")
    if cat and tostring(cat):lower():find("gear") then return true end
    -- atribut gear khas (dari debug: gear punya .<TipeGear>=nama)
    if tool:GetAttribute("Sprinkler") or tool:GetAttribute("WateringCan")
       or tool:GetAttribute("Trowel") or tool:GetAttribute("Shovel")
       or tool:GetAttribute("Build") then return true end
    local low = tool.Name:lower()
    if low:find("sprinkler") or low:find("watering") or low:find("trowel")
       or low:find("shovel") or low:find("can") then return true end
    return false
end

-- list gear di tas (buat picker)
function Seed.gearDiTas()
    local hitung = {}
    pcall(function()
        for _, holder in ipairs(tasHolders()) do
            for _, t in ipairs(holder:GetChildren()) do
                if toolItuGear(t) then
                    local nm = t.Name
                    local n = t:GetAttribute("Count") or 1
                    if n == 0 then n = 1 end
                    hitung[nm] = (hitung[nm] or 0) + n
                end
            end
        end
    end)
    local arr = {}
    for nm, n in pairs(hitung) do arr[#arr+1] = { n = nm, j = n } end
    table.sort(arr, function(a, b) return a.n < b.n end)
    return arr
end
local function namaGearDiTas()
    local out = {}
    for _, e in ipairs(Seed.gearDiTas()) do out[#out+1] = e.n end
    return out
end

-- cek Tool = seed (buat gift mail). Cara ringkas map baru: seed asli punya
-- MainCategory=Seed / SeedTool, BUAH punya SizeMultiplier (skip), gear ada
-- atribut/nama gear. Sengaja LOKAL di sini biar gak kena urutan upvalue.
local function giftToolSeed(t)
    if not (t and t:IsA("Tool")) then return false end
    if t:GetAttribute("SizeMultiplier") then return false end   -- buah
    if toolItuGear(t) then return false end                     -- gear
    local cat = t:GetAttribute("MainCategory")
    if cat and tostring(cat):lower():find("seed") then return true end
    if t:GetAttribute("SeedTool") or t:GetAttribute("SeedName") then return true end
    if t.Name:match("[Ss]eed%s*$") then return true end
    -- fallback: bukan buah + bukan gear -> anggap seed (tas seed map baru
    -- namanya "Gold"/"Carrot" tanpa atribut jelas)
    return true
end

-- kirim gift mail SEKALI. return: ok(bool), pesan(string)
function Seed.kirimGiftMail()
    local target = tostring(state.giftMailTarget or ""):gsub("%s+", "")
    if target == "" then return false, "target kosong" end
    local sb = pkt("Mailbox", "SendBatch")
    if not (sb and sb.Fire) then return false, "SendBatch gak ada" end
    local uid = resolveTargetId(target)
    if not uid then return false, "user '" .. target .. "' gak ketemu" end
    local qty = tonumber(state.giftMailQty) or 100
    if qty < 1 then qty = 1 end
    -- kumpulin item (seed + gear yg dipilih)
    local items = {}
    for _, holder in ipairs(tasHolders()) do
        for _, t in ipairs(holder:GetChildren()) do
            if t:IsA("Tool") and #items < 8 then
                -- GEAR (cek dulu, karena giftToolSeed fallback true)
                if toolItuGear(t) then
                    if state.giftGearPilih[t.Name] then
                        local punya = t:GetAttribute("Count") or 1
                        local kirim = math.min(qty, punya)
                        local cat = t:GetAttribute("MainCategory") or "Gear"
                        if kirim > 0 then
                            items[#items+1] = { ItemKey = t.Name, Count = kirim, Category = tostring(cat) }
                        end
                    end
                -- SEED
                elseif giftToolSeed(t) then
                    local nm = t:GetAttribute("SeedName") or t.Name
                    nm = tostring(nm):gsub("%s*[Ss]eed%s*$", "")
                    if nm == "" then nm = t.Name end
                    if state.giftSeedPilih[nm] or state.giftSeedPilih[t.Name] then
                        local punya = t:GetAttribute("Count") or 1
                        local kirim = math.min(qty, punya)
                        if kirim > 0 then
                            items[#items+1] = { ItemKey = nm, Count = kirim, Category = "Seeds" }
                        end
                    end
                end
            end
        end
    end
    if #items == 0 then return false, "gak ada item kepilih di tas" end
    local ok = pcall(function() sb:Fire(uid, items, "") end)
    if ok then
        return true, ("terkirim ke %s: %d jenis"):format(target, #items)
    end
    return false, "gagal kirim"
end


