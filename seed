    c("===== CEK AUTO PLANT =====")
    c("autoPlantOn = " .. tostring(state.autoPlantOn))
    c("plantSemua  = " .. tostring(state.plantSemua))
    local pp = state.plantPilih or {}
    if state.plantSemua and next(pp) == nil then
        c(">>> plantSemua NYALA + plantPilih kosong -> nanam SEMUA jenis!")
    end
    local list = {}
    for k, v in pairs(pp) do if v then list[#list+1] = tostring(k) end end
    c("plantPilih = " .. #list .. " jenis: " .. table.concat(list, ", "))
    local adaPilihan = next(pp) ~= nil
    if adaPilihan then
        c(">>> plantPilih ADA ISI -> plantSemua DIABAIKAN (cuma tanam yg dipilih)")
    end
    c("")
    c("-- SEED DI TAS (nama Tool + SeedTool attr) --")
    local char = player.Character
    local bp = player:FindFirstChildOfClass("Backpack")
    local n = 0
    for _, holder in ipairs({ char, bp }) do
        if holder then
            for _, t in ipairs(holder:GetChildren()) do
                if t:IsA("Tool") then
                    -- pakai logika PLANT ASLI: cuma Tool yg punya SeedTool/SeedName
                    local seedName = t:GetAttribute("SeedTool") or t:GetAttribute("SeedName")
                    if seedName then
                        -- v3.51: plantPilih ada isi -> abaikan plantSemua
                        local match
                        if adaPilihan then match = (pp[seedName] == true)
                        else match = state.plantSemua end
                        n = n + 1
                        if n <= 25 then
                            c(("  Tool='%s' Seed=%s -> ketanam=%s"):format(
                                t.Name, tostring(seedName), tostring(match)))
                        end
                    end
                end
            end
        end
    end
    c("total seed di tas: " .. n)
    c("")
    if adaPilihan then
        c(">>> filter: CUMA yg ada di plantPilih (plantSemua diabaikan)")
    else
        c(">>> plantPilih KOSONG -> pakai plantSemua (" .. tostring(state.plantSemua) .. ")")
    end
    c(">>> kalau tetep nanam semua padahal plantSemua false -> nama gak match tapi lolos (bug)")
    c("")
    c("-- HITUNG TANAMAN DI KEBUN (per grup, buat batas 200) --")
    do
        local function grupTipe(nama)
            local low = tostring(nama):lower()
            if low:find("gold") or low:find("rainbow") or low:find("mega") then return "_moon" end
            return nama
        end
