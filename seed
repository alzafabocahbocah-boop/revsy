-- hitung seed di tas. Seed di tas namanya LANGSUNG "Bamboo"/"Tulip" -- tanpa
-- atribut SeedName, tanpa akhiran "Seed". Jadi patokannya: Tool yang namanya
-- ada di SeedData. Gear (Trowel, Sprinkler) otomatis keskip karena gak ada di situ.
-- v3.18: HARGA BUAH -- dari FruitValueCalc (eksak) / SellValueData (fallback)
-- rumus: SellValueData[jenis] × SizeMultiplier^2.5 × mutMult
Seed._fvc = nil          -- FruitValueCalc (fungsi)
Seed._sellBase = nil     -- SellValueData (base per jenis)
Seed._mutData = nil      -- MutationData (pengali mutasi)
local function getFVC()
    if Seed._fvc == nil then
        Seed._fvc = false
        pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local m = sm and sm:FindFirstChild("FruitValueCalc")
            if m then
                local ok, f = pcall(require, m)
                if ok and type(f) == "function" then Seed._fvc = f end
            end
        end)
    end
    return Seed._fvc or nil
end
local function getSellBase()
    if not Seed._sellBase then
        Seed._sellBase = {}
        pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local m = sm and sm:FindFirstChild("SellValueData")
            if m then
                local ok, d = pcall(require, m)
                if ok and type(d) == "table" then Seed._sellBase = d end
            end
        end)
    end
    return Seed._sellBase
end
-- jenis buah dari nama Tool "Maple Blueberry [1.44kg]" -> "Blueberry"
-- (buang prefix "Maple " + suffix "[...]"), atau atribut Fruit/FruitName
local function jenisBuah(tool)
    local j = tool:GetAttribute("Fruit") or tool:GetAttribute("FruitName")
        or tool:GetAttribute("CorePartName")
    if j and j ~= "" then return tostring(j) end
    -- fallback: dari nama Tool
    local nm = tostring(tool.Name)
    nm = nm:gsub("%s*%[.-%]", "")   -- buang semua [xxx]
    nm = nm:gsub("^Maple%s+", "")   -- buang prefix Maple
    nm = nm:gsub("^%s+", ""):gsub("%s+$", "")
    return nm
end
local function hargaBuah(tool)
    local jenis = jenisBuah(tool)
    local sm = tool:GetAttribute("SizeMultiplier") or tool:GetAttribute("SizeMulti")
    if not jenis or type(sm) ~= "number" then return nil end
    local mut = getMutasiBuah(tool)
    -- coba FruitValueCalc (eksak)
    local fvc = getFVC()
    if fvc then
        local ok, v = pcall(fvc, jenis, sm, mut, tool, tool:GetAttribute("DecayAlpha"))
        if ok and type(v) == "number" and v > 0 then return math.floor(v) end
    end
    -- fallback: SellValueData × sm^2.5
    local base = getSellBase()
    local b = base[jenis]
    if type(b) == "number" then
        return math.floor(b * (sm ^ 2.5))
    end
    return nil
end

-- v3.18: singkat harga (5.2M, 1.9B)
local function singkatHarga(n)
    if not n then return "?" end
    if n >= 1e12 then return ("%.2fT"):format(n/1e12)
    elseif n >= 1e9 then return ("%.2fB"):format(n/1e9)
    elseif n >= 1e6 then return ("%.2fM"):format(n/1e6)
    elseif n >= 1e3 then return ("%.1fK"):format(n/1e3)
    else return tostring(math.floor(n)) end
end

