-- hitung pumpkin >= kg di inventory (buah tas punya SizeMultiplier + Weight)
-- v4.56b: hitung pumpkin >= minKg DI GARDEN (buah udah spawn, gak dishovel karena
-- gede). Baca SizeMulti buah -> konversi kg. Ini yg jadi stop condition sprinkler.
-- v4.73: harga 1 buah pumpkin dari SizeMulti (FVC eksak / SellValueData × sm^2.5)
function Seed._hargaPk(jenis, sm)
    if type(sm) ~= "number" then return 0 end
    -- v7.4: FVC (FruitValueCalc) pake DIMINISHING RETURNS -- decompile nunjukin:
    --   v29 = sm^exp  TAPI kalau sm > knee(5): knee^exp × (sm/knee)^min(tail,exp)
    --   exp=2.5 (SizeExponent), knee=5, tail=1.5 (TailExponent). value = base × v29.
    -- (dulu selalu sm^2.5 -> ketinggian: 55jt vs asli 34jt buat sm~8.)
    -- FVC gak bisa dipanggil langsung (butuh arg p25 objek bonus), jadi reimplement.
    if not Seed._sellBase then
        Seed._sellBase = {}
        pcall(function()
            local RS2 = game:GetService("ReplicatedStorage")
            local smm = RS2:FindFirstChild("SharedModules")
            local m = smm and smm:FindFirstChild("SellValueData")
            if m then local ok, d = pcall(require, m); if ok and type(d) == "table" then Seed._sellBase = d end end
        end)
    end
    local base = Seed._sellBase and (Seed._sellBase[jenis] or Seed._sellBase["Pumpkin"])
    if type(base) ~= "number" then base = 300000 end   -- fallback Atlantic Giant Pumpkin
    local exp, knee, tail = 2.5, 5, 1.5
    local sizeVal
    if knee < sm then
        local t = math.min(tail, exp)
        sizeVal = (knee ^ exp) * ((sm / knee) ^ t)   -- diminishing returns
    else
        sizeVal = sm ^ exp
    end
    return base * sizeVal
end

-- v4.71: STATS pumpkin -- total TANAMAN + berbuah + ≥goalKg + range + total value.
-- kg predicted dari SizeMulti (math): kg = SizeMulti × ratio -- FINAL kg walau
-- buah masih muda (SizeMulti udah fix pas spawn, gak nunggu gede).
-- v6.1: kg buah AKURAT -- pake atribut Weight (kg asli dari game) kalau ada,
-- fallback ke SizeMulti × ratio cuma kalau Weight belum di-set (buah fresh).
-- (dulu selalu sm×ratio -> ratio 8.055 ketinggian, 46kg ke-detect 50+.)
function Seed.buahKg(fruit)
    local w = fruit:GetAttribute("Weight")
    if type(w) == "number" and w > 0 then return w end
    local sm = fruit:GetAttribute("SizeMulti") or fruit:GetAttribute("SizeMultiplier")
    if type(sm) == "number" then return sm * (Seed._pkRatio or 8.055) end
    return 0
end

function Seed.pumpkinStats(goalKg)
