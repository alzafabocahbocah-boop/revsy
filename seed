--
-- Bukti lapangan (star_seeddata):
--   SellValueData.<nama>          = nilai jual dasar per buah
--     (Rocket Pop 22500, Mushroom 13000 ... Carrot 5, Strawberry 3)
--   SeedShopEnabled.IsSeedEnabled(nama) = udah rilis apa belum
--     -- ini padanan SpawnChance=0 punya pet
-- Dua-duanya dikirim ke panel, jadi picker bisa nunjukin mana yang berharga
-- dan mana yang belum bisa didapat.
-- ============================================================
Seed._nilaiJual = nil
