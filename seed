            local cell = d.Parent
            while cell and cell ~= root
              and not (cell:IsA("TextButton") or cell:IsA("ImageButton")) do
                cell = cell.Parent
            end
            if cell and cell ~= root and not seen[cell]
              and cell:FindFirstChild("ToolCount", true) then
