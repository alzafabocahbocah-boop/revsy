-- AUTO BALIK GARDEN (v3.96) -- kalau grab selesai (jauh dr garden + gak ada
-- pack), balik ke area garden pakai NYICIL (gak snap). Cek tiap 10s.
-- MATI 1 menit sebelum gold/blood moon mulai (biar gak ganggu grab).
-- NYALA lagi 20s setelah event selesai.
-- ============================================================
-- posisi center garden (PlantArea terdekat / fallback)
function Seed.posisiGarden()
    local hasil = nil
    pcall(function()
        local g = workspace:FindFirstChild("Gardens")
        if not g then return end
        local uid = player.UserId
        local plot = nil
        for _, pl in ipairs(g:GetChildren()) do
            local own = pl:GetAttribute("OwnerUserId")
            local ownNm = pl:GetAttribute("Owner")
            if own == uid or ownNm == player.Name then plot = pl; break end
        end
        if not plot then return end
        local hrp2 = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local petakArr = {}
        for _, o in ipairs(plot:GetDescendants()) do
            if o.Name:find("PlantArea") and o:IsA("BasePart") then petakArr[#petakArr+1] = o end
        end
        if #petakArr > 0 and hrp2 then
            local terdekat, bestD
            for _, pk in ipairs(petakArr) do
                local d = math.abs(hrp2.Position.X - pk.Position.X) + math.abs(hrp2.Position.Z - pk.Position.Z)
                if not bestD or d < bestD then bestD, terdekat = d, pk end
            end
            hasil = Vector3.new(terdekat.Position.X, terdekat.Position.Y + (terdekat.Size.Y/2) + 3, terdekat.Position.Z)
        end
        if not hasil then
            local ref = plot:FindFirstChild("PlotSizeReference") or plot:FindFirstChild("SpawnPoint")
            if ref and ref:IsA("BasePart") then hasil = ref.Position + Vector3.new(0,3,0) end
        end
    end)
    return hasil
end

-- gerak NYICIL ke tujuan (STEP 55, durasi 0.3s, jeda 5s antar segmen) -- gak snap
function Seed.gerakNyicil(tujuan, cekBatal)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local STEP = 55
    for _ = 1, 20 do
        if cekBatal and cekBatal() then return false end
        local kini = root.Position
        local ke = tujuan - kini
        local sisa = ke.Magnitude
        if sisa <= 8 then break end
        local langkah = math.min(STEP, sisa)
        local targetSeg = kini + ke.Unit * langkah
        local awalSeg = root.Position
        local durasi = 0.3
        local t = 0
        while t < durasi do
            if cekBatal and cekBatal() then return false end
            local dt = task.wait()
            t = t + dt
            local a = math.min(t / durasi, 1)
            pcall(function() root.CFrame = CFrame.new(awalSeg:Lerp(targetSeg, a)) end)
        end
        pcall(function() root.CFrame = CFrame.new(targetSeg) end)
        if sisa - langkah > 8 then task.wait(5) end
    end
    return true
end

-- loop auto-balik-garden
task.spawn(function()
    while isCurrentGen() do
        task.wait(10)   -- cek tiap 10s
        local boleh = state.autoBalikGarden
        -- v3.97: SKIP kalau lagi/baru tame pet (<10s dari tame terakhir)
        if boleh and Seed._lagiTame and (os.time() - Seed._lagiTame) < 10 then
            boleh = false
        end
        -- MATI kalau <1 menit sebelum gold/blood moon mulai
        if boleh then
            local moon = Seed.fetchMoonAPI()
            if type(moon) == "table" then
                for key, sisaDetik in pairs(moon) do
                    if (key == "Goldmoon" or key == "Bloodmoon" or key == "Rainbow" or key == "Mega")
                        and sisaDetik <= 60 then
                        boleh = false; break
                    end
                end
            end
        end
        -- cek: ada pack gak (kalau ada, lagi event -> jgn balik)
        local map = workspace:FindFirstChild("Map")
        local folderPack = map and map:FindFirstChild("SeedPackSpawnServerLocations")
        if boleh and folderPack then
            for _, o in ipairs(folderPack:GetDescendants()) do
                if o:IsA("BasePart") and (o:GetAttribute("GoldSeed") or o:GetAttribute("RainbowSeed")
                    or o:GetAttribute("MegaSeed")) and o.Position.Magnitude > 1 then
                    boleh = false; break
                end
            end
        end
        -- gak ada pack + gak deket event -> cek jauh dr garden gak
        if boleh then
            local garden = Seed.posisiGarden()
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if garden and root then
                local jauh = (Vector3.new(garden.X,0,garden.Z) - Vector3.new(root.Position.X,0,root.Position.Z)).Magnitude
                if jauh > 40 then   -- jauh dr garden -> balik NYICIL
                    print(("[StarSeed] Auto balik garden (jauh %.0f stud)"):format(jauh))
                    Seed.gerakNyicil(garden, function()
                        if not state.autoBalikGarden then return true end
                        local m2 = map and map:FindFirstChild("SeedPackSpawnServerLocations")
                        if m2 then
                            for _, o in ipairs(m2:GetDescendants()) do
                                if o:IsA("BasePart") and o:GetAttribute("GoldSeed") then return true end
                            end
                        end
                        return false
                    end)
                end
            end
        end
    end
end)

