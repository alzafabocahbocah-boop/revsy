-- v1.6: KIRIM PET ke akun lain (Mailbox.SendBatch, Category="Pets")
-- Pet di tas = Tool ber-atribut Pet/PetName + PetId. Buah punya Fruit+Id, jadi
-- dibedain lewat situ -- kalau nggak, buah ikut kekirim.
-- Cuma scan BACKPACK: pet yang lagi dipasang gak keikut, jadi aman.
-- ============================================================
Seed.statGiftKirim = 0
Seed._logKirim = ""
Seed._uidCache = {}

local function cariUserId(nama)
    if Seed._uidCache[nama] then return Seed._uidCache[nama] end
    local ok, id = pcall(function()
        return Players:GetUserIdFromNameAsync(nama)
    end)
    if ok and id then Seed._uidCache[nama] = id; return id end
    return nil
end

function Seed.kirimPetSekali()
    local target = state.giftTarget
    if not target or target == "" then Seed._logKirim = "tujuan kosong"; return 0 end
    local sb = pkt("Mailbox", "SendBatch")
    if not sb or not sb.Fire then Seed._logKirim = "packet SendBatch gak ada"; return 0 end

    local uid = cariUserId(target)
    if not uid then Seed._logKirim = "akun '" .. target .. "' gak ketemu"; return 0 end

    local batch, total = {}, 0
    local function lepas()
        if #batch > 0 then
            local isi = batch; batch = {}
            pcall(function() sb:Fire(uid, isi, "") end)
            total = total + #isi
            task.wait(0.5)
        end
    end

    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local nama = t:GetAttribute("Pet") or t:GetAttribute("PetName") or t:GetAttribute("PetType")
                local pid  = t:GetAttribute("PetId") or t:GetAttribute("Id")
                local buah = t:GetAttribute("Fruit") or t:GetAttribute("FruitName")
                if pid and nama and not buah then
                    batch[#batch+1] = { ItemKey = tostring(pid), Count = 1, Category = "Pets" }
                    if #batch >= 8 then lepas() end
                end
            end
        end
    end
    lepas()

    if total > 0 then
        Seed.statGiftKirim = Seed.statGiftKirim + total
        Seed._logKirim = total .. " pet dikirim"
        print("[StarSeed] kirim " .. total .. " pet ke " .. target)
    else
        Seed._logKirim = "gak ada pet di tas"
    end
    return total
end

