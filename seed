    -- ikut sinyal server juga: Mailbox.Updated nembak pas ada gift baru
    pcall(function()
        local up = pkt("Mailbox", "Updated")
        if up and up.OnClientEvent then
            up.OnClientEvent:Connect(function(...)
                Seed._mailKotor = true
                -- v3.11: argumennya DITANGKEP, bukan dibuang. Dulu cuma nyetel
                -- penanda -- padahal di sini kemungkinan ada rincian barangnya.
                pcall(catatMail, "Updated", ...)
            end)
        end
    end)

    -- v3.11: event klaim -- ini yang paling mungkin bawa nama barang
    pcall(function()
        for _, nm in ipairs({ "ClaimAllProgress", "ClaimAllFinished" }) do
            local p = pkt("Mailbox", nm)
            if p and p.OnClientEvent then
                p.OnClientEvent:Connect(function(...)
