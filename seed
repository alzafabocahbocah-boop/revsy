-- Tanpa ini, tiap re-execute nambah satu set loop baru yang jalan barengan
-- (di script farm ini pernah bikin lag & data nyesatin).
local genv = getgenv and getgenv() or _G
genv.StarSeedGen = (genv.StarSeedGen or 0) + 1
local MY_GEN = genv.StarSeedGen
local function isCurrentGen() return genv.StarSeedGen == MY_GEN end

local Seed = {}
genv.StarSeed = Seed

-- v3.24: STREAMING nyala di game ini -> objek jauh (pet liar, dll) gak ke-load
