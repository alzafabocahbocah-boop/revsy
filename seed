function Seed.ringkasFilterPet()
    if state.petSemua then return "SEMUA jenis" end
    local t = {}
    for k in pairs(state.petPilih or {}) do t[#t+1] = k end
    table.sort(t)
    if #t == 0 then return "(kosong -- gak ada yang diburu)" end
    if #t <= 4 then return table.concat(t, ", ") end
    return table.concat({t[1], t[2], t[3]}, ", ") .. " +" .. (#t - 3)
end

function Seed.tarikCfgPanel()
    if not (state.ikutPanel and panelAktif()) then return end
    local r = panelReq("/seed-cfg?akun=" .. player.Name, "GET")
    local body = r and (r.Body or r.body)
    if not body then
        Seed._cfgLog = "GAGAL: panel gak jawab"
        if not Seed._cfgWarn then Seed._cfgWarn = true
            warn("[StarSeed] setelan panel GAK KEBACA: panel gak jawab") end
        return
    end

    local ok, d = pcall(function() return HS:JSONDecode(body) end)
    if not ok or type(d) ~= "table" then
        Seed._cfgLog = "GAGAL: jawaban gak kebaca"
        return
    end
    -- v3.1: kalau backend belum di-deploy, CF balikin {"error":"jalur gak
    -- dikenal: /seed-cfg"}. Dulu ini diem-diem dianggap "gak ada perubahan"
    -- -- makanya setelan panel keliatan diabaikan tanpa ada tanda apa pun.
    if type(d.error) == "string" then
        Seed._cfgLog = "GAGAL: " .. d.error
        if not Seed._cfgWarn then
            Seed._cfgWarn = true
            warn("[StarSeed] SETELAN PANEL GAK KEPAKAI -> " .. d.error)
            warn("[StarSeed] Backend Cloudflare kemungkinan belum di-deploy.")
            warn("[StarSeed] Sementara ini script pakai setelan LOKAL (GUI).")
        end
        return
    end
    if type(d.cfg) ~= "table" then
        Seed._cfgLog = "GAGAL: jawaban tanpa cfg"
        return
    end
    local c = d.cfg
    local ubah = {}

    for _, k in ipairs(BOOL_PANEL) do
        if type(c[k]) == "boolean" and state[k] ~= c[k] then
            state[k] = c[k]; ubah[#ubah+1] = k .. "=" .. tostring(c[k])
        end
    end
    for _, k in ipairs(NUM_PANEL) do
        local n = tonumber(c[k])
        if n and state[k] ~= n then state[k] = n; ubah[#ubah+1] = k .. "=" .. n end
    end
    -- v3.2: field TEKS dari panel. Dulu cuma giftTarget yang ditangani; minRarity
    -- kelewat, jadi "Ikut samber seed bagus" bisa dinyalain dari panel tapi
    -- ambangnya gak bisa diubah -- nyangkut di nilai lokal.
    if type(c.giftTarget) == "string" and state.giftTarget ~= c.giftTarget then
        state.giftTarget = c.giftTarget
        Seed._uidCache = {}          -- tujuan ganti -> cache id lama gak berlaku
        ubah[#ubah+1] = "giftTarget=" .. c.giftTarget
    end
    if type(c.minRarity) == "string" and c.minRarity ~= "" then
        -- cuma terima yang beneran ada di daftar rarity, biar gak nyetel ke
        -- nilai ngawur yang bikin saringan diam-diam gak pernah kena
        local sah = false
        for _, r in ipairs(RARITY_ORDER) do
            if r:lower() == c.minRarity:lower() then
                if state.minRarity ~= r then
                    state.minRarity = r
                    ubah[#ubah+1] = "minRarity=" .. r
                end
                sah = true
                break
            end
        end
        if not sah then
            Seed._cfgLog = "minRarity '" .. c.minRarity .. "' gak dikenal"
        end
    end
    -- daftar jenis: dikirim panel sebagai array nama
    if type(c.seedPilih) == "table" then
        local baru = {}
        for _, nm in ipairs(c.seedPilih) do if type(nm) == "string" then baru[nm] = true end end
        state.seedPilih = baru; ubah[#ubah+1] = "seedPilih(" .. #c.seedPilih .. ")"
    end
    if type(c.petPilih) == "table" then
        local baru = {}
        for _, nm in ipairs(c.petPilih) do if type(nm) == "string" then baru[nm] = true end end
        state.petPilih = baru; ubah[#ubah+1] = "petPilih(" .. #c.petPilih .. ")"
    end

    if #ubah > 0 then
        simpan()
        if Seed._segarkanGUI then pcall(Seed._segarkanGUI) end
        Seed._cfgLog = "dari panel: " .. table.concat(ubah, ", ")
        print("[StarSeed] setelan panel: " .. table.concat(ubah, ", "))
    else
        Seed._cfgLog = "sinkron"
    end
    Seed._cfgTs = os.time()
end

