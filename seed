-- AUTO-SKIP TUTORIAL GAG 2 (v3.14)
-- Akun baru masuk GAG 2 nyangkut tutorial (beli->tanam->sell) -> beli seed
-- gak jalan. Fix: fire Networking.Tutorial.Complete -> server tandai tutorial
-- selesai (TutorialCompleted false->true), gate kebuka. Ketemu dari decompile
-- TutorialRunner + module Networking. Cuma fire kalau masih false (gak spam).
-- ============================================================
task.spawn(function()
    -- v4.43: retry TERUS tiap 1 menit (bukan cuma 5x di awal). Bug user: tutorial
    -- "kadang nyangkut" -- sebab: dulu cuma 5x percobaan (5 detik total), kalau
    -- akun masuk lambat/lag/remote belum ready, 5 detik gak cukup -> nyerah ->
    -- nyangkut. Sekarang: cek tiap 1 menit sampai TutorialCompleted true, gak nyerah.
    -- Percobaan awal cepet (tiap 1s, 5x) biar akun normal langsung skip.
    local awal = 0
    while isCurrentGen() do
        if state.skipTutorialOn then
            if player:GetAttribute("TutorialCompleted") == true then
                -- udah selesai -> diem (cek lagi tiap 1 menit kalau-kalau reset)
            else
                pcall(function()
                    local C = pkt("Tutorial", "Complete")
                    if C then C:Fire() end
                end)
                awal = awal + 1
                print("[StarSeed] skip tutorial dikirim (#" .. awal .. ")")
                -- cek berhasil abis sebentar
                task.wait(2)
                if player:GetAttribute("TutorialCompleted") == true then
                    print("[StarSeed] tutorial selesai (skip berhasil)")
                end
            end
        end
        -- 5 percobaan pertama cepet (tiap 1s), sesudah itu tiap 1 menit
        if awal < 5 then task.wait(1) else task.wait(60) end
    end
end)

