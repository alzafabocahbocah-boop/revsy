function Seed.bukaMailbox()
    -- lagi kebuka? jangan disenggol (toggle -> malah nutup)
    local kebuka = false
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local mb = pg and pg:FindFirstChild("MailboxUI")
        if not mb then return end
        local sgui = mb:IsA("ScreenGui") and mb or mb:FindFirstAncestorOfClass("ScreenGui")
        if sgui and sgui.Enabled == false then return end
        local f = mb:FindFirstChild("Frame")
        if f and f:IsA("GuiObject") and f.Visible then kebuka = true end
    end)
    if kebuka then return end
    for _, nm in ipairs({ "OpenInbox", "Open", "List", "GetInbox", "Inbox" }) do
        local op = pkt("Mailbox", nm)
        if op and op.Fire then pcall(function() op:Fire() end) end
    end
