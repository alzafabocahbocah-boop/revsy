local RARITY_RANK  = { Common=1, Uncommon=2, Rare=3, Epic=4, Legendary=5, Mythic=6, Super=7, Divine=7, Prismatic=8 }
local RARITY_ORDER = { "Super", "Mythic", "Legendary", "Epic", "Rare", "Uncommon", "Common" }

local function bacaSeedData()
    local sm = RS:FindFirstChild("SharedModules")
    local sd = sm and sm:FindFirstChild("SeedData")
    if not sd then return nil end
    local ok, mod = pcall(require, sd)
    if not ok or type(mod) ~= "table" then return nil end
    if type(mod.Seeds) == "table" then return mod.Seeds end
    return mod
end

-- v1.2: daftar seed digabung dari TIGA sumber. Pakai SeedData doang bikin
-- daftarnya bolong -- seed yang dijual di toko tapi belum masuk SeedData
-- (biasanya seed baru / event) jadi gak keliatan & gak kebeli.
--   1) StockValues.SeedShop.Items  -- APA YANG BENERAN DIJUAL sekarang. Paling
--      penting: seed baru muncul di sini duluan, sebelum modul lain nyusul.
--   2) SharedModules.SeedData      -- katalog resmi (bawa rarity juga)
--   3) RemoteDeveloperProducts     -- entri "Seed:<Nama>:<qty>", nangkep yang
--      belum nongol di dua sumber di atas
local function muatDaftarSeed()
    local seen, list = {}, {}
    local function tambah(nm)
        if type(nm) == "string" and nm ~= "" and not seen[nm] then
            seen[nm] = true; list[#list+1] = nm
        end
    end

    -- 1) stok toko (paling akurat buat "apa yang bisa dibeli")
    pcall(function()
        local sv = RS:FindFirstChild("StockValues")
        local shop = sv and sv:FindFirstChild("SeedShop")
        local items = shop and shop:FindFirstChild("Items")
        if items then
            for _, it in ipairs(items:GetChildren()) do tambah(it.Name) end
        end
    end)

    -- 2) katalog SeedData
    -- v1.9 FIX: cuma ambil entri yang isinya TABEL (data seed beneran).
    -- Di game asli SeedData isinya FUNGSI (GetSeed, Validate, dst) -- kalau
    -- ikut diambil, nama fungsi itu masuk daftar seed, dianggap "seed baru",
    -- terus ditembak beli. Kekonfirmasi dari star_debug.
    pcall(function()
        local src = bacaSeedData()
        if not src then return end
        for k, v in pairs(src) do
            if type(v) == "table" then
                if type(k) == "string" and not k:match("^_") then tambah(k) end
                tambah(v.SeedName or v.Name)
            end
        end
    end)

    -- 3) RemoteDeveloperProducts -- format entri: "Seed:<Nama>:<qty>"
    pcall(function()
        local raw = workspace:GetAttribute("RemoteDeveloperProducts")
        if type(raw) == "string" then
            for nama in raw:gmatch('"Seed:([^:"]+):') do tambah(nama) end
        end
    end)

    -- 4) RS.Assets.Seeds -- v2.4: ternyata INI yang paling lengkap (72 jenis,
    -- vs 64 di stok toko). Seed yang modelnya udah ada tapi belum dijual
    -- nongol di sini duluan (Buttercup, Lotus, Pumpkin, Thorn Rose, dst).
    pcall(function()
        local as = RS:FindFirstChild("Assets")
        local sdd = as and as:FindFirstChild("Seeds")
        if not sdd then return end
        for _, c in ipairs(sdd:GetChildren()) do tambah(c.Name) end
    end)

    if #list == 0 then
        -- cadangan terakhir kalau semua sumber buntu
        list = {"Acorn","Apple","Baby Cactus","Bamboo","Banana","Blueberry","Briar Rose","Cactus","Carrot",
            "Cherry","Coconut","Corn","Dragon Fruit","Dragon's Breath","Ghost Pepper","Glow Mushroom",
            "Gold","Grape","Green Bean","Horned Melon","Hypno Bloom","Mango","Mega","Moon Bloom","Mushroom",
            "Pineapple","Poison Apple","Poison Ivy","Pomegranate","Rainbow","Romanesco","Strawberry",
            "Sunflower","Tomato","Tulip","Venom Spitter","Venus Fly Trap"}
        for _, n in ipairs(list) do seen[n] = true end
    end
    table.sort(list)
    return list
end

local function muatRarity()
    local map = {}
    pcall(function()
        local src = bacaSeedData()
        if not src then return end
        for k, v in pairs(src) do
            if type(v) == "table" then
                local nm = (type(k) == "string" and k) or v.SeedName or v.Name
                if type(nm) == "string" and type(v.Rarity) == "string" then map[nm] = v.Rarity end
            end
        end
    end)
    return map
end

Seed.daftar = nil
Seed._rarity = nil
function Seed.rarity(nama)
    if not Seed._rarity then Seed._rarity = muatRarity() end
    return Seed._rarity[nama]
end
function Seed.rank(nama)
    local r = Seed.rarity(nama)
    return (r and RARITY_RANK[r]) or 0
end

