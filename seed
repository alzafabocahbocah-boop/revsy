local function parseAngka(s)
    s = tostring(s):upper():gsub(" ", "")
    local num = tonumber((s:gsub("[BMKT]", "")))
    if not num then return nil end
    if s:find("T") then return num * 1e12
    elseif s:find("B") then return num * 1e9
    elseif s:find("M") then return num * 1e6
    elseif s:find("K") then return num * 1e3
    else return num end
end
