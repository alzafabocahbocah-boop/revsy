-- v4.67: GERAK HALUS (lerp, anti-snap) -- TP instant ke-snap server (karakter
-- gak beneran nyampe -> placement ditolak). Kayak grabSeed. Gak balik ke asal.
function Seed.gerakHalus(target, tol)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    tol = tol or 15
    local STEP = 55
    for _ = 1, 20 do
        if not isCurrentGen() then break end
        local kini = root.Position
        local ke = target - kini
        local sisa = ke.Magnitude
        if sisa <= tol then break end
        local d = math.min(STEP, sisa)
        local seg = kini + ke.Unit * d
        local awal = root.Position
        local t = 0
        while t < 0.3 do
            local dt = task.wait()
            t = t + dt
            pcall(function() root.CFrame = CFrame.new(awal:Lerp(seg, math.min(t / 0.3, 1))) end)
        end
        pcall(function() root.CFrame = CFrame.new(seg) end)
        if sisa - d > tol then task.wait(1.2) end   -- jeda anti-snap
    end
end

