-- v2.8: gak kepakai lagi (jalur packet dicabut). Ditinggal buat jaga-jaga
-- kalau nanti ketemu cara BACA yang gak nimpa apa-apa.
local function methodPacket(p)
    local ada = {}
    -- method bisa nempel langsung, atau di metatable.__index
    pcall(function()
        for k, v in pairs(p) do if type(v) == "function" then ada[k] = true end end
        local mt = getmetatable(p)
        if type(mt) == "table" and type(mt.__index) == "table" then
            for k, v in pairs(mt.__index) do if type(v) == "function" then ada[k] = true end end
        end
    end)
    return ada
end

local function petikDariTabel(t, dalam)
    -- ambil field yang keliatan kayak info event, apa pun namanya
    local hasil = {}
    if type(t) ~= "table" or (dalam or 0) > 2 then return hasil end
    for k, v in pairs(t) do
        local kl = tostring(k):lower()
        if type(v) == "string" and #v > 0 and #v < 120 then
            if kl:find("name") or kl:find("title") or kl:find("nama") then hasil.nama = v
            elseif kl:find("desc") or kl:find("tag") then hasil.tag = hasil.tag or v end
        elseif type(v) == "number" then
            if kl:find("end") or kl:find("expire") or kl:find("akhir") then hasil.berakhir = v
            elseif kl:find("rank") or kl:find("place") then hasil.peringkat = v
            elseif kl:find("score") or kl:find("skor") then hasil.skor = v end
        elseif type(v) == "table" then
            local dalam2 = petikDariTabel(v, (dalam or 0) + 1)
            for k2, v2 in pairs(dalam2) do if hasil[k2] == nil then hasil[k2] = v2 end end
        end
    end
    return hasil
end

-- v2.6 FIX: API packet-nya akhirnya ketauan dari metatable:
--   Deserialize, Fire, FireAllClients, FireClient, Response, Serialize
-- Polanya BUKAN "panggil lalu dapet balasan". Yang bener:
--   1. daftarin handler lewat p:Response(fn)   <- ini yang v2.5 kelewat
--   2. baru p:Fire()  buat ngirim permintaan
--   3. tunggu handler-nya kepanggil (ResponseTimeout di game = 10 detik)
-- v2.5 manggil p:Response() TANPA argumen -> handler kosong -> gak pernah
-- ada yang nangkep jawabannya.
-- ============================================================
-- v2.8: JALUR PACKET DICABUT
--
-- Percobaan v2.6/v2.7 manggil p:Response(handler) buat nangkep jawaban
-- Guild.GetCompetition. Server gak pernah jawab -- DAN ada efek samping yang
-- kekonfirmasi dari dua dump berturut-turut:
--     sebelum dipanggil : ResponseWrites 1=function  ResponseReads 1=function
--     sesudah dipanggil : ResponseWrites (kosong)    ResponseReads (kosong)
-- Handler bawaan GAME-nya ketimpa. Artinya Response() itu MENDAFTARKAN
-- (nulis), bukan mendengarkan (baca) -- dan panel guild game bisa berhenti
-- keupdate gara-gara itu.
--
-- Jadi jalur packet DICABUT sepenuhnya. Bacanya lewat panel aja: lebih
-- lambat, tapi gak nyentuh apa pun milik game.
-- ============================================================
local function eventDariPacket()
    return nil, "jalur packet dicabut (Response() nimpa handler game)"
end

local function eventDariPanel()
    local pg = player:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    local sgui = pg:FindFirstChild("ViewGuildProgress")
    if not sgui then return nil end

    local baris = {}
    pcall(function()
        for _, d in ipairs(sgui:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = tostring(d.Text or ""):gsub("<[^>]->", "")
                    :gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                if t ~= "" and #t < 140 then baris[#baris+1] = t end
            end
        end
    end)
    if #baris == 0 then return nil end

    -- v2.7 FIX: panel nyimpen teks event LAMA juga (minggu lalu belum kehapus).
    -- v2.6 ngambil nama pertama yang masuk akal -> ke-ambil yang LAMA.
    -- Bukti: panel isinya "Carrot Frenzy ... Tallest Plant / Ends in 5h 11m" --
    -- yang aktif itu Tallest Plant, bukan Carrot Frenzy.
    -- Patokan yang bener: nama event = teks TEPAT SEBELUM "Ends in".
    local hasil = { sumber = "panel" }
    local iEnds
    for i, t in ipairs(baris) do
        local j, m = t:match("[Ee]nds in (%d+)h (%d+)m")
        if j then
            hasil.sisaDetik = tonumber(j) * 3600 + tonumber(m) * 60
            iEnds = i
            break
        end
        local mm = t:match("^[Ee]nds in (%d+)m")
        if mm then hasil.sisaDetik = tonumber(mm) * 60; iEnds = i break end
    end

    local function layakNama(t)
        if not t or #t < 4 or #t > 60 then return false end
        if t:match("^[Xx]$") then return false end
        local l = t:lower()
        if l:find("how to earn") or l:find("reward") or l:find("ends in")
           or l:find("bracket") or l:find("placement") or l:match("^#") then
            return false
        end
        return true
    end

    if iEnds then
        -- mundur dari "Ends in" sampai ketemu teks yang layak jadi nama
        for i = iEnds - 1, 1, -1 do
            if layakNama(baris[i]) then hasil.nama = baris[i] break end
        end
    end
    -- cadangan: kalau gak ada "Ends in" sama sekali, pakai yang pertama layak
    if not hasil.nama then
        for _, t in ipairs(baris) do
            if layakNama(t) then hasil.nama = t break end
        end
    end

    for _, t in ipairs(baris) do
        if t:lower():find("contest over") then hasil.selesai = true end
    end
    return hasil.nama and hasil or nil
end

function Seed.bacaEventGuild()
