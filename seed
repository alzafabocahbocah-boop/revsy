                        lbl.Position = UDim2.new(0, 0, 0, 1)
                        lbl.BackgroundTransparency = 1
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 12
                        lbl.TextStrokeTransparency = 0.4
                        lbl.ZIndex = 20
                        lbl.Parent = cell
                    end
                    -- warna ikut freshness: putih fresh, kuning mulai basi, merah basi
                    local col = Color3.fromRGB(245, 245, 245)
                    if decay > 0.5 then col = Color3.fromRGB(235, 90, 90)
                    elseif decay > 0.25 then col = Color3.fromRGB(245, 210, 70) end
                    lbl.TextColor3 = col
                    lbl.Text = singkatHarga(harga)
                elseif lbl then
                    lbl:Destroy()
                end
            end
            task.wait(15)   -- refresh tiap 15s
        end
        espInvBersih()
    end)
