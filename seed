-- v3.30: AUTO TELE ke fall world. Kalau akun nyasar di GAG 2 BIASA (world 1),
-- PlaceId-nya BEDA dari fall world (129343810645058). Deteksi: PlaceId sekarang
-- != target -> TeleportService:Teleport ke fall world. Cegah spam: cuma TP
-- sekali per 60 detik (TP butuh waktu, loading). Default MATI.
Seed._teleTerakhir = 0
Seed._logTele = ""
function Seed.cekTele()
    if not state.autoTele then return end
    local target = tonumber(state.telePlaceId) or 129343810645058
    local skrg = tonumber(game.PlaceId) or 0
    -- udah di fall world -> gak perlu TP
    if skrg == target then Seed._logTele = "udah di fall world"; return end
    if skrg == 0 then return end   -- PlaceId belum kebaca
    -- cegah spam: 1 TP per 60 detik (TP + loading butuh waktu)
    local now = os.time()
    if (now - Seed._teleTerakhir) < 60 then return end
    Seed._teleTerakhir = now
    Seed._logTele = ("nyasar di place %d -> TP ke fall world"):format(skrg)
    print("[StarSeed] " .. Seed._logTele)
    pcall(function()
        local TS = game:GetService("TeleportService")
        TS:Teleport(target, player)
    end)
end
task.spawn(function()
    task.wait(15)   -- kasih waktu game kebaca dulu (PlaceId)
    while isCurrentGen() do
        if state.autoTele then pcall(Seed.cekTele) end
        task.wait(20)
    end
end)

