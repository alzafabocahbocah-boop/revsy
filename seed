local function gambarDaftarSeed()
    for _, b in pairs(barisSeed) do b:Destroy() end
    barisSeed = {}
    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    for i, nama in ipairs(Seed.daftar) do
        local rar = Seed.rarity(nama) or "?"
        local b = mk("TextButton", { Parent = gulir, LayoutOrder = i,
            Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = WARNA.bg,
            BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextSize = 19,
            TextColor3 = state.seedPilih[nama] and WARNA.aksen or WARNA.redup,
            TextXAlignment = Enum.TextXAlignment.Left, Text = "  " .. nama })
        mk("UICorner", { CornerRadius = UDim.new(0, 5), Parent = b })
        mk("TextLabel", { Parent = b, BackgroundTransparency = 1,
            Position = UDim2.new(1, -74, 0, 0), Size = UDim2.new(0, 70, 1, 0),
            Font = Enum.Font.GothamMedium, TextSize = 19, TextColor3 = WARNA.samar,
            TextXAlignment = Enum.TextXAlignment.Right, Text = rar .. "  " })
        b.MouseButton1Click:Connect(function()
            state.seedPilih[nama] = (not state.seedPilih[nama]) or nil
            b.TextColor3 = state.seedPilih[nama] and WARNA.aksen or WARNA.redup
