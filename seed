function Seed.trowelOnce()
    if not state.autoTrowel then return 0 end
    local p = pkt("Trowel", "MovePlant")
    if not (p and p.Fire) then Seed._logTrowel = "remote Trowel.MovePlant gak ada"; return 0 end
    -- v4.80: target = PETAK DEFAULT (hardcode -- selalu ke sini)
    local target = Vector3.new(426.5, 143.7, -163.2)
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return 0 end
    -- v4.80: kumpulin plant yg BELUM di target (>3 stud). kalau kosong -> udah numpuk
    -- semua -> gak ngapa2in (char diem, gak trowel ulang).
    local perlu = {}
    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                if tonumber(plant.Name:match("^(%d+)_")) == player.UserId then
                    local sn = plant:GetAttribute("SeedName") or "?"
                    if Seed.trowelBoleh(sn) then
                        local pos
                        pcall(function()
                            if plant:IsA("Model") and plant.PrimaryPart then pos = plant.PrimaryPart.Position
                            else pos = plant:GetPivot().Position end
                        end)
                        if pos then
                            local flat = Vector3.new(target.X, pos.Y, target.Z)
                            if (flat - pos).Magnitude > 9 then perlu[#perlu+1] = plant end
                        end
                    end
                end
            end
        end
    end
    if #perlu == 0 then return 0 end   -- semua udah di petak -> diem
    -- v4.92: cap 60 per loop -- kalau 400+ tanaman, fire semua sekaligus kelamaan.
    -- sisanya loop berikutnya (4s lagi).
    if #perlu > 60 then
        local potong = {}
        for i = 1, 60 do potong[i] = perlu[i] end
        perlu = potong
    end
    -- equip trowel
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local tool
    for _, h in ipairs({ char, player:FindFirstChildOfClass("Backpack") }) do
        if h then
            for _, t in ipairs(h:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("trowel") then tool = t; break end
            end
        end
        if tool then break end
    end
    if not tool then Seed._logTrowel = "Trowel gak ada di tas"; return 0 end
    if tool.Parent ~= char and hum then pcall(function() hum:EquipTool(tool) end); task.wait(0.15) end
    -- v4.95: char WAJIB deket target biar MovePlant keterima (terbukti: char 4 stud
    -- -> tanaman 120 stud nyampe; char jauh -> ketolak). Gerak SEKALI ke petak (bukan
    -- mondar-mandir per tanaman), terus fire semua yg nyebar dari sini.
    if hrp then
        local dChar = (Vector3.new(target.X, hrp.Position.Y, target.Z) - hrp.Position).Magnitude
        if dChar > 5 then
            if Seed.gerakHalus then
                pcall(function() Seed.gerakHalus(Vector3.new(target.X, target.Y + 3, target.Z), 4) end)
            else
                pcall(function() hrp.CFrame = CFrame.new(target.X, target.Y + 3, target.Z) end)
                task.wait(0.3)
            end
            if tool.Parent ~= char and hum then pcall(function() hum:EquipTool(tool) end); task.wait(0.1) end
        end
    end
    -- fire tiap plant yg belum di target -- RETRY sampe 4x (kadang ketolak server)
    local moved = 0
    for _, plant in ipairs(perlu) do
        if not (state.autoTrowel and isCurrentGen()) then break end
        local pos
        pcall(function()
            if plant:IsA("Model") and plant.PrimaryPart then pos = plant.PrimaryPart.Position
            else pos = plant:GetPivot().Position end
        end)
        if pos then
            local rot = 0
            pcall(function() local _, ry = plant:GetPivot():ToOrientation(); rot = ry end)
            local sampai = false
            for _ = 1, 4 do   -- retry
                if not (state.autoTrowel and isCurrentGen()) then break end
                if tool.Parent ~= char and hum then pcall(function() hum:EquipTool(tool) end); task.wait(0.05) end
                pcall(function() p:Fire(plant.Name, Vector3.new(target.X, target.Y, target.Z), rot) end)
                task.wait(0.2)
                local pos2
                pcall(function()
                    if plant:IsA("Model") and plant.PrimaryPart then pos2 = plant.PrimaryPart.Position
                    else pos2 = plant:GetPivot().Position end
                end)
                if pos2 then
                    local flat = Vector3.new(target.X, pos2.Y, target.Z)
                    if (flat - pos2).Magnitude <= 9 then sampai = true; break end   -- udah nyampe petak (snap ~7 stud)
                    if (pos2 - pos).Magnitude > 1 then pos = pos2 end   -- gerak dikit, lanjut (step-wise)
                end
            end
            if sampai then moved = moved + 1 end
        end
    end
    if moved > 0 then Seed._logTrowel = moved .. " seed ke petak (sisa " .. (#perlu - moved) .. ")" end
    return moved
end

