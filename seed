-- v4.59: RUMUS BERAT PUMPKIN (dari gag2 ref -- LINEAR, bukan pangkat!)
--   kg = SizeMulti * rasio.  rasio Atlantic Giant Pumpkin = 8.055 (kalibrasi
--   13.78=111kg). Auto-kalibrasi dari buah PANEN di tas (Weight/SizeMulti) biar
--   presisi -- sekali panen 1 pumpkin, rasio ke-set exact.
-- ============================================================
Seed._pkRatio = 8.055
Seed._pkRerollTotal = 0   -- v4.76: kumulatif buah di-reroll
function Seed.kalibrasiPkRatio()
    pcall(function()
        for _, h in ipairs({ player.Character, player:FindFirstChildOfClass("Backpack") }) do
            if h then
                for _, t in ipairs(h:GetChildren()) do
                    if t:IsA("Tool") then
                        local nm = (t:GetAttribute("CorePartName") or t.Name or ""):lower()
                        if nm:find("pumpkin") then
                            local w = t:GetAttribute("Weight")
                            local sm = t:GetAttribute("SizeMulti") or t:GetAttribute("SizeMultiplier")
                            if type(w) == "number" and type(sm) == "number" and sm > 0 then
                                Seed._pkRatio = w / sm   -- rasio exact dari buah asli
                                return
                            end
                        end
                    end
                end
            end
        end
    end)
end

