-- ============================================================
-- v2.2: HARGA DASAR DARI DATA GAME (SharedData.PetData)
--
-- Bukti lapangan (star_petdata di fifinx_1):
--   PetData.Owl.BasePrice   = 25000   <-> pet liar Owl   Price=25000
--   PetData.Bunny.BasePrice = 20000   <-> pet liar Bunny Price=20000
--   PetData.Frog.BasePrice  = 10000   <-> pet liar Frog  Price=10000
-- Cocok persis. Jadi harga dasar GAK PERLU dipelajari lagi -- tinggal dibaca.
--
-- Catatan: dulu gua nyari di SharedModules.PetModules (isinya perilaku:
-- WanderSpeed, PerchDuration, dst). Yang bener SharedData.PetData.
-- ============================================================
local FIELD_HARGA = { "BasePrice", "Price", "Cost", "TamePrice" }

local function bacaPetData()
    local sd = RS:FindFirstChild("SharedData")
    local m = sd and sd:FindFirstChild("PetData")
    if not m then return nil end
    local ok, mod = pcall(require, m)
    if ok and type(mod) == "table" then return mod end
    return nil
end

local function bacaPetModules()
    local sm = RS:FindFirstChild("SharedModules")
    local pm = sm and sm:FindFirstChild("PetModules")
    if not pm then return nil end
    local ok, mod = pcall(require, pm)
    if ok and type(mod) == "table" then return mod end
    return nil
end

Seed._petData = nil
Seed._petHargaGame = nil
Seed._petRarity = nil
Seed._petPeta = nil   -- nama disamakan (tanpa spasi/kapital) -> kunci asli

-- v2.2: game nulis kunci "BlackDragon" tapi DisplayName-nya "Black Dragon",
-- dan pet liar bisa muncul dengan dua-duanya. Jadi semua pencarian lewat peta
-- yang udah diseragamin. Tanpa ini, "Black Dragon" gak bakal nemu harganya.
local function ratakan(s) return tostring(s or ""):lower():gsub("[%s_%-]", "") end

-- harga dasar dari modul game. nil = gak ketemu (baru pakai cara belajar)
function Seed.hargaDasarGame(nama)
    if Seed._petHargaGame == nil then
        Seed._petHargaGame, Seed._petRarity, Seed._petPeta = {}, {}, {}
        pcall(function()
            local mod = bacaPetData()
            if not mod then return end
            Seed._petData = mod
            local fn = type(mod.GetBasePrice) == "function" and mod.GetBasePrice or nil
            for k, v in pairs(mod) do
                if type(k) == "string" and type(v) == "table" then
                    Seed._petPeta[ratakan(k)] = k
                    -- DisplayName juga didaftarin ("Black Dragon" -> BlackDragon)
                    if type(v.DisplayName) == "string" then
                        Seed._petPeta[ratakan(v.DisplayName)] = k
                    end
                    for _, f in ipairs(FIELD_HARGA) do
                        local n = tonumber(v[f])
                        if n and n > 0 then Seed._petHargaGame[k] = n break end
                    end
                    if type(v.Rarity) == "string" then Seed._petRarity[k] = v.Rarity end
                end
            end
            if fn then
                for k in pairs(Seed._petRarity) do
                    if not Seed._petHargaGame[k] then
                        local ok2, h = pcall(fn, k)
                        if ok2 and tonumber(h) then Seed._petHargaGame[k] = tonumber(h) end
                    end
                end
            end
        end)
    end
    if not nama then return nil end
    local kunci = Seed._petPeta[ratakan(nama)]
    return Seed._petHargaGame[kunci or nama]
end

function Seed.rarityPet(nama)
    if Seed._petRarity == nil then Seed.hargaDasarGame("_muat_") end
    if not Seed._petRarity then return nil end
    local kunci = Seed._petPeta and Seed._petPeta[ratakan(nama)]
    return Seed._petRarity[kunci or nama]
end

-- ============================================================
-- v2.1: MUTASI DIBACA DARI NAMA
--
-- Bukti lapangan: hadiah guild nampilin "Mega Rainbow Black Dragon" -- mutasi
-- ditulis sebagai AWALAN NAMA, bukan atribut terpisah. Itu jauh lebih andal
-- daripada ngukur ukuran model (yang butuh model-nya ke-render dulu DAN butuh
-- pembanding ukuran terkecil yang harus dipelajari duluan).
--
-- Catatan istilah: data game (PetModules) nyebut "Huge", tampilan game nyebut
-- "Mega". Dua-duanya dianggap sama = tier paling gede.
-- ============================================================
local KATA_MUTASI = {
    Rainbow = { "rainbow" },
    Mega    = { "mega", "huge" },
    Big     = { "big", "giant" },
    Golden  = { "golden" },
    Shiny   = { "shiny" },
}

-- balik: {Mega=true, Rainbow=true}, dan nama pet tanpa awalan mutasi
function Seed.mutasiDariNama(nama)
    local hasil = {}
    if type(nama) ~= "string" or nama == "" then return hasil, nama end
    local rendah = " " .. nama:lower() .. " "
    for mut, kata in pairs(KATA_MUTASI) do
        for _, k in ipairs(kata) do
            -- kata UTUH, biar "big" gak kena di tengah kata lain
            if rendah:find("%f[%w]" .. k .. "%f[%W]") then hasil[mut] = true break end
        end
    end
    -- buang awalan mutasi buat dapet nama dasarnya
    local dasar = nama
    local lagi = true
    while lagi do
        lagi = false
        for _, kata in pairs(KATA_MUTASI) do
            for _, k in ipairs(kata) do
                local pola = "^" .. k .. "%s+"
                if dasar:lower():find(pola) then
                    dasar = dasar:sub(#k + 1):gsub("^%s+", "")
                    lagi = true
                end
            end
        end
    end
    return hasil, dasar
end

-- ===== MUTASI / UKURAN PET =====
-- Big & Mega gak disimpen sebagai atribut -- bedanya di UKURAN MODEL. Jadi
-- diukur: model pet ada di workspace.Map.WildPetSpawns, dibandingin sama
-- ukuran terkecil yang pernah keliat buat jenis itu.
Seed._petUkuranDasar = {}

function Seed.tierPet(uuid, nama)
    if not nama then return "Normal", 1 end

    -- v2.1: NAMA DULUAN. Kalau mutasi udah ketulis di nama, gak usah repot
    -- ngukur model -- itu sumber yang pasti, bukan perkiraan.
    local mut = Seed.mutasiDariNama(nama)
    if mut.Mega then return "Mega", 3 end
    if mut.Big then return "Big", 1.5 end

    -- cadangan: ukur model (buat pet yang mutasinya gak ketulis di nama)
    local map = workspace:FindFirstChild("Map")
    local spawns = map and map:FindFirstChild("WildPetSpawns")
    if not spawns then return "Normal", 1 end
    local model
    for _, m in ipairs(spawns:GetChildren()) do
        if tostring(m.Name):find(uuid, 1, true) then model = m break end
    end
    if not model then return "Normal", 1 end

    local lin
    local rp = model:FindFirstChild("RootPart", true)
    if rp and rp:IsA("BasePart") then
        lin = math.max(rp.Size.X, rp.Size.Y, rp.Size.Z)
    else
        pcall(function()
            local sz
            if model:IsA("Model") then local _, s = model:GetBoundingBox(); sz = s
            elseif model:IsA("BasePart") then sz = model.Size end
            if sz then lin = math.max(sz.X, sz.Y, sz.Z) end
        end)
    end
    if not lin or lin <= 0 then return "Normal", 1 end

    local dasar = Seed._petUkuranDasar[nama]
    if not dasar or lin < dasar then Seed._petUkuranDasar[nama] = lin; dasar = lin end
    local skala = lin / dasar

    -- v2.2: ambang dari SharedData.PetSizes.Scales -- ANGKA ASLI GAME.
    -- Bukti: Scales = { Big=2, Huge=4 }, BoostMultipliers = { Big=2, Huge=3 }.
    -- Tebakan lama gua (1.5 & 3) SALAH dan bakal bikin Big kebaca Huge.
    -- Istilah: data nyebut "Huge", tampilan game nyebut "Mega" -- disamain
    -- ke "Mega" biar gak dua istilah buat satu hal.
    local ambangBig, ambangHuge = 2, 4
    pcall(function()
        local sd = RS:FindFirstChild("SharedData")
        local m = sd and sd:FindFirstChild("PetSizes")
        if not m then return end
        local ok, mod = pcall(require, m)
        if not ok or type(mod) ~= "table" then return end
        Seed._petSizes = mod
        if type(mod.Scales) == "table" then
            ambangBig  = tonumber(mod.Scales.Big)  or ambangBig
            ambangHuge = tonumber(mod.Scales.Huge) or ambangHuge
        end
    end)
    -- toleransi 10% -- ukuran model bisa meleset dikit
    if skala >= (ambangHuge * 0.9) then return "Mega", skala
    elseif skala >= (ambangBig * 0.9) then return "Big", skala
    else return "Normal", skala end
end

-- v2.2: Rainbow dicek lewat SharedData.PetTypes -- itu registry resminya
-- (Registry.Rainbow.DisplayText = "RAINBOW", boost 1.25x, ada IsRainbow()).
Seed._petTypes = nil
local function muatPetTypes()
    if Seed._petTypes ~= nil then return Seed._petTypes end
    Seed._petTypes = false
    pcall(function()
        local sd = RS:FindFirstChild("SharedData")
        local m = sd and sd:FindFirstChild("PetTypes")
        if not m then return end
        local ok, mod = pcall(require, m)
        if ok and type(mod) == "table" then Seed._petTypes = mod end
    end)
    return Seed._petTypes
end

function Seed.rainbowPet(o, nama)
    -- 1) fungsi resmi game (paling sah)
    local pt = muatPetTypes()
    if pt and type(pt.IsRainbow) == "function" then
        local ok, hasil = pcall(function()
            -- bentuk argumennya belum pasti -> coba objek dulu, terus nama
            local a = o and pt.IsRainbow(o)
            if a ~= nil then return a end
            return pt.IsRainbow(nama)
        end)
        if ok and hasil == true then return true end
    end
    -- 2) atribut di objeknya
    local r = false
    pcall(function()
        if o and (o:GetAttribute("Rainbow") or o:GetAttribute("IsRainbow")
           or o:GetAttribute("PetType") == "Rainbow"
           or o:GetAttribute("Variant") == "Rainbow"
           or o:GetAttribute("Mutation") == "Rainbow") then r = true end
    end)
    if r then return true end
    -- 3) nama (kalau varian ditulis di depan)
    return Seed.mutasiDariNama(nama).Rainbow == true
end

