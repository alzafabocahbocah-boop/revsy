            Seed.petBaru[#Seed.petBaru + 1] = nm
            -- pet baru: auto-pilih kalau mode semua pet ATAU seedBaruAuto nyala
            if state.petSemua then state.petPilih[nm] = true end
        end
        print(("[StarSeed] PET BARU (%d): %s"):format(#baru, table.concat(baru, ", ")))
    end
    if #baru > 0 or pertamaKali then simpan() end
    return baru
end
