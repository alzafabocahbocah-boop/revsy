-- ============================================================
-- v3.9: BACA ISI MAILBOX -- dikirimin apa, dari siapa, berapa.
--
-- Kenapa perlu: sampai sekarang mailbox cuma DIHITUNG (jumlahGift) terus
-- diklaim borongan (ClaimAll). Jadi gak ada catatan barang apa yang masuk --
-- padahal itu yang nentuin auto-suplai jalan bener apa nggak. Kalau farm
-- ngirim Carrot (nilai 5) bukan Glow (ribuan kali lebih mahal), yang keliatan
-- di panel cuma "ada 5 mail" -- gak ketauan isinya sampah.
--
-- Struktur yang dipakai (kekonfirmasi dari jumlahGift):
--   PlayerGui.MailboxUI.Frame.RecieveFrame.Gift_<id>
-- Nama child DI DALAM Gift_* belum pasti antar versi, jadi teksnya diambil
-- APA ADANYA dari semua TextLabel di dalamnya -- gak ngandelin nama tertentu.
--
-- PENTING: isi RecieveFrame cuma kebangun pas mailbox DIBUKA (lihat catatan
-- di bukaMailbox). Jadi baca ini setelah mailbox pernah kebuka; kalau belum,
-- hasilnya kosong walau mailboxnya sebenernya ada isinya.
-- ============================================================
function Seed.bacaMailbox()
    local hasil = {}
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local mb = pg and pg:FindFirstChild("MailboxUI")
        local frame = mb and mb:FindFirstChild("Frame")
        local recv = frame and frame:FindFirstChild("RecieveFrame")
        if not recv then return end

        for _, g in ipairs(recv:GetChildren()) do
            local id = tostring(g.Name):match("^Gift_(.+)$")
            if id and g:IsA("GuiObject") then
                local baris = {}
                for _, d in ipairs(g:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local t = tostring(d.Text or "")
                            :gsub("<[^>]->", "")        -- buang tag RichText
                            :gsub("%s+", " ")
                            :gsub("^%s+", ""):gsub("%s+$", "")
                        -- lewati teks tombol yang gak ada isinya
                        if t ~= "" and #t < 90 and not t:match("^[Xx]$") then
                            baris[#baris+1] = { nama = d.Name, teks = t }
                        end
                    end
                end
                hasil[#hasil+1] = { id = id, tampil = g.Visible, isi = baris }
            end
        end
    end)
    return hasil
end

-- ============================================================
-- v3.10 KOREKSI PENTING (hasil ukur star_mail v1.0 di fifinx_1):
--
-- UI mailbox TIDAK MENYEBUT BARANGNYA sama sekali. Isi surat aslinya cuma:
--     [SubjectLine1]  From @fifibuah_13!
--     [NoteTextlabel] Here is a gift!
--     [TextLabel]     Reply / Claim / Delete
-- Gak ada nama barang, gak ada jumlah. Roblox baru nunjukin isinya SETELAH
-- diklaim. Jadi "dikirimin apa" MUSTAHIL dijawab dari UI.
--
-- Akibatnya bagian `barang` di v3.9 ngejar sesuatu yang gak ada -- dan lebih
-- buruk: dia ngambil "teks terpanjang" sebagai nama barang, yang di kenyataan
-- bakal jadi "From @fifibuah_13!" atau "Here is a gift!". Itu bukan cuma gagal,
-- itu NGARANG.
--
-- Sekarang yang dilaporin cuma yang beneran ada: JUMLAH surat + PENGIRIM.
-- Buat tau isinya, jalurnya packet (List / ClaimAllProgress) -- masih
-- diselidiki lewat star_mail, belum dipasang di sini.
--
-- Temuan lain yang berguna:
--   * RecieveFrame isinya 7 objek, 5 di antaranya TEMPLATE (GiftTemplate,
--     GuildInviteTemplate, GuildRewardTemplate*). Pola "^Gift_" udah bener
--     nyaring itu -- "GiftTemplate" gak cocok karena gak ada underscore.
--   * id gift bentuknya "4:<uuid>", bukan uuid polos.
--   * pengirim ada di SubjectLine1/2 dengan pola "From @<nama>!"
-- ============================================================
-- Ringkasan mailbox buat GUI & laporan panel.
--
-- Balikin TABEL, bukan string -- sengaja, biar pemanggilnya bisa milih mau
-- nampilin bagian mana tanpa mengurai teks lagi:
--   { surat = <jumlah gift>,
--     barang = { "Glow Carrot x20", ... },   -- nama barang, maks 4 + sisa
--     dari   = { "wildnx_3", ... },          -- pengirim, kalau kebaca
--     adaBarang = <bool> }                   -- false = teksnya gak kebaca
--
-- adaBarang perlu dibedain dari "kosong": kalau mailbox ADA isinya tapi
-- teksnya gak kebaca (nama child beda di versi Roblox lain), yang salah itu
-- PEMBACANYA -- dan itu harus keliatan, bukan disamarkan jadi "gak ada apa-apa".
-- ============================================================
function Seed.ringkasMailbox()
    local m = Seed.bacaMailbox()
    if #m == 0 then return nil end

    -- kata UI yang bentuknya mirip nama akun tapi jelas bukan.
    -- Ketangkep pas uji: "Claim" lolos saringan (huruf doang, 5 karakter) dan
    -- kebaca sebagai pengirim. Disaring pakai daftar, bukan pola -- soalnya
    -- nama akun juga huruf+angka, jadi gak bisa dibedain dari bentuknya.
    local BUKAN_NAMA = {
        claim = true, claimall = true, close = true, cancel = true, ok = true,
        accept = true, decline = true, delete = true, gift = true, gifts = true,
        mail = true, mailbox = true, inbox = true, send = true, receive = true,
        recieve = true, from = true, to = true, all = true, new = true,
    }

    local barang, dari, seenDari = {}, {}, {}
    for i, g in ipairs(m) do
        -- pengirim: teks yang keliatan kayak nama akun (huruf+angka+underscore,
        -- gak ada spasi), bukan angka doang, dan bukan kata UI
        -- v3.10: pengirim dibaca dari POLA YANG KEBUKTI di lapangan --
        -- "From @<nama>!" di SubjectLine1/2. Jauh lebih tepat daripada nebak
        -- "teks yang bentuknya kayak nama akun", yang dulu bikin "Claim"
        -- kebaca sebagai pengirim.
        for _, b in ipairs(g.isi) do
            local nm = b.teks:match("^From%s+@([%w_]+)!?$")
                    or b.teks:match("^From:?%s*@?([%w_]+)$")
                    or b.teks:match("^Dari%s+@?([%w_]+)!?$")
            if nm and #nm >= 3 and not BUKAN_NAMA[nm:lower()] and not seenDari[nm] then
                seenDari[nm] = true
                if #dari < 3 then dari[#dari+1] = nm end
            end
        end
    end

    return {
        surat = #m,
        dari  = dari,
        -- v3.10: `barang` DIBUANG -- UI-nya gak punya info itu (lihat catatan
        -- di atas). Dipertahanin sebagai tabel kosong biar pemanggil lama gak
        -- meledak, tapi isinya gak pernah keisi.
        barang    = {},
        adaBarang = false,
    }
end

