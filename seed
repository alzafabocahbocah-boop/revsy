-- v7.9: HISTORY GIFT (persist ke file, kayak gag2). Max 60 entry, terbaru di atas.
Seed._gfHistory = {}
function Seed.gfHistLoad()
    if type(readfile) ~= "function" then return end
    if isfile and not isfile("star_gifthist.json") then return end
    local ok, raw = pcall(readfile, "star_gifthist.json")
    if ok and raw and raw ~= "" then
        local ok2, d = pcall(function() return HS:JSONDecode(raw) end)
        if ok2 and type(d) == "table" then Seed._gfHistory = d end
    end
end
function Seed.gfHistAdd(entry)
    entry.t = os.time()
    table.insert(Seed._gfHistory, 1, entry)          -- terbaru di atas
    while #Seed._gfHistory > 60 do table.remove(Seed._gfHistory) end
    if type(writefile) == "function" then
        pcall(function() writefile("star_gifthist.json", HS:JSONEncode(Seed._gfHistory)) end)
    end
end
pcall(Seed.gfHistLoad)

-- v7.15: cek akun udah di-gift belum. Dua sumber: _giftDone (memory, cepet) DAN
-- RIWAYAT (persist ke file, SURVIVE REJOIN). Riwayat = sumber pasti -- abis rejoin
-- memory ilang tapi riwayat masih ada, jadi gak re-gift akun yg udah dikirimin.
function Seed.giftSudah(target)
    local pk = tostring(target):lower()
    local now = os.time()
    if Seed._giftDone and Seed._giftDone[pk] and (now - Seed._giftDone[pk]) < 600 then return true end
    for _, en in ipairs(Seed._gfHistory or {}) do
        if en.target and tostring(en.target):lower() == pk and en.t and (now - en.t) < 600 then
            return true
        end
    end
    return false
end

