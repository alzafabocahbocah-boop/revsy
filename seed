local PANEL_CEK, PANEL_DENYUT = 20, 120
Seed._panelGen = 0

-- ============================================================
-- v3.12: DETEKSI DI-KICK, DILAPOR KE PANEL.
--
-- Masalah yang dipecahin: pas Roblox nendang (mis. Error 267 "Your save data
-- didn't load right"), worker di RF GAK BISA TAU sebabnya. Dialognya digambar
-- ke permukaan GL, dan uiautomator balik 0 teks -- kekonfirmasi v4.85 di
-- zenx_worker. Jadi worker cuma tau "script berhenti lapor", lalu nunggu
-- auto_rejoin_menit (3 menit) sebelum nutup-buka client.
--
-- Dari DALAM game beda: dialognya objek Roblox biasa di CoreGui, dan itu
-- KEBUKTI kebaca -- star_mail berhasil baca MailboxUI dengan cara yang sama.
--
-- Caranya: sapu CoreGui cari teks yang mirip pesan kick, patokannya ISI
-- teksnya BUKAN nama objeknya. Nama child beda-beda antar versi Roblox; isi
-- pesannya jauh lebih stabil.
--
-- Yang dilaporin: kode + potongan pesannya. Worker jadi bisa tau BEDANYA
-- antara "gagal muat data" (ngulang = obatnya) dan "anti-cheat" (ngulang =
-- makin parah) -- beda yang gak mungkin dia tau dari luar.
--
-- CATATAN: laporannya dikirim SEKALI per kejadian. Client yang kena kick
-- sering masih sempat jalan beberapa detik sebelum DataModel dibongkar --
-- itu jendelanya. Kalau kelewat, jalur lama (bridge diem) tetep nangkep.
-- ============================================================
local KICK_KATA = {
    "error code", "kicked by this experience", "moderation message",
    "save data didn't load", "save data did not load",
    "lost connection", "disconnected", "please rejoin", "you were banned",
}

-- v4.06: DETEKSI DISCONNECT ANDAL buat AUTO-REJOIN (beda dari cekKick text-scan
-- yg buat lapor panel). Pakai cara resmi Roblox:
--   1. GuiService:GetErrorCode() -- kode error koneksi (0 = gak ada)
--   2. ErrorPrompt resmi (CoreGui.RobloxPromptGui / ErrorPrompt) yg VISIBLE
-- Ini cuma nyala pas DISCONNECT BENERAN (bukan text nyasar di UI game).
function Seed.cekDisconnectAndal()
    local dc = false
    pcall(function()
        local GuiService = game:GetService("GuiService")
        -- cara 1: error code resmi (koneksi putus)
        local ec = GuiService:GetErrorCode()
        if ec and ec ~= Enum.ConnectionError.OK and ec ~= Enum.ConnectionError.None then
            dc = true
            return
        end
    end)
    if dc then return true end
    -- cara 2: ErrorPrompt resmi Roblox yg BENERAN tampil (Leave/Reconnect button)
    pcall(function()
        local CoreGui = game:GetService("CoreGui")
        -- prompt disconnect resmi: RobloxPromptGui > promptOverlay > ErrorPrompt
        local pg = CoreGui:FindFirstChild("RobloxPromptGui")
        if pg then
            local overlay = pg:FindFirstChild("promptOverlay")
            if overlay then
                for _, child in ipairs(overlay:GetChildren()) do
                    -- ErrorPrompt / frame yg Visible = disconnect beneran tampil
                    if child:IsA("GuiObject") and child.Visible
                        and (child.Name:find("Error") or child.Name:find("Prompt")) then
                        -- cek ada tombol Leave/Reconnect (ciri prompt disconnect)
                        for _, d in ipairs(child:GetDescendants()) do
                            if (d:IsA("TextButton") or d:IsA("TextLabel")) then
                                local t = tostring(d.Text or ""):lower()
                                if t:find("reconnect") or t:find("leave")
                                    or t:find("disconnect") then
                                    dc = true; return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    return dc
end

function Seed.cekKick()
    local hasil = nil
    pcall(function()
        local CoreGui = game:GetService("CoreGui")
        local kumpul, kode = {}, nil
        for _, d in ipairs(CoreGui:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                -- v4.05: CUMA deteksi kalau text BENERAN KELIATAN di layar. Bug:
                -- Roblox punya prompt disconnect bawaan yg SELALU ada di CoreGui
                -- (hidden sampai beneran DC). cekKick baca text hidden -> rejoin
                -- palsu terus. Fix: cek Visible + ancestor Visible + ukuran > 0.
                local keliatan = d.Visible
                if keliatan then
                    -- cek semua ancestor Visible juga (kalau parent hidden, gak keliatan)
                    local p = d.Parent
                    for _ = 1, 8 do
                        if not p or p == CoreGui then break end
                        if p:IsA("GuiObject") and not p.Visible then keliatan = false; break end
                        p = p.Parent
                    end
                end
                if keliatan then
                    local t = tostring(d.Text or "")
                    if t:match("%S") then
                        local l = t:lower()
                        for _, k in ipairs(KICK_KATA) do
                            if l:find(k, 1, true) then
                                kumpul[#kumpul + 1] = t:gsub("%s+", " ")
                                kode = kode or tonumber(t:match("[Ee]rror [Cc]ode:?%s*(%d+)"))
                                break
                            end
                        end
                    end
                end
            end
            if #kumpul >= 6 then break end
        end
        if #kumpul == 0 then return end

        local pesan = table.concat(kumpul, " | ")
        local l = pesan:lower()
        local sebab = "lain"
        if l:find("save data", 1, true) or l:find("didn't load", 1, true)
           or l:find("did not load", 1, true) then
            sebab = "gagal-muat-data"
        elseif l:find("banned", 1, true) or l:find("exploit", 1, true)
            or l:find("cheat", 1, true) then
            sebab = "anti-cheat"
        elseif l:find("lost connection", 1, true) then
            sebab = "koneksi"
        end
        hasil = { kode = kode or 0, sebab = sebab, pesan = pesan:sub(1, 180) }
    end)
    return hasil
end

-- pemantau: begitu ketauan, lapor SEKALI lalu berhenti mantau
function Seed.pantauKick()
    task.spawn(function()
        local dilapor = false
        while isCurrentGen() and not dilapor do
            local k = Seed.cekKick()
            if k then
                dilapor = true
                Seed._kick = k
                warn(("[StarSeed] DI-KICK: %d (%s) -- %s"):format(k.kode, k.sebab, k.pesan))
                -- lapor cepat, jangan nunggu denyut /stat berikutnya (120 detik).
                -- Waktu itu penting: DataModel bisa dibongkar kapan aja.
                pcall(function()
                    panelReq("/stat", "POST", {
                        akun = player.Name, sc = "seed",
                        kick = k.kode, kickSebab = k.sebab, kickPesan = k.pesan,
                        farm2On = false,
                        job = tostring(game.JobId or ""):sub(1, 8),
                        place = tostring(game.PlaceId or ""),
                    })
                end)
                -- v4.06: rejoin DIPISAH ke loop sendiri (Seed.pantauRejoin) yg
                -- pakai cekDisconnectAndal -- biar gak numpang cekKick text-scan
                -- yg false-positive. Di sini cuma lapor panel.
            end
            -- 3 detik: cukup rapat buat nangkep jendela sebelum DataModel
            -- dibongkar, cukup jarang buat gak jadi beban.
            task.wait(3)
        end
    end)
end

-- v4.06: loop AUTO-REJOIN terpisah -- cuma pakai cekDisconnectAndal (GuiService
-- error / ErrorPrompt resmi), gak numpang cekKick text-scan. Cooldown 90s.
function Seed.pantauRejoin()
    task.spawn(function()
        task.wait(25)   -- jeda awal (biar loading kelar, gak false-positive)
        while isCurrentGen() do
            if state.autoRejoinSeed and Seed.cekDisconnectAndal() then
                local now = os.time()
                local lastRejoin = (getgenv and getgenv().ZenxRejoinLast) or 0
                if (now - lastRejoin) >= 90 then
                    if getgenv then getgenv().ZenxRejoinLast = now end
                    -- v4.39: target = PlaceId GAME SEKARANG (game.PlaceId), bukan
                    -- telePlaceId statis (W1). Bug user: main W2 (FALL) tapi rejoin
                    -- ke W1 -> nyasar server, "gak kuat". Rejoin ke game yg lagi
                    -- dimainin = balik ke server yg sama (W2 kalau di W2). Fallback
                    -- ke telePlaceId kalau game.PlaceId gak kebaca.
                    local target = tonumber(game.PlaceId) or tonumber(state.telePlaceId) or 129343810645058
                    warn(("[StarSeed] AUTO-REJOIN (DC andal) -> place %d (game skrg)"):format(target))
                    pcall(function()
                        local TS = game:GetService("TeleportService")
                        Seed._teleSendiri = true    -- v4.31: izinin (teleport kita)
                        TS:Teleport(target, player)
                        Seed._teleSendiri = false
                    end)
                    task.wait(30)   -- kasih waktu teleport jalan
                end
            end
            task.wait(5)
        end
    end)
end

