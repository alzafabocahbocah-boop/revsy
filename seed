-- BELI GEAR: Super Watering Can + Super Sprinkler
-- Nebeng saklar `beliOn` yang sama -- sengaja gak dikasih toggle sendiri.
--
-- PENTING (pelajaran dari star_farm.lua v10.2): gear TIDAK boleh dibeli tiap
-- siklus kayak seed. Dulu ditembak tiap 3 detik -> ~14 fire/3s -> server
-- timeout 30-60 detik -> semua aksi lain ikut ke-block. Gear cuma restock
-- sesekali dan stoknya 1-2 biji, jadi:
--   * kalau UnixNextRestock kebaca -> beli CUMA pas nilainya berubah
--   * kalau gak kebaca -> mundur ke jeda aman 60 detik, bukan spam
-- ============================================================
local GEAR_KATA = {
    { "super", "watering" },   -- Super Watering Can
    { "super", "sprinkler" },  -- Super Sprinkler
}

-- Nama gear dicocokin dari daftar ASLI di game (bukan hardcoded), biar tetep
-- kena walau penulisannya beda ("Super Sprinkler" / "SuperSprinkler" / dsb).
function Seed.gearTarget()
    local out = {}
    pcall(function()
        local sv = RS:FindFirstChild("StockValues")
        local gs = sv and sv:FindFirstChild("GearShop")
        local items = gs and gs:FindFirstChild("Items")
        if not items then return end
        for _, it in ipairs(items:GetChildren()) do
            local ln = tostring(it.Name):lower()
            for _, kata in ipairs(GEAR_KATA) do
                local cocok = true
                for _, k in ipairs(kata) do
                    if not ln:find(k, 1, true) then cocok = false break end
                end
                if cocok then out[#out+1] = it.Name break end
            end
        end
    end)
    return out
end

function Seed.stokGear(nama)
    local n = nil
    pcall(function()
        local sv = RS:FindFirstChild("StockValues")
        local gs = sv and sv:FindFirstChild("GearShop")
        local items = gs and gs:FindFirstChild("Items")
        local v = items and items:FindFirstChild(nama)
        if v and v:IsA("ValueBase") then n = v.Value end
    end)
    return n
end

Seed.statGear = 0
Seed._logGear = ""

function Seed.beliGearSekali()
    -- nama remote gear beda-beda antar versi game -> coba beberapa
    local p = pkt("GearShop", "PurchaseGear") or pkt("GearShop", "Purchase")
           or pkt("Gear", "Purchase") or pkt("Gear", "PurchaseGear")
           or pkt("SeedShop", "PurchaseGear") or pkt("Shop", "PurchaseGear")
    if not p or not p.Fire then
        Seed._logGear = "remote gear gak ketemu"
        return 0
    end

    if (state.sisaSheck or 0) > 0 and sheckles() <= state.sisaSheck then
        Seed._logGear = "sheckles mepet"
        return 0
    end

    local target = Seed.gearTarget()
    if #target == 0 then Seed._logGear = "Super WC/Sprinkler gak ada di toko"; return 0 end

    local fired = 0
    for _, nama in ipairs(target) do
        if not (state.beliOn and isCurrentGen()) then break end
        local stok = Seed.stokGear(nama)
        if stok and stok > 0 then
            if stok > 20 then stok = 20 end
            for _ = 1, stok do
                if not (state.beliOn and isCurrentGen()) then break end
                pcall(function() p:Fire(nama) end)
                fired = fired + 1
                if fired % 5 == 0 then task.wait() end
            end
        end
    end

    if fired > 0 then
        Seed.statGear = Seed.statGear + fired
        Seed._logGear = fired .. " fire"
    else
        Seed._logGear = "stok kosong"
    end
    return fired
end

-- loop gear: DIGERBANG RESTOCK (lihat catatan di atas -- jangan diubah jadi
-- tiap siklus, itu yang dulu bikin server timeout).
Seed._restockAkhir = nil
Seed._gearBeliAkhir = 0
task.spawn(function()
    while isCurrentGen() do
        task.wait(5)
        if isCurrentGen() and state.beliOn then
            pcall(function()
                local restock = nil
                pcall(function()
                    local sv = RS:FindFirstChild("StockValues")
                    local gs = sv and sv:FindFirstChild("GearShop")
                    local nx = gs and gs:FindFirstChild("UnixNextRestock")
                    if nx then restock = nx.Value end
                end)

                local beli = false
                if restock ~= nil then
                    -- restock kebaca: beli cuma pas nilainya BERUBAH (= stok baru)
                    if restock ~= Seed._restockAkhir then
                        Seed._restockAkhir = restock
                        beli = true
                    end
                else
                    -- restock gak kebaca: jangan spam -- maksimal 1x per 60 detik
                    local now = os.time()
                    if (now - Seed._gearBeliAkhir) >= 60 then
                        Seed._gearBeliAkhir = now
                        beli = true
                    end
                end

                if beli then Seed.beliGearSekali() end
            end)
        end
    end
end)

