-- biar area lebih luas ke-load (pet liar lebih jauh tetep kebaca). Aman: cuma
-- naikin target radius, gak ngubah gameplay.
task.spawn(function()
    pcall(function()
        if workspace.StreamingEnabled then
            pcall(function() workspace.StreamingTargetRadius = 2048 end)
            pcall(function() workspace.StreamingMinRadius = 512 end)
        end
    end)
end)

