-- v3.18: DAFTAR MUTASI (dari MutationData game -- fall world)
-- ============================================================
Seed._daftarMutasi = nil
local function muatDaftarMutasi()
    local seen, list = {}, {}
    local function tambah(nm)
        if type(nm) == "string" and nm ~= "" and not seen[nm]
           and nm:lower() ~= "none" and nm:lower() ~= "normal" then
            seen[nm] = true; list[#list+1] = nm
        end
    end
    pcall(function()
        local sm = RS:FindFirstChild("SharedModules")
        local md = sm and sm:FindFirstChild("MutationData")
        if md then
            local ok, data = pcall(require, md)
            if ok and type(data) == "table" then
                for k, v in pairs(data) do
                    if type(k) == "string" and not k:match("^_")
                       and type(v) ~= "function" then
                        tambah(k)
                    end
                end
            end
        end
    end)
    table.sort(list)
    return list
end
function Seed.daftarMutasi()
    if not Seed._daftarMutasi then Seed._daftarMutasi = muatDaftarMutasi() end
    return Seed._daftarMutasi
end

-- ============================================================
-- STOK SERVER: StockValues.SeedShop.Items.<nama> = NumberValue
-- Cuma beli yang stoknya > 0. Nembak seed yang habis itu percuma --
-- server nolak, tapi packet-nya tetep kekirim (bikin lag di RF).
-- ============================================================
Seed._itemsRef = nil
function Seed.stok(nama)
    local items = Seed._itemsRef
    if not items or not items.Parent then
        local ok = pcall(function()
            local sv = RS:FindFirstChild("StockValues")
            local shop = sv and sv:FindFirstChild("SeedShop")
            items = shop and shop:FindFirstChild("Items")
        end)
        if not ok or not items then return nil end
        Seed._itemsRef = items
    end
    local n = items:FindFirstChild(nama)
    if n and n:IsA("ValueBase") then return n.Value end
    return nil
end

-- v3.18: singkat angka gede (1240500 -> 1.2M, 8500 -> 8.5K)
local function ringkasAngka(n)
    n = tonumber(n) or 0
    if n >= 1e12 then return ("%.1fT"):format(n/1e12):gsub("%.0T","T")
    elseif n >= 1e9 then return ("%.1fB"):format(n/1e9):gsub("%.0B","B")
    elseif n >= 1e6 then return ("%.1fM"):format(n/1e6):gsub("%.0M","M")
    elseif n >= 1e3 then return ("%.1fK"):format(n/1e3):gsub("%.0K","K")
    else return tostring(math.floor(n)) end
end

-- v3.18: hitung jumlah tanaman di kebun kita (Gardens.<plot milik kita>.Plants)
local function hitungSeedKebun()
    local n = 0
    pcall(function()
        local g = workspace:FindFirstChild("Gardens")
        if not g then return end
        local uid = player.UserId
        for _, plot in ipairs(g:GetChildren()) do
            local own = plot:GetAttribute("OwnerUserId")
            local ownNm = plot:GetAttribute("Owner")
            if own == uid or ownNm == player.Name then
                local plants = plot:FindFirstChild("Plants")
                if plants then
                    for _, plant in ipairs(plants:GetChildren()) do
                        if plant:GetAttribute("PlantId") then n = n + 1 end
                    end
                end
            end
        end
    end)
    return n
end

local function sheckles()
    local n = 0
    pcall(function()
        -- 1. leaderstats.Sheckles / Cash (cara utama, sama kayak gag2 map baru)
        local ls = player:FindFirstChild("leaderstats")
        local sh = ls and (ls:FindFirstChild("Leaves") or ls:FindFirstChild("Sheckles")
                   or ls:FindFirstChild("Cash") or ls:FindFirstChild("Money")
                   or ls:FindFirstChild("Coins"))
        if sh and sh.Value then n = tonumber(sh.Value) or 0 end
        -- 2. fallback: atribut di player (map baru kadang taruh di sini)
        if n == 0 then
            local a = player:GetAttribute("Sheckles") or player:GetAttribute("Cash")
                      or player:GetAttribute("Money")
            if a then n = tonumber(a) or 0 end
        end
    end)
    return n
end

-- ============================================================
-- v1.2: PEMINDAI SEED BARU
-- Daftar seed di-refresh berkala. Nama yang belum pernah keliat = SEED BARU
-- -> langsung dicentang biar kebeli, tanpa nunggu diurus manual.
--
-- Kenapa perlu: di mode "Pilih jenis", seed yang baru rilis gak akan pernah
-- kecentang -> kelewat total. Mode "Borong semua" aman, tapi daftarnya sendiri
-- tetep harus di-refresh biar seed baru masuk hitungan.
--
-- Pertama kali jalan (seedDikenal masih kosong) SEMUA seed dianggap "udah
-- dikenal" -- kalau nggak, semua langsung kecentang dan itu bukan maunya user.
-- ============================================================
Seed.seedBaru = {}     -- nama seed baru yang kedeteksi sesi ini (buat ditampilin)

local function pindaiSeedBaru(pertamaKali)
    local baru = {}
    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    for _, nm in ipairs(Seed.daftar) do
        if not state.seedDikenal[nm] then
            state.seedDikenal[nm] = true
            if not pertamaKali then baru[#baru+1] = nm end
        end
    end
    if #baru > 0 then
        for _, nm in ipairs(baru) do
            Seed.seedBaru[#Seed.seedBaru + 1] = nm
            if state.seedBaruAuto then state.seedPilih[nm] = true end
        end
        print(("[StarSeed] SEED BARU (%d): %s%s"):format(
            #baru, table.concat(baru, ", "),
            state.seedBaruAuto and " -> langsung dibeli" or " (auto-beli MATI, centang manual)"))
    end
    if #baru > 0 or pertamaKali then simpan() end
    return baru
end

-- refresh daftar tiap 60 detik. Cukup jarang biar gak boros, cukup sering biar
-- seed baru kena di siklus berikutnya.
task.spawn(function()
    task.wait(10)
    while isCurrentGen() do
        pcall(function()
            local lama = Seed.daftar and #Seed.daftar or 0
            Seed.daftar = muatDaftarSeed()
            Seed._rarity = nil   -- rarity ikut dimuat ulang (seed baru bawa rarity baru)
            local baru = pindaiSeedBaru(false)
            if #baru > 0 and Seed._gambarDaftar then
                pcall(Seed._gambarDaftar)   -- daftar di GUI ikut diperbarui
            end
        end)
        task.wait(60)
    end
end)

-- ============================================================
-- v3.18: DAFTAR PET + AUTO-DETECT PET BARU
-- Jenis pet yang ADA di map ini, dibaca dari:
--   workspace.Map.WildPetRef.WildPet_*  (atribut PetName) -- pet liar aktif
--   workspace.Map.WildPetSpawns.*       (atribut PetName) -- titik spawn
-- Kalau ada jenis pet BARU (belum pernah keliat) -> catat + (opsional) auto-pilih.
-- ============================================================
Seed.petBaru = {}   -- jenis pet baru kedeteksi sesi ini
Seed._petModulCache = nil   -- cache daftar pet dari game (PetModules)

-- v3.18b: baca daftar pet dari SharedModules.PetModules -- MODUL GAME LANGSUNG
-- (kayak seed dari SeedData). Ini list SEMUA pet yang ADA di game ini (fall
-- world) -- bukan cuma yang lagi spawn. Jadi otomatis bedain pet fall world vs
-- world lama: PetModules di game fall world = pet fall world doang.
local function loadPetModul()
    local list = {}
    pcall(function()
        local sm = RS:FindFirstChild("SharedModules")
        local pm = sm and sm:FindFirstChild("PetModules")
        if pm then
            local ok, mod = pcall(require, pm)
            if ok and type(mod) == "table" then
                for k, v in pairs(mod) do
                    -- entri pet = key string, value bukan fungsi, bukan "_privat"
                    if type(k) == "string" and type(v) ~= "function" and not k:match("^_") then
                        list[#list+1] = k
                    end
                end
            end
        end
    end)
    return list
end

local function daftarPet()
    local seen, list = {}, {}
    local function tambah(nm)
        if type(nm) == "string" and nm ~= "" and not seen[nm] then
            seen[nm] = true; list[#list+1] = nm
        end
    end
    -- 1) PetModules (game langsung -- SUMBER UTAMA, semua pet fall world)
    if not Seed._petModulCache then Seed._petModulCache = loadPetModul() end
    for _, nm in ipairs(Seed._petModulCache) do tambah(nm) end
    -- 2) WildPetRef + WildPetSpawns (pet yang lagi ada di map -- pelengkap)
    pcall(function()
        local map = workspace:FindFirstChild("Map")
        if not map then return end
        local ref = map:FindFirstChild("WildPetRef")
        if ref then
            for _, o in ipairs(ref:GetChildren()) do tambah(o:GetAttribute("PetName")) end
        end
        local spawns = map:FindFirstChild("WildPetSpawns")
        if spawns then
            for _, o in ipairs(spawns:GetChildren()) do tambah(o:GetAttribute("PetName")) end
        end
    end)
    table.sort(list)
    return list
end

local function pindaiPetBaru(pertamaKali)
    local baru = {}
    for _, nm in ipairs(daftarPet()) do
        if not state.petDikenal[nm] then
            state.petDikenal[nm] = true
            if not pertamaKali then baru[#baru+1] = nm end
        end
    end
    if #baru > 0 then
        for _, nm in ipairs(baru) do
            Seed.petBaru[#Seed.petBaru + 1] = nm
            -- pet baru: auto-pilih kalau mode semua pet ATAU seedBaruAuto nyala
            if state.petSemua then state.petPilih[nm] = true end
        end
        print(("[StarSeed] PET BARU (%d): %s"):format(#baru, table.concat(baru, ", ")))
    end
    if #baru > 0 or pertamaKali then simpan() end
    return baru
end
-- scan pertama (kenalin yg udah ada, jangan dianggap "baru") + loop tiap 60s
task.spawn(function()
