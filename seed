-- BELI GEAR: Super Watering Can + Super Sprinkler
-- Nebeng saklar `beliOn` yang sama -- sengaja gak dikasih toggle sendiri.
--
-- PENTING (pelajaran dari star_farm.lua v10.2): gear TIDAK boleh dibeli tiap
-- siklus kayak seed. Dulu ditembak tiap 3 detik -> ~14 fire/3s -> server
-- timeout 30-60 detik -> semua aksi lain ikut ke-block. Gear cuma restock
-- sesekali dan stoknya 1-2 biji, jadi:
--   * kalau UnixNextRestock kebaca -> beli CUMA pas nilainya berubah
--   * kalau gak kebaca -> mundur ke jeda aman 60 detik, bukan spam
-- ============================================================
local GEAR_KATA = {
    { "super", "watering" },   -- Super Watering Can
    { "super", "sprinkler" },  -- Super Sprinkler
}

-- Nama gear dicocokin dari daftar ASLI di game (bukan hardcoded), biar tetep
-- kena walau penulisannya beda ("Super Sprinkler" / "SuperSprinkler" / dsb).
-- v3.20: harga gear dari GearShopData.Data (by ItemName)
Seed._gearHarga = nil
function Seed.hargaGear(nama)
    if not Seed._gearHarga then
        Seed._gearHarga = {}
        pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local mod = sm and sm:FindFirstChild("GearShopData")
            if not mod then return end
            local ok, data = pcall(require, mod)
            if ok and type(data) == "table" and type(data.Data) == "table" then
                for _, v in pairs(data.Data) do
                    if type(v) == "table" and v.ItemName then
                        Seed._gearHarga[tostring(v.ItemName)] = tonumber(v.Cost) or 0
                    end
                end
            end
        end)
    end
    return Seed._gearHarga[nama] or 0
end

function Seed.gearTarget()
    local out = {}
    pcall(function()
        local sv = RS:FindFirstChild("StockValues")
        local gs = sv and sv:FindFirstChild("GearShop")
        local items = gs and gs:FindFirstChild("Items")
        if not items then return end
        for _, it in ipairs(items:GetChildren()) do
            local nm = it.Name
            -- v3.20: pakai pilihan panel. gearSemua ON = semua gear di stok,
            -- else cuma yg dicentang (gearPilih). fallback: GEAR_KATA lama.
            local pilih = false
            if state.gearSemua then
                pilih = true
            elseif state.gearPilih and next(state.gearPilih) then
                pilih = state.gearPilih[nm] == true
            else
                -- fallback lama (Super WC/Sprinkler) kalau panel belum set
                local ln = tostring(nm):lower()
                for _, kata in ipairs(GEAR_KATA) do
                    local cocok = true
                    for _, k in ipairs(kata) do
                        if not ln:find(k, 1, true) then cocok = false break end
                    end
                    if cocok then pilih = true break end
                end
            end
            if pilih then out[#out+1] = nm end
        end
    end)
    return out
end

function Seed.stokGear(nama)
    local n = nil
    pcall(function()
        local sv = RS:FindFirstChild("StockValues")
        local gs = sv and sv:FindFirstChild("GearShop")
        local items = gs and gs:FindFirstChild("Items")
        local v = items and items:FindFirstChild(nama)
        if v and v:IsA("ValueBase") then n = v.Value end
    end)
    return n
end

Seed.statGear = 0
Seed._logGear = ""

function Seed.beliGearSekali()
    -- nama remote gear beda-beda antar versi game -> coba beberapa
    local p = pkt("GearShop", "PurchaseGear") or pkt("GearShop", "Purchase")
           or pkt("Gear", "Purchase") or pkt("Gear", "PurchaseGear")
           or pkt("SeedShop", "PurchaseGear") or pkt("Shop", "PurchaseGear")
    if not p or not p.Fire then
        Seed._logGear = "remote gear gak ketemu"
        return 0
    end

    -- v3.8: rem keras yang sama kayak beli seed -- lihat catatan di beliSekali
    local saldoG = sheckles()
    if saldoG <= 0 then
        Seed._logGear = "sheckles NOL -- beli ditahan"
        return 0
    end
    if (state.sisaSheck or 0) > 0 and saldoG <= state.sisaSheck then
        Seed._logGear = "sheckles mepet"
        return 0
    end

    local target = Seed.gearTarget()
    if #target == 0 then Seed._logGear = "Super WC/Sprinkler gak ada di toko"; return 0 end

    local fired = 0
    for _, nama in ipairs(target) do
        if not ((state.gearOn or state.beliOn) and isCurrentGen()) then break end
        -- v3.20: batas harga gear (gearMaxHarga, 0 = bebas)
        local bolehBeli = true
        local maxH = tonumber(state.gearMaxHarga) or 0
        if maxH > 0 then
            local harga = Seed.hargaGear and Seed.hargaGear(nama) or 0
            if harga > 0 and harga > maxH then
                bolehBeli = false   -- gear ini lebih mahal dari batas -> skip
            end
        end
        if bolehBeli then
            local stok = Seed.stokGear(nama)
            if stok and stok > 0 then
                if stok > 20 then stok = 20 end
                -- v3.23: harga gear ini (buat cek saldo sebelum tiap fire)
                local hargaGear = Seed.hargaGear and Seed.hargaGear(nama) or 0
                for _ = 1, stok do
                    if not ((state.gearOn or state.beliOn) and isCurrentGen()) then break end
                    -- v3.23: cek Leaves cukup DULU (hindari "not enough leaves").
                    -- kalau harga kebaca + leaves < harga -> stop beli gear ini.
                    if hargaGear > 0 then
                        local leaves = sheckles()
                        if leaves < hargaGear then break end   -- saldo abis, stop
                    end
                    pcall(function() p:Fire(nama) end)
                    fired = fired + 1
                    task.wait(0.15)   -- jeda: kasih server waktu update saldo
                end
            end
        end
    end

    if fired > 0 then
        Seed.statGear = Seed.statGear + fired
        Seed._logGear = fired .. " fire"
    else
        Seed._logGear = "stok kosong"
    end
    return fired
end

-- loop gear: DIGERBANG RESTOCK (lihat catatan di atas -- jangan diubah jadi
-- tiap siklus, itu yang dulu bikin server timeout).
