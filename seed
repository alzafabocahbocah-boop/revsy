    end

    for _, k in ipairs(BOOL_PANEL) do
        if type(c[k]) == "boolean" and state[k] ~= c[k] then
            state[k] = c[k]; ubah[#ubah+1] = k .. "=" .. tostring(c[k])
            -- v3.32: ringanOn TIDAK LAGI maksa noclip + hilangin visual (itu
            -- bikin ProximityPrompt E ke NPC/mailbox gak jalan). Sekarang
            -- hideVisual + noclip toggle SENDIRI dari panel (hideVisualOn,
            -- noclipOn), gak nempel ke ringanOn.
