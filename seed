-- MainCategory=Seed / SeedTool, BUAH punya SizeMultiplier (skip), gear ada
-- atribut/nama gear. Sengaja LOKAL di sini biar gak kena urutan upvalue.
local function giftToolSeed(t)
    if not (t and t:IsA("Tool")) then return false end
    if t:GetAttribute("SizeMultiplier") then return false end   -- buah
    if toolItuGear(t) then return false end                     -- gear
    local cat = t:GetAttribute("MainCategory")
    if cat and tostring(cat):lower():find("seed") then return true end
    if t:GetAttribute("SeedTool") or t:GetAttribute("SeedName") then return true end
    if t.Name:match("[Ss]eed%s*$") then return true end
    -- fallback: bukan buah + bukan gear -> anggap seed (tas seed map baru
    -- namanya "Gold"/"Carrot" tanpa atribut jelas)
    return true
end

-- kirim gift mail SEKALI. return: ok(bool), pesan(string)
function Seed.kirimGiftMail(onProgress)
    -- v4.12: cek PENGIRIM. Kalau giftMailPengirim diisi spesifik (bukan kosong/
    -- "all"), cuma akun ITU yang boleh kirim. Akun lain skip (bukan pengirim).
    local pengirim = tostring(state.giftMailPengirim or ""):gsub("%s+", ""):lower()
    if pengirim ~= "" and pengirim ~= "all" then
        local akuIni = tostring(player.Name or ""):lower()
        if pengirim ~= akuIni then
            return false, "bukan akun pengirim (pengirim=" .. pengirim .. ")"
        end
    end
    -- v4.17: MULTI-TARGET. giftMailTarget bisa banyak akun (dipisah koma):
    -- "akunA, akunB, akunC" -> kirim ke SEMUA. Parse jadi daftar.
    local targetRaw = tostring(state.giftMailTarget or "")
    local daftarTarget = {}
    for t in targetRaw:gmatch("[^,]+") do
        t = t:gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" then daftarTarget[#daftarTarget+1] = t end
    end
    if #daftarTarget == 0 then return false, "target kosong" end
    -- v4.41: COUNTER GIFT HARIAN + guard EscrowCap. Dari debug game: MagicMail
    -- EscrowCap=50 (max 50 mail pending). User: limit 50 gift/hari. Hitung mail
    -- terkirim hari ini -> warning kalau mendekati/mentok 50. Reset tiap ganti hari.
    local hariIni = os.date("%Y-%m-%d")
    if Seed._giftHari ~= hariIni then
        Seed._giftHari = hariIni
        Seed._giftCountHari = 0   -- reset counter hari baru
    end
    local ESCROW_CAP = 50
    if (Seed._giftCountHari or 0) >= ESCROW_CAP then
        return false, ("LIMIT HARIAN: udah kirim %d/%d mail hari ini (EscrowCap). Tunggu besok / penerima claim dulu."):format(
            Seed._giftCountHari, ESCROW_CAP)
    end
    local sb = pkt("Mailbox", "SendBatch")
    if not (sb and sb.Fire) then return false, "SendBatch gak ada" end
    local qty = tonumber(state.giftMailQty) or 100
    if qty < 1 then qty = 1 end
    -- kumpulin item SEKALI (sama buat semua target)
    local items = {}
    local rincianItem = {}   -- v4.17: buat notif detail (nama + jumlah)
    for _, holder in ipairs(tasHolders()) do
        for _, t in ipairs(holder:GetChildren()) do
            if t:IsA("Tool") and #items < 8 then
                if toolItuGear(t) then
                    if state.giftGearPilih[t.Name] then
                        local punya = t:GetAttribute("Count") or 1
                        local kirim = math.min(qty, punya)
                        local cat = t:GetAttribute("MainCategory") or "Gear"
                        if kirim > 0 then
                            items[#items+1] = { ItemKey = t.Name, Count = kirim, Category = tostring(cat) }
                            rincianItem[#rincianItem+1] = ("%d %s"):format(kirim, t.Name)
                        end
                    end
                elseif giftToolSeed(t) then
                    local nm = t:GetAttribute("SeedName") or t.Name
                    nm = tostring(nm):gsub("%s*[Ss]eed%s*$", "")
                    if nm == "" then nm = t.Name end
                    if state.giftSeedPilih[nm] or state.giftSeedPilih[t.Name] then
                        local punya = t:GetAttribute("Count") or 1
                        local kirim = math.min(qty, punya)
                        if kirim > 0 then
                            items[#items+1] = { ItemKey = nm, Count = kirim, Category = "Seeds" }
                            rincianItem[#rincianItem+1] = ("%d %s"):format(kirim, nm)
                        end
                    end
                end
            end
        end
    end
    if #items == 0 then return false, "gak ada item kepilih di tas" end
    -- v4.51: teks debug kecil di GUI -- jalan buat manual DAN auto gift mail.
    -- Nunjukin lagi kirim apa ke siapa. Set langsung (bukan cuma via onProgress
    -- yg cuma dipasang tombol manual).
    local ringkasItem = table.concat(rincianItem, ", ")
    Seed._logMail = ("kirim [%s] ke %d akun..."):format(ringkasItem ~= "" and ringkasItem or "?", #daftarTarget)
    -- v4.17: kirim ke SEMUA target (loop). Catat sukses/gagal per akun.
    local sukses, gagal = {}, {}
    for idx, target in ipairs(daftarTarget) do
        -- v4.18: kabarin progress live (kirim ke akun idx dari total)
        Seed._logMail = ("→ %s (%d/%d): %s"):format(target, idx, #daftarTarget, ringkasItem)
        if onProgress then
            pcall(onProgress, ("kirim ke %s (%d/%d)..."):format(target, idx, #daftarTarget))
        end
        local uid = resolveTargetId(target)
        if not uid then
            gagal[#gagal+1] = target .. " (gak ketemu)"
            Seed._logMail = ("✗ %s gak ketemu"):format(target)
        else
            local okK = pcall(function() sb:Fire(uid, items, "") end)
            if okK then
                sukses[#sukses+1] = target
                Seed._logMail = ("✓ done %s (%d/%d)"):format(target, idx, #daftarTarget)
                if onProgress then
                    pcall(onProgress, ("done %s (%d/%d)"):format(target, idx, #daftarTarget))
                end
            else gagal[#gagal+1] = target .. " (gagal fire)"; Seed._logMail = ("✗ %s gagal fire"):format(target) end
            task.wait(0.5)   -- jeda antar target (done akun ini, baru pindah)
        end
    end
    Seed._logMail = ("selesai: %d terkirim%s [%s]"):format(#sukses,
        #gagal > 0 and (", " .. #gagal .. " gagal") or "", ringkasItem)
    -- v4.17: notif DONE detail -- "done kirim <item> ke <akun-akun>"
    local isiItem = table.concat(rincianItem, ", ")
    if #sukses > 0 then
        Seed.statGiftMail = (Seed.statGiftMail or 0) + #sukses
        Seed._giftCountHari = (Seed._giftCountHari or 0) + #sukses   -- v4.41: counter harian
        local sisa = 50 - (Seed._giftCountHari or 0)
        local pesan = ("done kirim [%s] ke %d akun: %s [kuota harian: %d/50, sisa %d]"):format(
            isiItem, #sukses, table.concat(sukses, ", "), Seed._giftCountHari, math.max(0, sisa))
        if #gagal > 0 then
            pesan = pesan .. (" | GAGAL %d: %s"):format(#gagal, table.concat(gagal, ", "))
        end
        if sisa <= 5 and sisa > 0 then
            pesan = pesan .. (" | ⚠ HAMPIR LIMIT (sisa %d)"):format(sisa)
        end
        return true, pesan
    end
    return false, ("gagal kirim ke semua (%d): %s"):format(#gagal, table.concat(gagal, ", "))
end

-- v6.6: hitung TARGET AKU (index-based) + KEKURANGAN target (1b - sheckles skrg).
-- format giftPkList = "username:kekurangan, ..." (kekurangan = raw sheckles dari panel)
function Seed.giftTargetKu()
    local farms, habis, kurang = {}, {}, {}
    for t in tostring(state.giftFarmList or ""):gmatch("[^,]+") do
        t = t:gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" then farms[#farms+1] = t:lower() end
    end
    for t in tostring(state.giftPkList or ""):gmatch("[^,]+") do
        t = t:gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" then
            local nm, sf = t:match("^(.-):(.+)$")
            if nm and nm ~= "" then
                habis[#habis+1] = nm
                kurang[#habis] = tonumber(sf) or 0
            else
                habis[#habis+1] = t
                kurang[#habis] = 0
            end
        end
    end
    if #habis == 0 then return nil, 0, "antrian kosong" end
    local me = tostring(player.Name or ""):lower()
    local myIdx
    for i, f in ipairs(farms) do if f == me then myIdx = i; break end end
    if not myIdx then return nil, 0, "aku gak ada di daftar farm" end
    if myIdx <= #habis then return habis[myIdx], kurang[myIdx] or 0 end
    return nil, 0, ("idle (farm ke-%d, habis cuma %d)"):format(myIdx, #habis)
end

-- v7.0: ANTRIAN AKU -- max 5 seed di-assign ke farm ini (round-robin cap 5).
-- farm ke-N pegang habis[N], habis[N+F], habis[N+2F], ... sampe 5. Gift ke yg
-- pertama (habis[N]). Kelar 5 -> panel kasih lagi (via broadcast).
function Seed.giftQueueKu()
    local farms, habis, kurang = {}, {}, {}
    for t in tostring(state.giftFarmList or ""):gmatch("[^,]+") do
        t = t:gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" then farms[#farms+1] = t:lower() end
    end
    for t in tostring(state.giftPkList or ""):gmatch("[^,]+") do
        t = t:gsub("^%s+", ""):gsub("%s+$", "")
        if t ~= "" then
            local nm, sf = t:match("^(.-):(.+)$")
            if nm and nm ~= "" then habis[#habis+1] = nm; kurang[#habis] = tonumber(sf) or 0
            else habis[#habis+1] = t; kurang[#habis] = 0 end
        end
    end
    local F = #farms
    if F == 0 or #habis == 0 then return {} end
    local me = tostring(player.Name or ""):lower()
    local myIdx
    for i, f in ipairs(farms) do if f == me then myIdx = i; break end end
    if not myIdx then return {} end
    local out = {}
    for k = 0, 4 do   -- max 5
        local idx = myIdx + k * F
        if idx <= #habis then out[#out+1] = { nm = habis[idx], kurang = kurang[idx] or 0 }
        else break end
    end
    return out
end

