            end
        end)
    end
    return Seed._fvc or nil
end
local function getSellBase()
    if not Seed._sellBase then
        Seed._sellBase = {}
        pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local m = sm and sm:FindFirstChild("SellValueData")
