local function samakan(s) return tostring(s or ""):lower():gsub("%s+", "") end

local function jenisDipilih(nama)
    if state.petSemua then return true end
    if not nama then return false end
    local _, dasar = Seed.mutasiDariNama(nama)
    local kunciA, kunciB = samakan(nama), samakan(dasar)
    for pilih in pairs(state.petPilih or {}) do
        local p = samakan(pilih)
        if p == kunciA or p == kunciB then return true end
    end
    return false
end

function Seed.tamePetSekali()
    local p = pkt("Pets", "WildPetTame")
    if not p or not p.Fire then Seed._logPet = "packet WildPetTame gak ada"; return 0 end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then Seed._logPet = "karakter belum siap"; return 0 end

    local map = workspace:FindFirstChild("Map")
    local ref = map and map:FindFirstChild("WildPetRef")
    if not ref then Seed._logPet = "WildPetRef gak ketemu"; return 0 end

    local shk = sheckles()
    local dapat, direbut, kemahalan, belumTau = 0, 0, 0, 0

    -- Potret harga dasar SEBELUM scan ini. Dipakai sebagai pembanding di tahap 2.
    -- Kenapa dipotret: tahap 1 nambahin harga dari scan ini juga. Kalau langsung
    -- dipakai, pet yang harganya udah naik bisa "mendefinisikan dirinya sendiri"
    -- sebagai harga dasar -- pas dia satu-satunya yang muncul di scan itu.
    local dasarLama = {}
    for k, v in pairs(state.petHargaDasar) do dasarLama[k] = v end

    -- ===== TAHAP 1: PELAJARI HARGA DULU, JANGAN AMBIL APA-APA =====
    -- Ini WAJIB duluan. Kalau dicampur sama tahap ambil, urutan scan nentuin
    -- hasil: pet yang harganya udah naik bisa kebeli duluan gara-gara harga
    -- dasarnya belum kepelajari. (Kejadian pas diuji: pet 4500 kebeli padahal
    -- dasarnya 1000, cuma karena dia diproses lebih dulu.)
    local kandidat = {}
    for _, o in ipairs(ref:GetChildren()) do
        if o:IsA("BasePart") and tostring(o.Name):sub(1, 8) == "WildPet_" then
            local nama = o:GetAttribute("PetName")
            local harga = hargaPet(o)
            local punyaOrang = adaPemilik(o)
            -- cuma belajar dari pet yang BELUM diklaim -- yang udah diklaim
            -- harganya pasti udah naik, bukan patokan yang sah
            if nama and harga and not punyaOrang then
                -- cuma catat dari pet POLOS. Pet mutasi harganya emang beda,
                -- kalau ikut dicatat, harga dasarnya jadi ngaco.
                local m, nd = Seed.mutasiDariNama(nama)
                if next(m) == nil then catatHargaDasar(nd, harga) end
            end
            kandidat[#kandidat+1] = { o = o, nama = nama, harga = harga, milik = punyaOrang }
        end
    end

    -- ===== TAHAP 2: BARU AMBIL =====
    for _, k in ipairs(kandidat) do
        if not (state.petOn and isCurrentGen()) then break end
        local o, nama, harga, punyaOrang = k.o, k.nama, k.harga, k.milik
        local uuid = tostring(o.Name):sub(9)

        local okJenis = jenisDipilih(nama)
        -- v1.8: harga dari MODUL GAME menang. Itu angka pasti, bukan tebakan --
        -- jadi gak perlu putaran belajar buat jenis yang datanya ada di modul.
        -- harga dasar dicatat per nama DASAR -- "Mega Raccoon" & "Raccoon" itu
        -- jenis yang sama, cuma beda mutasi. Kalau dipisah, tiap mutasi harus
        -- belajar harganya sendiri dari nol.
        local _, namaDasar = Seed.mutasiDariNama(nama)
        local dasar = nama and (Seed.hargaDasarGame(namaDasar) or Seed.hargaDasarGame(nama)
                                or dasarLama[namaDasar] or dasarLama[nama])

        -- ===== v2.0: PENGECUALIAN PET MUTASI =====
        -- Big / Huge / Rainbow itu langka. Aturan "cuma harga dasar" sengaja
        -- DILONGGARIN buat mereka -- kelewat pet mutasi lebih rugi daripada
        -- bayar lebih mahal. Batasnya bisa disetel (mutasiMaxKali).
        local tier = select(1, Seed.tierPet(uuid, nama))
        local rb = Seed.rainbowPet(o, nama)
        local mutasi = nil
        if rb and state.mutasiRainbow then mutasi = "Rainbow"
        elseif tier == "Mega" and state.mutasiHuge then mutasi = "Mega"
        elseif tier == "Big" and state.mutasiBig then mutasi = "Big" end
        local istimewa = state.mutasiSikat and mutasi ~= nil

        -- ===== SARINGAN "HARGA DASAR" =====
        -- Sistem pet ini REBUTAN: begitu ada yang klaim, harganya naik dan
        -- siapa pun boleh nimpa dengan bayar lebih. Kita SENGAJA gak ikut
        -- perang harga -- cuma ambil yang masih perawan.
        --   1) belum ada pemiliknya
        --   2) harganya gak di atas harga dasar yang udah dipelajari
        --   3) kalau harga dasarnya BELUM KETAUAN -> JANGAN AMBIL, pelajari
        --      dulu. Lebih baik kelewat sekali daripada kebeli mahal. Harga
        --      dasar kesimpen di config, jadi ini cuma sekali per jenis pet.
        local masihBase, sebab
        if istimewa then
            -- pet mutasi: harga dasar DIABAIKAN, tapi tetep dibatesin
            -- mutasiMaxKali (kalau diisi) biar gak kebablasan.
            local batas = tonumber(state.mutasiMaxKali) or 0
            if batas > 0 and dasar and harga and harga > (dasar * batas) then
                masihBase, sebab = false, "mutasi_kemahalan"
            else
                masihBase = true
            end
        elseif punyaOrang then
            masihBase, sebab = false, "direbut"
        elseif not dasar then
            masihBase, sebab = false, "belumtau"
        elseif harga and harga > dasar then
            masihBase, sebab = false, "mahal"
        else
            masihBase = true
        end

        local okHarga = (not harga) or (state.petMaxHarga or 0) <= 0 or harga <= state.petMaxHarga
        local mampu   = (not harga) or harga <= shk
        local belumDicoba = not Seed._petCoba[uuid]

        if okJenis and masihBase and okHarga and mampu and belumDicoba then
            -- SEKALI COBA. Kalau gagal, berarti keburu disamber orang --
            -- ngulang cuma bikin ikut perang harga, persis yang dihindarin.
            -- v3.0: JANGAN tandai "udah dicoba" di sini. Dulu ditandai SEBELUM
            -- nyoba, jadi kalau gagal karena hal sementara (server telat
            -- daftarin posisi kita) pet itu gak pernah dicoba lagi selamanya --
            -- padahal masih perawan & masih harga dasar.
            -- Sekarang ditandai di BAWAH, dan cuma kalau jatah cobanya habis.
            local posisiAsal = hrp.CFrame
            local nempel = true
            local hb
            pcall(function()
                hb = game:GetService("RunService").Heartbeat:Connect(function()
                    if nempel and o.Parent and hrp and hrp.Parent then
                        pcall(function()
                            hrp.CFrame = o.CFrame + Vector3.new(0, 2.5, 0)
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end)
                    end
                end)
            end)

            -- v3.0: TUNGGU SAMPAI BENERAN DEKET, bukan asal jeda 0.2 detik.
            -- Nembak sebelum server ngakuin posisi baru kita = ditolak diam2,
            -- dan itu yang keliatan sebagai "teleport-teleport doang".
            local dekat = false
            for _ = 1, 15 do
                task.wait(0.06)
                if not o.Parent then break end
                local ok2, jarak = pcall(function()
                    return (hrp.Position - o.Position).Magnitude
                end)
                if ok2 and jarak and jarak < 6 then dekat = true break end
            end
            task.wait(0.25)   -- kasih waktu posisi itu ke-replikasi ke server

            -- v3.0: BERHASIL itu gak cuma "objeknya ilang".
            -- Pas pet dijinakin, entri di WildPetRef biasanya TETEP ADA --
            -- yang berubah OwnerUserId-nya. Versi lama cuma ngecek o.Parent,
            -- jadi berhasil pun kebaca gagal: nembak terus 6x lalu dilaporin
            -- gagal. Sekarang tiga tanda dicek.
            local hargaAwal = harga
            local function udahKena()
                if not o.Parent then return true end            -- objek ilang
                local uid = o:GetAttribute("OwnerUserId")
                if type(uid) == "number" and uid == MY_UID then return true end
                local onm = o:GetAttribute("OwnerName")
                if onm == player.Name then return true end
                -- harga berubah = ada yang ngeklaim (bisa kita, bisa orang)
                local h2 = hargaPet(o)
                if hargaAwal and h2 and h2 ~= hargaAwal then return true end
                return false
            end

            local kena = false
            local direbutOrang = false
            for _ = 1, 6 do
                if udahKena() then kena = true break end
                pcall(function() p:Fire(o) end)
                task.wait(0.22)
                if udahKena() then kena = true break end
            end
            nempel = false
            pcall(function() if hb then hb:Disconnect() end end)
            pcall(function() if hrp and hrp.Parent then hrp.CFrame = posisiAsal end end)

            -- v3.0: cek "direbut orang" LEPAS dari status kena. Dulu
            -- pengecekan ini cuma jalan kalau kena=true -- padahal pas
            -- direbut orang, kena justru FALSE. Jadi gak pernah kedeteksi,
            -- dan pet-nya masih dicoba lagi 2 putaran berikutnya percuma.
            if o.Parent then
                local uid = o:GetAttribute("OwnerUserId")
                local onm = o:GetAttribute("OwnerName")
                local punyaOrangLain =
                    (type(uid) == "number" and uid ~= 0 and uid ~= MY_UID)
                    or (type(onm) == "string" and onm ~= "" and onm ~= player.Name)
                if punyaOrangLain then
                    kena = false
                    direbutOrang = true
                end
            end

            -- v3.0: jatah coba. Gagal karena hal sementara boleh diulang di
            -- putaran berikutnya -- ITU BUKAN perang harga, selama pet-nya
            -- masih perawan & harganya masih dasar (dua-duanya udah dicek di
            -- saringan atas). Yang dihindarin itu nawar lebih mahal, bukan
            -- nyoba ulang di harga yang sama.
            if not kena then
                Seed._petGagal[uuid] = (Seed._petGagal[uuid] or 0) + 1
                if direbutOrang or Seed._petGagal[uuid] >= 3 then
                    Seed._petCoba[uuid] = true   -- nyerah, jangan ganggu lagi
                end
                if not dekat then
                    Seed._logPet = "teleport gak nyampe -- server nolak posisi"
                end
            else
                Seed._petCoba[uuid] = true
            end

            if kena then
                dapat = dapat + 1
                Seed.statPet = Seed.statPet + 1
                -- v2.1: JANGAN tempel ulang awalan mutasi kalau namanya emang
                -- udah ngandung (mis. "Mega Rainbow Black Dragon"). Dulu jadi
                -- "Rainbow Mega Mega Rainbow Black Dragon".
                local adaDiNama = Seed.mutasiDariNama(nama)
                local label = nama
                if tier ~= "Normal" and not (adaDiNama.Mega or adaDiNama.Big) then
                    label = tier .. " " .. label
                end
                if rb and not adaDiNama.Rainbow then label = "Rainbow " .. label end
                print(("[StarSeed] dapet pet: %s @ %s (dasar %s)%s")
                    :format(label, tostring(harga or "?"), tostring(dasar or "?"),
                            istimewa and "  <- MUTASI, harga diabaikan" or ""))
            end
        elseif okJenis then
            if sebab == "direbut" then direbut = direbut + 1
            elseif sebab == "belumtau" then belumTau = belumTau + 1
            elseif sebab == "mahal" or sebab == "mutasi_kemahalan" then
                kemahalan = kemahalan + 1 end
        end
    end

    if dapat > 0 then
        Seed._logPet = dapat .. " pet (harga dasar)"
    elseif direbut > 0 or kemahalan > 0 or belumTau > 0 then
        Seed._logPet = ("dilewat: %d direbut, %d mahal, %d blm tau dasar")
            :format(direbut, kemahalan, belumTau)
    else
        Seed._logPet = "gak ada pet yang dicari"
    end
    return dapat
end

