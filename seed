                print("       barang: (gak kekenali polanya)")
            end
            -- mentah SELALU dicetak: kalau penebak barang meleset, di sinilah
            -- bentuk aslinya keliatan -- itu yang dipakai buat mempertajam
            if #e.mentah > 0 then
                print("       mentah:")
                for j, m in ipairs(e.mentah) do
                    if j > 12 then print("         ... (" .. (#e.mentah - 12) .. " lagi)") break end
                    print("         " .. m:sub(1, 110))
                end
            end
        end
    end

    print("=================================================")
end
