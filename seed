    task.wait(6)
    while isCurrentGen() do
        pcall(Seed.refreshPasar)
        task.wait(30)
    end
end)

-- ============================================================
-- v1.3: TERIMA GIFT (mailbox)
-- Claim: Mailbox.Claim:Fire("<id>"), id dari nama frame Gift_<id> di
-- PlayerGui.MailboxUI.Frame.RecieveFrame.
-- Isi RecieveFrame cuma kebangun/keperbarui pas mailbox DIBUKA -> perlu dibuka
-- sesekali. Tapi tombol mailbox itu TOGGLE: kalau dibuka pas lagi kebuka,
-- malah NUTUP. Makanya dicek dulu, dan cuma dibuka KALAU ADA gift.
-- ============================================================
Seed.statGift = 0

-- ============================================================
-- v3.9: BACA ISI MAILBOX -- siapa ngirim, isinya apa.
--
-- Bentuk isi tiap gift BELUM PASTI (nama child bisa beda antar versi game),
-- jadi pembacanya SENGAJA gak nebak nama: dia nyisir seluruh keturunan tiap
-- frame Gift_*, ngumpulin SEMUA teks yang keliatan + SEMUA atribut. Cara ini
-- tetep jalan walau dev game ngubah susunannya.
--
-- Dari kumpulan itu baru ditebak mana yang pengirim & mana yang barang:
--   * atribut bernama Sender/From/Giver          -> pengirim
--   * teks yang cocok "xN" atau "Nama xN"        -> barang + jumlah
--   * sisanya disimpen apa adanya di `mentah`    -> biar gak ada info kebuang
--
-- Kalau nanti bentuk aslinya udah ketauan dari `mentah`, penebaknya bisa
-- dipertajam -- tapi jangan dihapus jaring sapuannya.
-- ============================================================
function Seed.isiMailbox()
    local out = {}
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local mb = pg and pg:FindFirstChild("MailboxUI")
        local frame = mb and mb:FindFirstChild("Frame")
        local recv = frame and frame:FindFirstChild("RecieveFrame")
        if not recv then return end

        for _, g in ipairs(recv:GetChildren()) do
            local id = tostring(g.Name):match("^Gift_(.+)$")
            if id and g:IsA("GuiObject") then
                local e = { id = id, dari = nil, barang = {}, mentah = {} }

                -- atribut di frame-nya sendiri
                pcall(function()
                    for k, v in pairs(g:GetAttributes()) do
                        local kl = tostring(k):lower()
                        if kl:find("sender") or kl:find("from") or kl:find("giver")
                           or kl:find("pengirim") then
                            e.dari = tostring(v)
                        else
                            e.mentah[#e.mentah+1] = tostring(k) .. "=" .. tostring(v)
                        end
                    end
                end)

                -- semua teks di dalamnya
                pcall(function()
                    for _, d in ipairs(g:GetDescendants()) do
                        if d:IsA("TextLabel") or d:IsA("TextButton") then
                            local t = tostring(d.Text or "")
                                :gsub("<[^>]->", "")          -- buang tag RichText
                                :gsub("%s+", " ")
                                :gsub("^%s+", ""):gsub("%s+$", "")
                            if t ~= "" and #t < 80 then
                                -- "Carrot x12" / "x12 Carrot" / "Carrot 12"
                                local nm, jm = t:match("^(.-)%s*[xX]%s*(%d+)$")
                                if not nm then jm, nm = t:match("^[xX]%s*(%d+)%s+(.+)$") end
                                if nm and jm and nm ~= "" then
                                    e.barang[#e.barang+1] = { n = nm, j = tonumber(jm) or 1 }
                                else
                                    -- pengirim kadang ditulis di TEKS, bukan atribut
                                    local dr = t:match("^[Ff]rom:?%s*(.+)$")
                                             or t:match("^[Dd]ari:?%s*(.+)$")
                                             or t:match("^[Ss]ent by:?%s*(.+)$")
                                    if dr and not e.dari then
                                        e.dari = dr
                                    else
                                        e.mentah[#e.mentah+1] = t
                                    end
                                end
                            end
                        end
                        -- atribut di keturunan juga (kadang data barangnya di sini)
                        pcall(function()
                            for k, v in pairs(d:GetAttributes()) do
                                e.mentah[#e.mentah+1] = d.Name .. "." .. tostring(k) .. "=" .. tostring(v)
                            end
                        end)
                    end
                end)

                out[#out+1] = e
            end
        end
