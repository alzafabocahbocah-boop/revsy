-- v3.79: DENYUT FILE -- tulis file penanda tiap 20 detik selama script hidup.
-- Script CUMA jalan kalau BENERAN di game (disconnect = script mati). Jadi file
-- ini = bukti "beneran main". Worker baca file lokal (0 request CF): kalau file
-- gak ke-update > 90 detik = script mati = disconnect -> rejoin. Lebih akurat
-- dari grafis RAM / activity (yang gak bisa bedain di-game vs layar disconnect).
-- File pakai NAMA AKUN biar gak ketimpa antar client (kalau share folder Delta):
--   zenx_denyut_<username>.txt  isi: "<os.time()>"
-- + file umum zenx_denyut.txt (client sendiri) buat cek cepat.
task.spawn(function()
    local nama = player.Name
    while isCurrentGen() do
        pcall(function()
            -- v4.01: cuma nulis denyut kalau BENERAN DI GAME. isCurrentGen() cuma
            -- cek generasi script (masih true walau keluar ke menu/loading). Bug:
            -- client keluar tapi script hidup -> denyut tetep nulis -> worker anggap
            -- di game. Fix: cek karakter + HRP ADA + di workspace (kalau keluar,
            -- karakter despawn -> denyut BERHENTI -> worker deteksi OUT).
            local ch = player.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            local diGame = hrp and hrp:IsDescendantOf(workspace)
            -- v4.38: TAMBAH cek GAME BENER-BENER SIAP (bukan cuma HRP ada). Bug
            -- user: client NYANGKUT di loading (mau masuk game) tapi HRP udah
            -- ke-spawn -> diGame true -> denyut ke-tulis FRESH -> worker kira udah
            -- masuk game, padahal masih loading/nyangkut. Fix: denyut cuma nulis
            -- kalau game LOADED + Humanoid HIDUP (Health>0). Loading blm kelar ->
            -- IsLoaded false / Humanoid blm ada -> denyut BERHENTI -> worker tau
            -- masih nyangkut -> rejoin. Denyut = tanda BENERAN MAIN, bukan loading.
            local siapMain = false
            if diGame then
                local okS = pcall(function()
                    local loaded = game:IsLoaded()
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    local hidup = hum and hum.Health > 0
                    siapMain = loaded and hidup and true or false
                end)
                if not okS then siapMain = false end
            end
            -- v4.37: cek DISCONNECT (server putus tapi karakter blm despawn).
            local dc = false
            if Seed and Seed.cekDisconnectAndal then
                local okc, hasil = pcall(Seed.cekDisconnectAndal)
                dc = okc and hasil == true
            end
            if writefile and siapMain and not dc then
                local ts = tostring(os.time())
                writefile("zenx_denyut_" .. nama .. ".txt", ts)
                writefile("zenx_denyut.txt", nama .. " " .. ts)
            end
        end)
        task.wait(20)
    end
end)

-- v3.24: STREAMING nyala di game ini -> objek jauh (pet liar, dll) gak ke-load
-- di client, jadi dianggap hilang. Perbesar radius streaming SEKALI di awal
-- biar area lebih luas ke-load (pet liar lebih jauh tetep kebaca). Aman: cuma
-- naikin target radius, gak ngubah gameplay.
task.spawn(function()
    pcall(function()
        if workspace.StreamingEnabled then
            pcall(function() workspace.StreamingTargetRadius = 2048 end)
            pcall(function() workspace.StreamingMinRadius = 512 end)
        end
    end)
end)

