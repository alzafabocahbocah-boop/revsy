function Seed.pakaiCfgPanel(r)
    if not state.ikutPanel then return end
    local body = r and (r.Body or r.body)
    if not body then
        Seed._cfgLog = "GAGAL: panel gak jawab"
        if not Seed._cfgWarn then Seed._cfgWarn = true
            warn("[StarSeed] setelan panel GAK KEBACA: panel gak jawab") end
        return
    end

    local ok, d = pcall(function() return HS:JSONDecode(body) end)
    if not ok or type(d) ~= "table" then
        Seed._cfgLog = "GAGAL: jawaban gak kebaca"
        return
    end
    -- v3.1: kalau backend belum di-deploy, CF balikin {"error":"jalur gak
    -- dikenal: /seed-cfg"}. Dulu ini diem-diem dianggap "gak ada perubahan"
    -- -- makanya setelan panel keliatan diabaikan tanpa ada tanda apa pun.
    if type(d.error) == "string" then
        Seed._cfgLog = "GAGAL: " .. d.error
        if not Seed._cfgWarn then
            Seed._cfgWarn = true
            warn("[StarSeed] SETELAN PANEL GAK KEPAKAI -> " .. d.error)
            warn("[StarSeed] Backend Cloudflare kemungkinan belum di-deploy.")
            warn("[StarSeed] Sementara ini script pakai setelan LOKAL (GUI).")
        end
        return
    end
    if type(d.cfg) ~= "table" then
        Seed._cfgLog = "GAGAL: jawaban tanpa cfg"
        return
    end
    local c = d.cfg
    local ubah = {}

    -- v4.15: MINTA INVENTORY FRESH. Panel set flag (via /inv-minta) -> nyelip di
    -- response ini (d.mintaInv). Kalau true, KIRIM inventory sekarang juga (gak
    -- nunggu siklus 30s/5menit). Buat panel "cek inventory akun ini fresh".
    if d.mintaInv == true or d.mintaInv == player.Name then
        pcall(function()
            local arr, total = seedDiTas()
            local wcR, sprR, swcR, ssprR = gearDiTas()
            local bersih = {}
            for _, e in ipairs(arr) do bersih[#bersih+1] = { n = e.n, j = e.j, r = e.r } end
            panelReq("/inv", "POST", {
                akun = player.Name, seeds = bersih,
                gears = Seed.gearDiTas(), pets = Seed.petDiTas(),
                totSeed = total, superWC = wcR, superSpr = sprR,
                superSyrupWC = swcR, superSyrupSpr = ssprR,
