-- ============================================================
-- v2.9: RINGANKAN RAM
--
-- Akun ini CUMA beli seed/gear/pet, terima gift, jual buah dari tas. Dia GAK
-- PERNAH baca kebun -- udah dicek: gak ada satu pun bagian script yang
-- nyentuh workspace.Gardens / Plants / Fruits. Buah buat dijual diambil dari
-- TAS & KARAKTER (lihat pemegangBuah), bukan dari kebun.
--
-- Jadi buat akun ini, kebun itu murni beban: ribuan Part yang gak ada yang
-- baca. Sama juga Sound -- gak ada yang dengerin.
--
-- Bukti lapangan kenapa Suara diprioritasin: ngapus 242 Sound nurunin RAM
-- 93 MB, sedangkan ngapus 3.755 objek kebun cuma 8 MB. Satu Part beberapa
-- ratus byte; tiap Sound megang data audio sendiri.
--
-- YANG GAK BOLEH DISENTUH (dipakai script ini):
--   Backpack & Character  -> isi tas, buah buat dijual
--   Map.WildPetRef/Spawns -> jinakin pet
--   StockValues           -> stok toko
--   PlayerGui             -> harga pasar, mailbox, guild
-- Empat itu semua di LUAR workspace.Gardens, jadi aman.
--
-- Bawaannya MATI. Ini ngapus barang -- harus dinyalain sadar-sadar.
-- ============================================================
Seed.statRingan = { suara = 0, kebun = 0 }

local function ringanSuara()
    local n = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Sound") then
            pcall(function() d:Destroy() end)
            n = n + 1
            if n % 60 == 0 then task.wait() end
        end
    end
    pcall(function()
        local ss = game:GetService("SoundService")
        for _, d in ipairs(ss:GetDescendants()) do
            if d:IsA("Sound") then pcall(function() d:Destroy() end); n = n + 1 end
        end
    end)
    return n
end

local function ringanKebun()
    local n = 0
    local g = workspace:FindFirstChild("Gardens")
    if not g then return 0 end
    -- ISI-nya yang dihapus, foldernya DIBIARIN. Kalau foldernya ikut kehapus,
    -- client game bisa bingung pas server ngirim data kebun baru.
    for _, plot in ipairs(g:GetChildren()) do
        local isi = #plot:GetDescendants()
        pcall(function() plot:Destroy() end)
        n = n + isi
        task.wait()
    end
    return n
end

function Seed.ringankan()
    if state.ringanSuara then
        local ok, n = pcall(ringanSuara)
        if ok then Seed.statRingan.suara = Seed.statRingan.suara + n end
    end
    if state.ringanKebun then
        local ok, n = pcall(ringanKebun)
        if ok then Seed.statRingan.kebun = Seed.statRingan.kebun + n end
    end
end

