-- true / false / nil (nil = gak bisa dipastiin)
local function seedUdahRilis(nama)
    if Seed._seedEnabled == nil then
        Seed._seedEnabled = false
        pcall(function()
            local sm = RS:FindFirstChild("SharedModules")
            local m = sm and sm:FindFirstChild("SeedShopEnabled")
            if not m then return end
            local ok, mod = pcall(require, m)
            if ok and type(mod) == "table" and type(mod.IsSeedEnabled) == "function" then
                Seed._seedEnabled = mod
            end
        end)
    end
    if not Seed._seedEnabled then return nil end
    local ok, hasil = pcall(Seed._seedEnabled.IsSeedEnabled, nama)
    if ok and type(hasil) == "boolean" then return hasil end
    return nil
end

function Seed.kirimKatalog()
    if not panelAktif() then return end

    local pets = {}
    local detail = {}     -- v2.3: rincian per pet buat ditampilin di panel
    pcall(function()
        local mod = bacaPetModules()
        if mod then
            for k, v in pairs(mod) do
                if type(k) == "string" and not k:match("^_") and type(v) == "table" then
                    pets[#pets+1] = k
                end
            end
        end
        -- rincian dari SharedData.PetData: harga dasar, rarity, peluang spawn.
        -- SpawnChance = 0 artinya BELUM RILIS -- pet-nya ada di data tapi gak
        -- pernah spawn liar. Kalau gak ditandai, orang bisa milih pet yang
        -- mustahil didapat dan bingung kenapa gak pernah kena.
        local pd = bacaPetData()
        if pd then
            for k, v in pairs(pd) do
                if type(k) == "string" and type(v) == "table" then
                    local sc = tonumber(v.SpawnChance)
                    detail[k] = {
                        tampil = tostring(v.DisplayName or k),
                        harga  = tonumber(v.BasePrice) or 0,
                        rarity = tostring(v.Rarity or "?"),
                        spawn  = sc,
                        rilis  = not (sc ~= nil and sc <= 0),
                    }
                    local ada = false
                    for _, n in ipairs(pets) do if n == k then ada = true break end end
                    if not ada then pets[#pets+1] = k end
                end
            end
        end
        -- pet liar yang lagi spawn (jaga-jaga ada yang gak ada di modul)
        local map = workspace:FindFirstChild("Map")
        local ref = map and map:FindFirstChild("WildPetRef")
        if ref then
            local ada = {}
            for _, n in ipairs(pets) do ada[n] = true end
            for _, o in ipairs(ref:GetChildren()) do
                local pn = o:GetAttribute("PetName")
                if pn and not ada[tostring(pn)] then
                    pets[#pets+1] = tostring(pn); ada[tostring(pn)] = true
                end
            end
        end
    end)

    if not Seed.daftar then Seed.daftar = muatDaftarSeed() end
    local seeds = {}
    local nilai = muatNilaiJual()
    for _, n in ipairs(Seed.daftar) do
        seeds[#seeds+1] = n
        local rilis = seedUdahRilis(n)
        local jual = nilai[n]
        if jual or rilis ~= nil then
            detail[n] = {
                tampil = n,
                harga  = jual or 0,      -- buat seed, "harga" = nilai jual buahnya
                rarity = Seed.rarity(n) or "?",
                rilis  = (rilis ~= false),
            }
        end
    end

    if #pets == 0 and #seeds == 0 then return end

    local r = panelReq("/katalog", "POST", { pets = pets, seeds = seeds, detail = detail })
    local body = r and (r.Body or r.body)
    if body then
        local ok, d = pcall(function() return HS:JSONDecode(body) end)
        if ok and type(d) == "table" and type(d.baru) == "table" then
            local nP = #(d.baru.pets or {})
            local nS = #(d.baru.seeds or {})
            if nP > 0 or nS > 0 then
                print(("[StarSeed] KATALOG: %d pet baru, %d seed baru -> dilaporin ke panel")
                    :format(nP, nS))
                if nP > 0 then print("   pet  : " .. table.concat(d.baru.pets, ", ")) end
                if nS > 0 then print("   seed : " .. table.concat(d.baru.seeds, ", ")) end
            end
        end
    end
end

