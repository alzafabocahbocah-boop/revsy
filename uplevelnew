local function doCollect(fruits)
    unequipCurrentTool()
    local collected = 0
    local pending = #fruits
    local done = (pending == 0)
    for _, fruit in ipairs(fruits) do
        task.spawn(function()
            local ok, prompt = pcall(getFruitPrompt, fruit)
            if ok and prompt then
                pcall(fireproximityprompt, prompt)
                collected = collected + 1
            end
            pending = pending - 1
            if pending <= 0 then done = true end
        end)
    end
    local t0 = tick()
    while not done and tick()-t0 < 1 do task.wait(0.01) end
    return collected
end

local function processFruits()
    local data=scanFruits()
    _lastMutasiCount = #data.shovel
    addLog("scan: mutasi="..#data.shovel.." nm="..data.nightmareCount)

    if #data.shovel > 0 then
        -- ada mutasi non-nightmare -> switch ke cadangan 1, loop sampai habis
        local needCadangan = _activeSesiDef ~= nil and _activeSesiDef ~= SESI_CADANGAN_DEF
        if needCadangan then
            addLog("Mutasi ditemukan — switch cadangan 1 (M.Oct×7 + Spider)")
            setStatus("Cadangan 1 — collect mutasi...", Color3.fromRGB(160,120,220))
            unequipAll()
            equipSesi(3, SESI_CADANGAN_DEF)
        end

        -- loop collect sampai tidak ada mutasi lagi
        local fruits = data.shovel
        while #fruits > 0 and not stopRequested do
            local collected = doCollect(fruits)
            totalShovel = totalShovel + collected
            _fruitCollectedSinceLastSell = _fruitCollectedSinceLastSell + collected
            addLog("Collect: "..collected.."/"..#fruits.." | tas: ".._fruitCollectedSinceLastSell.."/"..SELL_THRESHOLD)
            -- sell kalau sudah >= threshold
            if _fruitCollectedSinceLastSell >= SELL_THRESHOLD then
                task.wait(0.1)
                addLog("Sell! (tas ".._fruitCollectedSinceLastSell.." >= "..SELL_THRESHOLD..")")
                sellInventory()
                _fruitCollectedSinceLastSell = 0
            end
            -- scan lagi — jeda singkat biar server proses collect
            task.wait(0.3)
            local next = scanFruits()
            _lastMutasiCount = #next.shovel
            fruits = next.shovel
            if #fruits > 0 then
                addLog("Masih ada "..#fruits.." mutasi — lanjut collect")
            end
        end

        -- balik ke sesi aktif sebelumnya
        if needCadangan and _activeSesiDef and not stopRequested then
            addLog("Mutasi habis — balik sesi ".._activeSesiNum)
            setStatus("Sesi ".._activeSesiNum.." — balik equip", C.accent)
            unequipAll()
            equipSesi(_activeSesiNum, _activeSesiDef)
            setStatus("Sesi ".._activeSesiNum.." — running", C.accent)
        end
    elseif data.nightmareCount == 0 and _activeSesiDef ~= nil and _activeSesiDef ~= SESI_CADANGAN2_DEF then
        -- tidak ada nightmare DAN tidak ada mutasi -> masuk cadangan 2 (Peacock×4 + Baku×1)
        -- tunggu nightmare muncul lagi, lalu balik ke sesi aktif sebelumnya
        addLog("Nightmare 0 + no mutasi — masuk Cadangan 2 (Peacock×7 + Baku×1)")
        setStatus("Cadangan 2 — tunggu nightmare...", Color3.fromRGB(78,200,130))
        local prevSesiNum = _activeSesiNum
        local prevSesiDef = _activeSesiDef
        unequipAll()
        equipSesi(4, SESI_CADANGAN2_DEF)
        -- fav 1 buah random dari backpack (biar cepat dideteksi dapat mutasi nightmare)
        local _favFruitId = nil
        task.spawn(function()
            task.wait(2)  -- tunggu biar farm fruits load
            local farmFruits = getFruitsFromFarm()
            -- prioritas: pilih nightmare fruit (biar fav nightmare, gak ke-shovel)
            -- kalau gak ada nightmare, pilih buah random
            local pick = nil
            for _,f in ipairs(farmFruits) do
                if f.obj:GetAttribute("Nightmare") == true then pick = f; break end
            end
            if not pick and #farmFruits > 0 then
                pick = farmFruits[math.random(1, #farmFruits)]
            end
            if pick then
                _favFruitId = pick.id
                setFruitFav(pick.id, true)
                addLog("Cad2: fav buah id="..tostring(pick.id):sub(1,12))
            else
                addLog("Cad2: gak ada buah di farm untuk di-fav")
            end
        end)
        -- loop scan sampai nightmare muncul DAN tidak ada mutasi lain
        while not stopRequested do
            task.wait(CFG.loopWait)
            local d2 = scanFruits()
            _lastMutasiCount = #d2.shovel
            addLog("Cad2 scan: nm="..d2.nightmareCount.." mutasi="..#d2.shovel)
            -- kalau ada mutasi non-nightmare -> keluar cadangan 2 (akan dihandle cadangan 1 di loop utama)
            if #d2.shovel > 0 then
                addLog("Ada mutasi lain — keluar Cad2, masuk Cad1 di loop")
                break
            end
            -- nightmare muncul lagi -> balik sesi aktif
            if d2.nightmareCount > 0 then
                addLog("Nightmare muncul! Balik sesi "..prevSesiNum)
                -- unfav buah yang tadi di-fav (sudah dapat mutasi nightmare-nya)
                if _favFruitId then
                    setFruitFav(_favFruitId, false)
                    addLog("Cad2: unfav buah id="..tostring(_favFruitId):sub(1,12))
                    _favFruitId = nil
                end
                break
            end
        end
        -- pastikan unfav kalau keluar karena alasan lain (mutasi lain / stop)
        if _favFruitId then
            setFruitFav(_favFruitId, false)
            addLog("Cad2: unfav buah (keluar loop) id="..tostring(_favFruitId):sub(1,12))
            _favFruitId = nil
        end
        if not stopRequested then
            setStatus("Sesi "..prevSesiNum.." — balik equip", C.accent)
            unequipAll()
            _activeSesiNum = prevSesiNum
            _activeSesiDef = prevSesiDef
            equipSesi(prevSesiNum, prevSesiDef)
            setStatus("Sesi "..prevSesiNum.." — running", C.accent)
        end
    end

    return data.nightmareCount
end

