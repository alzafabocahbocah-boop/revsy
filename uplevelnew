                                        local mp = rawget(obj, "MaxPetsInInventory")
                                        if type(mp) == "number" and mp > 0
                                            and rawget(obj, "MaxEggsInFarm") ~= nil
                                            and rawget(obj, "MaxEquippedPets") ~= nil
                                            and mp >= floor then
                                            tally[mp] = (tally[mp] or 0) + 1
                                        end
