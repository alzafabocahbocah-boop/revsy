                            end)
                            local bestN, bestV = 0, nil
                            for v, n in pairs(tally) do
                                if n > bestN or (n == bestN and (not bestV or v < bestV)) then
                                    bestV = v; bestN = n
                                end
                            end
                            maxUI = bestV
                        end
                        _G.__ZenxMaxPetCache = maxUI or _G.__ZenxMaxPetCache
