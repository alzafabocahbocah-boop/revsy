-- reduclag: reduce FPS lag dari game GAG
-- standalone script, jalanin terpisah dari up6kg
-- v1.2

local VERSION = "reduclag-v1.2"
print("[ReducLag] " .. VERSION .. " start")

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

-- ============ CONFIG ============
local CFG = {
    disableShadows      = true,
    disableParticles    = true,
    disableFog          = true,
    disableBloom        = true,
    disableTerrainDecor = true,
    disableWeather      = true,   -- WeatherVisuals + WindBlastTemplate
    disableSky          = true,   -- Sky + Atmosphere di Lighting
    disableColorFX      = true,   -- semua ColorCorrection + Blur weather effect
    cleanupInterval     = 10,
}

-- ============ APPLY FUNCTIONS ============
local function applyShadows(on)
    pcall(function()
        Lighting.GlobalShadows = not on
        Lighting.ShadowSoftness = on and 0 or 0.5
    end)
end

local function applyFog(on)
    pcall(function()
        Lighting.FogEnd   = on and 100000 or 1000
        Lighting.FogStart = on and 99999  or 0
    end)
end

local function applyBloom(on)
    pcall(function()
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("BloomEffect") then
                v.Enabled = not on
            end
        end
    end)
end

local function disableParticlesIn(obj)
    pcall(function()
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("Trail")
            or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
                d.Enabled = false
                if d:IsA("ParticleEmitter") then pcall(function() d.Rate = 0 end) end
            end
        end
    end)
end

local function applyParticles(on)
    if on then disableParticlesIn(workspace) end
end

local function applyTerrain(on)
    pcall(function()
        local t = workspace:FindFirstChildOfClass("Terrain")
        if t then t.Decoration = not on end
    end)
end

-- matiin WeatherVisuals folder + WindBlastTemplate trail
local function applyWeather(on)
    pcall(function()
        -- WeatherVisuals: disable semua particle
        local wv = workspace:FindFirstChild("WeatherVisuals")
        if wv then
            if on then
                disableParticlesIn(wv)
            end
        end
        -- WindBlastTemplate: disable trail (sumber lag mutasi angin)
        local wb = workspace:FindFirstChild("WindBlastTemplate")
        if wb then
            for _, d in ipairs(wb:GetDescendants()) do
                if d:IsA("Trail") or d:IsA("Beam") or d:IsA("ParticleEmitter") then
                    d.Enabled = not on
                end
            end
        end
    end)
end

-- matiin Sky + Atmosphere di semua folder Lighting
local function applySky(on)
    pcall(function()
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("Sky") or v:IsA("Atmosphere") then
                pcall(function() v.Parent:FindFirstChildOfClass("Sky") and true end)
                -- destroy sky biar render langit plain (lebih ringan)
                if on then v:Destroy() end
            end
        end
    end)
end

-- matiin semua ColorCorrection + Blur + SunRays + DepthOfField (weather effects)
local function applyColorFX(on)
    pcall(function()
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect")
            or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
                v.Enabled = not on
            end
        end
    end)
end

local function applyAll()
    applyShadows(CFG.disableShadows)
    applyFog(CFG.disableFog)
    applyBloom(CFG.disableBloom)
    applyParticles(CFG.disableParticles)
    applyTerrain(CFG.disableTerrainDecor)
    applyWeather(CFG.disableWeather)
    applySky(CFG.disableSky)
    applyColorFX(CFG.disableColorFX)
end

-- ============ GUI ============
local AQ   = Color3.fromRGB(78, 214, 204)
local WH   = Color3.fromRGB(255, 255, 255)
local GR   = Color3.fromRGB(110, 110, 110)
local BG   = Color3.fromRGB(12, 12, 12)
local BG2  = Color3.fromRGB(22, 22, 22)
local RED  = Color3.fromRGB(235, 40, 40)
local ORG  = Color3.fromRGB(245, 158, 11)
local GRN  = Color3.fromRGB(34, 197, 94)

local fpsSamples = {}
local fpsLbl = nil
local gui = nil

local function avgFPS()
    if #fpsSamples == 0 then return 0 end
    local s = 0; for _, v in ipairs(fpsSamples) do s = s + v end
    return math.floor(s / #fpsSamples)
end

local function buatGui()
    pcall(function()
        local lp = Players.LocalPlayer
        local par = lp:FindFirstChildOfClass("PlayerGui") or game:GetService("CoreGui")
        local old = par:FindFirstChild("ReducLagGui"); if old then old:Destroy() end

        local sg = Instance.new("ScreenGui")
        sg.Name = "ReducLagGui"; sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true; sg.DisplayOrder = 999997
        sg.Parent = par
        gui = sg

        -- WRAPPER (scale)
        local wrap = Instance.new("Frame"); wrap.Size = UDim2.new(1,0,1,0)
        wrap.BackgroundTransparency = 1; wrap.Parent = sg
        local scale = Instance.new("UIScale"); scale.Scale = 1.8; scale.Parent = wrap

        -- MAIN FRAME — height dinaikkan untuk 8 toggle
        local fr = Instance.new("Frame")
        fr.Size = UDim2.new(0, 200, 0, 310)
        fr.Position = UDim2.new(0, 8/1.8, 0.5, -155/1.8)
        fr.AnchorPoint = Vector2.new(0, 0.5)
        fr.BackgroundColor3 = BG; fr.BackgroundTransparency = 0.08
        fr.BorderSizePixel = 0; fr.Parent = wrap
        Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 12)
        local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(38,38,38); st.Thickness = 1.5; st.Parent = fr
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0,10); pad.PaddingBottom = UDim.new(0,10)
        pad.PaddingLeft = UDim.new(0,10); pad.PaddingRight = UDim.new(0,10)
        pad.Parent = fr
        local vlist = Instance.new("UIListLayout")
        vlist.FillDirection = Enum.FillDirection.Vertical
        vlist.Padding = UDim.new(0, 6); vlist.SortOrder = Enum.SortOrder.LayoutOrder
        vlist.Parent = fr

        -- HEADER
        local hdr = Instance.new("Frame"); hdr.Size = UDim2.new(1,0,0,20)
        hdr.BackgroundTransparency = 1; hdr.LayoutOrder = 1; hdr.Parent = fr
        local dot = Instance.new("Frame"); dot.Size = UDim2.new(0,8,0,8)
        dot.Position = UDim2.new(0,0,0.5,-4); dot.BackgroundColor3 = AQ
        dot.BorderSizePixel = 0; dot.Parent = hdr
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1,0)
        local ttl = Instance.new("TextLabel"); ttl.BackgroundTransparency = 1
        ttl.Font = Enum.Font.GothamBold; ttl.TextSize = 13; ttl.TextColor3 = AQ
        ttl.Text = "REDUCLAG"; ttl.Position = UDim2.new(0,14,0,0)
        ttl.Size = UDim2.new(1,-14,1,0); ttl.TextXAlignment = Enum.TextXAlignment.Left
        ttl.Parent = hdr

        -- FPS ROW
        local fpsRow = Instance.new("Frame"); fpsRow.Size = UDim2.new(1,0,0,28)
        fpsRow.BackgroundColor3 = BG2; fpsRow.BorderSizePixel = 0; fpsRow.LayoutOrder = 2; fpsRow.Parent = fr
        Instance.new("UICorner", fpsRow).CornerRadius = UDim.new(0,8)
        local fpsVal = Instance.new("TextLabel"); fpsVal.BackgroundTransparency = 1
        fpsVal.Font = Enum.Font.GothamBold; fpsVal.TextSize = 18; fpsVal.TextColor3 = AQ
        fpsVal.Text = "--"; fpsVal.AnchorPoint = Vector2.new(1,0.5)
        fpsVal.Position = UDim2.new(1,-8,0.5,0); fpsVal.Size = UDim2.new(0,60,1,0)
        fpsVal.TextXAlignment = Enum.TextXAlignment.Right; fpsVal.Parent = fpsRow
        local fpsLb = Instance.new("TextLabel"); fpsLb.BackgroundTransparency = 1
        fpsLb.Font = Enum.Font.GothamSemibold; fpsLb.TextSize = 11; fpsLb.TextColor3 = GR
        fpsLb.Text = "FPS (avg 60f)"; fpsLb.Position = UDim2.new(0,8,0,0)
        fpsLb.Size = UDim2.new(1,-70,1,0); fpsLb.TextXAlignment = Enum.TextXAlignment.Left
        fpsLb.Parent = fpsRow
        fpsLbl = fpsVal

        -- DIVIDER
        local div = Instance.new("Frame"); div.Size = UDim2.new(1,0,0,1)
        div.BackgroundColor3 = Color3.fromRGB(38,38,38); div.BorderSizePixel = 0
        div.LayoutOrder = 3; div.Parent = fr

        -- TOGGLE ROWS
        local toggles = {
            { key = "disableShadows",      label = "Shadows OFF" },
            { key = "disableParticles",    label = "Particles OFF" },
            { key = "disableBloom",        label = "Bloom OFF" },
            { key = "disableFog",          label = "Fog OFF" },
            { key = "disableTerrainDecor", label = "Terrain Decor OFF" },
            { key = "disableWeather",      label = "Weather FX OFF" },
            { key = "disableSky",          label = "Sky/Atmos OFF" },
            { key = "disableColorFX",      label = "Color FX OFF" },
        }

        local applyMap = {
            disableShadows      = applyShadows,
            disableParticles    = applyParticles,
            disableBloom        = applyBloom,
            disableFog          = applyFog,
            disableTerrainDecor = applyTerrain,
            disableWeather      = applyWeather,
            disableSky          = applySky,
            disableColorFX      = applyColorFX,
        }

        for i, tog in ipairs(toggles) do
            local row = Instance.new("Frame"); row.Size = UDim2.new(1,0,0,22)
            row.BackgroundTransparency = 1; row.BorderSizePixel = 0
            row.LayoutOrder = 3 + i; row.Parent = fr

            local lbl = Instance.new("TextLabel"); lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.GothamSemibold; lbl.TextSize = 11; lbl.TextColor3 = WH
            lbl.Text = tog.label; lbl.Position = UDim2.new(0,0,0,0)
            lbl.Size = UDim2.new(1,-44,1,0); lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            local pill = Instance.new("Frame"); pill.Size = UDim2.new(0,36,0,18)
            pill.AnchorPoint = Vector2.new(1,0.5); pill.Position = UDim2.new(1,0,0.5,0)
            pill.BackgroundColor3 = CFG[tog.key] and GRN or Color3.fromRGB(60,60,60)
            pill.BorderSizePixel = 0; pill.Parent = row
            Instance.new("UICorner", pill).CornerRadius = UDim.new(1,0)

            local knob = Instance.new("Frame"); knob.Size = UDim2.new(0,14,0,14)
            knob.AnchorPoint = Vector2.new(0,0.5)
            knob.Position = CFG[tog.key] and UDim2.new(1,-16,0.5,0) or UDim2.new(0,2,0.5,0)
            knob.BackgroundColor3 = WH; knob.BorderSizePixel = 0; knob.Parent = pill
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

            local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1,0,1,0)
            btn.BackgroundTransparency = 1; btn.Text = ""; btn.Parent = row

            local key = tog.key
            btn.MouseButton1Click:Connect(function()
                CFG[key] = not CFG[key]
                local on = CFG[key]
                pill.BackgroundColor3 = on and GRN or Color3.fromRGB(60,60,60)
                knob.Position = on and UDim2.new(1,-16,0.5,0) or UDim2.new(0,2,0.5,0)
                if applyMap[key] then applyMap[key](on) end
                print("[ReducLag] " .. key .. " = " .. tostring(on))
            end)
        end
    end)
end

-- ============ MAIN ============
buatGui()
applyAll()

-- FPS counter
task.spawn(function()
    local last = tick()
    while true do
        task.wait()
        local now = tick(); local dt = now - last; last = now
        local fps = dt > 0 and math.floor(1/dt) or 0
        fpsSamples[#fpsSamples+1] = fps
        if #fpsSamples > 60 then table.remove(fpsSamples, 1) end
        if fpsLbl then
            local avg = avgFPS()
            fpsLbl.TextColor3 = avg >= 45 and AQ or avg >= 25 and ORG or RED
            fpsLbl.Text = tostring(avg)
        end
    end
end)

-- cleanup loop: re-apply tiap interval (weather bisa spawn ulang)
task.spawn(function()
    while true do
        task.wait(CFG.cleanupInterval)
        if CFG.disableParticles then disableParticlesIn(workspace) end
        if CFG.disableWeather then applyWeather(true) end
        applyShadows(CFG.disableShadows)
        applyBloom(CFG.disableBloom)
        applyColorFX(CFG.disableColorFX)
    end
end)

print("[ReducLag] running — toggle via GUI")
