-- skor pet buat sortir (kg / koi% / bronto% / seal%)
local function _skorPet(p, sortir)
    local kg = p.dispKg or 0
    if sortir == "koi" then
        return PetDetect.koiPct(kg, p.mut)
    elseif sortir == "bronto" then
        return PetDetect.brontoPct(kg, p.mut)
    elseif sortir == "seal" then
        local bw = (p.age1Kg and p.age1Kg > 0) and (p.age1Kg / 1.1) or kg
        return PetDetect.sealPct(bw, p.level or 1, p.mut)
    else
        return kg   -- default: KG
    end
end
local function _cocokTipe(nm, tipe)
    return (((nm or ""):lower()):find(tipe:lower(), 1, true)) ~= nil
end

-- auto-pick pet ke 1 tim sesuai komposisi (tipe + jumlah + sortir). balikin jumlah.
local function autoPickTeam(tabName, spec)
    local pets = PetDetect.listBackpackPets(true)
    local selected = {}
    for _, slot in ipairs(spec) do
        local kandidat = {}
        for _, p in ipairs(pets) do
            if not selected[p.uuid] and _cocokTipe(p.name, slot.tipe) then
                table.insert(kandidat, p)
            end
        end
        -- fallback: tipe utama gak ada -> pakai 'ganti' (mis Bald Eagle -> Birb)
        if #kandidat == 0 and slot.ganti then
            for _, p in ipairs(pets) do
                if not selected[p.uuid] and _cocokTipe(p.name, slot.ganti) then
                    table.insert(kandidat, p)
                end
            end
        end
        table.sort(kandidat, function(a, b)
            return _skorPet(a, slot.sortir) > _skorPet(b, slot.sortir)   -- skor tertinggi dulu
        end)
        for i = 1, math.min(slot.jml, #kandidat) do
            selected[kandidat[i].uuid] = true
        end
    end
    if teamData[tabName] then teamData[tabName].selected = selected end
    local c = 0; for _ in pairs(selected) do c = c + 1 end
    return c
end

-- terapin preset: egg + komposisi tim
local function applyPresetHact(name)
    local ps = PRESET_HACT[name]
    if not ps then return false, 0 end
    config.eggSelected = {}
    for _, e in ipairs(ps.egg) do config.eggSelected[e] = true end
    config.komposisi = ps.komposisi   -- v27.40: simpen tim pet yg dipakai (buat lapor panel)
    config.petPool = nil
    if ps.petPool then config.petPool = {}; for _, pn in ipairs(ps.petPool) do config.petPool[pn] = true end end
    config.keepOnly = ps.keepOnly or false   -- v27.50: keep CUMA petPool, sisanya jual (mis Paradise Egg keep Peacock)
    local total = 0
    for tabName, spec in pairs(ps.komposisi) do
        total = total + autoPickTeam(tabName, spec)
    end
    -- sell-rule hasil hatch (kalau preset punya)
    if ps.sellRules then
        config.sellRules = {}
        for pet, rule in pairs(ps.sellRules) do
            config.sellRules[pet] = { action = rule.action, kg = rule.kg }
        end
    end
    print(("[HactTelur] Preset '%s' diterapin: egg=%s | %d pet kepilih ke tim | sellRules=%s")
        :format(name, table.concat(ps.egg, ","), total, ps.sellRules and "ya" or "-"))
    return true, total
end
