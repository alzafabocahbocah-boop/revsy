local function makeManualPanel()
    local panel = mk("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Visible = true, Parent = manualContent })

    local judul = lbl(panel, "Manual Sell", 14, C.text)
    judul.Font = FONT_B; judul.Position = UDim2.new(0,0,0,0); judul.Size = UDim2.new(1,-100,0,22)
    local info = lbl(panel, "Pilih pet -> auto-unfav -> Sell Pet (ada konfirmasi)", 11, C.textDim)
    info.Position = UDim2.new(0,0,0,22); info.Size = UDim2.new(1,-100,0,16)

    local refBtn = mk("TextButton", {
        Size = UDim2.new(0,90,0,26), Position = UDim2.new(1,-90,0,0),
        BackgroundColor3 = C.input, Text = "\u{21BB} Refresh", Font = FONT, TextSize = 21,
        TextColor3 = C.accent, AutoButtonColor = true, Parent = panel })
    corner(refBtn, 6)

    local list = mk("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -90), Position = UDim2.new(0,0,0,46),
        BackgroundTransparency = 1, ScrollBarThickness = 4, ScrollBarImageColor3 = C.border,
        CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel })
    mk("UIListLayout", { Padding = UDim.new(0,4), Parent = list })

    local dipilih = {}   -- {[tipe]=true} tipe pet yg mau dijual

    -- jenis DASAR pet (buang prefix mutasi biar "Golden Newt" & "Newt" = 1 jenis)
    local function jenisDasar(p)
        local nm = p.name or "?"
        local mut = p.mut
        if mut and mut ~= "" then
            local pre = (mut:lower()) .. " "
            if nm:lower():sub(1, #pre) == pre then
                nm = nm:sub(#pre + 1)   -- buang prefix mutasi di depan
            end
        end
        nm = nm:gsub("^%s+", ""):gsub("%s+$", "")
        return (nm ~= "" and nm) or (p.name or "?")
    end

    local function refresh()
        for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        -- group pet backpack by JENIS DASAR (mutasi diabaikan) + hitung jumlah
        local grup = {}
        for _, p in ipairs(PetDetect.listBackpackPets(true)) do
            local jd = jenisDasar(p)
            local g = grup[jd]
            if not g then g = { count=0, fav=0, pets={} }; grup[jd] = g end
            g.count = g.count + 1
            if p.fav then g.fav = g.fav + 1 end
            table.insert(g.pets, p)
        end
        local names = {}
        for nm in pairs(grup) do table.insert(names, nm) end
        table.sort(names, function(a,b) return grup[a].count > grup[b].count end)  -- terbanyak dulu
