        pruneTeamBekasan(tabName)  -- v24.8: buang bekasan dulu biar hitungan akurat
        local cnt = 0
        for _ in pairs(sel) do cnt = cnt + 1 end
        teamData[tabName].pickLbl.Text = teamData[tabName].label .. "  (" .. cnt .. " dipilih)"
    end

