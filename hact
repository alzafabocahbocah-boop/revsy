-- v24.8: buang uuid "bekasan" dari teamData[tabName].selected — pet yg udah GAK ADA
-- di backpack DAN gak di garden (udah kejual/gift/ganti). biar jumlah dipilih akurat
-- (dulu pet Koi lama yg diganti masih kehitung -> "kepilih 10 padahal 8" -> waitTeam nunggu 10 -> hatch gagal).
-- v24.9: dipindah ke ATAS (sebelum automationLoop) — dulu di ~3013, automationLoop (2762) panggil
-- saat masih nil -> error "attempt to call a nil value" line 2769.
local function pruneTeamBekasan(tabName)
    local data = teamData[tabName]
    if not data or not data.selected then return 0 end
    local inBp = {}
    for _, p in ipairs(PetDetect.listBackpackPets()) do
        inBp[tostring(p.uuid):gsub("[{}]","")] = true
    end
    local inGarden = {}
    pcall(function()
        for _, nm in ipairs({"PetsPhysical","Pets","PlacedPets","ActivePets"}) do
            local f = Workspace:FindFirstChild(nm)
            if f then
                for _, m in ipairs(f:GetDescendants()) do
                    if m:IsA("Model") and m.Name:sub(1,1) == "{" then
                        inGarden[m.Name:gsub("[{}]","")] = true
                    end
                end
            end
        end
    end)
    local removed = 0
    for uuid in pairs(data.selected) do
        local uclean = tostring(uuid):gsub("[{}]","")
        if not inBp[uclean] and not inGarden[uclean] then
            data.selected[uuid] = nil
            removed = removed + 1
        end
    end
    if removed > 0 then print("[HactTelur] prune "..removed.." bekasan dari "..tabName) end
    return removed
end

