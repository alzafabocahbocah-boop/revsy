-- SYNC FAVORIT IKUT RULE: pet yg masuk kriteria SELL -> unfav (biar kejual),
-- pet keep -> fav (terlindungi). dipanggil tiap rule diubah.
function syncFavByRules()
    PetDetect.rebuild(true)  -- v23.8: FORCE fresh — cache basi bikin fav salah toggle
    -- pet tim selalu keep (jgn di-unfav walau masuk rule)
    local teamSel = {}
    for _, tn in ipairs({"Reduce Tim", "Hatch Tim", "Sell Tim"}) do
        if teamData[tn] and teamData[tn].selected then
            for u in pairs(teamData[tn].selected) do
                teamSel[tostring(u):gsub("[{}]","")] = true
            end
        end
    end
    -- v23.1: kumpulin pet yg LAGI di-target gift/trade aktif (running + unfavFirst).
    -- pet ini JANGAN di-fav (walau posisi keep), biar gift/trade bisa unfav & kirim. Kalau gak,
    -- sync fav ulang -> fav balik pet di tengah proses -> bentrok bolak-balik.
    -- v27.14: dulu cuma method=="gift" -> mode TRADE (tiket) pet-nya ke-fav lagi di tengah
    -- trade (bug). sekarang gift & trade dua2nya dilindungi.
    local giftTargeted = {}
    pcall(function()
        local cfgs = _G.HactTelurGiftCfgs
        if cfgs then
            for _, cfg in ipairs(cfgs) do
                if cfg._running and (cfg.method == "gift" or cfg.method == "trade") and cfg.unfavFirst then
                    for _, p in ipairs(getMatchedPets(cfg)) do
                        giftTargeted[tostring(p):gsub("[{}]","")] = true
                    end
                end
            end
        end
    end)
    local unfav, fav = 0, 0
    for _, p in ipairs(PetDetect.listBackpackPets(true)) do
        if p.tool then
            local uclean = tostring(p.uuid):gsub("[{}]","")
            local isTeam = teamSel[uclean]
            local fate = petFate(p)
            if giftTargeted[uclean] then
                -- v23.1: lagi mau di-gift -> JANGAN sentuh fav (biar gift yg kelola unfav-nya)
            elseif fate == "sell" and not isTeam then
                -- masuk kriteria jual -> pastiin TIDAK favorit
                if p.fav then favoritePet(p.tool); unfav = unfav + 1; task.wait(0.04) end
            else
                -- keep/tim -> pastiin favorit
                if not p.fav then favoritePet(p.tool); fav = fav + 1; task.wait(0.04) end
            end
        end
    end
    print("[HactTelur] sync fav by rule: unfav "..unfav..", fav "..fav)
    return unfav, fav
end
-- AUTO SELL: favoritkan semua pet yg di-KEEP (termasuk gak di-list), lalu jual yg SELL.
function doAutoSell()
    -- v26.3: tunda sell CUMA kalau baru aja "Trade completed!" (dalam 3 detik) — pet keep lagi
    -- transisi unfav buat gift. KALAU cuma fitur gift ON tapi gak ada trade complete, sell JALAN
    -- (dulu: gift cfg running = langsung tunda -> sell ke-block terus walau gift gak ngapa2in).
    local recentTrade = (tick() - (Auto.lastTradeComplete or 0)) < 3
    if recentTrade then
        print("[HactTelur] Auto-sell DITUNDA: baru trade complete (tunggu fav stabil)")
        return 0
    end
    PetDetect.rebuild(true)
    local kept, toSellCount = 0, 0
    -- fav udah diatur real-time (syncFavByRules + favTeamPets), jadi gak perlu fav ulang.
    -- cuma hitung aja brp yg bakal kejual vs keep.
    for _, p in ipairs(PetDetect.listBackpackPets(true)) do
        local fate = petFate(p)
        if fate == "keep" then kept = kept + 1 else toSellCount = toSellCount + 1 end
    end
    print("[HactTelur] doAutoSell: hitung toSell="..toSellCount.." keep="..kept.." (total "..(#PetDetect.listBackpackPets(true))..")")
    if toSellCount == 0 then
        print("[HactTelur] Auto-sell: gak ada pet buat dijual (semua keep:"..kept..")")
        return 0
    end
    -- v25.2: proteksi RINGAN — fav pet keep/tim yg belum fav SEKALI aja (data fresh), TANPA loop.
    -- loop fav-stabil v24.0 + syncFavByRules ganda bikin doAutoSell nyangkut/return 0 walau toSell>0.
    -- fav udah diatur di automationLoop sebelum doAutoSell, di sini cuma jaring pengaman terakhir.
    local teamSel2 = {}
    for _, tn in ipairs({"Reduce Tim", "Hatch Tim", "Sell Tim"}) do
        if teamData[tn] and teamData[tn].selected then
            for u in pairs(teamData[tn].selected) do teamSel2[tostring(u):gsub("[{}]","")] = true end
        end
    end
    local protN = 0
    for _, p in ipairs(PetDetect.listBackpackPets(true)) do
        local uclean = tostring(p.uuid):gsub("[{}]","")
        local mustKeep = teamSel2[uclean] or (petFate(p) == "keep")
        if mustKeep and not p.fav and p.tool then
            favoritePet(p.tool); protN = protN + 1; task.wait(0.04)
        end
    end
    if protN > 0 then print("[HactTelur] proteksi: fav "..protN.." pet keep/tim sebelum jual"); task.wait(0.4) end
    -- SELL ALL langsung (yg gak difavorit kejual). gak nunggu lama.
    if SellSys.sellAllRE then
        local eggBefore = totalEggNow()
        local petBefore = #PetDetect.listBackpackPets(true)  -- v25.0: cek pet sebelum
        print("[HactTelur] FIRE SellAll — toSell="..toSellCount.." keep="..kept.." petBefore="..petBefore)
        pcall(function() SellSys.sellAllRE:FireServer() end)
        Track.totalSold = Track.totalSold + toSellCount
        task.wait(1.2)  -- v25.0: tunggu lebih lama biar server proses sell
        local petAfter = #PetDetect.listBackpackPets(true)
        print("[HactTelur] Sell All SELESAI — petBefore="..petBefore.." petAfter="..petAfter.." (turun "..(petBefore-petAfter)..")")
        if petBefore - petAfter == 0 then
            warn("[HactTelur] ⚠ PET GAK BERKURANG! SellAll gak jual apa2 — cek remote/favorit")
        end
        local eggAfter = totalEggNow()
        local delta = eggAfter - eggBefore
        Track.lastEggBefore = eggBefore
        Track.lastEggAfter = eggAfter
        Track.lastEggDelta = delta
        if delta > 0 then Track.luckySell = Track.luckySell + delta end
        sendCycleSummary("sell")
        return toSellCount
    else
        warn("[HactTelur] SellAllPets_RE gak ada")
        return 0
    end
end

-- ============ DETEKSI EGG (jumlah egg dimiliki) — metode dari telur PET STAT ============
local EggDetect = {}
EggDetect.counts = {}          -- {[eggName] = jumlah}
EggDetect.guiCache = {}        -- cache hasil scan PlayerGui (anti-kedip)
EggDetect.lastGuiScan = 0
function EggDetect.scan()
    local counts = {}
    pcall(function()
        local function scanTools(container)
            if not container then return end
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("egg") then
                    counts[t.Name] = (counts[t.Name] or 0) + 1
                end
            end
        end
        scanTools(player:FindFirstChild("Backpack"))
        scanTools(player.Character)
    end)
    -- scan PlayerGui TextLabel tiap 15 detik (buat egg yg ditumpuk/stack, mis "18x Bug Egg")
    local now = os.time()
    if (now - EggDetect.lastGuiScan) >= 15 then
        EggDetect.lastGuiScan = now
        local fresh = {}
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if pg then
            for _, d in ipairs(pg:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local txt = d.Text or ""
                    local cnt, name = txt:match("^(%d+)x%s+(.+[Ee]gg.*)$")
                    if not cnt then cnt, name = txt:match("^x(%d+)%s+(.+[Ee]gg.*)$") end
                    if not cnt then name, cnt = txt:match("^(.+[Ee]gg.-)%s+x?(%d+)$") end
                    if cnt and name then
                        local n = tonumber(cnt)
                        if n and n > 0 then fresh[name] = math.max(fresh[name] or 0, n) end
                    end
                end
            end
        end
        EggDetect.guiCache = fresh
    end
    for k, v in pairs(EggDetect.guiCache) do
        counts[k] = math.max(counts[k] or 0, v)
    end
    EggDetect.counts = counts
    return counts
end
-- ambil jumlah egg tertentu (EXACT match setelah buang suffix " xNNN")
function EggDetect.getCount(eggName)
    local c = EggDetect.counts
    if c[eggName] then return c[eggName] end
    -- v27.18: dulu substring dua arah -> "Premium Springtide Egg" kebaca pakai
    -- count "Springtide Egg" biasa (nampil punya padahal enggak). skrg exact
    -- setelah normalisasi suffix xNNN.
    local want = eggName:lower():gsub("%s*x%d+.*$", ""):gsub("%s+$", "")
    local best = 0
    for k, v in pairs(c) do
        local kk = k:lower():gsub("%s*x%d+.*$", ""):gsub("%s+$", "")
        if kk == want and v > best then best = v end
    end
    return best
end
-- expose hitung total egg buat tracking webhook
_G.HactTelurEggTotal = function()
    EggDetect.scan()
    local total = 0
    for _, c in pairs(EggDetect.counts or {}) do total = total + (tonumber(c) or 0) end
    return total
end

