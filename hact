-- v26.9: pegang Trading Ticket pas mau trade (gift lewat trade butuh item tiket di tangan).
-- kalau lagi pegang tool lain, lepas dulu lalu equip tiket.
local function holdTradingTicket()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = player:FindFirstChild("Backpack")
    if not (char and hum and bp) then return false end
    local function findTicket(container)
        if not container then return nil end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") then
                local n = t.Name:lower()
                if n:find("trading") and n:find("ticket") or n:find("trade ticket") then return t end
            end
        end
        return nil
    end
    -- udah pegang tiket?
    if findTicket(char) then return true end
    -- cari di backpack, lepas tool lain, equip tiket
    local tk = findTicket(bp)
    if not tk then return false end  -- gak punya tiket
    pcall(function() hum:UnequipTools() end)
    task.wait(0.1)
    pcall(function() hum:EquipTool(tk) end)
    task.wait(0.15)
    return findTicket(char) ~= nil
end

local function tradePetsToTarget(targetPlayer, petList, stopCheck)
    if not (TradeSys.sendReqRE and TradeSys.addItemRE and targetPlayer) then return 0 end
    -- deteksi notif "you can't add more items" di layar (slot trade penuh)
    local function cantAddMore()
        local found = false
        pcall(function()
            local pg = player:FindFirstChild("PlayerGui")
            if not pg then return end
            for _, d in ipairs(pg:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local t = (d.Text or ""):lower()
                    if t:find("can't add more") or t:find("cant add more") or t:find("can.t add more") then
                        found = true; break
                    end
                end
            end
        end)
        return found
    end
    -- v27.65: cek window trade masih kebuka?
    local function windowOpen()
        local o = false
        pcall(function()
            local pg = player:FindFirstChild("PlayerGui")
            local tui = pg and pg:FindFirstChild("TradingUI")
            local lt = tui and tui:FindFirstChild("LiveTrade")
            o = (lt and lt.Visible) or false
        end)
        return o
    end
    -- v27.74: deteksi notif TARGET FULL yg BENER (teks persis dari game):
    -- "You can't give more pets to this user, because they will max their inventory (236/235)"
    -- BEDA dari "can't add more items" (itu limit 12 slot trade, ditangani cantAddMore).
    local function targetMaxPet()
        local found = false
        pcall(function()
            local pg = player:FindFirstChild("PlayerGui")
            if not pg then return end
            for _, d in ipairs(pg:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local t = (d.Text or ""):lower()
                    if t:find("give more pets") or t:find("max their inventory")
                       or t:find("can.t give more") or (t:find("max") and t:find("inventory"))
                       or t:find("their inventory")
                       -- v27.75: Indonesia (tebakan, refine kalau dapet teks asli)
                       or t:find("tidak bisa memberi") or t:find("tidak dapat memberi")
                       or t:find("gak bisa memberi") or t:find("tidak bisa memberikan")
                       or (t:find("inventaris") and (t:find("penuh") or t:find("maks") or t:find("maksimal")))
                       or (t:find("inventori") and (t:find("penuh") or t:find("maks")))
                       or (t:find("memberi") and (t:find("pet") or t:find("hewan"))) then
                        found = true; break
                    end
                    -- v27.76: notif target-full PASTI ada angka "(X/Y)" (EN+ID, mis 236/235).
                    -- X>=Y & Y>=50 (inventaris penuh, BUKAN slot trade 12) -> target full, lintas-bahasa.
                    local xx, yy = t:match("%((%d+)%s*/%s*(%d+)%)")
                    if xx and yy then
                        xx = tonumber(xx); yy = tonumber(yy)
                        if xx and yy and yy >= 50 and xx >= yy then found = true; break end
                    end
                end
            end
        end)
        return found
    end
    local totalSent = 0
    local idx = 1
    -- v27.65: SPAM RE-SEND. Kirim batch pet, accept, TUNGGU window HILANG (trade kelar),
    -- lalu re-send SISA pet sampai abis / target penuh. Dulu cuma 1 batch -> sisa gak kekirim.
    for round = 1, 40 do
        if stopCheck and stopCheck() then break end
        if idx > #petList then break end
        pcall(holdTradingTicket)  -- pegang tiket dulu tiap re-send
        pcall(function() TradeSys.sendReqRE:FireServer(targetPlayer) end)
        task.wait(0.3)   -- tunggu window kebuka (was 0.4)
        local added = 0
        for i = idx, #petList do
            if stopCheck and stopCheck() then break end
            -- v27.78: TARGET full (max pet) -> lapor + STOP
            if targetMaxPet() then
                _G.__hactTargetFull = targetPlayer.Name
                print("[HactTelur] HACT OTO: target " .. targetPlayer.Name .. " FULL (max pet) -> lapor panel")
                break
            end
            -- v27.78: ADD dulu, BARU cek cantAddMore. Dulu cek SEBELUM add -> notif "can't add more"
            -- yg LINGER dari batch sebelumnya nge-block round baru -> cuma 12 kekirim, sisa 50 nyangkut.
            local u = tostring(petList[i]):gsub("[{}]",""); u = "{"..u.."}"
            pcall(function() TradeSys.addItemRE:FireServer("Pet", u) end)
            added = added + 1
            task.wait(0.05)
            if cantAddMore() then break end   -- slot trade penuh (12) -> accept + re-send sisa
        end
        -- auto-accept (spam loop v27.68 udah bantu, jadi cukup 2x)
        for i = 1, 2 do autoAcceptTrade(); task.wait(0.2) end
        totalSent = totalSent + added
        idx = idx + added
        -- v27.79: cek TARGET FULL SETELAH accept -- notif "max their inventory (236/235)" muncul pas
        -- CONFIRM, BUKAN pas add-pet. Dulu cuma cek pas add -> notif kelewat -> trade terus walau full.
        if targetMaxPet() then
            _G.__hactTargetFull = targetPlayer.Name
            print("[HactTelur] HACT OTO: target "..targetPlayer.Name.." FULL (max pet pas confirm) -> stop + lapor")
            break
        end
