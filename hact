-- lagi trade/gift manual? (trade UI / gift prompt terbuka di layar)
local function isTradingManual()
    local open = false
    pcall(function()
        local pg = player:FindFirstChild("PlayerGui")
        if not pg then return end
        -- v26.8: cek beberapa kemungkinan nama UI trade (mode tiket/trade pakai UI).
        -- begitu salah satu UI trade KEBUKA -> automation berhenti.
        for _, nm in ipairs({"TradingUI", "TradeUI", "TradingScreen", "Trade", "LiveTradeUI"}) do
            local tui = pg:FindFirstChild(nm)
            if tui and tui:IsA("ScreenGui") and tui.Enabled == true then
                open = true
                break
            end
        end
