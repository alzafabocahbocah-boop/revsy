-- ===== STAT LAPOR KE PANEL (egg + pet keep + kg range) — buat campur display =====
-- tulis zenx_hactstat_<akun>.json tiap 15s. Worker baca -> lapor backend -> panel.
do
    task.spawn(function()
        local HttpService = game:GetService("HttpService")
        local Players = game:GetService("Players")
        while true do
            task.wait(15)
            pcall(function()
                local plr = Players.LocalPlayer
                if not plr or not plr.Name or not writefile then return end
                -- egg name aktif (dari config)
                local eggName = "?"
                if config and config.eggSelected then
                    for e in pairs(config.eggSelected) do eggName = e; break end
                elseif config and config.egg and config.egg[1] then
                    eggName = config.egg[1]
                end
                -- jumlah egg AKTIF (Gem doang, bukan semua tipe egg)
                local eggN = 0
                pcall(function()
                    if EggDetect and EggDetect.scan then EggDetect.scan() end
                    eggN = (EggDetect and EggDetect.counts and tonumber(EggDetect.counts[eggName])) or 0
                end)
                -- pet KEEP (petFate == "keep") -> per nama, per bucket kg (base weight age 1)
                local keep = {}   -- { [namaPet] = { total=N, ranges={ ["1-2"]=x, ["2-3"]=y } } }
                pcall(function()
                    if PetDetect and PetDetect.listBackpackPets and petFate then
                        for _, p in ipairs(PetDetect.listBackpackPets()) do
                            if petFate(p) == "keep" and (not config.petPool or config.petPool[p.name]) then
                                local kg = tonumber(p.dispKg) or 0
                                local lo = math.floor(kg)
                                local bucket = lo .. "-" .. (lo + 1)
                                local nm = p.name or "?"
                                keep[nm] = keep[nm] or { total = 0, ranges = {} }
                                keep[nm].total = keep[nm].total + 1
                                keep[nm].ranges[bucket] = (keep[nm].ranges[bucket] or 0) + 1
                            end
                        end
                    end
                end)
                -- v27.49: total pet hactotomatis (buat aturan HACT OTO: cuma isi kalau pet > 50)
                local totalPet = 0
                pcall(function() if PetDetect and PetDetect.listBackpackPets then totalPet = #PetDetect.listBackpackPets() end end)
                local stat = { egg = eggName, eggN = eggN, keep = keep, totalPet = totalPet, ts = os.time(), ver = VERSION }
                -- v27.73: lapor akun target yg udah FULL (dari notif max pet) -> panel pindahin target
                if _G.__hactFullReport and _G.__hactFullReport ~= "" then stat.hactotoFull = _G.__hactFullReport end
                -- v27.57: DEBUG hactoto -- baca file target dari worker, lapor status ke panel
                pcall(function()
                    local fn = "zenx_hactoto_" .. plr.Name .. ".json"
                    stat.hactotoFile = fn   -- v27.59: nama file yg hact cari
                    if isfile and isfile(fn) then
                        local raw = readfile(fn)
                        stat.hactotoRaw = tostring(raw):gsub("%s+", " "):sub(1, 55)   -- v27.61: raw content (debug parse)
                        local ok, d = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
                        if ok and type(d) == "table" then
                            stat.hactotoTarget = d.target or ""
                            stat.hactotoMin = d.minCount or 50
                            pcall(function()
                                if _G.HactGetMatched and d.target and d.target ~= "" then
                                    local c2 = { pets = {["Peacock"]=true}, kg = 2, age = 0, muts = {}, targets = {[d.target]=true} }
                                    stat.hactotoStok = #(_G.HactGetMatched(c2))
                                end
                                -- v27.63: online = ada target present (data.target ATAU salah satu targets[])
                                local onlineT = nil
                                if d.target and d.target ~= "" and game:GetService("Players"):FindFirstChild(d.target) then onlineT = d.target
                                elseif type(d.targets) == "table" then
                                    for _, t in ipairs(d.targets) do if t and game:GetService("Players"):FindFirstChild(t) then onlineT = t break end end
                                end
                                stat.hactotoOnline = onlineT ~= nil
                                if onlineT then stat.hactotoTarget = onlineT end   -- tampil target yg BENERAN dipilih
                                stat.hactotoBusy = Auto.giftBusy == true
                                -- v27.62: siapa aja di server ini (debug kenapa target gak online)
                                local pl = {}
                                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do pl[#pl+1] = p.Name end
                                stat.hactotoNplayer = #pl
                                stat.hactotoPsample = table.concat(pl, ",", 1, math.min(#pl, 5)):sub(1, 70)
                                -- v27.80: nama PS sendiri (server yg di-join) -- buat debug kalau malah masuk PS sendiri
                                pcall(function()
                                    local jobId = game.JobId or ""
                                    -- cari nama server dari /ps-list (cocokkan jobId)
                                    -- fallback: tampilin 8 char JobId biar bisa dibandingkan
                                    stat.hactotoPsSendiri = jobId:sub(1, 8)
                                end)
                            end)
                        else
                            stat.hactotoTarget = "(parse GAGAL)"   -- v27.61: file ADA tapi JSON rusak
                        end
                    else
                        stat.hactotoTarget = "(no file)"   -- worker belum nulis file target
                    end
                end)
                -- pet yang DIPAKAI (tim hatching) dari config.komposisi
                local used = {}   -- { [namaPet] = jml }
                pcall(function()
                    if config and config.komposisi then
                        for _, timSlots in pairs(config.komposisi) do
                            for _, slot in ipairs(timSlots) do
                                if slot.tipe then used[slot.tipe] = (used[slot.tipe] or 0) + (slot.jml or 1) end
                            end
                        end
                    end
                end)
                stat.used = used
                _G.HactStat = stat
                local ok, js = pcall(function() return HttpService:JSONEncode(stat) end)
                if ok and js then writefile("zenx_hactstat_" .. plr.Name .. ".json", js) end
            end)
        end
    end)
    print("[HactTelur] stat-lapor aktif (egg + pet keep -> panel)")
end
