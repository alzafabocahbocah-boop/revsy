-- v27.23: DENYUT UNCONDITIONAL di PALING ATAS (copy dari market v8.344). Tulis
-- zenx_denyut_<akun>.txt tiap 20s ke Workspace executor. Tanpa ini, worker liat
-- "0 file denyut" -> kira client MATI -> rejoin sia-sia. Spawn coroutine sendiri,
-- gate 1x per VM (_G flag), independen dari GUI/automation. Aman di place manapun.
do
    if not _G.__ZenxDenyutJalan then
        _G.__ZenxDenyutJalan = true
        -- DETEKSI DISCONNECT (port star_seed) — denyut BERHENTI + file DIHAPUS pas putus
        local function zenxCekDisconnect()
            local dc = false
            pcall(function()
                local GuiService = game:GetService("GuiService")
                local ec = GuiService:GetErrorCode()
                if ec and ec ~= Enum.ConnectionError.OK and ec ~= Enum.ConnectionError.None then dc = true end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                local pg = CoreGui:FindFirstChild("RobloxPromptGui")
                local overlay = pg and pg:FindFirstChild("promptOverlay")
                if overlay then
                    for _, child in ipairs(overlay:GetChildren()) do
                        if child:IsA("GuiObject") and child.Visible
                            and (child.Name:find("Error") or child.Name:find("Prompt")) then
                            for _, d in ipairs(child:GetDescendants()) do
                                if d:IsA("TextButton") or d:IsA("TextLabel") then
                                    local t = tostring(d.Text or ""):lower()
                                    if t:find("reconnect") or t:find("leave") or t:find("disconnect")
                                        or t:find("shut") or t:find("keluar") or t:find("sambung")
                                        or t:find("terputus") or t:find("dimatikan") or t:find("hubungkan") then
                                        dc = true; return
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                for _, d in ipairs(CoreGui:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local vis = false
                        pcall(function() vis = d.Visible end)
                        if vis then
                            local t = tostring(d.Text or ""):lower()
                            if t:find("reconnect") or t:find("sambung ulang")
                                or t:find("terputus") or t:find("disconnected")
                                or t:find("dimatikan") or t:find("was shut down")
                                or t:find("lost connection") or t:find("kehilangan koneksi")
                                or t:find("error code") or t:find("kode error") or t:find("kode eror")
                                or t:find("id error") or t:find("(error)") then
                                dc = true; return
                            end
                        end
                    end
                end
            end)
            return dc
        end
        local function zenxDcStrict()
            local dc = false
            pcall(function()
                local cg = game:GetService("CoreGui")
                local pg = cg:FindFirstChild("RobloxPromptGui")
                local overlay = pg and pg:FindFirstChild("promptOverlay")
                if not overlay then return end
                for _, child in ipairs(overlay:GetChildren()) do
                    if child:IsA("GuiObject") and child.Visible then
                        for _, d in ipairs(child:GetDescendants()) do
                            if d:IsA("TextButton") and d.Visible then
                                local t = tostring(d.Text or ""):lower()
                                if t:find("reconnect") or t == "leave" or t:find("sambung ulang") then dc = true; return end
                            end
                        end
                    end
                end
            end)
            return dc
        end
        _G.ZenxCekDisconnect = zenxCekDisconnect
        -- SELF-REJOIN: error kedeteksi tapi VM masih hidup -> rejoin SENDIRI (gak nunggu worker)
        _G.ZenxSelfRejoin = function(reason)
            if _G.ZenxRejoining then return end
            _G.ZenxRejoining = true
            _G.ZenxRejoinSisa = 0
            print("[SelfRejoin] " .. tostring(reason) .. " -> rejoin sendiri (VM masih hidup)")
            local TS = game:GetService("TeleportService")
            local plr = game:GetService("Players").LocalPlayer
            task.spawn(function()
                local cg = game:GetService("CoreGui")
                local guiSvc = game:GetService("GuiService")
                for _ = 1, 120 do
                    pcall(function()
                        for _, g in ipairs(cg:GetChildren()) do
                            local n = tostring(g.Name):lower()
                            if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                if g:IsA("ScreenGui") then g.Enabled = false end
                                pcall(function() g.Parent = nil end)
                            end
                        end
                        guiSvc:ClearError()
                    end)
                    task.wait(0.5)
                end
            end)
            task.wait(8)
            while true do
                pcall(function() TS:Teleport(game.PlaceId, plr) end)
                task.wait(8)
            end
        end
        -- loop cepat: hapus denyut pas disconnect + REJOIN SENDIRI (grace 60s + konfirmasi 4x, hindari false-positive)
        task.spawn(function()
            local dcStrict = 0
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if not plr or not plr.Name or _G.ZenxRejoining then dcStrict = 0; return end
                    if zenxDcStrict() and delfile and isfile and isfile("zenx_denyut_" .. plr.Name .. ".txt") then
                        pcall(function() delfile("zenx_denyut_" .. plr.Name .. ".txt") end)
                    end
                    if zenxDcStrict() then
                        dcStrict = dcStrict + 1
                        local umur = os.time() - (_G.__ZenxBootT or os.time())
                        if dcStrict >= 4 and umur > 60 and _G.ZenxSelfRejoin then
                            _G.ZenxSelfRejoin("prompt reconnect Roblox (" .. dcStrict .. "x)")
                        end
                    else
                        dcStrict = 0
                    end
                end)
                task.wait(3)
            end
        end)
        -- v27.69: FPS tracker (kayak up_kg) -- denyut BAWA fps. Client PUTIH (fps<=5, GPU gak
        -- render) -> worker deteksi fps<=5 -> REJOIN cepet. Optimis 60 dulu (biar gak salah-rejoin loading).
        if not _G.__ZenxFpsTrack then
            _G.__ZenxFpsTrack = true
            _G.__ZenxFps = 60
            local cnt = 0
            pcall(function()
                game:GetService("RunService").RenderStepped:Connect(function() cnt = cnt + 1 end)
            end)
            local fpsLbl
            pcall(function()
                local plr = game:GetService("Players").LocalPlayer
                local g = Instance.new("ScreenGui"); g.Name = "ZenxFpsHud"; g.ResetOnSpawn = false; g.IgnoreGuiInset = true
                pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
                if not g.Parent then g.Parent = plr:WaitForChild("PlayerGui") end
                fpsLbl = Instance.new("TextLabel", g)
                fpsLbl.Size = UDim2.new(0, 120, 0, 34)
                fpsLbl.Position = UDim2.new(1, -128, 0, 8)   -- pojok kanan atas
                fpsLbl.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
                fpsLbl.BackgroundTransparency = 0.25
                fpsLbl.Font = Enum.Font.GothamBold; fpsLbl.TextSize = 18
                fpsLbl.TextColor3 = Color3.fromRGB(120, 255, 140); fpsLbl.BorderSizePixel = 0
                fpsLbl.Text = "FPS --"
                Instance.new("UICorner", fpsLbl).CornerRadius = UDim.new(0, 8)
            end)
            task.spawn(function()
                while true do
                    task.wait(1); _G.__ZenxFps = cnt; cnt = 0
                    if fpsLbl then
                        local f = _G.__ZenxFps or 0
                        fpsLbl.Text = "FPS " .. f .. (f <= 5 and " (putih)" or "")
                        fpsLbl.TextColor3 = (f <= 5) and Color3.fromRGB(255, 90, 90)
                            or (f <= 20) and Color3.fromRGB(255, 210, 90)
                            or Color3.fromRGB(120, 255, 140)
                    end
                end
            end)
        end
        -- denyut tiap 20s — SELALU nulis + BAWA fps. format "ts;0;hact;<fps>"
        -- (worker: denyut ada + fps<=5 = PUTIH -> rejoin cepet; denyut gak ada = loading -> grace)
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if plr and plr.Name and writefile and not zenxDcStrict() then
                        local fps = math.floor(tonumber(_G.__ZenxFps) or 60)
                        writefile("zenx_denyut_" .. plr.Name .. ".txt", os.time() .. ";0;hact;" .. fps)
                    end
                end)
                task.wait(20)
            end
        end)
    end
end

-- ===== AUTO-REJOIN tiap N menit (KICK dulu -> rejoin server SAMA dalam 30s) =====
-- SETTING WAKTU: ganti REJOIN_MENIT di sini (berlaku semua RF pas reload script).
-- Bisa juga di-override runtime: _G.ZenxRejoinMenit = 45
local REJOIN_MENIT = 30    -- <<< SETTING: rejoin tiap berapa menit
_G.ZenxRejoinMenit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT   -- DEFAULT 30, WAJIB nyala (gak ada toggle mati)
_G.__ZenxBootT = _G.__ZenxBootT or os.time()   -- waktu boot script (buat guard kick-pertama)
-- Port dari leveling/farm: player:Kick (putus server, script executor TETEP hidup)
-- -> tunggu 30s (ghost slot bekas kita bebas) -> TeleportToPlaceInstance jobId SAMA
-- (retry 12s). Private server: retry server SAMA terus (Teleport acak = kelempar public).
-- _G.ZenxRejoining=true -> disconnect-detect JANGAN hapus denyut (worker gak ikut rejoin).
_G.__ZenxRejoinJalan = true   -- <<< AUTO-REJOIN SC DIMATIIN (worker + panel kick handle rejoin, gak perlu dobel)
do
    if not _G.__ZenxRejoinJalan then
        _G.__ZenxRejoinJalan = true
        local TS = game:GetService("TeleportService")
        task.spawn(function()
            while true do
                -- COUNTDOWN GLOBAL TERSINKRON + LIVE: align wall-clock (os.time UTC), semua
                -- client rejoin BARENG di boundary. Recompute TIAP DETIK -> ganti waktu
                -- (_G.ZenxRejoinMenit) LIVE langsung re-align ke boundary baru (gak nunggu cycle).
                while true do
                    local menit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT
                    local interval = math.max(60, math.floor(menit * 60))
                    -- OFFSET per-interval: tiap interval punya grid GLOBAL sendiri (10m/20m/
                    -- 30m/dst gak numpuk boundary-nya). offset = (menit/10 - 1) menit.
                    local offset = math.max(0, math.floor(menit / 10) - 1) * 60
                    local now = os.time()
                    local nextB = (math.floor((now - offset) / interval) + 1) * interval + offset
                    -- guard: jangan kick dalam 60s pertama abis load (biar gak kick barusan exe)
                    while nextB - _G.__ZenxBootT < 60 do nextB = nextB + interval end
                    _G.ZenxRejoinSisa = nextB - now
                    if _G.ZenxRejoinSisa <= 1 then break end
                    task.wait(1)
                end
                _G.ZenxRejoinSisa = 0
                local plr = game:GetService("Players").LocalPlayer
                if plr then
                    local jobId  = game.JobId
                    local isPriv = (game.PrivateServerId or "") ~= ""
                    _G.ZenxRejoining = true
                    pcall(function() plr:Kick("ZenxFreezeRejoin") end)
                    -- SEMBUNYIIN dialog "kicked/disconnect" biar TeleportToPlaceInstance gak ke-blok
                    task.spawn(function()
                        local cg = game:GetService("CoreGui")
                        local guiSvc = game:GetService("GuiService")
                        for _ = 1, 300 do
                            pcall(function()
                                for _, g in ipairs(cg:GetChildren()) do
                                    local n = tostring(g.Name):lower()
                                    if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                        if g:IsA("ScreenGui") then g.Enabled = false end
                                        pcall(function() g.Parent = nil end)
                                    end
                                end
                                pcall(function() guiSvc:ClearError() end)
                            end)
                            task.wait(0.5)
                        end
                    end)
                    task.wait(40)   -- ghost slot bekas kita bebas dulu (30->40s)
                    while true do
                        -- GACOR: Teleport polos (matchmaking) -> balik ke PS SAMA + LOLOS anti-scam.
                        -- (TeleportToPlaceInstance keblok anti-scam krn target jobId spesifik.
                        --  Teleport() polos dianggap "join balik" biasa -> otomatis ke PS lo.)
                        pcall(function() TS:Teleport(game.PlaceId, plr) end)
                        task.wait(12)
                    end
                end
            end
        end)
    end
end

