local function checkKoiSealOk()
    local allSel = {}
    for _, tn in ipairs({"Reduce Tim", "Hatch Tim", "Sell Tim"}) do
        if teamData[tn] and teamData[tn].selected then
            for u in pairs(teamData[tn].selected) do allSel[u] = true end
