-- v16.2: cek pause gift/trade (1 fungsi, dipanggil di BANYAK titik biar STOP LANGSUNG,
-- gak nunggu cycle selesai). Begitu gift mulai di tengah aksi, aksi berikutnya di-skip.
-- v21.4: pause selama MASIH ada aktivitas gift (terima/keluar/trade UI/giftBusy).
-- Hitung mundur resume baru MULAI saat gift BENAR-BENAR berhenti (gak ada aktivitas baru).
-- Kalau gift beruntun, timer ke-reset terus (krn lastGiftAct/lastGiftOut ke-update tiap aktivitas).
-- Retry bertingkat: tunggu 3s sunyi -> kalau aktivitas lagi, ulang; safety paksa-resume 3->6->9s.
local RESUME_QUIET = 5  -- v22.6: detik "sunyi" (gak ada remote send gift) sebelum resume
-- v25.5: cek apakah Auto Gift lagi AKTIF (running + method gift). dipakai buat STOP semua
-- fav/unfav otomatis selama gift, biar gak bentrok sama unfav-buat-gift. lebih reliable dari
-- Auto.giftBusy (yg cuma true sesaat per putaran -> celah fav nyempil).
local function isGiftRunning()
    local r = false
    pcall(function()
        local cfgs = _G.HactTelurGiftCfgs
        if cfgs then
            for _, cfg in ipairs(cfgs) do
                if cfg._running and cfg.method == "gift" then r = true break end
            end
        end
    end)
    return r or Auto.giftBusy
end

local function isPausedForGift()
    -- v22.5: pause berdasarkan AKTIVITAS NYATA (sinyal dari hook namecall):
    --   - lastGiftOut: di-update tiap FireServer gift/trade KELUAR (kita kirim pet)
    --   - lastGiftAct: di-update tiap terima/accept pet
    --   - tradeOpen: trade UI lagi kebuka
    -- Selama masih ada aktivitas, pause. Kalau SUNYI >= RESUME_QUIET (3 detik) -> resume.
    -- giftBusy gak lagi bikin pause penuh sendiri (dulu bikin nyangkut); cuma jadi 1 sinyal.
    local tradeOpen = isTradingManual()
    -- v26.1: PATOKAN = "Trade completed!" notif. begitu trade complete -> pause RESUME_QUIET detik.
    -- (send gift request DIBUANG — cuma trade complete yg jadi acuan)
    local sinceTrade = tick() - (Auto.lastTradeComplete or 0)
    local quiet = sinceTrade  -- "sunyi" = berapa lama sejak trade complete terakhir

    -- safety: giftBusy nyangkut kelamaan (proses gift error gak ke-reset) -> paksa reset
    if Auto.giftBusy and Auto.giftBusySince and (tick() - Auto.giftBusySince) > 30 then
        print("[HactTelur] giftBusy nyangkut >30s -> auto-reset")
        Auto.giftBusy = false
    end

    -- v26.1: trade complete -> pause sampai sunyi RESUME_QUIET detik.
    if tradeOpen or quiet < RESUME_QUIET then
        if not Auto._wasPaused then
            local why = tradeOpen and "trade UI kebuka" or "TRADE COMPLETE (gift sukses)"
            print("[HactTelur] ⏸ PAUSE: "..why.." (automation STOP)")
            Auto._wasPaused = true
            Auto._pauseSince = tick()
            -- begitu pause -> langsung unequip pet garden (stop mendadak)
            Auto.currentTeam = nil
            Auto.eggPhase = "hatch"
            task.spawn(function() pcall(clearGarden) end)
            Auto._lastClear = tick()
        end
        -- safety paksa-resume kalau trade UI nyangkut kebuka kelamaan
        if tradeOpen and Auto._pauseSince then
            local pd = tick() - Auto._pauseSince
            if pd > 9 then
                print("[HactTelur] ⚠ trade UI nyangkut 9s, PAKSA resume")
                Auto.lastGiftAct = 0; Auto.lastGiftOut = 0; Auto.giftBusy = false
                Auto._wasPaused = false; Auto._pauseSince = nil
                return false
            end
        end
        return true
    end

    -- udah sunyi >= RESUME_QUIET detik (gak ada gift complete/remote dalam 3s) -> resume
    if Auto._wasPaused then
        print("[HactTelur] ▶ RESUME automation (sunyi "..RESUME_QUIET.."s, gift udah beres)")
        Auto._wasPaused = false; Auto._pauseSince = nil
    end
    return false
end

