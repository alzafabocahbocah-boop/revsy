-- ║  v27.19: AUTO-DESTROY POHON (RINGANIN GAG 1) — LANGSUNG ON     ║
-- ║  Destroy semua pohon di SEMUA kebun (kita + orang lain) biar   ║
-- ║  FPS naik. Pohon baru spawn -> auto-destroy. Jalan sendiri.    ║
-- ╚══════════════════════════════════════════════════════════════╝
do
    if _G.__ZenxAutoDestroyPohon then return end   -- cegah dobel
    _G.__ZenxAutoDestroyPohon = true

    local WS = game:GetService("Workspace")
    local RS = game:GetService("RunService")

    local AKTIF = true   -- LANGSUNG ON. Set false kalau mau matiin.

    -- cari SEMUA Plants_Physical (kebun kita + orang lain)
    local function semuaFarm()
        local roots = {}
        local farm = WS:FindFirstChild("Farm")
        if farm then
            for _, f in ipairs(farm:GetDescendants()) do
                if f.Name == "Plants_Physical" and (f:IsA("Folder") or f:IsA("Model")) then
                    table.insert(roots, f)
                end
            end
        end
        if #roots == 0 then
            for _, f in ipairs(WS:GetDescendants()) do
                if f.Name == "Plants_Physical" and (f:IsA("Folder") or f:IsA("Model")) then
                    table.insert(roots, f)
                end
            end
        end
        return roots
    end

    -- destroy semua pohon (Model) di semua kebun. balikin jumlah.
    local function destroyPohonSemua()
        if not AKTIF then return 0 end
        local n = 0
        for _, root in ipairs(semuaFarm()) do
            for _, c in ipairs(root:GetChildren()) do
                if c:IsA("Model") then
                    pcall(function() c:Destroy() end)
                    n = n + 1
                end
            end
        end
        return n
    end

    -- 1) SAPU AWAL: begitu jalan, destroy semua pohon yg ada (tunggu farm ke-load)
    task.spawn(function()
        task.wait(3)   -- kasih waktu Workspace.Farm ke-load
        local n = destroyPohonSemua()
        if n > 0 then print("[HactTelur] auto-destroy pohon: "..n.." pohon dibersihin (FPS up)") end
    end)

    -- 2) AUTO: pohon baru masuk kebun manapun -> langsung destroy
    task.spawn(function()
        local farm = WS:WaitForChild("Farm", 15)
        if not farm then return end
        farm.DescendantAdded:Connect(function(c)
            if not AKTIF then return end
            if c:IsA("Model") and c.Parent and c.Parent.Name == "Plants_Physical" then
                task.wait(0.05)
                pcall(function() c:Destroy() end)
            end
        end)
    end)

    -- 3) SAPU BERKALA (backup, tiap 30s) -- jaga2 kalau ada yg lolos listener
    task.spawn(function()
        while AKTIF do
            task.wait(30)
            destroyPohonSemua()
        end
    end)

    print("[HactTelur] AUTO-DESTROY POHON: ON (semua kebun, ringanin GAG 1)")
end

-- ===== AUTO BUY TRADING TICKET (port market v8.276) =====
-- fire BuyGearStock(namaTiket) tiap 5s KALAU tiket < 2 (biar gak over-buy).
-- game auto-tolak kalau stock abis / Sheckles kurang -> aman. self-contained.
if not _G.__ZenxAutoTicket then
    _G.__ZenxAutoTicket = true
    task.spawn(function()
        local rs = game:GetService("ReplicatedStorage")
        local plr = game:GetService("Players").LocalPlayer
        -- auto-detect nama tiket dari GearData (fallback "Trading Ticket")
        local ticketName = "Trading Ticket"
        pcall(function()
            local dataF = rs:FindFirstChild("Data")
            local mod = dataF and dataF:FindFirstChild("GearData")
            if mod then
                local ok, tbl = pcall(require, mod)
                if ok and type(tbl) == "table" then
                    for k, v in pairs(tbl) do
                        local nm
                        if type(k) == "string" then nm = k
                        elseif type(v) == "table" then nm = v.Name or v.ItemName or v.DisplayName end
                        if type(nm) == "string" then
                            local low = nm:lower()
                            if low:find("trading", 1, true) and low:find("ticket", 1, true) then ticketName = nm; break end
                        end
                    end
                end
            end
        end)
        local ge = rs:FindFirstChild("GameEvents")
        local re = ge and ge:FindFirstChild("BuyGearStock")
        if not re then print("[AutoTicket] BuyGearStock gak ketemu — auto-buy batal"); return end
        print("[AutoTicket] auto-buy '" .. ticketName .. "' aktif (beli kalau tiket < 2)")
        local function ticketCount()
            local n = 0
            pcall(function()
                local function scan(c) if not c then return end for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") then local low = t.Name:lower()
                        if (low:find("trading") and low:find("ticket")) or low:find("trade ticket") then n = n + 1 end end end end
                scan(plr:FindFirstChild("Backpack")); scan(plr.Character)
            end)
            return n
        end
        while true do
            task.wait(5)
            if ticketCount() < 2 then pcall(function() re:FireServer(ticketName) end) end
        end
    end)
end

