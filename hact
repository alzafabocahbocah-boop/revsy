            elseif ready > 0 and ready >= math.floor(total * 0.6) then
                -- sebagian besar ready (sisanya egg balik dari Koi yg CD) -> hatch yg ready aja
                Auto.eggPhase = "hatch"  -- v26.5: fase hatch -> pencet egg tiap 6s
                print("[HactTelur] "..ready.."/"..total.." ready (Koi balikin egg), hatch yg ready...")
                equipTeam("Hatch Tim")
                local ok = waitTeamInGarden("Hatch Tim", 12)
                if not ok then
                    -- v24.6: tim Koi gak lengkap -> BALIK ke Reduce + TUNGGU (jgn loop hatch terus).
                    -- dulu cuma clearGarden async -> bentrok sama equipTeam berikutnya -> 0 pet -> loop.
                    print("[HactTelur] tim Koi GAK LENGKAP ("..countGardenPets().."), balik Reduce, tunggu egg sisanya...")
                    equipTeam("Reduce Tim")
                    task.wait(3)  -- kasih waktu egg sisa ready / Koi CD selesai
                else
                    print("[HactTelur] Koi LENGKAP ("..countGardenPets().."), tunggu 6 detik...")
                    task.wait(6)
                    hatchAllEggs()
                    task.wait(2)
                    equipTeam("Reduce Tim")
                    pcall(holdEggTool)  -- v25.3: balik pegang egg
                end
            else
                -- masih banyak CD -> Reduce, tunggu
                equipTeam("Reduce Tim")
                task.wait(1.5)
            end
        end
        task.wait(0.5)
        end  -- tutup else (pause terima pet)
    end
    print("[HactTelur] automation loop STOP")
end

