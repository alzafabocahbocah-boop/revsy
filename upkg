-- ===== ZENX GAME REGISTRY (auto-baca data game; update sendiri kalau game nambah egg/pet/pack/seed baru) =====
-- Sc baca registry game LANGSUNG pas runtime -> konten baru (egg/pet/pack) otomatis kebaca, gak perlu edit sc.
-- Akses via _G.ZenxReg.pets / .petEggs / .eggShop / .packs / .seeds / .seedShop
do
    local _RS = game:GetService("ReplicatedStorage")
    local function _cnt(t) local n=0 if type(t)=="table" then for _ in pairs(t) do n=n+1 end end return n end
    local function _req(...)
        local segs = {...}
        local ok, mod = pcall(function()
            local o = _RS
            for _, s in ipairs(segs) do o = o:FindFirstChild(s); if not o then error(s) end end
            return require(o)
        end)
        return ok and mod or nil
    end
    _G.ZenxReg = _G.ZenxReg or {}
    local R = _G.ZenxReg
    local petReg = _req("Data", "PetRegistry")
    if petReg then
        R.pets      = petReg.PetList               -- semua pet (nama -> Rarity/SellPrice/Passives/Icon/MovementType..)
        R.petEggs   = petReg.PetEggs               -- semua egg hatch (nama -> EggRarity/HatchTime/Icon)
        local _mReg = petReg.PetMutationRegistry
        R.mutations  = _mReg                                -- container mutation penuh (Machine/Level500/dll)
        R.mutasiData = _mReg and _mReg.PetMutationRegistry  -- nama -> data (61 mutation: warna/efek)
        R.mutasiEnum = _mReg and _mReg.PetMutationToEnum    -- nama mutation -> kode enum (Rainbow -> c)
        R.enumMutasi = _mReg and _mReg.EnumToPetMutation    -- kode enum -> nama (c -> Rainbow)
        R.petReg    = petReg                        -- akses penuh (PetConfig/PetRarities/dll)
    end
    R.eggShop  = _req("Data", "PetEggData")          -- egg BELI (nama -> PurchaseID/Price/EggRarity/RebirthRequirement)
    R.packs    = (_req("Data", "SeedPackData") or {}).Packs  -- semua seed pack (nama -> data)
    R.seeds    = _req("Data", "SeedData")            -- semua seed/buah (nama -> SeedRarity/SeedName/Asset)
    R.seedShop = _req("Data", "SeedShopData")        -- seed BELI (nama -> Price/PurchaseID/StockChance)
    -- helper: daftar nama (buat picker/dropdown), urut
    R.namaList = function(tbl)
        local out = {}
        if type(tbl) == "table" then for k in pairs(tbl) do out[#out+1] = tostring(k) end table.sort(out) end
        return out
    end
    -- helper: PurchaseID egg beli by nama
    R.eggPurchaseId = function(nama) local e = R.eggShop and R.eggShop[nama]; return e and e.PurchaseID end
    -- helper: mutation pet disimpan sbg KODE enum -> konversi kode<->nama
    R.mutasiNama = function(kode) return R.enumMutasi and R.enumMutasi[kode] end   -- kode -> nama (c -> Rainbow)
    R.mutasiKode = function(nama) return R.mutasiEnum and R.mutasiEnum[nama] end   -- nama -> kode (Rainbow -> c)
    -- helper: cek nama egg/pet ada di registry (deteksi konten baru)
    R.punyaPet = function(nama) return R.pets and R.pets[nama] ~= nil end
    R.punyaEgg = function(nama) return (R.petEggs and R.petEggs[nama] ~= nil) or (R.eggShop and R.eggShop[nama] ~= nil) end
    if not _G.__ZenxRegPrinted then
        _G.__ZenxRegPrinted = true
        print(("[ZenxReg] pet:%d egg-hatch:%d egg-beli:%d pack:%d seed:%d mutasi:%d"):format(
            _cnt(R.pets), _cnt(R.petEggs), _cnt(R.eggShop), _cnt(R.packs), _cnt(R.seeds), _cnt(R.mutasiData)))
    end
end


