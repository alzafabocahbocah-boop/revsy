-- STAT loop (tiap 1s): total + belum + udah + tipe. FILTER by pet kepilih (_G.ZenxKgUpTipe).
-- Kalau belum pilih pet -> hitung SEMUA. tipe = SEMUA (buat picker).
task.spawn(function()
    while _G.__ZenxKgStatGen == statGen do
        pcall(function()
            local target = _G.ZenxKgUpTipe   -- SET {tipe=true} pet kepilih (nil/kosong = semua)
            local hasTarget = (type(target) == "table") and next(target) ~= nil
            local container = _kgContainer
            local total, belum, udah, tipe = 0, 0, 0, {}
            local age50Belum, mudaBelum = 0, 0   -- age50+ belum3.8 / age<50 belum3.8
            -- ITERASI CONTAINER = SEMUA pet (backpack + yg lagi ke-equip di kebun)
            if container then
                for _, entry in pairs(container) do
                    if type(entry) == "table" and entry.PetType and type(entry.PetData) == "table" then
                        local ptype = stripMutation(tostring(entry.PetType))
                        tipe[ptype] = (tipe[ptype] or 0) + 1   -- SEMUA tipe buat picker
                        if (not hasTarget) or target[ptype] then
                            local bw = tonumber(entry.PetData.BaseWeight) or 0
                            local lv = tonumber(entry.PetData.Level) or 0
                            local age = lv
                            local kg = bw * 1.1   -- AGE-1 KG (base, gak berubah walau age naik)
                            total = total + 1
                            if kg >= KG_TARGET_STAT - 0.005 then
                                udah = udah + 1
                            else
                                belum = belum + 1
                                if age >= 50 then age50Belum = age50Belum + 1 else mudaBelum = mudaBelum + 1 end
                            end
                        end
                    end
                end
                _G.ZenxKgStat.total = total
                _G.ZenxKgStat.belum = belum
                _G.ZenxKgStat.udah = udah
                _G.ZenxKgStat.age50Belum = age50Belum
                _G.ZenxKgStat.mudaBelum = mudaBelum
                _G.ZenxKgStat.tipe = tipe
            end
        end)
        task.wait(1)
    end
end)

-- ============================================================
-- ENGINE AUTO UP KG — SESI 1 (up BAHAN ke AGE 50)
-- 6 support (4 Mimic + 1 Ghostly Spider + 1 Gilded Coach Perytron) + SWAP GACOR
-- 2 bahan (jenis picker, age<50 + kg<3.8) — DIEM (no swap), rotate pas age 50
-- ============================================================
do
    local RS = game:GetService("ReplicatedStorage")
    local equipRE, getCooldownRF
    for _, v in pairs(RS:GetDescendants()) do
        if v.Name == "PetsService" and v:IsA("RemoteEvent") then equipRE = v end
        if v.Name == "GetPetCooldown" and v:IsA("RemoteFunction") then getCooldownRF = v end
    end
    if not equipRE then for _, v in pairs(RS:GetDescendants()) do if v.Name == "PetsService" then equipRE = v; break end end end
    local function fmtUUID(u) local s = tostring(u); if s:sub(1,1) ~= "{" then s = "{"..s.."}" end return s end
    local function unequipPet(uuid) if equipRE then pcall(function() equipRE:FireServer("UnequipPet", fmtUUID(uuid)) end) end end
    local function equipPet(uuid, pos)
        if not equipRE then return end
        if pos then pcall(function() equipRE:FireServer("EquipPet", fmtUUID(uuid), CFrame.new(pos)) end)
        else pcall(function() equipRE:FireServer("EquipPet", fmtUUID(uuid), nil) end) end
    end
    -- cooldown ready (swap gacor)
    local cdEventCache = {}
    -- ready kalau SALAH SATU skill ready (Time<=0). Skip entry MUTASI (Passive ada "mutation").
    -- Pet 2-skill: data[1]+data[2] dua-duanya skill -> ready kalau salah satu <=0.
    local function readyDariData(data)
        if type(data) ~= "table" then return nil end
        local adaSkill = false
        for _, v in ipairs(data) do
            if type(v) == "table" and type(v.Time) == "number" then
                local p = tostring(v.Passive or ""):lower()
                if not p:find("mutation") then
                    adaSkill = true
                    if v.Time <= 0 then return true end
                end
            end
        end
        if adaSkill then return false end
        return nil
    end
    do
        local ge = RS:FindFirstChild("GameEvents")
        local pcu = ge and ge:FindFirstChild("PetCooldownsUpdated")
        local req = ge and ge:FindFirstChild("RequestPetCooldowns")
        if pcu and pcu:IsA("RemoteEvent") then
            pcu.OnClientEvent:Connect(function(uuid, data)
                local key = tostring(uuid):gsub("[{}]", "")
                local rdy = readyDariData(data)
                cdEventCache[key] = { ready = rdy == true, at = tick() }
            end)
        end
        if req and req:IsA("RemoteEvent") then pcall(function() req:FireServer() end) end
    end
    local function petReady(uuid)
        local key = tostring(uuid):gsub("[{}]", "")
        local e = cdEventCache[key]
        if e and tick() - e.at <= 8 then return e.ready end
        return nil   -- GAK InvokeServer di hot-loop (biar gak nge-block/lambat). cache di-refresh loop periodik.
    end
    -- farm center (cluster)
    local function farmCenter()
        local farms = workspace:FindFirstChild("Farm")
        if not farms then return nil end
        for _, f in ipairs(farms:GetChildren()) do
            local imp = f:FindFirstChild("Important"); local data = imp and imp:FindFirstChild("Data"); local owner = data and data:FindFirstChild("Owner")
            if owner and owner.Value == player.Name then
                local c = f:FindFirstChild("Center", true)
                if c and c:IsA("BasePart") then return Vector3.new(c.Position.X, 4, c.Position.Z) end
            end
        end
        return nil
    end
    -- placed pet ({uuid} model) tracking
    local modelByUuid = {}
    local function isPetModel(m) return m:IsA("Model") and tostring(m.Name):sub(1,1) == "{" end
    local function regModel(m) if isPetModel(m) then modelByUuid[m.Name] = m end end
    pcall(function() for _, d in ipairs(workspace:GetDescendants()) do regModel(d) end end)
    workspace.DescendantAdded:Connect(function(d) task.defer(function() pcall(regModel, d) end) end)
    workspace.DescendantRemoving:Connect(function(d) if isPetModel(d) and modelByUuid[d.Name] == d then modelByUuid[d.Name] = nil end end)

    -- baca age (Level) + kg + tipe dari container/backpack
    local function getAge(uuid)
        local c = _kgContainer; if not c then return nil end
        local e = c[fmtUUID(uuid)]
        if type(e) == "table" and e.PetData then return tonumber(e.PetData.Level) end
        return nil
    end
    -- list pet backpack (uuid, tipe, age, kg)
    local function listPetsEngine()
        local out = {}
        local c = _kgContainer
        local bp = player:FindFirstChild("Backpack")
        if not bp then return out end
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local uuid = t:GetAttribute("PET_UUID")
                if uuid then
                    local tipe = stripMutation(tostring(t:GetAttribute("f") or ""))
                    local age, kg, kgBase = 0, 0, 0
                    if c then
                        local e = c[fmtUUID(uuid)]
                        if type(e) == "table" and e.PetData then
                            local bw = tonumber(e.PetData.BaseWeight) or 0
                            local lv = tonumber(e.PetData.Level) or 0
                            age = lv
                            kg = bw * (lv + 10) / 10   -- current (buat "paling gede")
                            kgBase = bw * 1.1          -- age-1 (buat cek "belum 3.8kg")
                        end
                    end
                    out[#out+1] = { uuid = fmtUUID(uuid), tipe = tipe, age = age, kg = kg, kgBase = kgBase }
                end
            end
        end
        return out
    end

    -- SESI 1 (up AGE): 6 support, swap support doang, bahan 2, rotate pas age>=50
    local SUPPORT_S1 = {
        { nama = "Mimic Octopus",   cari = { "mimic" },              jml = 4 },
        { nama = "Ghostly Spider",  cari = { "ghostly", "spider" },  jml = 1 },
        { nama = "Gilded Peryton",  cari = { "gilded", "peryton" },  jml = 1 },
    }
    -- v0.74: SESI 1 khusus config "Tim Dilop": 1 Elephant, 2 Dilop, 1 Peacock, 1 Gilded Choc Peryton + 3 bahan
    local SUPPORT_S1_DILOP = {
        { nama = "Elephant",            cari = { "elephant" },           jml = 1 },
        { nama = "Dilop",               cari = { "dilo" },               jml = 2 },
        { nama = "Peacock",             cari = { "peacock" },            jml = 1 },
        { nama = "Gilded Choc Peryton", cari = { "gilded", "peryton" },  jml = 1 },
    }
    -- SESI 2 (up KG): 7 support, swap SEMUA (support+bahan), bahan 1, rotate pas age turun <=30
    local SUPPORT_S2 = {
        { nama = "Mimic Octopus",   cari = { "mimic" },              jml = 3 },
        { nama = "Elephant",        cari = { "elephant" },           jml = 2 },
        { nama = "Peacock",         cari = { "peacock" },            jml = 1 },
        { nama = "Ghostly Spider",  cari = { "ghostly", "spider" },  jml = 1 },
    }
    local AGE_TARGET = 50     -- sesi 1: bahan sampe age ini
    local AGE_DROP   = 30     -- sesi 2: KG-up kelar kalau age turun <= ini
    local BAHAN_S1   = 2
    local BAHAN_S2   = 1
    -- cocok kalau pet type mengandung SEMUA kata di cari
    local function cocokSemua(ptype, kws)
        ptype = tostring(ptype):lower()
        for _, kw in ipairs(kws) do
            if not ptype:find(kw, 1, true) then return false end
        end
        return true
    end
    local KG = { aktif = false, sesi = 1 }
    _G.ZenxKg = KG
    local CLUSTER = nil
    local supportKunci = {}   -- uuid -> nama (support terkunci)
    local bahanAktif = {}     -- uuid -> tipe (bahan)
    local function kgLog(s) if _G.ZenxKgLog then _G.ZenxKgLog(s) end print("[UpKg] "..s) end
    local function jml(t) local n = 0; for _ in pairs(t) do n = n + 1 end return n end

    -- pilih support (PALING GEDE per tipe, kunci) — tim sesuai SESI
    local function pilihSupport(sesi)
        local SUP = (sesi == 2) and SUPPORT_S2 or ((_G.ZenxKgConfig == "Tim Dilop") and SUPPORT_S1_DILOP or SUPPORT_S1)
        local pets = listPetsEngine()
        table.sort(pets, function(a,b) return (a.kg or 0) > (b.kg or 0) end)   -- paling gede dulu
        local ada = {}
        for _, nm in pairs(supportKunci) do ada[nm] = (ada[nm] or 0) + 1 end
        for _, sup in ipairs(SUP) do
            local perlu = sup.jml - (ada[sup.nama] or 0)
            for _, p in ipairs(pets) do
                if perlu <= 0 then break end
                if not supportKunci[p.uuid] and not bahanAktif[p.uuid]
                   and cocokSemua(p.tipe, sup.cari) then
                    supportKunci[p.uuid] = sup.nama; perlu = perlu - 1
                end
            end
        end
    end
    -- pilih bahan (jenis picker, base<3.8) — SESI 1: age<50, 2 slot | SESI 2: age>=50, 1 slot
    local function pilihBahan(sesi)
        local target = _G.ZenxKgUpTipe
        if type(target) ~= "table" or not next(target) then return end
        local maxB = (sesi == 2) and BAHAN_S2 or ((_G.ZenxKgConfig == "Tim Dilop") and 3 or BAHAN_S1)
        local pets = listPetsEngine()
        table.sort(pets, function(a,b) return (a.kg or 0) > (b.kg or 0) end)   -- paling gede dulu
        local n = jml(bahanAktif)
        for _, p in ipairs(pets) do
            if n >= maxB then break end
            if not supportKunci[p.uuid] and not bahanAktif[p.uuid]
               and target[p.tipe] and p.kgBase < (3.8 - 0.005) then
                local eligible = (sesi == 2) and (p.age >= AGE_TARGET) or (p.age < AGE_TARGET)
                if eligible then
                    bahanAktif[p.uuid] = p.tipe; n = n + 1
                    kgLog("bahan sesi"..sesi..": "..p.tipe.." age "..p.age.." baseKG "..string.format("%.2f", p.kgBase))
                end
            end
        end
    end
    local function equipSemua()
        for u in pairs(supportKunci) do equipPet(u, CLUSTER); task.wait(0.06) end
        for u in pairs(bahanAktif) do equipPet(u, CLUSTER); task.wait(0.06) end
    end


    -- swap gacor PARALEL (tiap pet swap sendiri-sendiri, GAK antre) — lebih cepet
    local busy, lastSwap, lastPos, busySince = {}, {}, {}, {}
    local function swapPet(uuid)
        if busy[uuid] then return end
        busy[uuid] = true
        busySince[uuid] = tick()
        task.spawn(function()
            pcall(function()   -- kalau error di tengah, busy TETEP ke-clear di bawah (anti nyangkut)
                local pos = CLUSTER
                if not pos then local m = modelByUuid[uuid]; if m then local ok,p = pcall(function() return m:GetPivot().Position end); if ok then pos = p end end end
                if not pos then pos = lastPos[uuid] end
                if pos then lastPos[uuid] = pos end
                task.wait(KG.pickup or 0.3)
                unequipPet(uuid); task.wait(0.03)
                equipPet(uuid, pos)
                lastSwap[uuid] = tick()
                for i = 1, 12 do                       -- retry: cek tiap 0.1s (deteksi respawn CEPET) biar gak nyangkut lama
                    task.wait(0.1)
                    local m = modelByUuid[uuid]; if m and m.Parent then break end
                    if i % 4 == 0 then equipPet(uuid, lastPos[uuid]) end   -- re-equip tiap ~0.4s (gak spam)
                end
            end)
            busy[uuid] = nil   -- SELALU clear (walau error) -> pet gak nyangkut
        end)
    end
    -- ready-loop: swap SUPPORT doang (bahan DIEM di kedua sesi). Cek cepet 0.05s.
    task.spawn(function()
        while _G.__ZenxKgEngineGen == engGen do
            task.wait(0.05)
            if KG.aktif and not KG.reset then
                for uuid in pairs(modelByUuid) do
                    -- lepas busy yg NYANGKUT (>6s = swap gagal/kelamaan) biar pet swap lagi
                    if busy[uuid] and busySince[uuid] and (tick() - busySince[uuid]) > 6 then busy[uuid] = nil end
                    local nm = supportKunci[uuid]
                    -- support di-swap, TAPI Spider/Ghostly Spider di-equip aja (DIEM, gak di-swap). bahan juga diem.
                    local swapIni = nm and not (tostring(nm):lower():find("spider"))
                    if swapIni and not busy[uuid] then
                        local rdy = petReady(uuid)
                        local idle = lastSwap[uuid] and (tick() - lastSwap[uuid]) or 999
                        if (rdy == true) or (rdy == nil and idle > 4) then swapPet(uuid) end
                    end
                end
            end
        end
    end)

    -- v0.75: AUTO SWAP SKILL — swap skill SEMUA pet (bukan support doang), jalan WALAU engine spider/dilop OFF
    task.spawn(function()
        while _G.__ZenxKgEngineGen == engGen do
            task.wait(0.1)
            if _G.ZenxAutoSwapSkill and not KG.aktif then   -- cuma pas engine utama GAK jalan
                for uuid in pairs(modelByUuid) do
                    if busy[uuid] and busySince[uuid] and (tick() - busySince[uuid]) > 6 then busy[uuid] = nil end
                    if not busy[uuid] then
                        local rdy = petReady(uuid)
                        local idle = lastSwap[uuid] and (tick() - lastSwap[uuid]) or 999
                        if (rdy == true) or (rdy == nil and idle > 4) then swapPet(uuid) end
                    end
                end
            end
        end
    end)

    -- pickup all pet di kebun (scan workspace FRESH + retry)
    local function pickupAll()
        local np = 0
        for tri = 1, 3 do
            local uuids = {}
            for uuid in pairs(modelByUuid) do uuids[uuid] = true end
            pcall(function()
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("Model") and tostring(d.Name):sub(1,1) == "{" then uuids[d.Name] = true end
                end
            end)
            local any = false
            for uuid in pairs(uuids) do unequipPet(uuid); np = np + 1; any = true; task.wait(0.04) end
            task.wait(0.5)
            if not any then break end
        end
        return np
    end
    -- pasang tim sesuai SESI (pickup all -> pilih support+bahan -> equip)
    local function pasangSesi(sesi, pickup)
        supportKunci = {}; bahanAktif = {}
        if pickup then
            local np = pickupAll()
            if np > 0 then kgLog("pickup all: "..np.." pet"); task.wait(0.8) end
        end
        pilihSupport(sesi)
        pilihBahan(sesi)
        equipSemua()
        local SUP = (sesi == 2) and SUPPORT_S2 or ((_G.ZenxKgConfig == "Tim Dilop") and SUPPORT_S1_DILOP or SUPPORT_S1)
        local perT = {}
        for _, nm in pairs(supportKunci) do perT[nm] = (perT[nm] or 0) + 1 end
        local ss = ""; for _, sup in ipairs(SUP) do ss = ss..sup.nama.."="..(perT[sup.nama] or 0).."/"..sup.jml.." " end
        kgLog("SESI "..sesi.." | support: "..ss.."| bahan "..jml(bahanAktif).."/"..((sesi==2) and BAHAN_S2 or BAHAN_S1))
    end
    -- tentuin sesi dari stat (sticky): sesi1 sampe muda habis, sesi2 sampe age50 habis
    local function tentukanSesi()
        local st = _G.ZenxKgStat or {}
        local mudaB = st.mudaBelum or 0   -- age<50 base<3.8
        local a50B  = st.age50Belum or 0  -- age50+ base<3.8
        local total = st.total or 0
        if total == 0 then return KG.sesi end   -- stat belum siap -> jgn ganti/putus
        if KG.sesi == 1 then
            if mudaB == 0 then
                if a50B > 0 then return 2 else return 0 end   -- 0 = SELESAI
            end
            return 1
        else
            if a50B == 0 then
                if mudaB > 0 then return 1 else return 0 end
            end
            return 2
        end
    end

    local function kgStart(config)
        KG.aktif = true
        KG.sesi = 1
        KG.pickup = 0.25   -- jeda setelah ready sebelum copot (kecil = pickup responsif). spider gak di-swap jadi gak perlu special.
        CLUSTER = farmCenter()   -- v0.73: BALIKIN buat swap (equip ke tengah pas swap = gacor, nentuin posisi). HOLD-loop yg dimatiin (biar gak ditahan terus pas gak swap).
        supportKunci = {}; bahanAktif = {}
        kgLog("START ("..tostring(config)..") pickup="..KG.pickup.."s center="..(CLUSTER and "ada" or "NIL"))
        -- (RESET 3-menit DIHAPUS — HEALER 1s udah jaga visual, gak perlu refresh berkala)
        KG.reset = false
        _G.__ZenxKgResetGen = (_G.__ZenxKgResetGen or 0) + 1
        local resetGen = _G.__ZenxKgResetGen
        -- REFRESH cooldown cache periodik (2s, BACKGROUND) — biar petReady selalu dari cache (non-block).
        -- Ini yg bikin swap TETEP gacor (gak makin lambat): cache gak pernah basi -> gak ada InvokeServer di hot-loop.
        task.spawn(function()
            local ge2 = RS:FindFirstChild("GameEvents")
            local req2 = ge2 and ge2:FindFirstChild("RequestPetCooldowns")
            local lastInvoke = 0
            while KG.aktif and _G.__ZenxKgResetGen == resetGen do
                if req2 then pcall(function() req2:FireServer() end) end   -- SERING (0.5s, cheap/non-block) = cache fresh, readiness cepet = GACOR
                if getCooldownRF and (tick() - lastInvoke) >= 2 then       -- InvokeServer fallback JARANG (2s) buat pet yg cache masih basi
                    lastInvoke = tick()
                    for u in pairs(supportKunci) do
                        local key = tostring(u):gsub("[{}]", "")
                        local e = cdEventCache[key]
                        if not (e and tick() - e.at <= 8) then
                            local ok, res = pcall(function() return getCooldownRF:InvokeServer(fmtUUID(u)) end)
                            if ok then cdEventCache[key] = { ready = (readyDariData(res) == true), at = tick() } end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
        -- HEALER cek TERUS (tiap 1s): pet tim yg model-nya ILANG -> langsung PAKSA copot->pasang
        -- HOLD di TENGAH: tahan pet tim di CLUSTER (numpuk rapet) — pivot balik kalau drift >3 stud
        task.spawn(function()
            while KG.aktif and _G.__ZenxKgResetGen == resetGen do
                task.wait(0.25)
                if false then   -- v0.73: HOLD-ke-tengah DIMATIIN. Pet ke tengah CUMA pas SWAP (line 689), gak ditahan-tahan terus walau lagi gak swap.
                    for uuid in pairs(modelByUuid) do
                        if (supportKunci[uuid] or bahanAktif[uuid]) and not busy[uuid] then
                            local m = modelByUuid[uuid]
                            if m and m.Parent then
                                local ok, p = pcall(function() return m:GetPivot().Position end)
                                if ok and (p - CLUSTER).Magnitude > 3 then
                                    pcall(function() m:PivotTo(CFrame.new(CLUSTER)) end)
                                end
                            end
                        end
                    end
                end
            end
        end)
        -- (server nganggep udah equip -> equip biasa no-op. copot dulu baru equip = model spawn lagi)
        task.spawn(function()
            while KG.aktif and _G.__ZenxKgResetGen == resetGen do
                task.wait(1)
                if KG.aktif and not KG.reset and _G.__ZenxKgResetGen == resetGen then
                    local team = {}
                    for u in pairs(supportKunci) do team[u] = true end
                    for u in pairs(bahanAktif) do team[u] = true end
                    local healed = 0
                    for u in pairs(team) do
                        local idle = lastSwap[u] and (tick() - lastSwap[u]) or 999
                        -- ilang model + gak lagi di-swap + gak baru di-swap (biar gak ganggu swap normal)
                        if not modelByUuid[u] and not busy[u] and idle > 3 then
                            unequipPet(u); task.wait(0.15)
                            equipPet(u, CLUSTER); task.wait(0.12)
                            healed = healed + 1
                        end
                    end
                    if healed > 0 then kgLog("HEAL: " .. healed .. " pet model ilang -> paksa re-equip") end
                end
            end
        end)
        task.spawn(function()
            local tgt = _G.ZenxKgUpTipe
            if type(tgt) ~= "table" or not next(tgt) then kgLog("!! PICKER BELUM DIPILIH -> bahan gak ke-equip") end
            -- tunggu container + stat kebaca (biar keputusan sesi bener, bukan 0 palsu)
            for i = 1, 12 do
                if _kgContainer and _G.ZenxKgStat and (_G.ZenxKgStat.total or 0) > 0 then break end
                task.wait(1)
            end
            local mudaB0 = (_G.ZenxKgStat and _G.ZenxKgStat.mudaBelum) or 0
            local a50B0  = (_G.ZenxKgStat and _G.ZenxKgStat.age50Belum) or 0
            kgLog("awal: total="..((_G.ZenxKgStat and _G.ZenxKgStat.total) or 0).." muda(age<50 base<3.8)="..mudaB0.." age50+(base<3.8)="..a50B0)
            KG.sesi = (tentukanSesi() == 2) and 2 or 1   -- mulai dari sesi yg sesuai kondisi
            pasangSesi(KG.sesi, true)
            while KG.aktif do
                task.wait(3)
                if not KG.aktif then break end
                local mudaB = (_G.ZenxKgStat and _G.ZenxKgStat.mudaBelum) or 0
                local a50B  = (_G.ZenxKgStat and _G.ZenxKgStat.age50Belum) or 0
                -- cek transisi sesi
                local target = tentukanSesi()
                if target == 0 then kgLog("SELESAI \u{2014} semua base KG >= 3.8! (muda="..mudaB.." age50="..a50B..")"); break end
                if target ~= KG.sesi then
                    kgLog("GANTI ke SESI "..target.." (muda="..mudaB.." age50="..a50B..")")
                    KG.sesi = target
                    pasangSesi(target, true)
                else
                    -- rotate bahan
                    if KG.sesi == 1 then
                        -- SESI 1: copot bahan yg udah age >= 50
                        for u, tipe in pairs(bahanAktif) do
                            local age = getAge(u)
                            if age and age >= AGE_TARGET then
                                unequipPet(u); bahanAktif[u] = nil
                                kgLog("bahan "..tipe.." AGE "..age.." >= 50 -> copot (age kelar)")
                            end
                        end
                    else
                        -- SESI 2: copot bahan yg age udah TURUN <= 30 (KG-up kelar)
                        for u, tipe in pairs(bahanAktif) do
                            local age = getAge(u)
                            if age and age <= AGE_DROP then
                                unequipPet(u); bahanAktif[u] = nil
                                kgLog("bahan "..tipe.." AGE turun ke "..age.." <= 30 -> copot (KG-up kelar)")
                            end
                        end
                    end
                    -- isi ulang bahan
                    local maxB = (KG.sesi == 2) and BAHAN_S2 or ((_G.ZenxKgConfig == "Tim Dilop") and 3 or BAHAN_S1)
                    if jml(bahanAktif) < maxB then
                        pilihBahan(KG.sesi)
                        for u in pairs(bahanAktif) do
                            if not modelByUuid[u] then equipPet(u, CLUSTER); task.wait(0.06) end
                        end
                    end
                    -- re-equip support yg hilang
                    for u in pairs(supportKunci) do
                        if not modelByUuid[u] then equipPet(u, CLUSTER); task.wait(0.06) end
                    end
                end
            end
        end)
    end
    local function kgStop()
        KG.aktif = false
        task.spawn(function()
            for u in pairs(supportKunci) do unequipPet(u); task.wait(0.04) end
            for u in pairs(bahanAktif) do unequipPet(u); task.wait(0.04) end
            supportKunci = {}; bahanAktif = {}
            kgLog("STOP + unequip semua")
        end)
    end
    _G.ZenxKgStart = kgStart
    _G.ZenxKgStop = kgStop
end

