-- STAT KG — total pet + belum/udah 3.8kg (dari hact PetDetect + kg.lua base weight)
-- age-1 KG = BaseWeight × 1.1 (dari sc kg stat). Container via getgc.
-- ============================================================
local KG_TARGET_STAT = 3.8
local MUTATION_PREFIXES = {
    "Everchanted ","Rainbow ","Frozen ","Inverted ","Golden ","Diamond ",
    "Mythical ","Hexed ","Ascended ","Radiant ","Shocked ","Bloodlit ",
    "Twilight ","Voidtouched ","Foxfire ","Aurora ","Static ","Stormcloud ",
    "Frost ","Burnt ","Lethal ","Cooked ","Choc ",
}
local function stripMutation(s)
    if not s then return "" end
    for _, p in ipairs(MUTATION_PREFIXES) do
        if s:sub(1, #p) == p then return s:sub(#p + 1) end
    end
    return s
end
-- config -> pet type filter (substring match). Random = semua pet (no filter).
local KG_CONFIG_PET = { ["Tim Spider"] = "Spider", ["Tim Dilop"] = "Dilo", ["Tim Random"] = nil }

-- cari container getgc (cache, re-find kalau invalid) — port dari kg.lua
local _kgContainer = nil
local function findMemoryContainer()
    if not getgc then return nil end
    local backpackUUIDs, bpCount = {}, 0
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local u = t:GetAttribute("PET_UUID")
                if u then
                    local k = tostring(u); if k:sub(1,1) ~= "{" then k = "{"..k.."}" end
                    backpackUUIDs[k] = true; bpCount = bpCount + 1
                end
            end
        end
    end
    local best, bestCount, bestMatch = nil, 0, 0
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                local uuidLike, matchCount = 0, 0
                for k in pairs(obj) do
                    if type(k) == "string" and #k >= 32 and k:find("-") then
                        uuidLike = uuidLike + 1
                        if backpackUUIDs[k] then matchCount = matchCount + 1 end
                        if uuidLike >= 50 and matchCount == 0 then break end
                    end
                end
                if uuidLike >= 5 then
                    local sample = nil
                    for _, v in pairs(obj) do sample = v; break end
                    if type(sample) == "table" and rawget(sample, "PetData") then
                        local cnt = 0; for _ in pairs(obj) do cnt = cnt + 1 end
                        local better = false
                        if bpCount > 0 then
                            if matchCount > bestMatch then better = true
                            elseif matchCount == bestMatch and cnt > bestCount then better = true end
                        else
                            if cnt > bestCount then better = true end
                        end
                        if better then best = obj; bestCount = cnt; bestMatch = matchCount end
                    end
                end
            end
        end
    end)
    return best
end
local function ambilContainer()
    -- valid kalau masih tabel + ada PetData. re-find kalau nil.
    if _kgContainer then
        local ok = false
        pcall(function()
            for _, v in pairs(_kgContainer) do
                if type(v) == "table" and rawget(v, "PetData") then ok = true end
                break
            end
        end)
        if ok then return _kgContainer end
    end
    _kgContainer = findMemoryContainer()
    return _kgContainer
end
-- age-1 KG = BaseWeight × 1.1 (dari kg.lua)
local function getAgeOneKg(container, uuid)
    if not container or not uuid then return 0 end
    local key = tostring(uuid); if key:sub(1,1) ~= "{" then key = "{"..key.."}" end
    local entry = container[key]
    if type(entry) == "table" and entry.PetData then
        return (tonumber(entry.PetData.BaseWeight) or 0) * 1.1
    end
    return 0
end

