-- HELPER
-- ══════════════════════════════════════
local function getPlayerFarm()
    local farm = workspace:FindFirstChild("Farm")
    if not farm then return nil end
    local inner = farm:FindFirstChild("Farm")
    if not inner then return nil end
    return inner
end

local function fruitHasMutation(fruit)
    -- cek attribute Mutation atau child bernama Mutation
    local ok, v = pcall(function() return fruit:GetAttribute("Mutation") end)
    if ok and v and v ~= "" and v ~= false then return true end
    if fruit:FindFirstChild("Mutation") then return true end
    -- fallback: cek semua attribute
    local attrs = fruit:GetAttributes()
    for k, val in pairs(attrs) do
        if tostring(k):lower():find("mutation") and val and val ~= "" then return true end
    end
    return false
end

