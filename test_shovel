-- ══════════════════════════════════════
-- SHOVEL LOGIC
-- ══════════════════════════════════════
local autoOn = false
local busy = false

local function doShovel()
    if busy then addLog("busy, skip"); return end
    busy = true

    -- cari Remove_Item RE
    local re = removeItemRE
    if not re then
        re = gameEvents and gameEvents:FindFirstChild("Remove_Item")
        removeItemRE = re
    end
    if not re then addLog("ERR: Remove_Item RE tidak ditemukan"); busy = false; return end

    -- farm
    local farm = getPlayerFarm()
    if not farm then addLog("ERR: farm nil"); busy = false; return end
    local imp = farm:FindFirstChild("Important")
    if not imp then addLog("ERR: Important nil"); busy = false; return end
    local plants = imp:FindFirstChild("Plants_Physical")
    if not plants then addLog("ERR: Plants_Physical nil"); busy = false; return end

    -- kumpulkan semua pohon
    local targets = {}
    for _, pt in ipairs(plants:GetChildren()) do
        table.insert(targets, pt)
    end
    addLog("Total pohon: "..#targets)
    if #targets == 0 then addLog("Tidak ada pohon"); busy = false; return end

    -- cari shovel
    local char = plr.Character
    if not char then addLog("ERR: char nil"); busy = false; return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then addLog("ERR: hum nil"); busy = false; return end

    local shovelTool = nil
    for _, t in ipairs(plr.Backpack:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find("shovel") then shovelTool = t; break end
    end
    if not shovelTool then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("shovel") then shovelTool = t; break end
        end
    end
    if not shovelTool then addLog("ERR: shovel tidak ada di backpack"); busy = false; return end
    addLog("Shovel: "..shovelTool.Name)

    -- equip shovel
    pcall(function() hum:UnequipTools() end); task.wait(0.2)
    pcall(function() hum:EquipTool(shovelTool) end); task.wait(0.3)
    addLog("Shovel equipped")

    -- dapatkan InputGateway REs
    local wsAct, psAct = getInputGatewayREs()
    if not wsAct then addLog("WARN: Workspace InputGateway.Activation nil") end
    if not psAct then addLog("WARN: PlayerScripts InputGateway.Activation nil") end

    -- FireServer tiap pohon dengan sequence: Activation(true) → Remove_Item → Activation(false)
    local count = 0
    for _, pt in ipairs(targets) do
        -- ambil CFrame karakter saat ini
        local cf = CFrame.new()
        pcall(function()
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then cf = hrp.CFrame end
        end)

        -- Activation true
        if wsAct then pcall(function() wsAct:FireServer(true, cf) end) end
        if psAct then pcall(function() psAct:FireServer(true, cf) end) end
        task.wait(0.05)

        -- Remove_Item
        local ok, err = pcall(function() re:FireServer(pt) end)
        task.wait(0.05)

        -- Activation false
        if wsAct then pcall(function() wsAct:FireServer(false, cf) end) end
        if psAct then pcall(function() psAct:FireServer(false, cf) end) end

        if ok then
            count = count + 1
            addLog("OK: "..pt.Name)
        else
            addLog("ERR: "..tostring(err))
        end
        task.wait(0.3)
    end

    -- unequip shovel
    pcall(function() hum:UnequipTools() end); task.wait(0.2)
    addLog("Selesai: "..count.." pohon dishovel")
    busy = false
end

