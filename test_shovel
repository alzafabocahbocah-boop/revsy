local plr = game:GetService("Players").LocalPlayer
local gameEvents = game:GetService("ReplicatedStorage"):FindFirstChild("GameEvents")
local removeItemRE = gameEvents and gameEvents:FindFirstChild("Remove_Item")

-- InputGateway REs (diperlukan server sebelum Remove_Item)
local function getInputGatewayREs()
    local char = plr.Character
    local wsIG = char and char:FindFirstChild("InputGateway")
    local wsAct = wsIG and wsIG:FindFirstChild("Activation")
    local psIG = plr:FindFirstChild("PlayerScripts") and plr.PlayerScripts:FindFirstChild("InputGateway")
    local psAct = psIG and psIG:FindFirstChild("Activation")
    return wsAct, psAct
end

