-- ===================== LISTENER =====================
local ge = RS:FindFirstChild("GameEvents")
local pcu = ge and ge:FindFirstChild("PetCooldownsUpdated")
local req = ge and ge:FindFirstChild("RequestPetCooldowns")

if not pcu then
    addLine("❌ PetCooldownsUpdated NOT FOUND", Color3.fromRGB(255,80,80))
else
    addLine("✅ listener ON — waiting events...", Color3.fromRGB(80,255,120))
    -- track per uuid: last status
    local _lastStatus = {}

    pcu.OnClientEvent:Connect(function(uuid, data)
        local key = tostring(uuid):gsub("[{}]","")
        local rdy = readyDariData(data)
        local tipe = getPetTipe(key)
        local shortUuid = key:sub(1,8)

        -- warna berdasarkan status
        local status, color
        if rdy == true then
            status = "READY ✅"
            color = Color3.fromRGB(80, 255, 120)
        elseif rdy == false then
            local minTime = math.huge
            if type(data) == "table" then
                for _, v in ipairs(data) do
                    if type(v) == "table" and type(v.Time) == "number" then
                        local p = tostring(v.Passive or ""):lower()
                        if not p:find("mutation") and v.Time > 0 then
                            if v.Time < minTime then minTime = v.Time end
                        end
                    end
                end
            end
            local timerStr = minTime < math.huge and string.format(" (%.0fs)", minTime) or ""
            status = "ON-CD ⏳" .. timerStr
            color = Color3.fromRGB(255, 180, 60)
        else
            status = "NIL ❓"
            color = Color3.fromRGB(180, 80, 255)
        end

        -- deteksi perubahan status per uuid
        local prev = _lastStatus[key]
        local changed = (prev ~= rdy)
        _lastStatus[key] = rdy

        -- format: uuid | tipe | status [CHANGED]
        local changedMark = changed and " ◄CHANGE" or ""
        addLine(shortUuid .. " | " .. tipe .. " | " .. status .. changedMark,
            changed and Color3.fromRGB(255, 255, 80) or color)

        -- raw data kalau NIL
        if rdy == nil then
            local parts = {}
            if type(data) == "table" then
                for i, v in ipairs(data) do
                    if type(v) == "table" then
                        table.insert(parts, string.format("[%d]Pass=%s T=%s", i, tostring(v.Passive):sub(1,12), tostring(v.Time)))
                    else
                        table.insert(parts, tostring(v))
                    end
                end
            end
            local rawStr = #parts > 0 and table.concat(parts, " ") or ("type="..type(data).." kosong")
            addLine("  raw: " .. rawStr, Color3.fromRGB(110, 110, 110))
        end
    end)

    -- request refresh + auto retry tiap 5s
    if req and req:IsA("RemoteEvent") then
        pcall(function() req:FireServer() end)
        addLine("→ RequestPetCooldowns fired", Color3.fromRGB(100,100,100))
        task.spawn(function()
            while true do
                task.wait(5)
                pcall(function() req:FireServer() end)
            end
        end)
    end
end

-- ===================== SCAN modelByUuid tiap 3s =====================
-- Baca _G.ZenxModelByUuid (di-expose uplevelnew) = semua pet yang model-nya ada di workspace
task.spawn(function()
    task.wait(2)
    addLine("--- SCAN modelByUuid tiap 3s ---", Color3.fromRGB(100,100,100))
    while true do
        task.wait(3)
        local modelByUuid = _G.ZenxModelByUuid
        if type(modelByUuid) ~= "table" then
            addLine("ZenxModelByUuid nil (uplevelnew belum jalan?)", Color3.fromRGB(255,100,100))
        else
            -- snapshot dulu biar gak berubah saat iterate
            -- debug: log langsung dari modelByUuid tanpa snapshot
            local count = 0
            local firstKey = nil
            for uuid, _ in pairs(modelByUuid) do
                count = count + 1
                if not firstKey then firstKey = tostring(uuid) end
            end
            addLine(string.format("kebun: %d pet | firstKey=%s", count, tostring(firstKey):sub(1,16)), Color3.fromRGB(100, 150, 255))
            local n = 0
            for uuid, _ in pairs(modelByUuid) do
                n = n + 1
                local key = tostring(uuid):gsub("[{}]","")
                local tipe = getPetTipe(key)
                local lastS = _lastStatus[key]
                local statusStr, col
                if lastS == true then
                    statusStr = "READY ✅"; col = Color3.fromRGB(80,255,120)
                elseif lastS == false then
                    statusStr = "ON-CD ⏳"; col = Color3.fromRGB(255,180,60)
                else
                    statusStr = "NO EVENT ❌"; col = Color3.fromRGB(255,80,80)
                end
                addLine(string.format("  [%d] %s | %s | %s", n, key:sub(1,8), tipe, statusStr), col)
            end
            if n == 0 then addLine("  (iterate kosong padahal count="..count..")", Color3.fromRGB(255,80,80)) end
        end
    end
end)

