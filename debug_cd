-- ===================== HELPER =====================
local function readyDariData(data)
    if type(data) ~= "table" then return nil end
    local adaSkill = false
    for _, v in ipairs(data) do
        if type(v) == "table" and type(v.Time) == "number" then
            local p = tostring(v.Passive or ""):lower()
            if not p:find("mutation") then
                adaSkill = true
                if v.Time <= 0 then return true end
            end
        end
    end
    if adaSkill then return false end
    return nil
end

local function getPetTipe(uuid)
    local key = tostring(uuid):gsub("[{}]","")
    -- coba dari _kgContainer global
    local kgc = _G.__ZenxKgContainer or _G._kgContainer
    if type(kgc) == "table" then
        local e = kgc["{"..key.."}"] or kgc[key]
        if type(e) == "table" then
            local pt = tostring(e.PetType or (e.PetData and e.PetData.PetType) or "")
            if pt ~= "" then return pt end
        end
    end
    -- coba dari workspace model
    local pp = workspace:FindFirstChild("PetsPhysical")
    if pp then
        local m = pp:FindFirstChild("{"..key.."}") or pp:FindFirstChild(key)
        if m then return tostring(m:GetAttribute("PetType") or m.Name) end
    end
    return key:sub(1,8)
end

