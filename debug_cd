-- ===================== LOG =====================
local logLines = {}
local MAX_LINES = 200

local function addLine(txt, color)
    color = color or Color3.fromRGB(200, 200, 200)
    local ts = string.format("[%d]", math.floor(tick() % 10000))
    local full = ts .. " " .. txt
    table.insert(logLines, full)
    if #logLines > MAX_LINES then table.remove(logLines, 1) end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 18)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = full
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.Parent = scroll

    -- trim lama kalau kebanyakan
    local kids = scroll:GetChildren()
    local lbls = {}
    for _, c in ipairs(kids) do if c:IsA("TextLabel") then table.insert(lbls, c) end end
    if #lbls > MAX_LINES then lbls[1]:Destroy() end

    -- auto scroll bawah
    task.defer(function()
        scroll.CanvasPosition = Vector2.new(0, math.huge)
    end)
end

-- copy all
copyBtn.MouseButton1Click:Connect(function()
    local all = table.concat(logLines, "\n")
    setclipboard(all)
    copyBtn.Text = "Copied!"
