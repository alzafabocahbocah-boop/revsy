    Parent = content })
mk("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = cfgScroll })

local function sectionHeader(txt, lo)
    local h = mk("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.card,
        BorderSizePixel = 0, LayoutOrder = lo or 0, Parent = cfgScroll })
    corner(h, 7)
    local t = lbl(h, txt, 13, C.accent); t.Font = FONT_B
    t.Position = UDim2.new(0, 12, 0, 0); t.Size = UDim2.new(1, -12, 1, 0)
    return h
end
local function cfgRow(label, defaultVal, lo)
    local r = mk("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.panel,
        BorderSizePixel = 0, LayoutOrder = lo or 0, Parent = cfgScroll })
    corner(r, 6)
    local t = lbl(r, label, 12, C.text)
    t.Position = UDim2.new(0, 12, 0, 0); t.Size = UDim2.new(0.55, 0, 1, 0)
    local box = mk("TextBox", { Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -110, 0.5, -12),
        BackgroundColor3 = C.input, Text = tostring(defaultVal or ""), Font = FONT_B, TextSize = 12,
        TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false,
        Parent = r })
    corner(box, 5); stroke(box, C.border, 1)
    return box, r
end

