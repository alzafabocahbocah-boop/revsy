    Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0),
    BackgroundTransparency = 1, BorderSizePixel = 0,
    ScrollBarThickness = 4, ScrollBarImageColor3 = C.line,
