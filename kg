-- ===== CONFIG SIMPAN/LOAD (persist antar rejoin/re-exe — writefile) =====
-- rejoin = sesi baru (_G reset), jadi setting HARUS ke file biar gak balik awal.
do
    local CFG_FILE = "zenx_upkg_cfg.json"
    local HS = game:GetService("HttpService")
    _G.ZenxKgSaveCfg = function()
        pcall(function()
            if not writefile then return end
            local cfg = {
                upTipe = (type(_G.ZenxKgUpTipe) == "table") and _G.ZenxKgUpTipe or {},
                rejoinMenit = tonumber(_G.ZenxRejoinMenit) or 30,
                config = _G.ZenxKgConfig or "Tim Spider",
                autoOn = _G.ZenxKg and _G.ZenxKg.aktif or false,
            }
            writefile(CFG_FILE, HS:JSONEncode(cfg))
        end)
    end
    -- load pas awal
    pcall(function()
        if isfile and isfile(CFG_FILE) and readfile then
            local cfg = HS:JSONDecode(readfile(CFG_FILE))
            if type(cfg) == "table" then
                if type(cfg.upTipe) == "table" then
                    -- convert array kosong -> set kosong
                    local s = {}
                    for k, v in pairs(cfg.upTipe) do if type(k) == "string" and v then s[k] = true end end
                    _G.ZenxKgUpTipe = s
                end
                if tonumber(cfg.rejoinMenit) then _G.ZenxRejoinMenit = tonumber(cfg.rejoinMenit) end
                if cfg.config then _G.ZenxKgConfig = cfg.config end
            end
        end
    end)
end

-- ===== DENYUT — worker tau client hidup (guard disconnect) =====
do
    if not _G.__ZenxDenyutJalan then
        _G.__ZenxDenyutJalan = true
        -- DETEKSI DISCONNECT (port star_seed) — denyut BERHENTI + file DIHAPUS pas putus
        local function zenxCekDisconnect()
            local dc = false
            pcall(function()
                local GuiService = game:GetService("GuiService")
                local ec = GuiService:GetErrorCode()
                if ec and ec ~= Enum.ConnectionError.OK and ec ~= Enum.ConnectionError.None then dc = true end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                local pg = CoreGui:FindFirstChild("RobloxPromptGui")
                local overlay = pg and pg:FindFirstChild("promptOverlay")
                if overlay then
                    for _, child in ipairs(overlay:GetChildren()) do
                        if child:IsA("GuiObject") and child.Visible
                            and (child.Name:find("Error") or child.Name:find("Prompt")) then
                            for _, d in ipairs(child:GetDescendants()) do
                                if d:IsA("TextButton") or d:IsA("TextLabel") then
                                    local t = tostring(d.Text or ""):lower()
                                    if t:find("reconnect") or t:find("leave") or t:find("disconnect")
                                        or t:find("shut") or t:find("keluar") or t:find("sambung")
                                        or t:find("terputus") or t:find("dimatikan") or t:find("hubungkan") then
                                        dc = true; return
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                for _, d in ipairs(CoreGui:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local vis = false
                        pcall(function() vis = d.Visible end)
                        if vis then
                            local t = tostring(d.Text or ""):lower()
                            if t:find("reconnect") or t:find("sambung ulang")
                                or t:find("terputus") or t:find("disconnected")
                                or t:find("dimatikan") or t:find("was shut down")
                                or t:find("lost connection") or t:find("kehilangan koneksi")
                                or t:find("error code") or t:find("kode error") or t:find("kode eror")
                                or t:find("id error") or t:find("(error)") then
                                dc = true; return
                            end
                        end
                    end
                end
            end)
            return dc
        end
        _G.ZenxCekDisconnect = zenxCekDisconnect
        -- loop cepat: hapus denyut pas disconnect -> worker rejoin cepet (skip pas self-rejoin)
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if plr and plr.Name and not _G.ZenxRejoining and zenxCekDisconnect() and delfile then
                        if isfile and isfile("zenx_denyut_" .. plr.Name .. ".txt") then
                            pcall(function() delfile("zenx_denyut_" .. plr.Name .. ".txt") end)
                        end
                    end
                end)
                task.wait(3)
            end
        end)
        -- denyut tiap 20s — SKIP kalau disconnect
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if plr and plr.Name and writefile and not zenxCekDisconnect() then
                        writefile("zenx_denyut_" .. plr.Name .. ".txt", tostring(os.time()))
                    end
                end)
                task.wait(20)
            end
        end)
    end
end

-- ===== AUTO-REJOIN tiap N menit (KICK dulu -> rejoin server SAMA, countdown GLOBAL sync) =====
local REJOIN_MENIT = 30    -- <<< SETTING: rejoin tiap berapa menit (bisa override _G.ZenxRejoinMenit)
_G.ZenxRejoinMenit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT   -- DEFAULT 30, WAJIB nyala (gak ada toggle mati)
_G.__ZenxBootT = _G.__ZenxBootT or os.time()   -- waktu boot script (buat guard kick-pertama)
do
    _G.__ZenxRejoinGen = (_G.__ZenxRejoinGen or 0) + 1
    local myGen = _G.__ZenxRejoinGen
    do
        local TS = game:GetService("TeleportService")
        task.spawn(function()
            while _G.__ZenxRejoinGen == myGen do
                -- countdown: recompute boundary TIAP DETIK -> ganti _G.ZenxRejoinMenit LIVE
                -- langsung re-align ke boundary baru (gak nunggu cycle selesai).
                while _G.__ZenxRejoinGen == myGen do
                    local menit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT
                    local interval = math.max(60, math.floor(menit * 60))
                    local offset = math.max(0, math.floor(menit / 10) - 1) * 60
                    local now = os.time()
                    local nextB = (math.floor((now - offset) / interval) + 1) * interval + offset
                    while nextB - (_G.__ZenxBootT or now) < 60 do nextB = nextB + interval end
                    _G.ZenxRejoinSisa = nextB - now
                    if _G.ZenxRejoinSisa <= 1 then break end
                    task.wait(1)
                end
                if _G.__ZenxRejoinGen ~= myGen then return end
                _G.ZenxRejoinSisa = 0
                local plr = game:GetService("Players").LocalPlayer
                if plr then
                    local jobId = game.JobId
                    _G.ZenxRejoining = true
                    pcall(function() plr:Kick("ZenxFreezeRejoin") end)
                    -- SEMBUNYIIN dialog "kicked/disconnect" biar TeleportToPlaceInstance gak ke-blok
                    task.spawn(function()
                        local cg = game:GetService("CoreGui")
                        local guiSvc = game:GetService("GuiService")
                        for _ = 1, 300 do
                            pcall(function()
                                for _, g in ipairs(cg:GetChildren()) do
                                    local n = tostring(g.Name):lower()
                                    if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                        if g:IsA("ScreenGui") then g.Enabled = false end
                                        pcall(function() g.Parent = nil end)
                                    end
                                end
                                pcall(function() guiSvc:ClearError() end)
                            end)
                            task.wait(0.5)
                        end
                    end)
                    print("[Rejoin] KICK dilakukan. jobId=" .. tostring(jobId) .. " place=" .. tostring(game.PlaceId))
                    pcall(function()
                        TS.TeleportInitFailed:Connect(function(_, res, msg)
                            print("[Rejoin] teleport GAGAL: " .. tostring(res) .. " | " .. tostring(msg))
                        end)
                    end)
                    task.wait(30)
                    local tries = 0
                    while true do   -- rejoin sampe berhasil (VM mati pas teleport sukses)
                        tries = tries + 1
                        print("[Rejoin] coba teleport #" .. tries)
                        if jobId and jobId ~= "" then
                            pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, jobId, plr) end)
                        else
                            pcall(function() TS:Teleport(game.PlaceId, plr) end)
                        end
                        task.wait(8)
                    end
                end
            end
        end)
    end
end

