do
    local GameEvents = game:GetService("ReplicatedStorage"):FindFirstChild("GameEvents")
    local sellOneRE = GameEvents and GameEvents:FindFirstChild("SellPetShopSelected")
    local favRE = GameEvents and GameEvents:FindFirstChild("Favorite_Item")
    local function sellOne(tool) if sellOneRE and tool then pcall(function() sellOneRE:FireServer(tool) end) end end
    local function unfav(tool) if favRE and tool then pcall(function() favRE:FireServer(tool) end) end end
    local function listPets()
        local out = {}
        local bp = player:FindFirstChild("Backpack")
        if not bp then return out end
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local uuid = t:GetAttribute("PET_UUID")
                if uuid then
                    local base = stripMutation(tostring(t:GetAttribute("f") or t.Name))
                    local fav = false
                    for _, attr in ipairs({"Favorited","Favourited","Favorite","Favourite","IsFavorited","IsFavourited"}) do
                        if t:GetAttribute(attr) == true then fav = true; break end
                    end
                    out[#out+1] = { tool = t, base = base, fav = fav }
                end
            end
        end
        return out
    end
    local shH = mk("Frame", { Size = UDim2.new(1,0,0,30), BackgroundColor3 = C.card, BorderSizePixel=0, LayoutOrder=10, Parent=miscScroll }); corner(shH,7)
    local shHt = lbl(shH, "\u{1F4B0} SELL PET MANUAL", 13, C.accent); shHt.Font=FONT_B; shHt.Position=UDim2.new(0,12,0,0); shHt.Size=UDim2.new(1,-12,1,0)
    local shInfo = lbl(miscScroll, "Pilih jenis pet \u{2192} auto-unfav \u{2192} Sell (langsung, tanpa Seal).", 11, C.textDim); shInfo.Size=UDim2.new(1,0,0,18); shInfo.LayoutOrder=11
    local sellInfo = lbl(miscScroll, "", 11, C.textDim); sellInfo.Size=UDim2.new(1,0,0,16); sellInfo.LayoutOrder=12
    local sellList = mk("ScrollingFrame", { Size=UDim2.new(1,0,0,150), BackgroundColor3=C.panel, BorderSizePixel=0, ScrollBarThickness=4, ScrollBarImageColor3=C.line, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, LayoutOrder=13, Parent=miscScroll }); corner(sellList,6)
    mk("UIListLayout", { Padding=UDim.new(0,3), SortOrder=Enum.SortOrder.LayoutOrder, Parent=sellList })
    mk("UIPadding", { PaddingLeft=UDim.new(0,4), PaddingTop=UDim.new(0,4), PaddingRight=UDim.new(0,4), Parent=sellList })
    local dipilih = {}
    local refresh
    refresh = function()
        for _, c in ipairs(sellList:GetChildren()) do
            if c:IsA("TextButton") or (c:IsA("TextLabel") and c.Name=="kosong") then c:Destroy() end
        end
        local grup = {}
        for _, p in ipairs(listPets()) do
            local g = grup[p.base]
            if not g then g = {count=0, fav=0, pets={}}; grup[p.base]=g end
            g.count = g.count+1
            if p.fav then g.fav=g.fav+1 end
            g.pets[#g.pets+1] = p
        end
        local names = {}
        for nm in pairs(grup) do names[#names+1]=nm end
        table.sort(names, function(a,b) return grup[a].count > grup[b].count end)
        for i, nm in ipairs(names) do
            local g = grup[nm]
            local on = dipilih[nm]==true
            local b = mk("TextButton", { Size=UDim2.new(1,0,0,30), BackgroundColor3=on and C.cardSel or C.card, AutoButtonColor=true, Text="", LayoutOrder=i, Parent=sellList }); corner(b,5)
            local nl = lbl(b, (on and "\u{2713} " or "")..nm, 12, on and C.accent or C.text); nl.Position=UDim2.new(0,10,0,0); nl.Size=UDim2.new(0.6,-10,1,0)
            local cl = lbl(b, "x"..g.count..(g.fav>0 and ("  "..g.fav.."\u{2764}") or ""), 11, on and C.accent or C.textDim, Enum.TextXAlignment.Right); cl.Position=UDim2.new(0.6,0,0,0); cl.Size=UDim2.new(0.4,-12,1,0)
            b.MouseButton1Click:Connect(function()
                if dipilih[nm] then dipilih[nm]=nil
                else
                    dipilih[nm]=true
                    task.spawn(function()
                        local uf=0
                        for _, p in ipairs(g.pets) do if p.fav and p.tool then unfav(p.tool); uf=uf+1; task.wait(0.04) end end
                        if uf>0 then sellInfo.Text = nm..": "..uf.." pet di-unfav" end
                    end)
                end
                refresh()
            end)
        end
        if #names==0 then local e=lbl(sellList, "(gak ada pet)", 12, C.textDim); e.Size=UDim2.new(1,0,0,30); e.Name="kosong" end
    end
    local btnRow = mk("Frame", { Size=UDim2.new(1,0,0,34), BackgroundTransparency=1, LayoutOrder=14, Parent=miscScroll })
    mk("UIListLayout", { FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=btnRow })
    local refBtn = mk("TextButton", { Size=UDim2.new(0.4,-3,1,0), BackgroundColor3=C.card, Text="\u{1F504} Refresh", Font=FONT_B, TextSize=12, TextColor3=C.text, LayoutOrder=1, Parent=btnRow }); corner(refBtn,6)
    local sellBtn = mk("TextButton", { Size=UDim2.new(0.6,-3,1,0), BackgroundColor3=Color3.fromRGB(200,60,60), Text="\u{1F4B0} Sell Pet", Font=FONT_B, TextSize=13, TextColor3=Color3.fromRGB(255,255,255), LayoutOrder=2, Parent=btnRow }); corner(sellBtn,6)
    refBtn.MouseButton1Click:Connect(refresh)
    sellBtn.MouseButton1Click:Connect(function()
        local target = {}
        for _, p in ipairs(listPets()) do if dipilih[p.base] then target[#target+1]=p end end
        if #target==0 then sellInfo.Text="Pilih pet dulu."; return end
        local dim = mk("Frame", { Size=UDim2.new(1,0,1,0), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.5, ZIndex=100, Parent=gui })
        local box = mk("Frame", { Size=UDim2.new(0,280,0,150), Position=UDim2.new(0.5,-140,0.5,-75), BackgroundColor3=C.bg, ZIndex=101, Parent=dim }); corner(box,10); stroke(box,C.border,1.5)
        local q = lbl(box, "Yakin jual "..#target.." pet?", 14, C.text); q.Font=FONT_B; q.Position=UDim2.new(0,16,0,18); q.Size=UDim2.new(1,-32,0,24); q.ZIndex=102
        local det = lbl(box, "Langsung jual (tanpa Seal). Gak bisa balik.", 11, C.textDim); det.Position=UDim2.new(0,16,0,46); det.Size=UDim2.new(1,-32,0,32); det.ZIndex=102; det.TextWrapped=true
        local ya = mk("TextButton", { Size=UDim2.new(0.5,-20,0,34), Position=UDim2.new(0,16,1,-46), BackgroundColor3=Color3.fromRGB(200,60,60), Text="Yakin, jual", Font=FONT_B, TextSize=12, TextColor3=Color3.fromRGB(255,255,255), ZIndex=102, Parent=box }); corner(ya,7)
        local tidak = mk("TextButton", { Size=UDim2.new(0.5,-20,0,34), Position=UDim2.new(0.5,4,1,-46), BackgroundColor3=C.card, Text="Batal", Font=FONT, TextSize=12, TextColor3=C.text, ZIndex=102, Parent=box }); corner(tidak,7)
        tidak.MouseButton1Click:Connect(function() dim:Destroy() end)
        ya.MouseButton1Click:Connect(function()
            dim:Destroy()
            sellInfo.Text = "Jual "..#target.." pet..."
            task.spawn(function()
                local sold=0
                for _, p in ipairs(target) do
                    if p.tool then
                        if p.fav then unfav(p.tool); task.wait(0.05) end
                        sellOne(p.tool); sold=sold+1
                        task.wait(0.1)
                    end
                end
                sellInfo.Text = "Kelar: "..sold.." pet dijual."
                for k in pairs(dipilih) do dipilih[k]=nil end
                refresh()
            end)
        end)
    end)
    refresh()
end

