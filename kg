-- selector 3 config: Tim Spider / Tim Dilop / Tim Random
local KG_CONFIGS = { "Tim Spider", "Tim Dilop", "Tim Random" }
local kgConfigAktif = _G.ZenxKgConfig or "Tim Spider"
local kgConfBtns = {}
local kgSelRow = mk("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1,
    LayoutOrder = 2, Parent = cfgScroll })
mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal,
    Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = kgSelRow })
_G.ZenxKgConfig = kgConfigAktif
local kgConfStrokes = {}
local function pilihConfig(name)
    kgConfigAktif = name
    _G.ZenxKgConfig = name
    if _G.ZenxKgSaveCfg then _G.ZenxKgSaveCfg() end
    for n, b in pairs(kgConfBtns) do
        local on = (n == name)
        b.BackgroundColor3 = on and C.cardSel or C.card
        b.TextColor3 = on and C.accent or C.textDim
        if kgConfStrokes[n] then kgConfStrokes[n].Color = on and C.borderSel or C.border end
    end
    if _G.ZenxKgLog then _G.ZenxKgLog("config: " .. name) end
end
for i, name in ipairs(KG_CONFIGS) do
    local on = (name == kgConfigAktif)
    local b = mk("TextButton", { Size = UDim2.new(1/3, -4, 1, 0),
        BackgroundColor3 = on and C.cardSel or C.card, Text = name:gsub("Tim ", ""),
        Font = FONT_B, TextSize = 11, TextColor3 = on and C.accent or C.textDim,
        AutoButtonColor = false, LayoutOrder = i, Parent = kgSelRow })
    corner(b, 6); kgConfStrokes[name] = stroke(b, on and C.borderSel or C.border, 1)
    b.MouseButton1Click:Connect(function() pilihConfig(name) end)
    kgConfBtns[name] = b
end

