local function bukaPicker()
    for _, c in ipairs(pList:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local tipe = (_G.ZenxKgStat and _G.ZenxKgStat.tipe) or {}
    local names = {}
    for t in pairs(tipe) do names[#names+1] = t end
    table.sort(names)
    if #names == 0 then
        local e = lbl(pList, "(belum ada pet kebaca)", 12, C.textDim, Enum.TextXAlignment.Center)
        e.Size = UDim2.new(1, 0, 0, 30); e.ZIndex = 102; e.Name = "kosong"
    end
    for i, t in ipairs(names) do
        local set = _G.ZenxKgUpTipe
        local sel = (type(set) == "table" and set[t]) and true or false
        local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = sel and C.cardSel or C.card, AutoButtonColor = true,
            Text = "   " .. (sel and "\u{2713} " or "") .. t .. "   (" .. tostring(tipe[t]) .. ")",
            Font = FONT, TextSize = 12,
            TextColor3 = sel and C.accent or C.text, TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = i, ZIndex = 102, Parent = pList }); corner(b, 5)
        b.MouseButton1Click:Connect(function()
            _G.ZenxKgUpTipe = (type(_G.ZenxKgUpTipe) == "table") and _G.ZenxKgUpTipe or {}
            local s = _G.ZenxKgUpTipe
            if s[t] then s[t] = nil else s[t] = true end
            if _G.ZenxKgSaveCfg then _G.ZenxKgSaveCfg() end
            bukaPicker()   -- refresh highlight
        end)
    end
    pickOverlay.Visible = true
end
local function updatePickBtn()
    local s = _G.ZenxKgUpTipe
    local names = {}
    if type(s) == "table" then for t in pairs(s) do names[#names+1] = t end end
    table.sort(names)
    pickBtn.Text = "\u{1F43E} Pilih Pet Di-Up: " .. (#names > 0 and table.concat(names, ", ") or "(belum)")
end
pickBtn.MouseButton1Click:Connect(bukaPicker)
updatePickBtn()   -- reflect setting yg di-load
pClose.MouseButton1Click:Connect(function() updatePickBtn(); pickOverlay.Visible = false end)
-- klik luar panel (di overlay) buat nutup
pickOverlay.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        local m = inp.Position
        local ap, sz = pickPanel.AbsolutePosition, pickPanel.AbsoluteSize
        if m.X < ap.X or m.X > ap.X + sz.X or m.Y < ap.Y or m.Y > ap.Y + sz.Y then
            updatePickBtn(); pickOverlay.Visible = false
        end
    end
end)
