-- ============ MISC = REJOIN GLOBAL ============
mk("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = miscContent })
do
    local rjH = mk("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.card,
        BorderSizePixel = 0, LayoutOrder = 1, Parent = miscContent }); corner(rjH, 7)
    local rjHt = lbl(rjH, "\u{1F504} REJOIN GLOBAL", 13, C.accent); rjHt.Font = FONT_B
    rjHt.Position = UDim2.new(0, 12, 0, 0); rjHt.Size = UDim2.new(1, -12, 1, 0)

    local rjInfo = lbl(miscContent, "Rejoin tiap X menit (default 30, WAJIB nyala).\nSemua RF sinkron per interval \u{00b7} tiap interval grid sendiri.", 11.5, C.textDim)
    rjInfo.Size = UDim2.new(1, 0, 0, 40); rjInfo.TextWrapped = true; rjInfo.LayoutOrder = 2

    local RJ_PRESETS = { 10, 20, 30, 40, 50, 60, 70 }
    local rjPreRow = mk("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
        LayoutOrder = 3, Parent = miscContent })
    mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = rjPreRow })
    local rjPreBtns = {}
    local rjStrokes = {}
    local function setRejoin(m)
        _G.ZenxRejoinMenit = m
        if _G.ZenxKgSaveCfg then _G.ZenxKgSaveCfg() end
        for mm, b in pairs(rjPreBtns) do
            local on = (mm == m)
            b.BackgroundColor3 = on and C.cardSel or C.card
            b.TextColor3 = on and C.accent or C.textDim
            if rjStrokes[mm] then rjStrokes[mm].Color = on and C.borderSel or C.border end
        end
        if _G.ZenxKgLog then _G.ZenxKgLog("rejoin global -> " .. m .. " menit") end
    end
    local aktifM = tonumber(_G.ZenxRejoinMenit) or 30
    for i, m in ipairs(RJ_PRESETS) do
        local on = (m == aktifM)
        local b = mk("TextButton", { Size = UDim2.new(1/7, -4, 1, 0),
            BackgroundColor3 = on and C.cardSel or C.card, Text = tostring(m),
            Font = FONT_B, TextSize = 11, TextColor3 = on and C.accent or C.textDim,
            AutoButtonColor = false, LayoutOrder = i, Parent = rjPreRow })
        corner(b, 5); rjStrokes[m] = stroke(b, on and C.borderSel or C.border, 1)
        b.MouseButton1Click:Connect(function() setRejoin(m) end)
        rjPreBtns[m] = b
    end
    -- label sisa countdown (live, sinkron semua RF)
    local rjSisa = mk("TextLabel", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.panel,
        Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        Text = "", LayoutOrder = 4, Parent = miscContent }); corner(rjSisa, 6)
    mk("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = rjSisa })
    task.spawn(function()
        while gui.Parent do
            local s = tonumber(_G.ZenxRejoinSisa) or 0
            local m = tonumber(_G.ZenxRejoinMenit) or 30
            rjSisa.Text = ("Rejoin tiap %dm \u{00b7} sisa %02d:%02d\n(sinkron semua RF)"):format(
                m, math.floor(s/60), s%60)
            task.wait(1)
        end
    end)
end

