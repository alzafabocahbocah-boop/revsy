local SETTINGS_FILE = "ZenxPetStat_settings.json"

local function saveSettings()
    if not writefile then return end
    local data = {
        selectedSeals = {}, selectedMisc = {}, selectedPetTypes = {},
        selectedEgg = selectedEgg,
        tracker = {
            pet = trackerPet,
            eggInitial = trackerEggInitial,  -- v3.26
            startTime = trackerStartTime,
        }
    }
    for u in pairs(selectedSeals) do table.insert(data.selectedSeals, u) end
    for m in pairs(selectedMisc) do table.insert(data.selectedMisc, m) end
    for p in pairs(selectedPetTypes) do table.insert(data.selectedPetTypes, p) end
    pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(data)) end)
end

local function loadSettings()
    if not (isfile and readfile) then return end
    pcall(function()
        if isfile(SETTINGS_FILE) then
            local raw = readfile(SETTINGS_FILE)
            local data = HttpService:JSONDecode(raw)
            if type(data) == "table" then
                for _, u in ipairs(data.selectedSeals or {}) do selectedSeals[u] = true end
                for _, m in ipairs(data.selectedMisc or {}) do selectedMisc[m] = true end
                -- v3.37: multi-select pet types (migrasi dari single selectedPet lama)
                if type(data.selectedPetTypes) == "table" then
                    for _, p in ipairs(data.selectedPetTypes) do selectedPetTypes[p] = true end
                elseif type(data.selectedPet) == "string" then
                    selectedPetTypes[data.selectedPet] = true
                end
                if type(data.selectedEgg) == "string" then selectedEgg = data.selectedEgg end
                if data.tracker then
                    trackerPet = tonumber(data.tracker.pet) or 0
                    trackerEggInitial = tonumber(data.tracker.eggInitial)
                    trackerStartTime = tonumber(data.tracker.startTime) or os.time()
                end
                print(string.format("[PetStat] loaded %d seals + %d misc + tracker(p+%d eggAwal=%s) + filter(pet=%d jenis egg=%s)",
                    #(data.selectedSeals or {}), #(data.selectedMisc or {}),
                    trackerPet, tostring(trackerEggInitial),
                    petTypeCount(), tostring(selectedEgg)))
            end
        end
    end)
end
