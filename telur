-- Find memory container (kg.txt style) — dengan retry
local function findMemoryContainer()
    if not getgc then return nil end
    local best, bestCount = nil, 0
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                local uuidLike = 0
                for k in pairs(obj) do
                    if type(k) == "string" and #k >= 32 and k:find("-") then
                        uuidLike = uuidLike + 1
                        if uuidLike >= 5 then break end
                    end
                end
                if uuidLike >= 5 then
                    local sample = nil
                    for _, v in pairs(obj) do sample = v; break end
                    if type(sample) == "table" and rawget(sample, "PetData") then
                        local cnt = 0
                        for _ in pairs(obj) do cnt = cnt + 1 end
                        if cnt > bestCount then best = obj; bestCount = cnt end
                    end
                end
            end
        end
    end)
    return best, bestCount
end

-- v3.6: cached container (kg.txt style — only refresh kalo dapet lebih banyak)
local cachedContainer, cachedCount = nil, 0
local function getOrRefreshContainer()
    local nc, ncnt = findMemoryContainer()
    if nc and ncnt > 0 and ncnt >= cachedCount then
        cachedContainer = nc
        cachedCount = ncnt
    end
    return cachedContainer, cachedCount
end

-- v3.8: persistent cache — uuidToPetData dibuild SEKALI, refresh hanya kalo miss
local uuidToPetDataCache = {}  -- persists between scans
local containerLastChecked = 0
local lastForceScan = 0  -- v3.30: throttle force getgc rescan (anti lag)
local CONTAINER_RECHECK_INTERVAL = 60  -- detik

local function rebuildLookup()
    uuidToPetDataCache = {}
    local container = cachedContainer
    if not container then return end
    for k, v in pairs(container) do
        if type(v) == "table" and v.PetData then
            local rawKey = tostring(k)
            local clean = rawKey:gsub("^{", ""):gsub("}$", "")
            uuidToPetDataCache[clean] = v.PetData
            uuidToPetDataCache[rawKey] = v.PetData
        end
    end
end

-- v3.23: aggressive scan — walk SEMUA getgc, merge SEMUA uuid→PetData yg ketemu
local function aggressiveScanAllPetData()
    if not getgc then return 0 end
    local count = 0
    pcall(function()
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                pcall(function()
                    for k, v in pairs(obj) do
                        if type(k) == "string" and #k >= 32 and type(v) == "table" then
                            if rawget(v, "PetData") then
                                local clean = k:gsub("^{",""):gsub("}$","")
                                if not uuidToPetDataCache[clean] then
                                    uuidToPetDataCache[clean] = v.PetData
                                    uuidToPetDataCache[k] = v.PetData
                                    count = count + 1
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)
    return count
end

local function ensureContainer(forceMiss)
    local now = os.time()
    local needRefresh = forceMiss or (cachedContainer == nil) or
        ((now - containerLastChecked) > CONTAINER_RECHECK_INTERVAL)
    if needRefresh then
        local nc, ncnt = findMemoryContainer()
        -- v3.29: allow update walaupun count TURUN (gift/sell detection)
        -- Guard cuma reject kalo scan jelas broken (< 30% dari cached = transient load)
        if nc and ncnt > 0 and (forceMiss or ncnt >= math.floor(cachedCount * 0.3)) then
            cachedContainer = nc
            cachedCount = ncnt
            rebuildLookup()
        end
        -- v3.23: kalo force, juga aggressive scan merge tambahan PetData dari getgc
        if forceMiss then
            local added = aggressiveScanAllPetData()
            if added > 0 then
                print(string.format("[PetStat] aggressive scan: +%d PetData entries", added))
            end
        end
        containerLastChecked = now
    end
    return cachedContainer
end

-- SCAN PETS — persistent across scans (v3.14: pet di garden tetep ke-track)
local function scanPets()
    -- v3.14: JANGAN clear petsByUuid — persist supaya pet di garden tetep di list
    -- Hanya update stats + tambah pet baru. Remove kalo bener-bener gone dari container.
    petCounts = {}

    local bp = player:FindFirstChild("Backpack")
    if not bp then return end

    ensureContainer(false)

    local function getStats(uuid, tool)
        if tool then
            local bw = tonumber(tool:GetAttribute("BaseWeight") or tool:GetAttribute("kg"))
            local lvl = tonumber(tool:GetAttribute("Level") or tool:GetAttribute("Age"))
            local mut = tool:GetAttribute("MutationType") or tool:GetAttribute("Mutation") or tool:GetAttribute("m")
            if bw and bw > 0 then return bw * 1.1, lvl or 1, mut end
        end
        local pd = uuidToPetDataCache[uuid] or uuidToPetDataCache["{"..uuid.."}"]
        if pd then
            local bw = tonumber(pd.BaseWeight) or 0
            return bw * 1.1, tonumber(pd.Level) or 1, pd.MutationType or pd.Mutation
        end
        return 0, 1, nil
    end

    -- Step 1: scan backpack/character — refresh stats, mark inBackpack
    local seenInBp = {}
    local function scanCont(c)
        if not c then return end
        for _, tool in ipairs(c:GetChildren()) do
            if tool:IsA("Tool") then
                local uuid = tool:GetAttribute("PET_UUID")
                local typeRaw = tool:GetAttribute("f")
                if uuid and typeRaw then
                    seenInBp[uuid] = true
                    local petType = stripMutation(tostring(typeRaw))
                    local w, a, m = getStats(uuid, tool)
                    petsByUuid[uuid] = {
                        name = petType, weight = w, age = a, mutation = m, inBp = true,
                    }
                end
            end
        end
    end
    scanCont(bp)
    scanCont(player.Character)

    -- Step 2: pet yg ilang dari backpack = di-REMOVE (sold/gift/placed).
    -- v3.35: container gak reliable buat detect sold (entry stale ketinggalan di memory),
    -- jadi BACKPACK = sumber kebenaran. Pet ilang dari backpack → langsung turun.
    local toRemove = {}
    for uuid, pd in pairs(petsByUuid) do
        if not seenInBp[uuid] then
            table.insert(toRemove, uuid)
        end
    end
    for _, uuid in ipairs(toRemove) do
        petsByUuid[uuid] = nil
        selectedSeals[uuid] = nil
    end
    if #toRemove > 0 then saveSettings() end

    -- Step 3: retry stats lookup buat pet yg weight=0 (container belum ready saat scan pertama)
    local zeroCount = 0
    local totalCount = 0
    for _, pd in pairs(petsByUuid) do
        totalCount = totalCount + 1
        if pd.weight == 0 then zeroCount = zeroCount + 1 end
    end
    -- v3.30: force re-scan getgc itu BERAT — throttle max sekali tiap 20s (anti lag).
    -- Cuma force kalo >50% weight=0 DAN belum force baru-baru ini.
    if zeroCount > 0 and totalCount > 0 and zeroCount >= totalCount / 2 then
        local now = os.time()
        if (now - (lastForceScan or 0)) > 20 then
            lastForceScan = now
            ensureContainer(true)
        end
    end
    for uuid, pd in pairs(petsByUuid) do
        if pd.weight == 0 then
            local w, a, m = getStats(uuid, nil)
            if w > 0 then
                pd.weight = w; pd.age = a; pd.mutation = m
            end
        end
    end

    -- Step 4: rebuild petCounts
    for _, pd in pairs(petsByUuid) do
        petCounts[pd.name] = (petCounts[pd.name] or 0) + 1
    end
end

local lastEggGuiScan = 0  -- v3.31: throttle scan PlayerGui (berat)
local eggCountsGuiCache = {}  -- v3.34: cache count dari GUI biar gak kedip ke 0
local function scanEggs()
    eggCounts = {}
    pcall(function()
        local function scanTools(container)
            if not container then return end
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and t.Name:lower():find("egg") then
                    eggCounts[t.Name] = (eggCounts[t.Name] or 0) + 1
                end
            end
        end
        scanTools(player.Backpack)
        scanTools(player.Character)
    end)
    -- v3.31: scan PlayerGui descendant (BERAT) cuma tiap 15 detik
    -- v3.34: hasilnya disimpen di cache — biar gak kedip 772->0 pas scan di-skip
    local now = os.time()
    if (now - lastEggGuiScan) >= 15 then
        lastEggGuiScan = now
        local fresh = {}
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if pg then
            for _, d in ipairs(pg:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local txt = d.Text or ""
                    local cnt, name = txt:match("^(%d+)x%s+(.+[Ee]gg.*)$")
                    if not cnt then cnt, name = txt:match("^x(%d+)%s+(.+[Ee]gg.*)$") end
                    if not cnt then name, cnt = txt:match("^(.+[Ee]gg.-)%s+x?(%d+)$") end
                    if cnt and name then
                        local n = tonumber(cnt)
                        if n and n > 0 then
                            fresh[name] = math.max(fresh[name] or 0, n)
                        end
                    end
                end
            end
        end
        eggCountsGuiCache = fresh  -- update cache (replace, biar ngikut kalo telur berkurang)
    end
    -- merge cache GUI ke eggCounts (persist antar scan — anti kedip)
    for k, v in pairs(eggCountsGuiCache) do
        eggCounts[k] = math.max(eggCounts[k] or 0, v)
    end
end

