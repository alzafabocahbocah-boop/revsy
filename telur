-- v3.27: instant refresh saat Tool pet di-add/remove dari backpack/character
local function hookBackpack(c)
    if not c then return end
    -- v3.33: DEBOUNCE — pas hatch banyak telur, event ChildAdded/Removed nembak beruntun.
    -- Kumpulin jadi SATU scan (abis 0.6s diem) biar gak lag spike.
    c.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and child:GetAttribute("PET_UUID") then
            scheduleHatchRescan()
        end
    end)
    c.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and child:GetAttribute("PET_UUID") then
            scheduleHatchRescan()
        end
    end)
end
-- v3.36: equip/unequip pet (backpack<->character) fire event tapi GAK ngubah total.
-- Force getgc scan tiap equip = lag. Jadi refresh RINGAN aja (scan backpack/char doang).
-- Container stats buat pet baru (hatch) di-handle throttle di scanPets (20s), gak perlu force tiap event.
local _hatchPending = false
function scheduleHatchRescan()
    if _hatchPending then return end
    _hatchPending = true
    task.spawn(function()
        task.wait(0.4)
        _hatchPending = false
        refreshAll()  -- ringan: scan backpack/character, update count. NO force getgc.
    end)
end
