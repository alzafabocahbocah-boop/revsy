local function updateSealPct()
    -- v3.11: misc boost di-apply PER PET (additive ke individual pet's %)
    local miscSum = 0
    local miscCount = 0
    for mutName, on in pairs(selectedMisc) do
        if on then
            miscSum = miscSum + (MUTATION_BOOST[mutName] or 0)
            miscCount = miscCount + 1
        end
    end

    local total, count = 0, 0
    local totalSeal = 0
    for uuid, pd in pairs(petsByUuid) do
        if pd.name and pd.name:lower():find("seal", 1, true) then
            totalSeal = totalSeal + 1
            if selectedSeals[uuid] then
                -- Tiap pet: base% + (own mut boost) + (misc boost dari user)
                local petPct = sealPct(pd.weight, pd.age, pd.mutation) + (miscSum / 100)
                total = total + petPct
                count = count + 1
            end
        end
    end

    local final = total
    sealCol.val.Text = string.format("%.2f%%", final)
    if miscCount > 0 then
        sealCol.sub.Text = string.format("%d/%d • +%d/pet", count, totalSeal, miscSum)
    else
        sealCol.sub.Text = string.format("%d/%d picked", count, totalSeal)
    end
end

