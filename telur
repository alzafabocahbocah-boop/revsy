local function sealPct(Wh, age, mut)
    local W = (Wh / 11) * (age + 10)
    local base = (W <= 100) and (0.05 * W + 1.0) or (6.0 + 0.0125 * (W - 100))
    return base + ((MUTATION_BOOST[mut or ""] or 0) / 100)
end

