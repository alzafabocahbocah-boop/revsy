    end

    -- Pet: hanya tambah kalo nambah (no decrement)
    if trackerPrevPet ~= nil then
        local dPet = currentPet - trackerPrevPet
        if dPet > 0 then trackerPet = trackerPet + dPet end
    end
    trackerPrevPet = currentPet

    -- v3.26: Egg awal = first measurement (atau after CLEAR)
    if trackerEggInitial == nil then
        trackerEggInitial = currentEgg
    end

    if trackerVisible then updateTracker() end
