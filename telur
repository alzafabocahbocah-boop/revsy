local function formatTime(s)
    local h = math.floor(s / 3600)
    local m = math.floor((s % 3600) / 60)
    local sec = s % 60
    if h > 0 then return string.format("%dh %dm %ds", h, m, sec) end
    if m > 0 then return string.format("%dm %ds", m, sec) end
    return string.format("%ds", sec)
end

local function updateTracker()
    local petTag = (petTypeCount() == 0) and " (all)" or (" ("..petTypesLabel():gsub(" ▼","")..")")
    local eggTag = selectedEgg and (" ("..selectedEgg..")") or " (all)"
    trackPetLbl.Text = string.format("🐾 Pet +%d%s", trackerPet, petTag)
    -- v3.26: egg = awal vs sekarang, single net delta
    local currentEgg
    if selectedEgg then
        currentEgg = eggCounts[selectedEgg] or 0
    else
        currentEgg = 0
        for _, c in pairs(eggCounts) do currentEgg = currentEgg + c end
    end
    local initial = trackerEggInitial or currentEgg
    local delta = currentEgg - initial
    local sign = delta >= 0 and "+" or ""
    trackEggLbl.Text = string.format("🥚 Egg awal:%d → sekarang:%d (%s%d)%s",
        initial, currentEgg, sign, delta, eggTag)
    trackTimeLbl.Text = "⏱️ Time: " .. formatTime(os.time() - trackerStartTime)
end

