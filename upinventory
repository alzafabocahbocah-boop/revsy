-- Cari MaxPetsInInventory via getgc (paling akurat, otomatis ikut upgrade)
local _maxCache, _maxAt = nil, 0
local function getMaxInv()
    if _maxCache and (tick() - _maxAt) < 5 then return _maxCache end
    local best = nil
    pcall(function()
        if getgc then
            for _, obj in ipairs(getgc(true)) do
                if type(obj) == "table" then
                    local mp = rawget(obj, "MaxPetsInInventory")
                    if type(mp) == "number" and mp > 0 and (not best or mp > best) then
                        best = mp
                    end
                end
            end
        end
    end)
    if not best then
        pcall(function()
            local v = plr:GetAttribute("MaxPets") or plr:GetAttribute("MaxPetsInInventory")
                   or plr:GetAttribute("MaxPetsInventory")
            if type(v) == "number" and v > 0 then best = v end
        end)
    end
    _maxCache = best or 0
    _maxAt = tick()
    return _maxCache
end

-- Hitung pet di backpack sekarang
local function countPets()
    local n = 0
    local bp = plr:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and (t:FindFirstChild("PetToolLocal") or t:FindFirstChild("PetToolServer")) then
                n = n + 1
            end
        end
    end
    if plr.Character then
        for _, t in ipairs(plr.Character:GetChildren()) do
            if t:IsA("Tool") and (t:FindFirstChild("PetToolLocal") or t:FindFirstChild("PetToolServer")) then
                n = n + 1
            end
        end
    end
    return n
end

-- ===================== SCAN REMOTES (INVENTORY UPGRADE) =====================
-- Nama-nama remote yang mungkin dipakai GAG untuk upgrade inventory/slot
local INV_REMOTE_NAMES = {
    "ExpandInventory", "ExpandPetInventory", "UpgradeInventory", "BuyInventorySlot",
    "AddInventorySlot", "InventoryUpgrade", "PetInventoryUpgrade", "BuyPetSlot",
    "PetSlotUpgrade", "PetStorageUpgrade", "BuyStorage", "UpgradeStorage",
    "PetInventoryService", "InventoryService", "PurchaseInventory",
    "BuyInventory", "InventoryExpand", "PetExpand", "ExpandPets",
    -- format dengan underscore
    "Expand_Inventory", "Upgrade_Inventory", "Buy_Inventory",
    "Pet_Inventory", "Inventory_Upgrade", "Storage_Upgrade",
    -- format camelCase lain
    "expandInventory", "upgradeInventory", "buyInventorySlot", "petSlot",
    "inventoryUpgrade", "storageUpgrade",
}

local invUpgradeRE = nil
local function findInvRE()
    -- 1. cek langsung di GameEvents
    for _, name in ipairs(INV_REMOTE_NAMES) do
        local v = gameEvents:FindFirstChild(name)
        if v and (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            addLog("invRE FOUND di GameEvents: "..name)
            return v, name
        end
    end
    -- 2. scan SEMUA descendants GameEvents (cari yang mengandung kata kunci)
    for _, v in ipairs(gameEvents:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local ln = v.Name:lower()
            if ln:find("expand") or ln:find("slot") or ln:find("storage")
               or (ln:find("inventory") and (ln:find("buy") or ln:find("upgrade") or ln:find("add") or ln:find("expand")))
               or (ln:find("pet") and ln:find("slot")) then
                addLog("invRE scan FOUND: "..v:GetFullName())
                return v, v.Name
            end
        end
    end
    -- 3. scan seluruh RS descendants
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local ln = v.Name:lower()
            if ln:find("expand") and (ln:find("inv") or ln:find("pet") or ln:find("slot") or ln:find("stor")) then
                addLog("invRE RS FOUND: "..v:GetFullName())
                return v, v.Name
            end
        end
    end
    return nil, nil
end

