-- Satu siklus upgrade
local function doOneUpgrade()
    local mxBefore = getMaxInv()
    local ok, info = false, ""

    -- Coba Remote dulu
    if invUpgradeRE then
        ok, info = tryFireInvRE(invUpgradeRE)
        if ok then addLogLine("RE fire OK: "..info, C.Green)
        else addLogLine("RE fire FAIL: "..info, C.Red) end
    end

    -- Kalau RE gagal atau tidak ada, coba PP
    if not ok then
        local ppOk, ppInfo = tryFireInvPP()
        if ppOk then
            ok = true
            addLogLine("PP fire OK: "..tostring(ppInfo), C.Green)
        else
            addLogLine("PP: "..tostring(ppInfo), C.Red)
        end
    end

    -- Cek apakah maxInv naik
    task.wait(0.3)
    local mxAfter = getMaxInv()
    if mxAfter > mxBefore then
        upgradeCount = upgradeCount + 1
        addLogLine(string.format("✓ Slot naik: %d → %d (+%d)", mxBefore, mxAfter, mxAfter - mxBefore), C.Green)
        return true
    else
        if ok then
            addLogLine("Fire OK tapi maxInv belum naik (mungkin cooldown/gagal)", C.Gold)
        end
        return false
    end
end

-- Main loop
local function startLoop()
    if running then return end
    running = true
    maxBefore = getMaxInv()
    addLogLine(string.format("START — maxInv awal: %d", maxBefore), C.Teal)
    setStatus("Running...", C.Teal)
    startBtn.BackgroundColor3 = C.Dim
    startBtn.TextColor3 = C.Gray

    upgradeTask = task.spawn(function()
        while running do
            local target = tonumber(tgtBox.Text) or 500
            local delay = math.max(0.2, tonumber(dlyBox.Text) or 0.5)
            local current = getMaxInv()

            updateInvDisplay()

            if current >= target then
                addLogLine(string.format("Target tercapai! %d >= %d", current, target), C.Green)
                setStatus(string.format("SELESAI — Inv: %d (target %d)", current, target), C.Green)
                running = false
                break
            end

            setStatus(string.format("Upgrade... %d/%d (target %d)", current, current, target), C.Teal)
            doOneUpgrade()
            task.wait(delay)
        end
        running = false
        startBtn.BackgroundColor3 = C.TDim
        startBtn.TextColor3 = C.Teal
        updateInvDisplay()
    end)
end

local function stopLoop()
    running = false
    if upgradeTask then pcall(function() task.cancel(upgradeTask) end) upgradeTask = nil end
    setStatus("Stop", C.Red)
    startBtn.BackgroundColor3 = C.TDim
    startBtn.TextColor3 = C.Teal
    addLogLine("=== STOP ===", C.Red)
    updateInvDisplay()
end

