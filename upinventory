-- ===================== LOG =====================
local _logs = {}
local function addLog(msg)
    local t = os.date("*t")
    local ts = string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
    local line = "["..ts.."] "..tostring(msg)
    table.insert(_logs, line)
    if #_logs > 200 then table.remove(_logs, 1) end
    print("[INV] "..line)
end

