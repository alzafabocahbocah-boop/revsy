-- Scan workspace cari ProximityPrompt yang terkait inventory/slot/expand
local INV_PP_KEYWORDS = {
    "expand", "slot", "inventory", "storage", "upgrade", "capacity",
    "pet slot", "pet storage", "more pets", "increase", "enlarge",
    -- bahasa Indonesia
    "tambah slot", "upgrade inv", "slot pet",
}

local function findInvProximityPrompts()
    local found = {}
    pcall(function()
        for _, dd in ipairs(workspace:GetDescendants()) do
            if dd:IsA("ProximityPrompt") then
                local at = (dd.ActionText or ""):lower()
                local ot = (dd.ObjectText or ""):lower()
                for _, kw in ipairs(INV_PP_KEYWORDS) do
                    if at:find(kw, 1, true) or ot:find(kw, 1, true) then
                        table.insert(found, {pp=dd, action=dd.ActionText, obj=dd.ObjectText})
                        break
                    end
                end
            end
        end
    end)
    return found
end

local function tryFireInvPP()
    local pps = findInvProximityPrompts()
    if #pps == 0 then return false, "tidak ada PP inventory ditemukan" end
    for _, entry in ipairs(pps) do
        local pp = entry.pp
        addLog("Coba fire PP: action='"..entry.action.."' obj='"..entry.obj.."'")
        -- expand jangkauan
        pcall(function()
            pp.MaxActivationDistance = 10000
            pp.HoldDuration = 0
        end)
        local ok, err = pcall(function()
            if fireproximityprompt then
                fireproximityprompt(pp)
            else
                pp:InputHoldBegin()
                task.wait(0.05)
                pp:InputHoldEnd()
            end
        end)
        if ok then
            addLog("PP fire OK: "..entry.action)
            return true, entry.action
        else
            addLog("PP fire FAIL: "..tostring(err))
        end
    end
    return false, "semua PP gagal"
end

-- ===================== COBA FIRE REMOTE LANGSUNG =====================
-- Format fire berbeda-beda: coba beberapa pola
local function tryFireInvRE(re)
    if not re then return false, "no RE" end
    -- Pola 1: no args
    local ok, err = pcall(function()
        if re:IsA("RemoteEvent") then re:FireServer()
        else re:InvokeServer() end
    end)
    if ok then return true, "no args" end
    addLog("Pola no-args FAIL: "..tostring(err))

    -- Pola 2: arg "Buy" / "Upgrade"
    for _, arg in ipairs({"Buy", "Upgrade", "Expand", "Add", "Purchase", "buy", "upgrade"}) do
        local ok2, err2 = pcall(function()
            if re:IsA("RemoteEvent") then re:FireServer(arg)
            else re:InvokeServer(arg) end
        end)
        if ok2 then return true, "arg="..arg end
    end
    return false, "semua pola fire FAIL"
end

