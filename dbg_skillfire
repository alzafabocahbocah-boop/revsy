-- ============ LOG HELPER ============
local logCount = 0
local eventCount = 0
local fireCount = 0

local function addLog(txt, col)
    logCount = logCount + 1
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,0)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.BackgroundTransparency = 1; row.BorderSizePixel = 0
    row.LayoutOrder = logCount; row.Parent = scroll
    local lbl = Instance.new("TextLabel"); lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Code; lbl.TextSize = 9
    lbl.TextColor3 = col or WH
    lbl.Text = txt
    lbl.Size = UDim2.new(1,-4,0,0); lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.Position = UDim2.new(0,4,0,0)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true; lbl.Parent = row
    -- auto scroll ke bawah
    task.defer(function()
        scroll.CanvasPosition = Vector2.new(0, math.huge)
    end)
    -- batas 60 baris
    if logCount > 60 then
        local ch = scroll:GetChildren()
        for _, c in ipairs(ch) do
            if c:IsA("Frame") and c.LayoutOrder <= (logCount - 60) then c:Destroy() end
        end
    end
end

local function _ts()
    local t = tick() % 10000
    return string.format("%.2f", t)
end

-- ============ PET INFO HELPER ============
local function fmtUUID(u)
    local s = tostring(u):gsub("[{}]","")
    if s:sub(1,1) ~= "{" then s = "{"..s.."}" end
    return s
end

local function getPetInfo(uuid)
    -- coba dari getgc container (sama cara up6kg)
    local key = fmtUUID(uuid)
    if getgc then
        local ok, gc = pcall(getgc, true)
        if ok and gc then
            for _, v in ipairs(gc) do
                local entry = type(v) == "table" and rawget(v, key)
                if entry and type(entry) == "table" then
                    local e = entry
                    local pd = rawget(e, "PetData")
                    if pd then
                        local nm  = tostring(rawget(e,"PetType") or rawget(pd,"PetType") or "?")
                        local bw  = tonumber(rawget(pd,"BaseWeight")) or 0
                        local lv  = tonumber(rawget(pd,"Level")) or 0
                        local kg  = bw * (lv + 10) / 10
                        return nm, lv, kg
                    end
                end
            end
        end
    end
    -- fallback: scan backpack + char
    local plr = Players.LocalPlayer
    local sources = {}
    if plr.Character then table.insert(sources, plr.Character) end
    if plr.Backpack then table.insert(sources, plr.Backpack) end
    for _, src in ipairs(sources) do
        for _, t in ipairs(src:GetChildren()) do
            if t:IsA("Tool") then
                local u = t:GetAttribute("PET_UUID")
                if u and tostring(u):gsub("[{}]","") == tostring(uuid):gsub("[{}]","") then
                    local nm = tostring(t:GetAttribute("f") or t.Name or "?")
                    return nm, nil, nil
                end
            end
        end
    end
    return nil, nil, nil
end

-- ============ PET INFO CACHE (shared) ============
local petInfoCache = {}
local function getCachedInfo(key, uuid)
    local c = petInfoCache[key]
    if c and (tick() - c.at) < 5 then return c.nm, c.age, c.kg end
    local nm, age, kg = getPetInfo(uuid)
    petInfoCache[key] = { nm = nm or "?", age = age, kg = kg, at = tick() }
    return nm or "?", age, kg
end

local function fmtInfo(key, uuid)
    local pnm, page, pkg = getCachedInfo(key, uuid)
    local s = tostring(pnm):sub(1,14)
    if page then s = s.." a"..tostring(page) end
    if pkg  then s = s.." "..string.format("%.2f",pkg).."kg" end
    return s
end

-- ============ DETECT VIA POSITION (SpottedEffect + Zone) ============
-- SpottedEffect = Diloph/Spotted skill, Zone = Peacock/zone skill
-- pre-cache posisi tiap UUID tiap heartbeat → lookup cepat saat VFX spawn

local lastVFXFire = {}  -- debounce per uuid
local petPosCache = {}  -- key=uuid_key, val=Vector3

local function isUUID(s)
    return type(s) == "string" and
        s:match("[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]%-")
end

-- update cache tiap heartbeat
local RunService = game:GetService("RunService")
RunService.Heartbeat:Connect(function()
    local pp = workspace:FindFirstChild("PetsPhysical")
    if not pp then return end
    for _, mover in ipairs(pp:GetChildren()) do
        for _, uuidObj in ipairs(mover:GetChildren()) do
            if isUUID(uuidObj.Name) then
                local key = uuidObj.Name:gsub("[{}]","")
                for _, ch in ipairs(uuidObj:GetChildren()) do
                    if ch:IsA("BasePart") then
                        petPosCache[key] = ch.Position
                        break
                    end
                end
            end
        end
    end
end)

local function findClosestPetUUID(pos, maxDist)
    local bestKey, bestDist = nil, maxDist or 5
    for key, petPos in pairs(petPosCache) do
        local d = (petPos - pos).Magnitude
        if d < bestDist then
            bestDist = d
            bestKey = key
        end
    end
    return bestKey
end

local function onSkillVFX(obj, label)
    task.defer(function()  -- defer biar posisi settle
        local pos = nil
        pcall(function()
            if obj:IsA("BasePart") then pos = obj.Position end
        end)
        if not pos then return end
        local key = findClosestPetUUID(pos, 5)
        if not key then return end
        local now = tick()
        if lastVFXFire[key] and (now - lastVFXFire[key]) < 0.5 then return end
        lastVFXFire[key] = now
        fireCount = fireCount + 1
        eventCount = eventCount + 1
        local infoStr = fmtInfo(key, key)
        addLog("FIRE ["..infoStr.."] "..label, ORG)
        print("[dbg-skillfire] FIRE "..infoStr.." "..label)
        ctrLbl.Text = "events: "..eventCount.."  |  fires: "..fireCount
    end)
end

addLog("✓ watching VFX spawns (pos-based)", GRN)

workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "SpottedEffect" and obj:IsA("BasePart") then
        onSkillVFX(obj, "spotted")
    elseif obj.Name == "Zone" and obj:IsA("BasePart") then
        local par = obj.Parent
        if par and par.Name == "PetZoneAbilityVFX" then
            onSkillVFX(obj, "zone")
        end
    end
end)

-- ============ FALLBACK: PetCooldownsUpdated (untuk RDY info) ============
local ge = RS:FindFirstChild("GameEvents")
local pcu = ge and ge:FindFirstChild("PetCooldownsUpdated")
local req = ge and ge:FindFirstChild("RequestPetCooldowns")

if pcu then
    addLog("✓ connected PetCooldownsUpdated (RDY only)", GRN)
    local lastMinTime = {}
    pcu.OnClientEvent:Connect(function(uuid, data)
        if type(data) ~= "table" then return end
        local key = tostring(uuid):gsub("[{}]", "")
        local minNow = math.huge
        for _, v in ipairs(data) do
            if type(v) == "table" then
                local t = tonumber(v.Time) or tonumber(v.time) or tonumber(v[2]) or math.huge
                local nm = tostring(v.Name or v.name or v[1] or "")
                if not nm:lower():find("mutation") then
                    minNow = math.min(minNow, t)
                end
            end
        end
        if minNow <= 0 then
            local infoStr = fmtInfo(key, uuid)
            addLog("RDY  ["..infoStr.."]", GRN)
        end
        lastMinTime[key] = minNow
    end)
    if req then pcall(function() req:FireServer() end) end
end

