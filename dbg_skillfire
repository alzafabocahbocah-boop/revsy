-- ============ DETECT VIA SOUND (skill sound per pet) ============
-- Diloph skill         : rbxassetid://109335879280084
-- Peacock skill        : rbxassetid://73915703683838
-- Gilded Choc Peryton  : rbxassetid://120728735583575

local SKILL_SOUNDS = {
    ["rbxassetid://109335879280084"] = "diloph",
    ["rbxassetid://73915703683838"]  = "peacock",
    ["rbxassetid://120728735583575"] = "gld-peryton",
}

local lastFire = {}  -- debounce per uuid

local function onSkillSound(uuid, label)
    local key = uuid:gsub("[{}]","")
    local now = tick()
    if lastFire[key] and (now - lastFire[key]) < 1 then return end
    lastFire[key] = now
    fireCount = fireCount + 1
    eventCount = eventCount + 1
    local infoStr = fmtInfo(key, key)
    addLog("SND  ["..infoStr.."] "..label, ORG)
    print("[dbg-skillfire] SND "..infoStr.." "..label)
    ctrLbl.Text = "events: "..eventCount.."  |  fires: "..fireCount
    if _G.ZenxSkillSwap then
        _G.ZenxSkillSwap(key)
        addLog("  → swap via up6kg "..key:sub(1,8).."…", GR)
    else
        doSkillSwap(key)
    end
end

