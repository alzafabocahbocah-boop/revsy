          let detailBerubah = false;
          if (b.detail && typeof b.detail === "object") {
            for (const [nm, v] of Object.entries(b.detail)) {
              if (typeof nm !== "string" || nm.length > 60 || typeof v !== "object" || !v) continue;
              const isi = {
                tampil: teks(v.tampil, 60) || nm,
                harga: angka(v.harga),
                rarity: teks(v.rarity, 20) || "?",
                spawn: (typeof v.spawn === "number" && isFinite(v.spawn)) ? v.spawn : null,
