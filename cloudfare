          if (Array.isArray(b.muts) && b.muts.length) {
            const m = bersihkan(b.muts);
            if (JSON.stringify(d.muts || []) !== JSON.stringify(m)) {
              d.muts = m; await simpanKatalog(d);
            }
          }
          return json({ ok: true, baru, totalPet: Object.keys(d.pets).length,
                        totalSeed: Object.keys(d.seeds).length,
                        totalGear: Object.keys(d.gears).length });
        }

        if (jalur === "/katalog" && req.method === "GET") {
          const d = await bacaKatalog();
          const susun = (jenis) =>
            Object.entries(d[jenis])
              .map(([nama, sejak]) => ({
                nama, sejak, baru: !d.lihat[jenis][nama],
                // v15-55: rincian berlaku buat pet DAN seed (seed: "harga" =
                // nilai jual buahnya, "rilis" dari SeedShopEnabled)
                ...(d.detail[nama] || {}),
              }))
              .sort((a, b) => a.nama.localeCompare(b.nama));
          const pets = susun("pets"), seeds = susun("seeds"), gears = susun("gears");
          return json({
            skrg, pets, seeds, gears,
            muts: (d.muts || []).map((m) => ({ nama: m, tampil: m })),
            nBaruPet: pets.filter((x) => x.baru).length,
            nBaruSeed: seeds.filter((x) => x.baru).length,
            nBaruGear: gears.filter((x) => x.baru).length,
          });
        }

        if (jalur === "/katalog-lihat" && req.method === "POST") {
          const b = await req.json();
          const d = await bacaKatalog();
          // tanpa isi = tandai SEMUA udah dilihat
          const semua = !b.pets && !b.seeds;
          for (const jenis of ["pets", "seeds"]) {
            const daftar = semua ? Object.keys(d[jenis]) : bersihkan(b[jenis]);
            for (const nm of daftar) d.lihat[jenis][nm] = skrg;
          }
          await simpanKatalog(d);
          return json({ ok: true });
        }
        return salah("cara gak dikenal buat " + jalur, 405);
      }

      // ---------- v15-57: EVENT GUILD ----------
      // Script lapor event yang lagi jalan; CF nyatat kapan nama event
      // BERUBAH. Panel banding sama yang terakhir dilihat -> kalau beda,
      // kasih notif "event baru".
      //   POST /guild-event  -> {akun, nama, tag, sisa, selesai, sumber}
      //   GET  /guild-event  -> { event, baru }
      //   POST /guild-lihat  -> tandai udah dilihat
      if (jalur === "/guild-event" || jalur === "/guild-lihat") {
        const baca = async () => {
          const c = await db.prepare("SELECT ts, data FROM cfg WHERE scope='guild'").first();
          let d = { nama: "", tag: "", sisa: 0, selesai: false, sumber: "",
                    akun: "", mulai: 0, lihat: "" };
          if (c) { try { const x = JSON.parse(c.data); if (x && typeof x === "object") d = { ...d, ...x }; } catch {} }
          return d;
        };
        const simpan = async (d) => {
          await db.prepare(
            `INSERT INTO cfg (scope, ts, data) VALUES ('guild', ?1, ?2)
             ON CONFLICT(scope) DO UPDATE SET ts=?1, data=?2`
          ).bind(skrg, JSON.stringify(d)).run();
        };

        if (jalur === "/guild-event" && req.method === "POST") {
          const b = await req.json();
          const nama = teks(b.nama, 80);
          if (!nama) return salah("nama event kosong");
          const d = await baca();
          const gantiEvent = (d.nama !== nama);
          const isi = {
            nama,
            tag: teks(b.tag, 60) || "",
            sisa: angka(b.sisa),
            selesai: b.selesai === true,
            sumber: teks(b.sumber, 30) || "",
            akun: teks(b.akun) || "",
            // mulai = kapan nama event ini pertama keliat
            mulai: gantiEvent ? skrg : (d.mulai || skrg),
            // event ganti -> tanda "udah dilihat" direset
            lihat: gantiEvent ? "" : (d.lihat || ""),
          };
          await simpan(isi);
          return json({ ok: true, gantiEvent, ...isi });
        }

        if (jalur === "/guild-event" && req.method === "GET") {
          const d = await baca();
          return json({
            skrg, event: d.nama ? d : null,
            baru: !!(d.nama && d.lihat !== d.nama),
          });
        }

        if (jalur === "/guild-lihat" && req.method === "POST") {
          const d = await baca();
          d.lihat = d.nama || "";
          await simpan(d);
          return json({ ok: true });
        }
        return salah("cara gak dikenal buat " + jalur, 405);
      }

      // ---------- v15-64: KUNCI API bypass.vip ----------
      // Dulu ditanyain di SETIAP setup RF -- 20 RF = 20 kali ngetik kunci yang
      // sama. Sekarang disimpen SEKALI di sini, worker narik sendiri.
      //
      // Tetep GAK masuk GitHub: dia ada di D1, bukan di berkas yang di-push.
      // Aturan lama (jangan hardcode di worker) tetep dipegang -- yang berubah
      // cuma tempat nyimpennya: dari config per-RF jadi satu tempat terpusat.
      //   GET /bypass-key       -> { key }         (dipanggil worker)
      //   GET /bypass-key?samar=1 -> { key: "...abcd", ada: true }  (buat panel)
      //   PUT /bypass-key       -> { key }
      if (jalur === "/bypass-key") {
        if (req.method === "GET") {
          const c = await db.prepare("SELECT ts, data FROM cfg WHERE scope='bypass'").first();
          let key = "";
          if (c) { try { key = (JSON.parse(c.data) || {}).key || ""; } catch {} }
          // panel minta versi SAMAR -- biar kalau layarnya ke-screenshot,
          // kuncinya gak kebaca utuh. Worker minta yang asli.
          if (url.searchParams.get("samar")) {
            return json({
              ada: key !== "",
              key: key ? ("\u2022".repeat(Math.max(0, key.length - 4)) + key.slice(-4)) : "",
              ts: c ? c.ts : 0,
            });
          }
          return json({ key, ts: c ? c.ts : 0 });
        }
        if (req.method === "PUT") {
          const b = await req.json();
          const key = teks(b.key, 200);
          if (key === null) return salah("key harus teks");
          await db.prepare(
            `INSERT INTO cfg (scope, ts, data) VALUES ('bypass', ?1, ?2)
             ON CONFLICT(scope) DO UPDATE SET ts=?1, data=?2`
          ).bind(skrg, JSON.stringify({ key: key.trim() })).run();
          return json({ ok: true, ada: key.trim() !== "" });
        }
        return salah("cara gak dikenal buat /bypass-key", 405);
      }

      // ---------- KUNCI API blocksolve.site (solve captcha) ----------
      // Pola SAMA PERSIS kayak /bypass-key: satu tempat, worker narik sendiri,
      // gak masuk GitHub (ada di D1). Panel dapet versi samar biar aman
      // di-screenshot.
      //   GET /solve-key        -> { key }         (worker)
      //   GET /solve-key?samar=1 -> { key:"...cd2", ada:true }  (panel)
      //   PUT /solve-key        -> { key }
      if (jalur === "/solve-key") {
        if (req.method === "GET") {
          const c = await db.prepare("SELECT ts, data FROM cfg WHERE scope='solve'").first();
          let key = "";
          if (c) { try { key = (JSON.parse(c.data) || {}).key || ""; } catch {} }
          if (url.searchParams.get("samar")) {
            return json({
              ada: key !== "",
              key: key ? ("\u2022".repeat(Math.max(0, key.length - 4)) + key.slice(-4)) : "",
              ts: c ? c.ts : 0,
            });
          }
          return json({ key, ts: c ? c.ts : 0 });
        }
        if (req.method === "PUT") {
          const b = await req.json();
          const key = teks(b.key, 200);
          if (key === null) return salah("key harus teks");
          await db.prepare(
            `INSERT INTO cfg (scope, ts, data) VALUES ('solve', ?1, ?2)
             ON CONFLICT(scope) DO UPDATE SET ts=?1, data=?2`
          ).bind(skrg, JSON.stringify({ key: key.trim() })).run();
          return json({ ok: true, ada: key.trim() !== "" });
        }
        return salah("cara gak dikenal buat /solve-key", 405);
      }

      // ============================================================
      // v15-75: JALUR /basket/<nama> -- niru bentuk Pantry.
      // star_farm baca relay lewat pola ini, jadi bentuk balasannya harus
      // sama persis biar dia gak perlu diubah.
      //
      //   zenxprio -> "kirim semua ke sini". Balasannya { nm, t }, dan
      //               star_farm cuma nganggep sah kalau (skrg - t) < 90.
      //               ISINYA DIISI OTOMATIS: akun seed yang sheckles-nya
      //               paling mepet. Jadi farm ngirim ke yang paling butuh,
      //               tanpa ada yang nyetel manual.
      //   zenxfull -> daftar akun simpanan yang penuh. Ini tetep manual
      //               (ditulis akun simpanan itu sendiri).
      // ============================================================
      if (jalur.startsWith("/basket/")) {
        const basket = jalur.slice("/basket/".length);

        // ---- zenxprio: otomatis dari daftar sheckles mepet ----
        if (basket === "zenxprio" && req.method === "GET") {
          // ambang dari setelan seed (scope 'seed'), sama kayak yang dipakai panel
          let amb = 0, autoOn = true, minMail = 0;
          {
            const c = await db.prepare("SELECT data FROM cfg WHERE scope='seed'").first();
            if (c) { try {
              const d = JSON.parse(c.data) || {};
              amb = Number(d.ambangSheck) || 0;
              // saklar: kalau autoSuplai disetel false, fitur ini mati
              autoOn = (d.autoSuplai !== false);
              // v15-77: batas isi mailbox. Dipakai kalau terimaGift MATI --
              // buahnya numpuk di mailbox, jadi nilai di tas tetep 0 dan
              // patokan nilai gak kepakai. 0 = matiin aturan ini.
              minMail = Number(d.minMail) || 0;
            } catch {} }
          }
          if (!amb || !autoOn) return json({ nm: "", t: skrg });

          // akun SEED yang di bawah ambang, paling sedikit duluan.
          // Cuma yang MASIH LAPOR (<10 menit) -- ngirim ke akun mati itu
          // percuma, barangnya nyangkut di mailbox.
          // v15-76: akun yang barangnya UDAH DATENG dilewatin -- kalau nggak,
          // farm bakal ngirim terus ke akun yang sama sampai buahnya kejual
          // (dan itu bisa lama, karena nunggu pengali nyampe ambang).
          // Patokannya: nilai buah yang nunggu jual >= ambang. Sekali kirim
          // 100 buah nilainya jauh di atas itu, jadi sekali kirim ya cukup.
          const r = await db.prepare(
            `SELECT akun.nama, akun.sheck, akun.tunda FROM akun
               LEFT JOIN tim ON tim.nama = akun.tim
             WHERE akun.sheck < ?1
               AND akun.ts > ?2
               AND COALESCE(akun.tunda,0) < ?1
               AND (?3 = 0 OR COALESCE(akun.mail,0) < ?3)
               AND (UPPER(COALESCE(tim.sc,'')) LIKE '%SEED%'
                    OR (COALESCE(tim.sc,'') = '' AND COALESCE(akun.sc,'') = 'seed'))
             ORDER BY akun.sheck ASC LIMIT 1`
          ).bind(amb, skrg - 600, minMail).first();

          // t = skrg -> selalu segar, jadi star_farm nganggepnya sah
          return json({ nm: r ? r.nama : "", t: skrg,
                        sisa: r ? r.sheck : null, ambang: amb });
        }

        // ---- v15-80: /basket/relay -- jalur RELAY punya star_farm ----
        // Bentuknya beda dari zenxprio, dan star_farm merlakuinnya beda juga:
        //   zenxprio -> { nm, t }        "kirim SEMUA ke sini" (nimpa segalanya)
        //   relay    -> { nm, shk, t }   "akun ini punya shk sheckles"
        //                                farm kirim kalau shk < gfSheckMax,
        //                                kalau nggak -> rute ke simpanan
        //
        // Jalur relay yang lebih pas buat auto-suplai: dia bawa ANGKA, jadi
        // ambang keputusannya ada di sisi farm (gfSheckMax) dan tetep kepakai.
        // zenxprio itu palu godam -- semua buah dialihin, pet & simpanan
        // dilewat. Itu cocok buat "kuras ke sini sekarang", bukan buat
        // pengisian rutin.
        //
        // Catatan: star_farm nganggep basi kalau (skrg - t) > 300.
        if (basket === "relay" && req.method === "GET") {
          let amb = 0, autoOn = true, minMail = 0;
          {
            const c = await db.prepare("SELECT data FROM cfg WHERE scope='seed'").first();
            if (c) { try {
              const d = JSON.parse(c.data) || {};
              amb = Number(d.ambangSheck) || 0;
              autoOn = (d.autoSuplai !== false);
              minMail = Number(d.minMail) || 0;
            } catch {} }
          }
          // gak ada ambang / fitur dimatiin -> laporin saldo BESAR, biar farm
          // nganggep "gak ada yang butuh" dan jalan normal (simpanan/tahan).
          const KOSONG = { nm: "", shk: 999999999999, t: skrg };
          if (!amb || !autoOn) return json(KOSONG);

          const r = await db.prepare(
            `SELECT akun.nama, akun.sheck FROM akun
               LEFT JOIN tim ON tim.nama = akun.tim
             WHERE akun.sheck < ?1
               AND akun.ts > ?2
               AND COALESCE(akun.tunda,0) < ?1
               AND (?3 = 0 OR COALESCE(akun.mail,0) < ?3)
               AND (UPPER(COALESCE(tim.sc,'')) LIKE '%SEED%'
                    OR (COALESCE(tim.sc,'') = '' AND COALESCE(akun.sc,'') = 'seed'))
             ORDER BY akun.sheck ASC LIMIT 1`
          ).bind(amb, skrg - 600, minMail).first();

          if (!r) return json(KOSONG);
          return json({ nm: r.nama, shk: Number(r.sheck) || 0, t: skrg });
        }

        // ---- v15-83: /basket/zenxantrean -- DAFTAR akun yang nunggu suplai ----
        // Bedanya sama /basket/relay: relay balikin SATU akun (yang paling
        // butuh) buat dikirimin sekarang. Ini balikin SELURUH antrean, buat
        // ditampilin di GUI star_farm.
        //
        // Kenapa perlu ditampilin di sisi farm juga: sekarang satu-satunya cara
        // tau sambungannya jalan itu ngeliat panel. Kalau farm nampilin daftar
        // yang SAMA, dua sisi bisa saling dicek -- kalau panel bilang 10 tapi
        // farm bilang 0, sambungannya yang bermasalah, bukan datanya.
        //
        // Jalurnya sengaja ditaruh di bawah /basket/ biar star_farm bisa
        // nurunin alamatnya pakai gsub yang sama kayak relay & zenxprio.
        if (basket === "zenxantrean" && req.method === "GET") {
          let amb = 0, autoOn = true, minMail = 0;
          {
            const c = await db.prepare("SELECT data FROM cfg WHERE scope='seed'").first();
            if (c) { try {
              const d = JSON.parse(c.data) || {};
              amb = Number(d.ambangSheck) || 0;
              autoOn = (d.autoSuplai !== false);
              minMail = Number(d.minMail) || 0;
            } catch {} }
          }
          if (!amb) return json({ aktif: false, sebab: "ambang belum diatur", antre: [] });
          if (!autoOn) return json({ aktif: false, sebab: "auto suplai dimatiin", antre: [] });

          // Aturan sama persis kayak /basket/relay -- SENGAJA disamain, biar
          // yang ditampilin di GUI itu yang beneran bakal dikirimin. Kalau
          // aturannya beda, daftarnya jadi bohong.
          const r = await db.prepare(
            `SELECT akun.nama, akun.sheck, akun.tunda, akun.mail, akun.tim, akun.ts
               FROM akun LEFT JOIN tim ON tim.nama = akun.tim
             WHERE akun.sheck < ?1
               AND akun.ts > ?2
               AND COALESCE(akun.tunda,0) < ?1
               AND (?3 = 0 OR COALESCE(akun.mail,0) < ?3)
               AND (UPPER(COALESCE(tim.sc,'')) LIKE '%SEED%'
                    OR (COALESCE(tim.sc,'') = '' AND COALESCE(akun.sc,'') = 'seed'))
             ORDER BY akun.sheck ASC LIMIT 40`
          ).bind(amb, skrg - 600, minMail).all();

          const antre = (r.results || []).map(x => ({
            nm: x.nama, shk: Number(x.sheck) || 0,
            tunda: Number(x.tunda) || 0, mail: Number(x.mail) || 0,
            tim: x.tim || "", umur: skrg - (Number(x.ts) || 0),
          }));

          // yang "tertunda" ikut dilaporin TERPISAH -- mereka bukan antrean
          // (barangnya udah dateng), tapi berguna buat tau suplai sebelumnya
          // nyampe apa nggak.
          const rt = await db.prepare(
            `SELECT COUNT(*) AS n FROM akun LEFT JOIN tim ON tim.nama = akun.tim
             WHERE akun.sheck < ?1 AND akun.ts > ?2
               AND (COALESCE(akun.tunda,0) >= ?1
                    OR (?3 > 0 AND COALESCE(akun.mail,0) >= ?3))
               AND (UPPER(COALESCE(tim.sc,'')) LIKE '%SEED%'
                    OR (COALESCE(tim.sc,'') = '' AND COALESCE(akun.sc,'') = 'seed'))`
          ).bind(amb, skrg - 600, minMail).first();

          return json({
            aktif: true, ambang: amb, minMail,
            antre, jml: antre.length,
            tertunda: rt ? (Number(rt.n) || 0) : 0,
            t: skrg,
          });
        }

        // ---- basket biasa: simpan/ambil apa adanya (kayak Pantry) ----
        const scope = "basket:" + basket;
        if (req.method === "GET") {
          const c = await db.prepare("SELECT data FROM cfg WHERE scope=?1").bind(scope).first();
          if (!c) return json({});
          try { return json(JSON.parse(c.data) || {}); } catch { return json({}); }
        }
        if (req.method === "POST" || req.method === "PUT") {
          const b = await req.json().catch(() => ({}));
          let isi = b;
          if (req.method === "PUT") {
            // PUT = GABUNG per-kunci (Pantry begitu), bukan timpa
            const c = await db.prepare("SELECT data FROM cfg WHERE scope=?1").bind(scope).first();
            let lama = {};
            if (c) { try { lama = JSON.parse(c.data) || {}; } catch {} }
            isi = { ...lama, ...b };
          }
          await db.prepare(
            `INSERT INTO cfg (scope, ts, data) VALUES (?1, ?2, ?3)
             ON CONFLICT(scope) DO UPDATE SET ts=?2, data=?3`
          ).bind(scope, skrg, JSON.stringify(isi)).run();
          return json(isi);
        }
        return salah("cara gak dikenal buat " + jalur, 405);
      }

      // v8.77: RESET gift buat akun (tombol restart panel). Clear dari giftdone
      // (target balik ke giftPkList) + set giftReset di scope 'seed' (star_seed
      // abaikan riwayat lama -> gift fresh). Body: {akun}.
      if (jalur === "/gift-reset" && req.method === "POST") {
        const b = await req.json().catch(() => ({}));
        const akun = teks(b.akun);
        if (!akun) return salah("akun kosong");
        const pk = akun.toLowerCase();
        // 1. hapus dari giftdone
        try {
          const cg = await db.prepare("SELECT data FROM cfg WHERE scope='giftdone'").first();
          let done = {};
          if (cg) { try { done = JSON.parse(cg.data) || {}; } catch {} }
          delete done[pk];
          await db.prepare(
            `INSERT INTO cfg (scope, ts, data) VALUES ('giftdone', ?1, ?2)
             ON CONFLICT(scope) DO UPDATE SET ts=?1, data=?2`
          ).bind(skrg, JSON.stringify(done)).run();
        } catch (e) {}
        // 2. set giftReset di scope 'seed' (gabung ke config seed global)
        try {
          const cs = await db.prepare("SELECT data FROM cfg WHERE scope='seed'").first();
          let sd = {};
          if (cs) { try { sd = JSON.parse(cs.data) || {}; } catch {} }
          sd.giftReset = sd.giftReset || {};
          sd.giftReset[pk] = skrg;
          await db.prepare(
            `INSERT INTO cfg (scope, ts, data) VALUES ('seed', ?1, ?2)
             ON CONFLICT(scope) DO UPDATE SET ts=?1, data=?2`
          ).bind(skrg, JSON.stringify(sd)).run();
        } catch (e) {}
        return json({ ok: true, akun });
      }

      return salah("jalur gak dikenal: " + jalur, 404);
    } catch (e) {
      return salah("server: " + e.message, 500);
    }
  },
};
