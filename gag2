-- ============================================================
-- AUTO BUY PET (standalone test) — GUI minimalis. buat eksperimen.
-- self-contained, GAK butuh ZenxFarm. kalau udah bener, logikanya dimasukin ke sc utama.
-- mekanik: tame pet liar (WildPet_<uuid>) lewat Pets.WildPetTame:Fire(petPart).
-- ============================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ---- networking (sama kayak ZenxFarm: SharedModules.Networking) ----
local NET = nil
pcall(function()
    local sm = RS:FindFirstChild("SharedModules")
    local net = sm and sm:FindFirstChild("Networking")
    if net then local ok, m = pcall(require, net); if ok then NET = m end end
end)
local function pkt(grp, name)
    if not NET then return nil end
    local g = NET[grp]
    return g and g[name] or nil
end

-- ---- state ----
local running = false
local doTeleport = false
local boughtPet = {}   -- uuid -> true (anti dobel)
local gen = 0

-- ---- cari pet liar ----
local function getWildPets()
    local out = {}
    local wpr = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("WildPetRef")
    if wpr then
        for _, o in ipairs(wpr:GetChildren()) do
            if o:IsA("BasePart") and o.Name:sub(1,8) == "WildPet_" then out[#out+1] = o end
        end
    end
    -- fallback: scan workspace kalau path utama kosong (jaga2 kalau game pindah lokasi)
    if #out == 0 then
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and o.Name:sub(1,8) == "WildPet_" then out[#out+1] = o end
        end
    end
    return out
end

-- log ring buffer
local logLines = {}
local function pushLog(s)
    logLines[#logLines+1] = os.date("%H:%M:%S").."  "..s
    while #logLines > 12 do table.remove(logLines, 1) end
end

-- ---- aksi beli sekali ----
local function buyOnce(setStatus)
    local p = pkt("Pets", "WildPetTame")
    if not p or not p.Fire then setStatus("remote WildPetTame GAK ketemu", true); return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local pets = getWildPets()
    local bought = 0
    for _, o in ipairs(pets) do
        local uuid = o.Name:sub(9)
        if not boughtPet[uuid] then
            local petName = o:GetAttribute("PetName") or "?"
            local rarity  = o:GetAttribute("Rarity") or "?"
            if doTeleport and hrp then
                pcall(function() hrp.CFrame = o.CFrame + Vector3.new(0,3,0) end)
                task.wait(0.15)
            end
            pcall(function() p:Fire(o) end)
            boughtPet[uuid] = true
            bought = bought + 1
            pushLog("beli: "..petName.." ["..rarity.."]")
            task.wait(0.2)
        end
    end
    -- bersihin uuid yg udah ilang
    if bought == 0 then
        local present = {}
        for _, o in ipairs(pets) do present[o.Name:sub(9)] = true end
        for uuid in pairs(boughtPet) do if not present[uuid] then boughtPet[uuid] = nil end end
    end
    setStatus(#pets.." pet liar | "..bought.." dibeli barusan", false)
end

