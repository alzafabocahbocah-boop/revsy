    local knob = mk("Frame", { Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 3, 0.5, -10),
        BackgroundColor3 = C.textDim, BorderSizePixel = 0, Parent = sw })
    corner(knob, 10)
    local function apply()
        if state[key] then
            sw.BackgroundColor3 = C.green; knob.BackgroundColor3 = Color3.new(1,1,1)
            knob.Position = UDim2.new(1, -23, 0.5, -10); swStroke.Color = C.green
        else
            sw.BackgroundColor3 = C.input; knob.BackgroundColor3 = C.textDim
            knob.Position = UDim2.new(0, 3, 0.5, -10); swStroke.Color = C.border
        end
    end
    sw.MouseButton1Click:Connect(function()
        state[key] = not state[key]; saveState(); apply()
        print("[ZenxFarm] "..(extraLabel or key).." -> "..(state[key] and "ON" or "OFF"))
    end)
    apply()
    return apply
end

