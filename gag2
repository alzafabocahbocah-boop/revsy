    local sent = 0
    -- v14.1: kalau ada buah SATUAN dipilih, kirim PERSIS yg itu (by Id). abaikan jenis+filter.
    local useIds = next(state.dgiftFruitIds) ~= nil
    for _, holder in ipairs({ player.Character, player:FindFirstChildOfClass("Backpack") }) do
