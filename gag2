local function mkFarmCard(order, title, desc)
    local card = mk("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.card,
        BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = order, Parent = farmList })
    corner(card, 8)
    local cardStroke = stroke(card, C.border, 1)  -- v7.2: garis kartu dipertegas
    local hd = mk("TextButton", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, Parent = card })
    local nameL = lbl(hd, title, 14, C.text, Enum.TextXAlignment.Left)
    nameL.Position = UDim2.new(0, 14, 0, 9); nameL.Size = UDim2.new(1, -50, 0, 18)
    local descL = lbl(hd, desc, 11, C.textMute, Enum.TextXAlignment.Left)
    descL.Position = UDim2.new(0, 14, 0, 30); descL.Size = UDim2.new(1, -50, 0, 14)
    local arrow = lbl(hd, "▾", 14, C.textDim, Enum.TextXAlignment.Center)
    arrow.Position = UDim2.new(1, -32, 0, 19); arrow.Size = UDim2.new(0, 20, 0, 18)
    local body = mk("Frame", { Size = UDim2.new(1, -20, 0, 120), Position = UDim2.new(0, 10, 0, 60),
        BackgroundTransparency = 1, Visible = false, Parent = card })
    local expanded = false
    local bodyH = 120
    local function setBodyH(h) bodyH = h end
    hd.MouseButton1Click:Connect(function()
        expanded = not expanded
        body.Visible = expanded
        arrow.Text = expanded and "▴" or "▾"
        arrow.TextColor3 = expanded and C.text or C.textDim
        -- v7.2: pas dibuka, kartu jadi sedikit lebih terang + garis dipertegas
        card.BackgroundColor3 = expanded and C.cardSel or C.card
        cardStroke.Color = expanded and C.borderBright or C.border
        card.Size = UDim2.new(1, 0, 0, expanded and (bodyH + 64) or 56)
    end)
    return card, body, setBodyH
end

