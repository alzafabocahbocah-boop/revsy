-- ===== AUTO STEAL: curi buah garden orang lain =====
-- Steal.BeginSteal:Fire(ownerUserId, plantUUID, fruitUUID) lalu CompleteSteal:Fire()
-- garden orang: Workspace.Gardens.Plot*.Plants.<ownerId>_<plantUUID>.Fruits.<...>_<fruitUUID>
-- ownerId != userId kita = punya orang.
local MY_UID = player.UserId
function Farm.stealOnce()
    local bg = pkt("Steal", "BeginSteal")
    local cp = pkt("Steal", "CompleteSteal")
    if not bg or not bg.Fire or not cp or not cp.Fire then return end
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local stolen = 0
    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                if stolen >= 15 then break end
                -- ambil ownerId dari nama plant "<ownerId>_<plantUUID>"
                local ownerId = tonumber(plant.Name:match("^(%d+)_"))
                local plantId = plant:GetAttribute("PlantId")
                -- cuma garden ORANG (ownerId != kita)
                if ownerId and ownerId ~= MY_UID and plantId then
                    local fruits = plant:FindFirstChild("Fruits")
                    if fruits then
                        for _, fruit in ipairs(fruits:GetChildren()) do
                            local fruitUUID = fruit:GetAttribute("FruitId") or fruit.Name:match("_([%x%-]+)$")
                            if fruitUUID and #tostring(fruitUUID) >= 30 then
                                -- teleport ke buah (proximity steal) — opsional
                                if state.stealTeleport and hrp then
                                    local fp = fruit:IsA("BasePart") and fruit
                                        or (fruit:IsA("Model") and (fruit.PrimaryPart or fruit:FindFirstChildWhichIsA("BasePart")))
                                    if fp then pcall(function() hrp.CFrame = fp.CFrame + Vector3.new(0,3,0) end); task.wait(0.1) end
                                end
                                pcall(function() bg:Fire(ownerId, tostring(plantId), tostring(fruitUUID)) end)
                                task.wait()
                                pcall(function() cp:Fire() end)
                                stolen = stolen + 1
                                task.wait(0.15)
                            end
                        end
                    end
                end
            end
        end
    end
    if stolen > 0 then print("[ZenxFarm] steal: "..stolen.." buah") end
end

function Farm.giftOnce()
    local target = state.giftTarget
    if not target or target == "" then return end
    local sb = pkt("Mailbox", "SendBatch")
    if not sb or not sb.Fire then print("[ZenxFarm] SendBatch gak ada"); return end
    local plr = Players.LocalPlayer
    local bp = plr and plr:FindFirstChildOfClass("Backpack")
    if not bp then return end

    -- resolve userId penerima (cache)
    if not Farm._giftId or Farm._giftIdName ~= target then
        Farm._giftId = resolveTargetId(target)
        Farm._giftIdName = target
        if not Farm._giftId then print("[ZenxFarm] gift: user '"..target.."' gak ketemu"); return end
        print("[ZenxFarm] gift target: "..target.." (id "..tostring(Farm._giftId)..")")
    end
    local uid = Farm._giftId
    if not uid then return end

    -- kumpulin item dari backpack sesuai pilihan
    local items = {}
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and #items < 8 then  -- batch max 8 biar aman
            local seedName = t:GetAttribute("SeedTool")
            local petJenis = t:GetAttribute("Pet")
            local petId    = t:GetAttribute("PetId")
            if seedName and state.giftSeeds[seedName] then
                local cnt = t:GetAttribute("Count") or 1
                if cnt > 0 then
                    items[#items+1] = {ItemKey = seedName, Count = cnt, Category = "Seeds"}
                end
            elseif petId and petJenis then
                -- pakai nama Tool (mis "Big Owl"/"Owl") biar varian besar kebedain
                if state.giftPets[t.Name] then
                    items[#items+1] = {ItemKey = tostring(petId), Count = 1, Category = "Pets"}
                end
            end
        end
    end
    if #items == 0 then return end  -- gak ada item -> loop "berhenti" sendiri
    pcall(function() sb:Fire(uid, items, "") end)
    print("[ZenxFarm] gift terkirim ke "..target..": "..#items.." item")
end
