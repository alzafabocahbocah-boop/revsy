-- v4.5: SKIP "Press any key to play" — jalan di BACKGROUND, gak blokir UI.
task.spawn(function()
    local UISx = game:GetService("UserInputService")
    -- fake InputObject lengkap (biar diterima kayak input asli)
    local function fakeInput(itype, kc)
        return setmetatable({
            UserInputType = itype or Enum.UserInputType.MouseButton1,
            KeyCode = kc or Enum.KeyCode.Unknown,
            Position = Vector3.new(), Delta = Vector3.new(),
            UserInputState = Enum.UserInputState.Begin,
        }, { __index = function(_, k)
            if k == "IsModifierKeyDown" then return function() return false end end
            return nil
        end })
    end
    -- "masuk" dideteksi dari karakter udah bisa main: Humanoid Running + WalkSpeed>0
    local function reallyIn()
        local c = player.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not (hum and hrp) then return false end
        local moving = hum:GetState() == Enum.HumanoidStateType.Running
                    or hum:GetState() == Enum.HumanoidStateType.RunningNoPhysics
        local cam = workspace.CurrentCamera
        local camOk = cam and cam.CameraType == Enum.CameraType.Custom
        return (hum.WalkSpeed > 0) and (not hrp.Anchored) and (moving or camOk)
    end
    -- v4.7: VirtualInputManager — kirim input HARDWARE asli (lewat pipeline Roblox).
    -- ini yg paling ampuh: game "ngerasa" kita pencet keyboard/mouse beneran,
    -- persis kayak pencet manual. firesignal sering gak nembus -> VIM nembus.
    local VIM = nil
    pcall(function() VIM = game:GetService("VirtualInputManager") end)
    local cam = workspace.CurrentCamera
    -- v4.9: klik skip di POJOK KIRI BAWAH (bukan tengah) — biar gak keklik tombol/objek
    -- yg ada di tengah layar. loading screen nerima klik di mana aja, jadi pojok aman.
    local function clickPos()
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        return 40, vp.Y - 60   -- 40px dari kiri, 60px dari bawah
    end
    local function vimKey(kc)
        if not VIM then return end
        pcall(function() VIM:SendKeyEvent(true,  kc, false, game) end)
        task.wait(0.03)
        pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
    end
    local function vimClick()
        if not VIM then return end
        local x, y = clickPos()
        pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0) end)
        task.wait(0.03)
        pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
    end

    -- v5.0: cek apakah masih "Loading player data..." — kalau iya, JANGAN nembak input
    -- dulu (cegah anti-cheat ketrigger -> kick 267). nembak cuma pas udah "Press any key".
    local function dataStillLoading()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if not pg then return false end
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") then
                local t = tostring(d.Text):lower()
                if t:find("loading player data") or t:find("loading data") then
                    -- masih loading kalau belum 100%
                    if not t:find("100") then return true end
                end
            end
        end
        return false
    end

    task.wait(1)  -- jeda awal kecil: kasih game waktu mulai load (jangan nembak dari frame 0)
    for _ = 1, 200 do  -- max ~60 detik (spam tiap 0.3s)
        if reallyIn() then
            print("[ZenxFarm] auto-skip: berhasil masuk!")
            break
        end
        -- tahan input selama data masih loading (anti kick 267)
        if dataStillLoading() then
            task.wait(0.3)
        else
        -- 1) VIM: input hardware asli (PRIORITAS — paling ampuh)
        if VIM then
            vimKey(Enum.KeyCode.Space)
            vimKey(Enum.KeyCode.Return)
            vimKey(Enum.KeyCode.E)
            vimClick()  -- klik pojok kiri bawah (mouse / touch di mobile/cloud)
        end
        -- 2) firesignal: fallback kalau VIM gak ada
        if firesignal then
            pcall(function() firesignal(UISx.InputBegan, fakeInput(Enum.UserInputType.Keyboard, Enum.KeyCode.Space), false) end)
            pcall(function() firesignal(UISx.InputBegan, fakeInput(Enum.UserInputType.Keyboard, Enum.KeyCode.E), false) end)
            pcall(function() firesignal(UISx.InputBegan, fakeInput(Enum.UserInputType.Keyboard, Enum.KeyCode.Return), false) end)
            pcall(function() firesignal(UISx.InputBegan, fakeInput(Enum.UserInputType.MouseButton1), false) end)
            pcall(function() firesignal(UISx.InputBegan, fakeInput(Enum.UserInputType.Touch), false) end)
        end
        -- 3) panggil langsung connection InputBegan (fallback terakhir)
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(UISx.InputBegan)) do
                    pcall(function() if c.Function then c.Function(fakeInput(Enum.UserInputType.Keyboard, Enum.KeyCode.Space), false) end end)
                end
            end
        end)
        task.wait(0.3)
        end  -- tutup: else (dataStillLoading)
    end
end)

