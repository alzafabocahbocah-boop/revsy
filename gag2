        -- v12.5: utamain file per-user; kalau belum ada, migrasi dari file lama sekali.
        local useFile = SAVE_FILE
        if isfile and not isfile(SAVE_FILE) and SAVE_FILE_OLD and isfile(SAVE_FILE_OLD) then
            useFile = SAVE_FILE_OLD
        end
        if isfile and readfile and isfile(useFile) then
            local d = HS:JSONDecode(readfile(useFile))
            if type(d) == "table" then
                for _, k in ipairs(SETBOOL) do if d[k] ~= nil then state[k] = d[k] and true or false end end
                if type(d.plantLocation) == "string" then state.plantLocation = d.plantLocation end
                if type(d.plantSpread) == "number" then state.plantSpread = d.plantSpread end
                -- v13.0: giftTarget gak di-load (selalu kosong tiap masuk)
