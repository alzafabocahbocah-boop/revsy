-- ===== COLLECT: Garden.CollectFruit:Fire(PlantId, FruitUUID) =====
-- struktur: Workspace.Gardens.PlotN.Plants.<pid>_<PlantUUID>
--             .Fruits.<pid>_<PlantUUID>_<FruitUUID>
-- arg1 = PlantId (attr .PlantId di plant), arg2 = FruitUUID (UUID terakhir di nama fruit)
function Farm.collectOnce()
    local p = pkt("Garden", "CollectFruit")
    if not p or not p.Fire then print("[ZenxFarm] CollectFruit packet gak ada"); return end
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then print("[ZenxFarm] Gardens gak ada"); return end

    local fired, skipped = 0, 0
    local typesFired = {}
    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                local plantId = plant:GetAttribute("PlantId")
                -- filter jenis buah (SeedName). collectAll=true -> collect semua.
                local seedName = plant:GetAttribute("SeedName")
                local okType
                if state.collectAll then okType = true
                else okType = (seedName ~= nil and state.selectedCollect[seedName] == true) end
                if plantId and not okType then skipped = skipped + 1 end
                if plantId and okType then
                    typesFired[seedName or "?"] = (typesFired[seedName or "?"] or 0) + 1
                    local fruits = plant:FindFirstChild("Fruits")
                    local fruitCount = 0
                    if fruits then
                        for _, fruit in ipairs(fruits:GetChildren()) do
                            -- nama fruit: <pid>_<PlantUUID>_<FruitUUID> -> ambil UUID terakhir
                            local fruitUUID = fruit:GetAttribute("FruitId") or fruit.Name:match("_([%x%-]+)$")
                            if fruitUUID and #tostring(fruitUUID) >= 30 then
                                pcall(function() p:Fire(tostring(plantId), tostring(fruitUUID)) end)
                                fired = fired + 1; fruitCount = fruitCount + 1
                                if fired % 5 == 0 then task.wait() end
                            end
                        end
                    end
                    -- v4.4: single-harvest (Bamboo/Mushroom/GreenBean) — game fire 2x:
                    -- (plantId, plantId) LALU (plantId, "") dgn jeda. tiru persis.
                    if fruitCount == 0 then
                        local ready = plant:GetAttribute("PlantGrowthReady") == true
                        if ready then
                            local pid = tostring(plantId)
                            pcall(function() p:Fire(pid, pid) end)
                            task.wait()  -- jeda 1 frame (tiru 2 event terpisah)
                            pcall(function() p:Fire(pid, "") end)
                            fired = fired + 1
                            task.wait()
                        end
                    end
                end
            end
        end
    end
    if fired > 0 then
        local tlist = {}
        for nm, c in pairs(typesFired) do tlist[#tlist+1] = nm.."("..c..")" end
        print("[ZenxFarm] collect fired="..fired.." skipped="..skipped.." | jenis: "..(#tlist>0 and table.concat(tlist,", ") or "-"))
    end
end

-- ===== SELL: SellAll (semua) / SellFruit per-jenis =====
-- buah inventory = objek di Workspace.<karakter> / Backpack, nama "Jenis [0.71kg]", attr .Id = UUID.
-- sell per-jenis: scan objek, fire SellFruit(.Id) utk jenis yg dipilih.
local function fruitObjType(name)
    -- nama "Green Bean [0.71kg]" -> "Green Bean"
    return (name:gsub("%s*%[.-%]%s*$", ""))
end
local function getFruitHolders()
    local holders = {}
    local plr = Players.LocalPlayer
    if plr then
        local char = plr.Character
        if char then holders[#holders+1] = char end
        local bp = plr:FindFirstChildOfClass("Backpack")
        if bp then holders[#holders+1] = bp end
    end
    return holders
end

-- v5.7: deteksi isi & kapasitas inventory (buat mode "sell pas penuh").
-- "isi" = jumlah item (buah/tool) di Character+Backpack.
local function getInvCount()
    local n = 0
    for _, holder in ipairs(getFruitHolders()) do
        for _, o in ipairs(holder:GetChildren()) do
            -- item inventory = Tool, atau objek buah (punya attr .Id)
            if o:IsA("Tool") or o:GetAttribute("Id") ~= nil then
                n = n + 1
            end
        end
    end
    return n
end
-- "kapasitas max" — coba beberapa sumber dari data game. kalau gagal -> fallback.
Farm._invMaxCache = nil
local function getInvMax()
    local plr = Players.LocalPlayer
    if not plr then return state.sellMaxFallback end
    -- 1) attribute di player (nama-nama umum)
    for _, key in ipairs({"MaxInventory","InventoryLimit","BackpackLimit","MaxBackpack",
                          "InventorySize","MaxItems","ItemLimit","MaxSlots"}) do
        local v = plr:GetAttribute(key)
        if type(v) == "number" and v > 0 then return v end
    end
    -- 2) leaderstats / folder nilai (mis "Inventory" = "45/200")
    -- 3) scan PlayerGui cari teks pola "X/Y" yg Y-nya kelihatan kayak kapasitas
    local pg = plr:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") then
                local _, mx = tostring(d.Text):match("(%d+)%s*/%s*(%d+)")
                if mx then
                    local m = tonumber(mx)
                    -- kapasitas masuk akal: 10..5000 (buang angka acak kecil/besar)
                    if m and m >= 10 and m <= 5000 then return m end
                end
            end
        end
    end
    -- 4) fallback manual
    return state.sellMaxFallback
end
function Farm.sellOnce()
    if state.sellAll then
        local p = pkt("NPCS", "SellAll")
        if not p or not p.Fire then print("[ZenxFarm] SellAll packet gak ada"); return end
        pcall(function() p:Fire() end)
        print("[ZenxFarm] SellAll fired")
        return
    end
    -- per-jenis
    local p = pkt("NPCS", "SellFruit")
    if not p or not p.Fire then print("[ZenxFarm] SellFruit packet gak ada"); return end
    local sold, types = 0, {}
    for _, holder in ipairs(getFruitHolders()) do
        for _, o in ipairs(holder:GetChildren()) do
            local id = o:GetAttribute("Id")
            if id then
                local jenis = fruitObjType(o.Name)
                if state.selectedSell[jenis] then
                    pcall(function() p:Fire(tostring(id)) end)
                    sold = sold + 1
                    types[jenis] = (types[jenis] or 0) + 1
                    if sold % 5 == 0 then task.wait() end
                end
            end
        end
    end
    if sold > 0 then
        local tl = {}; for n, c in pairs(types) do tl[#tl+1] = n.."("..c..")" end
        print("[ZenxFarm] sell per-jenis: "..table.concat(tl, ", "))
    end
end

-- ===== BUY SEED: borong SEMUA seed (SeedData) — server auto-tolak yg habis =====
-- gak perlu baca stock / buka SeedShop. fire tiap nama seed; yg ada stock kebeli,
-- yg habis ditolak server. seed baru pas restock otomatis kebeli.
Farm.seedList = nil
local function loadSeedList()
    local list = {}
    pcall(function()
        local sm = RS:FindFirstChild("SharedModules")
        local sd = sm and sm:FindFirstChild("SeedData")
        if sd then
            local ok, mod = pcall(require, sd)
            if ok and type(mod) == "table" then
                local src = mod
                if type(mod.Seeds) == "table" then src = mod.Seeds end
                local seen = {}
                for k, v in pairs(src) do
                    local nm
                    if type(k) == "string" then nm = k
                    elseif type(v) == "table" then nm = v.SeedName or v.Name end
