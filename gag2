        local out = { plantLocation = state.plantLocation, giftTarget = state.giftTarget }
        out.giftSeedQty = state.giftSeedQty or 0  -- v8.7
        out.sprCoords = state.sprCoords or {}  -- v8.2: list koordinat sprinkler {x,y,z,name}
