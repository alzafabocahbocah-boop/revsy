local function loadState()
    pcall(function()
        if isfile and readfile and isfile(SAVE_FILE) then
            local d = HS:JSONDecode(readfile(SAVE_FILE))
            if type(d) == "table" then
                for _, k in ipairs(SETBOOL) do if d[k] ~= nil then state[k] = d[k] and true or false end end
                if type(d.plantLocation) == "string" then state.plantLocation = d.plantLocation end
                if type(d.giftTarget) == "string" then state.giftTarget = d.giftTarget end
                if type(d.giftSeedQty) == "number" then state.giftSeedQty = d.giftSeedQty end
                -- v8.2: koordinat sprinkler
                if type(d.sprCoords) == "table" then
                    state.sprCoords = {}
                    for _, c in ipairs(d.sprCoords) do
                        if type(c) == "table" and type(c.x) == "number" then
                            state.sprCoords[#state.sprCoords+1] = { x = c.x, y = c.y, z = c.z, name = tostring(c.name or "Sprinkler") }
                        end
                    end
                end
                for k in pairs(SETMAP) do
                    -- v4.4: clear isi table yg SAMA (bukan bikin table baru) — kalau
                    -- re-assign, referensi yg udah dipegang picker/loop jadi basi -> filter gak jalan.
