-- kg buah = attribute Weight (kalau ada) / SizeMulti (fallback), dibulatkan.
-- dari kalibrasi: Weight ≈ kg yg ditampilin game.
do
    local statsPanel = mk("Frame", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Visible = false, Parent = content })
    panels.stats = statsPanel
    local statsList = mk("ScrollingFrame", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
        ScrollBarThickness = 3, BorderSizePixel = 0, CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = statsPanel })
    mk("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = statsList })

    -- kartu ringkasan
    local sumCard = mk("Frame", { Size = UDim2.new(1, 0, 0, 96), BackgroundColor3 = C.card,
        BorderSizePixel = 0, LayoutOrder = 0, Parent = statsList })
    corner(sumCard, 8); stroke(sumCard, C.border, 1)
    local sumL = lbl(sumCard, "", 13, C.text, Enum.TextXAlignment.Left)
    sumL.Position = UDim2.new(0, 14, 0, 10); sumL.Size = UDim2.new(1, -28, 1, -20)
    sumL.TextYAlignment = Enum.TextYAlignment.Top; sumL.TextWrapped = true

    -- tombol refresh
    local refBtn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = C.input,
        Text = "🔄 Hitung Ulang", TextColor3 = C.text, Font = FONT_B, TextSize = 13,
        AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = 1, Parent = statsList })
    corner(refBtn, 6); stroke(refBtn, C.border, 1)

    -- container per jenis (diisi pas refresh)
    local perCard = mk("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.card,
        BorderSizePixel = 0, LayoutOrder = 2, AutomaticSize = Enum.AutomaticSize.Y, Parent = statsList })
    corner(perCard, 8); stroke(perCard, C.border, 1)
    local perLayout = mk("UIListLayout", { Padding = UDim.new(0,2), Parent = perCard })
    mk("UIPadding", { PaddingTop = UDim.new(0,10), PaddingBottom = UDim.new(0,10),
        PaddingLeft = UDim.new(0,14), PaddingRight = UDim.new(0,14), Parent = perCard })

    local function fruitKg(fruit)
        local w = fruit:GetAttribute("Weight")
        if type(w) == "number" then return w end
        local sm = fruit:GetAttribute("SizeMulti") or fruit:GetAttribute("SizeMultiplier")
        if type(sm) == "number" then return sm end
        return 0
    end

    local function computeStats()
        Farm.updateBaseW()  -- v10.8: kalibrasi dulu biar kg akurat
        -- bersihin baris lama
        for _, c in ipairs(perCard:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() end
        end
        local gardens = workspace:FindFirstChild("Gardens")
        if not gardens then sumL.Text = "Gardens gak ketemu"; return end
        local MY = player.UserId
        local byType = {}  -- jenis -> {n=buah, kg=total, plants=, ready=, mut={}}
        local totalFruit, totalKg, totalPlant, readyPlant = 0, 0, 0, 0
        local mutCount = {}
        for _, plot in ipairs(gardens:GetChildren()) do
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, pl in ipairs(plants:GetChildren()) do
                    local owner = tonumber(pl.Name:match("^(%d+)_"))
                    if (not owner or owner == MY) then
                        totalPlant = totalPlant + 1
                        local jenis = pl:GetAttribute("SeedName") or "?"
                        local e = byType[jenis]
                        if not e then e = { n=0, kg=0, plants=0, ready=0 }; byType[jenis] = e end
                        e.plants = e.plants + 1
                        if pl:GetAttribute("PlantGrowthReady") == true then e.ready = e.ready + 1; readyPlant = readyPlant + 1 end
                        local fr = pl:FindFirstChild("Fruits")
                        if fr then
                            for _, fruit in ipairs(fr:GetChildren()) do
                                local kg = Farm.gardenKg(fruit, jenis)
                                e.n = e.n + 1; e.kg = e.kg + kg
                                totalFruit = totalFruit + 1; totalKg = totalKg + kg
                                local mut = fruit:GetAttribute("Mutation")
                                if mut and mut ~= "" and mut ~= "None" then mutCount[mut] = (mutCount[mut] or 0) + 1 end
                            end
                        end
                    end
                end
            end
        end
        -- ringkasan
        local mutStr = {}
        for m, c in pairs(mutCount) do mutStr[#mutStr+1] = m.." x"..c end
        sumL.Text = string.format(
            "TOTAL DI KEBUN\nBuah: %d   |   Berat: %.2f kg\nTanaman: %d (ready: %d)\nMutasi: %s",
            totalFruit, totalKg, totalPlant, readyPlant,
            (#mutStr > 0 and table.concat(mutStr, ", ") or "-"))
        -- urutkan jenis dari kg terbanyak
        local order = {}
        for j, e in pairs(byType) do order[#order+1] = {j, e} end
        table.sort(order, function(a,b) return a[2].kg > b[2].kg end)
        for i, o in ipairs(order) do
            local j, e = o[1], o[2]
            local row = lbl(perCard, string.format("%s — %d buah, %.2f kg  (%d tanaman)", j, e.n, e.kg, e.plants),
                12, C.text, Enum.TextXAlignment.Left)
            row.Size = UDim2.new(1, 0, 0, 18); row.LayoutOrder = i
        end
        if #order == 0 then
            local row = lbl(perCard, "(belum ada buah di kebun)", 12, C.textDim, Enum.TextXAlignment.Left)
            row.Size = UDim2.new(1, 0, 0, 18)
        end
    end
    refBtn.MouseButton1Click:Connect(computeStats)
    -- auto-hitung pas tab dibuka pertama kali
    statsBtn.MouseButton1Click:Connect(function() task.wait(0.05); computeStats() end)
    computeStats()
end

