-- ===== DENYUT + EGG COUNT — worker tau client hidup + jumlah egg =====
-- format denyut: "ts;<egg>;egg" (worker baca sheck=egg, sheckW=egg -> panel)
_G.ZenxPanenEgg = _G.ZenxPanenEgg or 0
do
    if not _G.__ZenxDenyutJalan then
        _G.__ZenxDenyutJalan = true
        -- penghitung egg: scan backpack + character buat item nama "egg"
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    local n = 0
                    local function cek(cont)
                        if not cont then return end
                        for _, it in ipairs(cont:GetChildren()) do
                            if tostring(it.Name):lower():find("egg") then n = n + 1 end
                        end
                    end
                    cek(plr and plr:FindFirstChild("Backpack"))
                    cek(plr and plr.Character)
                    _G.ZenxPanenEgg = n
                end)
                task.wait(10)
            end
        end)
        -- denyut tiap 20s (bawa egg count)
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if plr and plr.Name and writefile then
                        local egg = tonumber(_G.ZenxPanenEgg) or 0
                        writefile("zenx_denyut_" .. plr.Name .. ".txt",
                            os.time() .. ";" .. egg .. ";egg")
                    end
                end)
                task.wait(20)
            end
        end)
    end
end

