-- ===== DENYUT + EGG COUNT — worker tau client hidup + jumlah egg =====
-- format denyut: "ts;<egg>;egg" (worker baca sheck=egg, sheckW=egg -> panel)
_G.ZenxPanenEgg = _G.ZenxPanenEgg or 0
do
    if not _G.__ZenxDenyutJalan then
        _G.__ZenxDenyutJalan = true
        -- DETEKSI DISCONNECT (port star_seed) — denyut BERHENTI + file DIHAPUS pas putus
        local function zenxCekDisconnect()
            local dc = false
            pcall(function()
                local GuiService = game:GetService("GuiService")
                local ec = GuiService:GetErrorCode()
                if ec and ec ~= Enum.ConnectionError.OK and ec ~= Enum.ConnectionError.None then dc = true end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                local pg = CoreGui:FindFirstChild("RobloxPromptGui")
                local overlay = pg and pg:FindFirstChild("promptOverlay")
                if overlay then
                    for _, child in ipairs(overlay:GetChildren()) do
                        if child:IsA("GuiObject") and child.Visible
                            and (child.Name:find("Error") or child.Name:find("Prompt")) then
                            for _, d in ipairs(child:GetDescendants()) do
                                if d:IsA("TextButton") or d:IsA("TextLabel") then
                                    local t = tostring(d.Text or ""):lower()
                                    if t:find("reconnect") or t:find("leave") or t:find("disconnect")
                                        or t:find("shut") or t:find("keluar") or t:find("sambung")
                                        or t:find("terputus") or t:find("dimatikan") or t:find("hubungkan") then
                                        dc = true; return
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                for _, d in ipairs(CoreGui:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local vis = false
                        pcall(function() vis = d.Visible end)
                        if vis then
                            local t = tostring(d.Text or ""):lower()
                            if t:find("reconnect") or t:find("sambung ulang")
                                or t:find("terputus") or t:find("disconnected")
                                or t:find("dimatikan") or t:find("was shut down")
                                or t:find("lost connection") or t:find("kehilangan koneksi")
                                or t:find("error code") or t:find("kode error") or t:find("kode eror")
                                or t:find("id error") or t:find("(error)") then
                                dc = true; return
                            end
                        end
                    end
                end
            end)
            return dc
        end
        local function zenxDcStrict()
            local dc = false
            -- [1] GuiService error code -- disconnect/kick bikin error code != OK.
            -- Sinyal PALING reliable + murah. Deteksi lama (scan prompt) suka meleset
            -- -> client disconnect tapi denyut tetep ketulis -> worker anggap hidup.
            pcall(function()
                local ec = game:GetService("GuiService"):GetErrorCode()
                if ec ~= nil and ec ~= Enum.ConnectionError.OK then dc = true end
            end)
            if dc then return true end
            -- [2] backup: scan RobloxPromptGui -- TextButton/TextLabel keyword disconnect
            -- (pakai find, bukan == exact).
            pcall(function()
                -- v-dc5: prompt "Koneksi terputus" muncul di GUI ATAS (indikator/notif), BUKAN cuma
                -- RobloxPromptGui. Jadi scan CoreGui -- TAPI biar gak false-positive kayak dulu:
                --   TOMBOL  -> match kata reconnect/leave/keluar/sambung (tombol prompt disconnect).
                --   LABEL   -> match FRASA LENGKAP pesan disconnect (koneksi terputus / connection
                --              lost / reconnecting / dll) -- spesifik, gak nyangkut kata tunggal.
                local cg = game:GetService("CoreGui")
                for _, d in ipairs(cg:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
                        local t = tostring(d.Text or ""):lower()
                        -- FRASA disconnect (spesifik) -- cek di LABEL & TOMBOL. Teks persis yg
                        -- muncul: "Koneksi terputus" (ID) / "Disconnected" (EN) di GUI atas.
                        if t:find("koneksi terputus") or t:find("disconnected")
                           or t:find("connection lost") or t:find("lost connection")
                           or t:find("reconnecting") or t:find("menyambungkan")
                           or t:find("you were disconnected") or t:find("you have been kicked")
                           or t:find("same account launched") or t:find("error code: 276")
                           or t:find("different device") or t:find("perangkat lain")
                           or t:find("akun yang sama") or t:find("akun sama") then
                            dc = true; return
                        end
                        -- TOMBOL prompt disconnect: reconnect/leave/keluar/sambungkan
                        if d:IsA("TextButton") and (t == "reconnect" or t == "leave" or t == "keluar"
                           or t:find("reconnect") or t:find("sambungkan") or t:find("sambung ulang")) then
                            dc = true; return
                        end
                    end
                end
            end)
            return dc
        end
        _G.ZenxCekDisconnect = zenxCekDisconnect
        -- SELF-REJOIN: error kedeteksi tapi VM masih hidup -> rejoin SENDIRI (gak nunggu worker)
        _G.ZenxSelfRejoin = function(reason)
            if _G.ZenxRejoining then return end
            _G.ZenxRejoining = true
            _G.ZenxRejoinSisa = 0
            print("[SelfRejoin] " .. tostring(reason) .. " -> rejoin sendiri (VM masih hidup)")
            local TS = game:GetService("TeleportService")
            local plr = game:GetService("Players").LocalPlayer
            task.spawn(function()
                local cg = game:GetService("CoreGui")
                local guiSvc = game:GetService("GuiService")
                for _ = 1, 120 do
                    pcall(function()
                        for _, g in ipairs(cg:GetChildren()) do
                            local n = tostring(g.Name):lower()
                            if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                if g:IsA("ScreenGui") then g.Enabled = false end
                                pcall(function() g.Parent = nil end)
                            end
                        end
                        guiSvc:ClearError()
                    end)
                    task.wait(0.5)
                end
            end)
            task.wait(8)
            while true do
                pcall(function() TS:Teleport(game.PlaceId, plr) end)
                task.wait(8)
            end
        end
        -- loop cepat: hapus denyut pas disconnect + REJOIN SENDIRI (grace 60s + konfirmasi 4x, hindari false-positive)
        task.spawn(function()
            local dcStrict = 0
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if not plr or not plr.Name or _G.ZenxRejoining then dcStrict = 0; return end
                    -- v-dc4: JANGAN hapus file denyut pas disconnect. Cukup BERHENTI
                    -- nulis (write di-gate not zenxDcStrict) -> denyut basi -> worker rejoin
                    -- setelah 2 menit. Hapus file bikin "BELUM ADA FILE" (lebih ribet).
                    if zenxDcStrict() then
                        dcStrict = dcStrict + 1
                        local umur = os.time() - (_G.__ZenxBootT or os.time())
                        if dcStrict >= 4 and umur > 60 and _G.ZenxSelfRejoin then
                            _G.ZenxSelfRejoin("prompt reconnect Roblox (" .. dcStrict .. "x)")
                        end
                    else
                        dcStrict = 0
                    end
                end)
                task.wait(3)
            end
        end)
        -- penghitung egg (port EggDetect hact: Tool backpack/char + GUI stacked "18x Egg")
        task.spawn(function()
            local lastGuiScan, guiCache = 0, {}
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if not plr then return end
                    local counts = {}
                    local function scanTools(cont)
                        if not cont then return end
                        for _, t in ipairs(cont:GetChildren()) do
                            if t:IsA("Tool") and t.Name:lower():find("egg") then
                                counts[t.Name] = (counts[t.Name] or 0) + 1
                            end
                        end
                    end
                    scanTools(plr:FindFirstChild("Backpack"))
                    scanTools(plr.Character)
                    -- scan GUI tiap 15s (egg stacked, mis "18x Bug Egg" / "Bug Egg x18")
                    local now = os.time()
                    if (now - lastGuiScan) >= 15 then
                        lastGuiScan = now
                        local fresh = {}
                        local pg = plr:FindFirstChildOfClass("PlayerGui")
                        if pg then
                            for _, d in ipairs(pg:GetDescendants()) do
                                if d:IsA("TextLabel") then
                                    local txt = d.Text or ""
                                    -- WAJIB penanda stack "Nx"/"xN" (bukan angka telanjang -> hindari nangkep stat/sheckles gede)
                                    local cnt, name = txt:match("^(%d+)x%s+(.+[Ee]gg.*)$")
                                    if not cnt then cnt, name = txt:match("^x(%d+)%s+(.+[Ee]gg.*)$") end
                                    if not cnt then name, cnt = txt:match("^(.+[Ee]gg.-)%s+x(%d+)$") end   -- WAJIB "x" (dulu "x?" nangkep angka apapun)
                                    if cnt and name then
                                        local n = tonumber(cnt)
                                        if n and n > 0 and n <= 20000 then fresh[name] = math.max(fresh[name] or 0, n) end   -- cap 20rb (egg gak mungkin jutaan)
                                    end
                                end
                            end
                        end
                        guiCache = fresh
                    end
                    for k, v in pairs(guiCache) do counts[k] = math.max(counts[k] or 0, v) end
                    -- HITUNG per JENIS spesifik: Gem Egg (nama ada "gem") + Christmas Egg (nama ada "christmas"/"festive")
                    -- + Night Egg (nama ada "night", tapi BUKAN "midnight"/dll -- match persis awal kata)
                    local totalChr, totalGem, totalNight = 0, 0, 0
                    for k, c in pairs(counts) do
                        local n = tonumber(c) or 0
                        local lk = tostring(k):lower()
                        if lk:find("christmas") or lk:find("festive") then totalChr = totalChr + n
                        elseif lk:find("gem") then totalGem = totalGem + n   -- CUMA gem egg (bukan all egg)
                        elseif lk:find("^night") or lk:find(" night") then totalNight = totalNight + n end
                    end
                    _G.ZenxPanenEggChr = totalChr
                    _G.ZenxPanenEggGem = totalGem
                    _G.ZenxPanenEggNight = totalNight
                    _G.ZenxPanenEgg = totalChr + totalGem + totalNight   -- total gem+christmas+night
                end)
                task.wait(10)
            end
        end)
        -- denyut tiap 20s (bawa egg count) — SKIP kalau disconnect
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if plr and plr.Name and writefile and not zenxDcStrict() then
                        local chr = tonumber(_G.ZenxPanenEggChr) or 0
                        local gem = tonumber(_G.ZenxPanenEggGem) or 0
                        local night = tonumber(_G.ZenxPanenEggNight) or 0
                        -- format egg3: "ts;<gemEgg>;<chrEgg>;<nightEgg>;egg3" (worker pisah 3 jenis)
                        writefile("zenx_denyut_" .. plr.Name .. ".txt",
                            os.time() .. ";" .. gem .. ";" .. chr .. ";" .. night .. ";egg3")
                    end
                end)
                task.wait(20)
            end
        end)
    end
end

-- ===== AUTO-REJOIN tiap N menit (KICK dulu -> rejoin server SAMA dalam 30s) =====
-- SETTING WAKTU: ganti REJOIN_MENIT di sini (berlaku semua RF pas reload script).
-- Bisa juga di-override runtime: _G.ZenxRejoinMenit = 45
local REJOIN_MENIT = 60    -- <<< SETTING: rejoin tiap berapa menit
_G.ZenxRejoinMenit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT   -- DEFAULT 60, WAJIB nyala (gak ada toggle mati)
_G.__ZenxBootT = _G.__ZenxBootT or os.time()   -- waktu boot script (buat guard kick-pertama)
-- Port dari leveling/farm: player:Kick (putus server, script executor TETEP hidup)
-- -> tunggu 30s (ghost slot bekas kita bebas) -> TeleportToPlaceInstance jobId SAMA
-- (retry 12s). Private server: retry server SAMA terus (Teleport acak = kelempar public).
-- _G.ZenxRejoining=true -> disconnect-detect JANGAN hapus denyut (worker gak ikut rejoin).
_G.__ZenxRejoinJalan = true   -- <<< AUTO-REJOIN SC DIMATIIN (worker + panel kick yg handle rejoin, gak perlu dobel)
do
    if not _G.__ZenxRejoinJalan then
        _G.__ZenxRejoinJalan = true
        local TS = game:GetService("TeleportService")
        task.spawn(function()
            while true do
                -- COUNTDOWN GLOBAL TERSINKRON + LIVE: align wall-clock (os.time UTC), semua
                -- client rejoin BARENG di boundary. Recompute TIAP DETIK -> ganti waktu
                -- (_G.ZenxRejoinMenit) LIVE langsung re-align ke boundary baru (gak nunggu cycle).
                while true do
                    local menit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT
                    local interval = math.max(60, math.floor(menit * 60))
                    -- OFFSET per-interval: tiap interval punya grid GLOBAL sendiri (10m/20m/
                    -- 30m/dst gak numpuk boundary-nya). offset = (menit/10 - 1) menit.
                    local offset = math.max(0, math.floor(menit / 10) - 1) * 60
                    local now = os.time()
                    local nextB = (math.floor((now - offset) / interval) + 1) * interval + offset
                    -- guard: jangan kick dalam 60s pertama abis load (biar gak kick barusan exe)
                    while nextB - _G.__ZenxBootT < 60 do nextB = nextB + interval end
                    _G.ZenxRejoinSisa = nextB - now
                    if _G.ZenxRejoinSisa <= 1 then break end
                    task.wait(1)
                end
                _G.ZenxRejoinSisa = 0
                local plr = game:GetService("Players").LocalPlayer
                if plr then
                    local jobId  = game.JobId
                    local isPriv = (game.PrivateServerId or "") ~= ""
                    _G.ZenxRejoining = true
                    pcall(function() plr:Kick("ZenxFreezeRejoin") end)
                    -- SEMBUNYIIN dialog "kicked/disconnect" biar TeleportToPlaceInstance gak ke-blok
                    task.spawn(function()
                        local cg = game:GetService("CoreGui")
                        local guiSvc = game:GetService("GuiService")
                        for _ = 1, 300 do
                            pcall(function()
                                for _, g in ipairs(cg:GetChildren()) do
                                    local n = tostring(g.Name):lower()
                                    if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                        if g:IsA("ScreenGui") then g.Enabled = false end
                                        pcall(function() g.Parent = nil end)
                                    end
                                end
                                pcall(function() guiSvc:ClearError() end)
                            end)
                            task.wait(0.5)
                        end
                    end)
                    task.wait(40)   -- ghost slot bekas kita bebas dulu (30->40s)
                    while true do
                        -- GACOR: Teleport polos (matchmaking) -> balik ke PS SAMA + LOLOS anti-scam.
                        -- (TeleportToPlaceInstance keblok anti-scam krn target jobId spesifik.
                        --  Teleport() polos dianggap "join balik" biasa -> otomatis ke PS lo.)
                        pcall(function() TS:Teleport(game.PlaceId, plr) end)
                        task.wait(12)
                    end
                end
            end
        end)
    end
end

