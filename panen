local function makeSideBtn(name, y)
    local btn = mk("TextButton", {
        Size = UDim2.new(1, -16, 0, 34), Position = UDim2.new(0, 8, 0, y),
        BackgroundColor3 = (name == activeSide) and C.card or C.panel,
        Text = "", AutoButtonColor = false, Parent = sidebar })
    corner(btn, 7)
    local accent = mk("Frame", {
        Size = UDim2.new(0, 3, 0.6, 0), Position = UDim2.new(0, 0, 0.2, 0),
        BackgroundColor3 = C.accent, BorderSizePixel = 0,
        Visible = (name == activeSide), Parent = btn })
    corner(accent, 2)
    local t = lbl(btn, name, 11.5, (name == activeSide) and C.text or C.textDim)
    t.Position = UDim2.new(0, 12, 0, 0); t.Size = UDim2.new(1, -12, 1, 0); t.Font = FONT_B
    sideBtns[name] = { btn = btn, accent = accent, label = t }
    btn.MouseButton1Click:Connect(function()
        activeSide = name
        for n, d in pairs(sideBtns) do
            local on = (n == name)
            d.btn.BackgroundColor3 = on and C.card or C.panel
            d.accent.Visible = on
            d.label.TextColor3 = on and C.text or C.textDim
        end
        if showSideFn then showSideFn(name) end
    end)
    return btn
end
