-- COLLECT = ProximityPrompt (fireproximityprompt). Auto ON pas ada rain.
-- ============================================================
local SEED = {
    auto  = false,      -- master: auto-collect pas ada seed di tanah
    jeda  = 0.01,
    spam  = 5,
    tp    = true,
    yOfs  = 3,
    ground = true,
    maxY  = 6,
    rain  = "-",
    collect = 0,
    adaSeed = 0,
}
_G.ZenxSeed = SEED
local FP_ADA = type(fireproximityprompt) == "function"
local function seedLog(s) if _G.ZenxSeedLog then _G.ZenxSeedLog(s) end print("[Seed] " .. s) end

local function seedCariPrompts()
    local out = {}
    local wv = workspace:FindFirstChild("WeatherVisuals")
    local root = wv or workspace
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local seed = d.Parent
            local lolosG = true
            if SEED.ground and seed then
                local ok, y = pcall(function()
                    if seed:IsA("BasePart") then return seed.Position.Y end
                    return seed:GetPivot().Position.Y
                end)
                if ok and type(y) == "number" then lolosG = (y <= SEED.maxY) end
            end
            if lolosG then out[#out+1] = d end
        end
    end
    return out
end

local function seedCollect(prompt, hrp)
    if SEED.tp and hrp then
        local seed = prompt.Parent
        local part = seed and (seed:IsA("BasePart") and seed or seed:FindFirstChildWhichIsA("BasePart"))
        if part then pcall(function() hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, SEED.yOfs, 0)) end) end
    end
    pcall(function() prompt.RequiresLineOfSight = false end)
    for i = 1, SEED.spam do
        if FP_ADA then pcall(function() fireproximityprompt(prompt) end)
        else pcall(function() prompt:InputHoldBegin(); prompt:InputHoldEnd() end) end
    end
end

-- loop collect non-stop (jalan pas SEED.auto ON + ada seed)
task.spawn(function()
    while true do
        if SEED.auto then
            local prompts = seedCariPrompts()
            SEED.adaSeed = #prompts
            if #prompts > 0 then
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                for _, p in ipairs(prompts) do
                    if not SEED.auto then break end
                    seedCollect(p, hrp)
                    SEED.collect = SEED.collect + 1
                end
            end
        end
        task.wait(SEED.jeda)
    end
end)

