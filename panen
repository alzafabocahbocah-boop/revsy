local function cocokTipe(petName, target)
    if not petName then return false end
    petName = tostring(petName):lower(); target = tostring(target):lower()
    return petName == target or petName:find(target, 1, true) ~= nil
end

-- uuid -> nama pet (akumulasi dari backpack scan; inget walau pet udah ke-equip)
local uuidTipe = {}
local function scanUuidTipe()
    pcall(function()
        for _, p in ipairs(PetDetect.listBackpackPets(true) or {}) do
            if p.uuid and p.name then uuidTipe[fmtUUID(p.uuid)] = p.name end
        end
    end)
end

-- TIM TERKUNCI: pilih uuid pet SEKALI, terus fokus ke pet itu-itu aja (gak ganti-ganti)
local timKunci = {}   -- uuid(fmt) -> tipe
local timInfo  = {}   -- uuid(fmt) -> { nama, tipe, kg, age }  (buat display UI)
_G.ZenxGemTim = timInfo
local function jmlKunci() local n = 0; for _ in pairs(timKunci) do n = n + 1 end; return n end

-- pilih tim SEKALI (isi slot yg belom kekunci). AMBIL PET PALING BESAR (KG tertinggi)
-- per jenis. uuid dikunci -> gak berubah tiap reset.
local function pilihTim()
    scanUuidTipe()
    local pets = {}
    pcall(function() pets = PetDetect.listBackpackPets(true) or {} end)
    local ada = {}
    for _, tipe in pairs(timKunci) do ada[tipe] = (ada[tipe] or 0) + 1 end
    for tipe, jml in pairs(GEM.tim) do
        local n = ada[tipe] or 0
        if n < jml then
            -- kumpulin semua pet jenis ini yg belom kekunci
            local cocok = {}
            for _, p in ipairs(pets) do
                local u = fmtUUID(p.uuid)
                if not timKunci[u] and cocokTipe(p.name, tipe) then cocok[#cocok+1] = p end
            end
            -- SORT KG paling besar dulu -> ambil yg gede
            table.sort(cocok, function(a, b) return (a.dispKg or 0) > (b.dispKg or 0) end)
            for _, p in ipairs(cocok) do
                if n >= jml then break end
                local u = fmtUUID(p.uuid)
                timKunci[u] = tipe
                uuidTipe[u] = p.name
                timInfo[u]  = { nama = p.name, tipe = tipe, kg = p.dispKg, age = p.level }
                n = n + 1
            end
        end
    end
end

-- equip pet YANG TERKUNCI (uuid sama terus, gak pilih baru)
local function equipTeam()
    scanUuidTipe()
    if jmlKunci() == 0 then pilihTim() end   -- pilih sekali di awal
    timUuids = {}
    local ambil = 0
    local per = {}
    for u, tipe in pairs(timKunci) do
        equipPet(u, CLUSTER)          -- equip pet TERKUNCI ini
        timUuids[u] = true
        per[tipe] = (per[tipe] or 0) + 1
        ambil = ambil + 1
        task.wait(0.06)
    end
    for tipe, jml in pairs(GEM.tim) do gemLog(("equip %s: %d/%d"):format(tipe, per[tipe] or 0, jml)) end
    gemLog("total equip: " .. ambil .. " (uuid terkunci)")
    return ambil
end

-- verify: pet terkunci masih placed? ada pet nyasar (bukan anggota tim)?
local function verifikasiTim()
    scanUuidTipe()
    local hilang, extra = {}, {}
    -- pet terkunci yg GAK placed -> perlu re-equip
    for u in pairs(timKunci) do
        if not modelByUuid[u] then hilang[#hilang+1] = u end
    end
    -- pet placed PUNYA GUA, tipe tim, TAPI bukan anggota terkunci -> nyasar, buang
    for uuid in pairs(modelByUuid) do
        local nama = uuidTipe[uuid]
        if nama and not timKunci[uuid] then
            for tipe in pairs(GEM.tim) do
                if cocokTipe(nama, tipe) then extra[#extra+1] = uuid; break end
            end
        end
    end
    return (#hilang == 0 and #extra == 0), hilang, extra
end

-- unequip SEMUA pet placed (BERSIH: timUuids + modelByUuid + retry + wait)
local function unequipSemua()
    for tri = 1, 3 do
        local seen = {}
        for uuid in pairs(timUuids)    do if not seen[uuid] then unequipPet(uuid); seen[uuid]=true; task.wait(0.04) end end
        for uuid in pairs(modelByUuid) do if not seen[uuid] then unequipPet(uuid); seen[uuid]=true; task.wait(0.04) end end
        task.wait(0.4)
        local adaGua = false
        for uuid in pairs(modelByUuid) do if uuidTipe[uuid] then adaGua = true; break end end
        if not adaGua then break end
    end
    timUuids = {}
end

-- ----- swap engine PARALEL (tiap pet swap SENDIRI, GAK antre) — gacor kayak up_kg -----
local busy, lastSwap, lastPos, busySince = {}, {}, {}, {}
local function swapPet(uuid)
    if busy[uuid] then return end
    busy[uuid] = true
    busySince[uuid] = tick()
    task.spawn(function()
        pcall(function()   -- error di tengah -> busy TETEP ke-clear di bawah (anti nyangkut)
            local pos = CLUSTER
            if not pos then local m = modelByUuid[uuid]; if m then local ok,p = pcall(function() return m:GetPivot().Position end); if ok then pos = p end end end
            if not pos then pos = lastPos[uuid] end
            if pos then lastPos[uuid] = pos end
            if GEM.pickup > 0 then task.wait(GEM.pickup) end
            unequipPet(uuid)
            if GEM.place > 0 then task.wait(GEM.place) else task.wait(0.03) end
            equipPet(uuid, pos)
            lastSwap[uuid] = tick()
            for i = 1, 12 do                       -- retry: cek tiap 0.1s (deteksi respawn CEPET) biar gak nyangkut lama
                task.wait(0.1)
                local m = modelByUuid[uuid]; if m and m.Parent then break end
                if i % 4 == 0 then equipPet(uuid, lastPos[uuid]) end   -- re-equip tiap ~0.4s (gak spam)
            end
        end)
        busy[uuid] = nil   -- SELALU clear (walau error) -> pet gak nyangkut
    end)
end
-- loop ready: pet tim yg ready -> SWAP LANGSUNG (paralel, gak antre). cek cepet 0.05s.
task.spawn(function()
    while true do
        task.wait(0.05)
        if GEM.aktif then
            for uuid in pairs(modelByUuid) do
                -- lepas busy NYANGKUT (>6s = swap gagal/kelamaan) biar pet swap lagi
                if busy[uuid] and busySince[uuid] and (tick() - busySince[uuid]) > 6 then busy[uuid] = nil end
                -- tim di-swap, TAPI Spider/Ghostly Spider di-equip aja (DIEM, gak di-swap)
                local nm = uuidTipe[uuid]
                if timUuids[uuid] and not busy[uuid] and not (nm and tostring(nm):lower():find("spider")) then
                    local rdy = petReady(uuid)
                    local idle = lastSwap[uuid] and (tick() - lastSwap[uuid]) or 999
                    if (rdy == true and idle > 0.15) or (rdy == nil and idle > 4) then swapPet(uuid) end
                end
            end
        end
    end
end)

-- ----- START / STOP gem egg -----
-- verify + auto-fix: buang pet nyasar + re-equip pet TERKUNCI yg hilang.
-- gak ganti-ganti pet: uuid tetap terkunci, cuma dibetulin posisinya.
local function pastikanTim()
    local sesuai, hilang, extra = verifikasiTim()
    if sesuai then return end
    -- buang pet nyasar (bukan anggota tim terkunci)
    for _, u in ipairs(extra) do unequipPet(u); task.wait(0.05) end
    -- re-equip pet terkunci yg gak placed (double-check biar gak salah tangkap
    -- pet yg lagi di-SWAP gacor -- swap ~0.3s, kita cek ulang abis 0.4s)
    local balik = 0
    for _, u in ipairs(hilang) do
        task.wait(0.4)
        if not modelByUuid[u] then   -- masih hilang beneran (bukan mid-swap)
            equipPet(u, CLUSTER); timUuids[u] = true; balik = balik + 1; task.wait(0.06)
        end
    end
    -- kalau ada slot terkunci yg PETNYA ILANG total (ketrade/kerelease) -> isi ulang slot
    if jmlKunci() < 8 then pilihTim() end
    gemLog(("FIX tim: buang %d nyasar, re-equip %d terkunci"):format(#extra, balik))
end

local function gemStart()
    GEM.aktif = true
    CLUSTER = farmCenter()
    timKunci = {}    -- kunci fresh tiap START (pilih tim baru sesuai backpack sekarang)
    gemLog("START. center=" .. (CLUSTER and "ada" or "NIL"))
    task.spawn(function()
        unequipSemua()   -- PICKUP ALL pet di kebun dulu (refresh) pas ON
        task.wait(0.5)
        equipTeam()   -- pilih + kunci tim + equip
        task.wait(1)
        pastikanTim()
        -- (RESET 60s DIHAPUS — HEALER 1s + verify 5s udah jaga visual, gak perlu refresh berkala)
    end)
    -- loop verify mandiri tiap 5s (buang pet nyasar / re-equip yg hilang)
    task.spawn(function()
        while GEM.aktif do
            task.wait(5)
            if GEM.aktif then pcall(pastikanTim) end
        end
    end)
    -- REFRESH cooldown cache periodik (2s, BACKGROUND) — biar petReady non-block = swap TETEP gacor
    task.spawn(function()
        local ge2 = game:GetService("ReplicatedStorage"):FindFirstChild("GameEvents")
        local req2 = ge2 and ge2:FindFirstChild("RequestPetCooldowns")
        local lastInvoke = 0
        while GEM.aktif do
            if req2 then pcall(function() req2:FireServer() end) end   -- SERING (0.5s) = cache fresh = GACOR
            if getCooldownRF and (tick() - lastInvoke) >= 2 then
                lastInvoke = tick()
                for u in pairs(timKunci) do
                    local key = tostring(u):gsub("[{}]", "")
                    local e = cdEventCache[key]
                    if not (e and tick() - e.at <= 8) then
                        local ok, res = pcall(function() return getCooldownRF:InvokeServer(fmtUUID(u)) end)
                        if ok and type(res) == "table" and type(res[1]) == "table" and type(res[1].Time) == "number" then
                            cdEventCache[key] = { ready = (res[1].Time <= 0), at = tick() }
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
    -- HEALER cek TERUS (1s): pet terkunci yg model ILANG -> PAKSA copot->pasang (force spawn)
    task.spawn(function()
        while GEM.aktif do
            task.wait(1)
            if GEM.aktif then
                for u in pairs(timKunci) do
                    local idle = lastSwap[u] and (tick() - lastSwap[u]) or 999
                    if not modelByUuid[u] and not busy[u] and idle > 3 then
                        pcall(function() unequipPet(u); task.wait(0.15); equipPet(u, CLUSTER); timUuids[u] = true; task.wait(0.12) end)
                    end
                end
            end
        end
    end)
end
local function gemStop()
    GEM.aktif = false
    task.spawn(function()
        task.wait(0.15)      -- kasih waktu loop swap berhenti
        unequipSemua()       -- kosongin garden (ambil semua pet)
        gemLog("STOP + garden dikosongin")
    end)
end
