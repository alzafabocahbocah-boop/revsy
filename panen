            local t
            if type(data) == "table" and type(data[1]) == "table" and type(data[1].Time) == "number" then t = data[1].Time end
            cdEventCache[key] = { ready = (t ~= nil) and (t <= 0) or false, at = tick() }
        end)
    end
    if req and req:IsA("RemoteEvent") then pcall(function() req:FireServer() end) end
