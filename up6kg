-- ===== AUTO BUY TRADING TICKET (port market v8.276) =====
-- fire BuyGearStock(namaTiket) tiap 5s KALAU tiket < 2 (biar gak over-buy).
-- game auto-tolak kalau stock abis / Sheckles kurang -> aman. self-contained.
if not _G.__ZenxAutoTicket then
    _G.__ZenxAutoTicket = true
    task.spawn(function()
        local rs = game:GetService("ReplicatedStorage")
        local plr = game:GetService("Players").LocalPlayer
        -- auto-detect nama tiket dari GearData (fallback "Trading Ticket")
        local ticketName = "Trading Ticket"
        pcall(function()
            local dataF = rs:FindFirstChild("Data")
            local mod = dataF and dataF:FindFirstChild("GearData")
            if mod then
                local ok, tbl = pcall(require, mod)
                if ok and type(tbl) == "table" then
                    for k, v in pairs(tbl) do
                        local nm
                        if type(k) == "string" then nm = k
                        elseif type(v) == "table" then nm = v.Name or v.ItemName or v.DisplayName end
                        if type(nm) == "string" then
                            local low = nm:lower()
                            if low:find("trading", 1, true) and low:find("ticket", 1, true) then ticketName = nm; break end
                        end
                    end
                end
            end
        end)
        local ge = rs:FindFirstChild("GameEvents")
        local re = ge and ge:FindFirstChild("BuyGearStock")
        if not re then print("[AutoTicket] BuyGearStock gak ketemu — auto-buy batal"); return end
        print("[AutoTicket] auto-buy '" .. ticketName .. "' aktif (beli kalau tiket < 2)")
        local function ticketCount()
            local n = 0
            pcall(function()
                local function scan(c) if not c then return end for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") then local low = t.Name:lower()
                        if (low:find("trading") and low:find("ticket")) or low:find("trade ticket") then n = n + 1 end end end end
                scan(plr:FindFirstChild("Backpack")); scan(plr.Character)
            end)
            return n
        end
        while true do
            task.wait(5)
            if ticketCount() < 2 then pcall(function() re:FireServer(ticketName) end) end
        end
    end)
end

