    local function giftEle(targetPlayer)
        if not targetPlayer or not OP.pick[targetPlayer.Name] then return false, "gak di picker (ditolak)" end
        local plr = Players.LocalPlayer
        local bp = plr:FindFirstChild("Backpack"); local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (bp and hum) then return false, "no bp/hum" end
        local eleTool
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local f = tostring(t:GetAttribute("f") or t.Name)
                if f:lower():find("rainbow elephant", 1, true) then eleTool = t; break end
            end
        end
        if not eleTool then return false, "Ele gak di backpack" end
        pcall(function() hum:EquipTool(eleTool) end); task.wait(0.25)
        local ge = RS:FindFirstChild("GameEvents"); local re = ge and ge:FindFirstChild("PetGiftingService")
        if re then
            local uuid = eleTool:GetAttribute("PET_UUID"); local u = tostring(uuid)
            if u:sub(1,1) ~= "{" then u = "{"..u.."}" end
            pcall(function() re:FireServer("GivePet", targetPlayer, u) end); task.wait(0.3)
