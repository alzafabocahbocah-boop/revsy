local function bukaPicker(filter)
    for _, c in ipairs(pList:GetChildren()) do if c:IsA("TextButton") or (c:IsA("TextLabel") and c.Name=="kosong") then c:Destroy() end end
    local tipe = (_G.ZenxKgStat and _G.ZenxKgStat.tipe) or {}   -- jumlah pet yg DIPUNYA
    local set = (type(_G.ZenxKgUpTipe)=="table") and _G.ZenxKgUpTipe or {}
    -- union: yg dipunya + SEMUA pet registry
    local seen, names = {}, {}
    for t in pairs(tipe) do if not seen[t] then seen[t]=true; names[#names+1]=t end end
    for t in pairs(set) do if not seen[t] then seen[t]=true; names[#names+1]=t end end
    pcall(function()
        local reg = _G.ZenxReg and _G.ZenxReg.pets
        if type(reg)=="table" then for nm in pairs(reg) do local ty=stripMutation(tostring(nm)); if ty~="" and not seen[ty] then seen[ty]=true; names[#names+1]=ty end end end
    end)
    table.sort(names, function(a, b)
        local sa, sb = set[a] and 1 or 0, set[b] and 1 or 0
        if sa ~= sb then return sa > sb end            -- KEPILIH di atas
        local ca, cb = tonumber(tipe[a]) or 0, tonumber(tipe[b]) or 0
        if ca ~= cb then return ca > cb end             -- punya (jumlah) di atas
        return a < b                                     -- sisanya alfabet
    end)
    filter = (filter or ""):lower()
    local shown = 0
    for _, t in ipairs(names) do
        if filter=="" or t:lower():find(filter,1,true) then
            shown = shown + 1
            if shown <= 200 then
                local sel = set[t] and true or false
                local cnt = tonumber(tipe[t]) or 0
                local b = mk("TextButton", { Size = UDim2.new(1, 0, 0, 30),
                    BackgroundColor3 = sel and C.cardSel or C.card, AutoButtonColor = true,
                    Text = "   " .. (sel and "\u{2713} " or "") .. t .. "   \u{00d7}" .. cnt,
                    Font = FONT, TextSize = 24,
                    TextColor3 = sel and C.accent or (cnt>0 and C.text or C.textDim), TextXAlignment = Enum.TextXAlignment.Left,
                    LayoutOrder = shown, ZIndex = 102, Parent = pList }); corner(b, 5)
                b.MouseButton1Click:Connect(function()
                    _G.ZenxKgUpTipe = (type(_G.ZenxKgUpTipe) == "table") and _G.ZenxKgUpTipe or {}
                    local s = _G.ZenxKgUpTipe
                    if s[t] then s[t] = nil else s[t] = true end
                    if _G.ZenxKgSaveCfg then _G.ZenxKgSaveCfg() end
