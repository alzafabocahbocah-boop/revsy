    local OP = { auto = false, pick = {}, minOper = 50, logAkun = {}, age40 = {}, operCount = 0 }

    local function httpReq(path, method, body)
        local req = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
        if not req then return nil end
        local o = { Url = WORKER .. path, Method = method or "GET" }
        if body then o.Headers = { ["Content-Type"] = "application/json" }; o.Body = body end
        local ok, res = pcall(function() return req(o) end)
        return ok and res or nil
    end
    local function loadPick()
        OP.pick = {}
        local res = httpReq("/ele-ikut", "GET")
        if res and res.Body then
            local arr = tostring(res.Body):match("%[(.-)%]")
            if arr then for nm in arr:gmatch('"([^"]+)"') do OP.pick[nm] = true end end
        end
    end
    local function setPick(nama, val)
        httpReq("/ele-ikut", "POST", string.format('{"kunci":"%s","akun":"%s","ikut":%s}', KUNCI, nama, tostring(val)))
        if val then OP.pick[nama] = true else OP.pick[nama] = nil end
    end
    local function nPick() local n = 0; for _ in pairs(OP.pick) do n = n + 1 end; return n end

    -- baca inventory target -> bahan age40 (<6kg) count
    local function bahanAge40Lain(target)
        local te = RS:FindFirstChild("GameEvents"); te = te and te:FindFirstChild("TradeEvents")
        local vi = te and te:FindFirstChild("ViewInventory")
        if not vi then return nil end
        local list
        for att = 1, 3 do
            local res = { pcall(function() return vi:InvokeServer(target) end) }
            if res[1] then for k = 2, #res do if type(res[k]) == "table" then list = res[k]; break end end end
            if list then break end
            if att < 3 then task.wait(13) end
        end
        if not list then return nil end
        local n, hasEle = 0, false
        local bahanSet = _G.ZenxKgUpTipe or {}
        for _, item in pairs(list) do
            if type(item) == "table" and tostring(item.type) == "Pet" and type(item.data) == "table" then
                local pd = item.data.PetData or {}
                local lvl = tonumber(pd.Level) or 0
                local bw = tonumber(pd.BaseWeight) or 0
                local tp = stripMutation(tostring(item.data.PetType or ""))
                if tostring(tp):lower():find("rainbow elephant", 1, true) then hasEle = true end
                local cocok = false
                for b in pairs(bahanSet) do if tostring(tp):lower():find(tostring(b):lower(), 1, true) then cocok = true; break end end
                if cocok and lvl >= 40 and bw < 6 then n = n + 1 end
            end
        end
        return n, hasEle
    end

