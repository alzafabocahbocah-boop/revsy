task.spawn(function()
    local mauOn = (_G.__ZenxKgAutoOnBoot == true)
    -- jaga-jaga flag ke-miss (config kebaca telat pas fresh join) -> baca ULANG file langsung
    if not mauOn then
        for _ = 1, 6 do
            local ok = pcall(function()
                if isfile and isfile("zenx_upkg_cfg.json") and readfile then
                    local c = game:GetService("HttpService"):JSONDecode(readfile("zenx_upkg_cfg.json"))
                    if type(c) == "table" and c.autoOn == true then mauOn = true end
                end
            end)
            if mauOn or not ok then break end
            if not mauOn then task.wait(1) end
        end
    end
    if not mauOn then syncKgTog(); return end
    task.wait(3)   -- kasih waktu engine/container siap dikit
    -- RETRY ~30s: begitu belum jalan -> START (kgStart nunggu container sendiri di dalamnya)
    for _ = 1, 20 do
        if _G.ZenxKg and _G.ZenxKg.aktif then break end   -- udah ON
        if _G.ZenxKgStart then pcall(function() _G.ZenxKgStart(kgConfigAktif) end) end
        syncKgTog()
        task.wait(1.5)
    end
    syncKgTog()
end)

