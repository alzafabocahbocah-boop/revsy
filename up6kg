    -- pickup all pet di kebun (scan workspace FRESH + retry)
    local function pickupAll()
        local np = 0
        for tri = 1, 3 do
            local uuids = {}
            for uuid in pairs(modelByUuid) do uuids[uuid] = true end
            pcall(function()
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("Model") and tostring(d.Name):sub(1,1) == "{" then uuids[d.Name] = true end
                end
            end)
            local any = false
            for uuid in pairs(uuids) do unequipPet(uuid); np = np + 1; any = true; task.wait(0.04) end
            task.wait(0.5)
            if not any then break end
        end
        return np
    end
    -- pasang tim sesuai SESI (pickup all -> pilih support+bahan -> equip)
    -- POOL support LOCKED once -> uuid pet support TETAP di 2 sesi (gak re-pick tiap sesi,
    -- biar gak numpuk/lebih). Max count per tipe = max(sesi1, sesi2).
    local supPool = nil   -- nama -> { uuid, ... }
    local POOL_FILE = "zenx_up6kg_pool.txt"
    local function savePool()
        if not supPool then return end
        local parts = {}
        for nm, list in pairs(supPool) do parts[#parts + 1] = nm .. "=" .. table.concat(list, ",") end
        pcall(function() if writefile then writefile(POOL_FILE, table.concat(parts, "\n")) end end)
    end
    local function loadPoolFile()
        local ok, data = pcall(function()
            if isfile and isfile(POOL_FILE) and readfile then return readfile(POOL_FILE) end
            return nil
        end)
        if not ok or not data then return nil end
        local pool = {}
        for line in tostring(data):gmatch("[^\n]+") do
            local nm, uuids = line:match("^(.-)=(.*)$")
            if nm and nm ~= "" then
                pool[nm] = {}
                for u in tostring(uuids):gmatch("[^,]+") do pool[nm][#pool[nm] + 1] = u end
            end
        end
        return next(pool) and pool or nil
    end
    -- KUNCI support: paksa=true -> kunci BARU (re-pick kg terbesar). else: pakai kunci lama
    -- (dari memory / file). Sekali kunci -> TETAP walau rejoin (persist file). Ganti = pencet "kunci baru".
    local function updateSupportUuids()
        local su, detail = {}, {}
        if supPool then
            local pets = listPetsAll()
            local kgByUuid = {}
            for _, p in ipairs(pets) do kgByUuid[p.uuid] = p.kg end
            for nm, list in pairs(supPool) do
                detail[nm] = {}
                for _, u in ipairs(list) do
                    su[u] = true
                    detail[nm][#detail[nm] + 1] = { uuid = u, kg = kgByUuid[u] or 0 }
                end
            end
        end
        _G.ZenxSupportUuids = su        -- buat auto-fav
        _G.ZenxSupportPool = detail     -- buat lineup UI (nama -> {{uuid, kg}})
    end
    local function kunciSupPool(paksa)
        if not paksa and supPool then updateSupportUuids(); return end   -- udah ke-kunci di memory
        if not paksa then
            local saved = loadPoolFile()
            if saved then supPool = saved; updateSupportUuids(); kgLog("pool support: LOAD kunci lama (uuid tetap, gak berubah)"); return end
        end
        local maxPer, cariMap = {}, {}
        for _, sup in ipairs(SUPPORT_S1_ELE) do maxPer[sup.nama] = math.max(maxPer[sup.nama] or 0, sup.jml); cariMap[sup.nama] = sup.cari end
        for _, sup in ipairs(SUPPORT_S2_ELE) do maxPer[sup.nama] = math.max(maxPer[sup.nama] or 0, sup.jml); cariMap[sup.nama] = sup.cari end
        -- pilih KG TERBESAR (kg current = base × age, BUKAN base weight doang)
        local pets = listPetsAll()
        table.sort(pets, function(a, b) return (a.kg or 0) > (b.kg or 0) end)
        supPool = {}; local taken = {}
        for nm, maxJ in pairs(maxPer) do
            supPool[nm] = {}
            for _, p in ipairs(pets) do
                if #supPool[nm] >= maxJ then break end
                if not taken[p.uuid] and cocokSemua(p.tipe, cariMap[nm]) then
                    supPool[nm][#supPool[nm] + 1] = p.uuid; taken[p.uuid] = true
                end
            end
        end
        savePool(); updateSupportUuids()   -- SIMPEN + expose uuid (buat auto-fav)
        local ss = ""; for nm, l in pairs(supPool) do ss = ss .. nm .. "=" .. #l .. "/" .. (maxPer[nm] or 0) .. " " end
        kgLog("pool support: KUNCI BARU (kg terbesar) -> " .. ss)
    end
    -- hook GUI: tombol "kunci support baru" -> re-pick + re-equip
    _G.ZenxKunciSupportBaru = function()
        pcall(function() if delfile and isfile and isfile(POOL_FILE) then delfile(POOL_FILE) end end)
        supPool = nil
        for u in pairs(supportKunci) do pcall(function() unequipPet(u) end) end
        supportKunci = {}
        kunciSupPool(true)   -- kunci baru (kg terbesar) + simpen
        if KG.aktif then pasangSesi(KG.sesi, false) end
        kgLog("KUNCI SUPPORT BARU dipencet -> support di-pilih ulang (kg terbesar)")
    end

    local function pasangSesi(sesi, pickup)
        kunciSupPool()   -- lock pool sekali -> uuid support KONSISTEN
        local SUP = (sesi == 2) and SUPPORT_S2_ELE or SUPPORT_S1_ELE
        -- support: PAKAI uuid dari POOL (jml sesuai config sesi). uuid SAMA tiap sesi.
        local supBaru = {}
        for _, sup in ipairs(SUP) do
            local pool = supPool[sup.nama] or {}
            for i = 1, sup.jml do if pool[i] then supBaru[pool[i]] = sup.nama end end
        end
        -- up6kg: SESI 2 -> Ele AUTO-DETECT (uuid apapun yg lagi di akun, bukan pool)
        if sesi == 2 then
            for u in pairs(eleUuids) do
                if tostring(u):sub(1,1) == "{" then supBaru[u] = "Rainbow Elephant"; break end
            end
        end
        -- copot support lama yg GAK di supBaru (mis. Ele/Gilded sesi lain, atau extra)
        for u in pairs(supportKunci) do
            if not supBaru[u] then pcall(function() unequipPet(u) end) end
        end
        supportKunci = supBaru
        -- bahan: selalu ganti (copot bahan lama)
        for u in pairs(bahanAktif) do pcall(function() unequipPet(u) end) end
        bahanAktif = {}
        pilihBahan(sesi)
        equipSemua()          -- equip yg baru aja (ke-keep udah ke-equip -> skip)
        -- ENFORCE: copot SEMUA pet equipped yg UNTRACKED (gak di supportKunci & bahanAktif).
        -- Fix: bahan 4 (bahan lama nyangkut), Ele masuk sesi 1, Dilop 3, dst. Ulang 3x biar pasti.
        task.spawn(function()
            for rep = 1, 3 do
                task.wait(2)
                if (KG.sesi or 1) ~= sesi then return end
                for uuid in pairs(modelByUuid) do
                    if not supportKunci[uuid] and not bahanAktif[uuid] then
                        pcall(function() unequipPet(uuid) end)
                        kgLog("copot UNTRACKED: " .. (tipeDariUuid(uuid) or "?"))
                    end
                end
            end
        end)
        local perT = {}
        for _, nm in pairs(supportKunci) do perT[nm] = (perT[nm] or 0) + 1 end
        local ss = ""; for _, sup in ipairs(SUP) do ss = ss..sup.nama.."="..(perT[sup.nama] or 0).."/"..sup.jml.." " end
        kgLog("SESI "..sesi.." | support: "..ss.."| bahan "..jml(bahanAktif).."/"..((sesi==2) and BAHAN_S2 or BAHAN_S1))
    end
    -- v6.7: ISI support KURANG aja (dari pool, TANPA copot/re-equip yg udah ada).
    -- Dipakai verifikasi -> gak siklus copot-semua. Kelebihan di-handle bersihGakCocok.
    local function isiKurang(sesi)
        kunciSupPool()   -- LOAD pool locked (uuid tetap, gak re-pick). cuma equip yg belum ke-equip.
        local SUP = getSUP(sesi)
        local cnt = {}
        for _, nm in pairs(supportKunci) do cnt[nm] = (cnt[nm] or 0) + 1 end
        for _, sup in ipairs(SUP) do
            local perlu = sup.jml - (cnt[sup.nama] or 0)
            if perlu > 0 then
                local pool = supPool[sup.nama] or {}
                for _, u in ipairs(pool) do
                    if perlu <= 0 then break end
                    if not supportKunci[u] and not bahanAktif[u] then
                        supportKunci[u] = sup.nama
                        equipPet(u, CLUSTER)   -- equip yg BARU ditambah aja (yg lama diem)
                        perlu = perlu - 1
                        kgLog("isi support kurang: "..sup.nama.." (+1)")
                    end
                end
            end
        end
    end
    -- tentuin sesi dari stat (sticky): sesi1 sampe muda habis, sesi2 sampe age50 habis
    local function tentukanSesi()
        -- up6kg: sesi 2 BUTUH Ele. Gak pegang Ele -> paksa sesi 1 (leveling, nunggu Ele dioper balik).
        if not next(eleUuids) then return 1 end
        local st = _G.ZenxKgStat or {}
        local mudaB = st.mudaBelum or 0   -- up6kg: age<40 base<6kg
        local a50B  = st.age50Belum or 0  -- up6kg: age40+ base<6kg
        local total = st.total or 0
        if total == 0 then return KG.sesi end   -- stat belum siap -> jgn ganti/putus
        if KG.sesi == 1 then
            if mudaB == 0 then
                if a50B > 0 then return 2 else return 0 end   -- 0 = SELESAI
            end
            return 1
        else
            if a50B == 0 then
                if mudaB > 0 then return 1 else return 0 end
            end
            return 2
        end
    end

