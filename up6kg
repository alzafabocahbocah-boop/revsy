                                kgLog("bahan "..tipe.." AGE turun ke "..age.." <= 30 -> copot (KG-up kelar)")
                            end
                        end
                    end
                    -- isi ulang bahan
                    local maxB = (KG.sesi == 2) and BAHAN_S2 or BAHAN_S1
                    if jml(bahanAktif) < maxB then
                        pilihBahan(KG.sesi)
                        for u in pairs(bahanAktif) do
                            if not modelByUuid[u] then equipPet(u, CLUSTER); task.wait(0.06) end
