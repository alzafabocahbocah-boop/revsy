    local TRADE_CFG = "zenx_trade_cfg.json"

    local TR = { targets = {}, tipe = {}, minKg = 0, minAge = 0, autoAcc = false, mode = "off" }
    local function saveTr()
        pcall(function()
            if not writefile then return end
            writefile(TRADE_CFG, HS:JSONEncode({ targets=TR.targets, tipe=TR.tipe, minKg=TR.minKg, minAge=TR.minAge, autoAcc=TR.autoAcc, mode=TR.mode }))
        end)
    end
    pcall(function()
        if isfile and isfile(TRADE_CFG) and readfile then
            local c = HS:JSONDecode(readfile(TRADE_CFG))
            if type(c) == "table" then
                if type(c.targets)=="table" then local a={} for _,v in ipairs(c.targets) do if type(v)=="string" then a[#a+1]=v end end TR.targets=a end
                if type(c.tipe)=="table" then local s={} for k,v in pairs(c.tipe) do if type(k)=="string" and v then s[k]=true end end TR.tipe=s end
                TR.minKg=tonumber(c.minKg) or 0; TR.minAge=tonumber(c.minAge) or 0; TR.autoAcc=(c.autoAcc==true)
                TR.mode = (c.mode=="trade" or c.mode=="gift") and c.mode or "off"
            end
        end
    end)

    local TradeSys = {}
    do
        local te = GE and GE:FindFirstChild("TradeEvents")
        if te then
            TradeSys.sendReqRE=te:FindFirstChild("SendRequest"); TradeSys.addItemRE=te:FindFirstChild("AddItem")
            TradeSys.respondRE=te:FindFirstChild("RespondRequest"); TradeSys.acceptRE=te:FindFirstChild("Accept"); TradeSys.confirmRE=te:FindFirstChild("Confirm")
        end
    end
    local GiftSys = {}
    do
        GiftSys.giftRE = GE and GE:FindFirstChild("PetGiftingService")
        if not GiftSys.giftRE then GiftSys.giftRE = RS:FindFirstChild("PetGiftingService", true) end
        pcall(function()
