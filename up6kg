                if getCooldownRF and (tick() - lastInvoke) >= 2 then       -- InvokeServer fallback JARANG (2s) buat pet yg cache masih basi
                    lastInvoke = tick()
                    for u in pairs(supportKunci) do
                        local key = tostring(u):gsub("[{}]", "")
                        local e = cdEventCache[key]
                        if not (e and tick() - e.at <= 8) then
                            local ok, res = pcall(function() return getCooldownRF:InvokeServer(fmtUUID(u)) end)
                            if ok then cdEventCache[key] = { ready = (readyDariData(res) == true), at = tick() } end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
        -- HEALER cek TERUS (tiap 1s): pet tim yg model-nya ILANG -> langsung PAKSA copot->pasang
        -- HOLD di TENGAH: tahan pet tim di CLUSTER (numpuk rapet) — pivot balik kalau drift >3 stud
        task.spawn(function()
            while KG.aktif and _G.__ZenxKgResetGen == resetGen do
                task.wait(0.25)
                if _G.ZenxAutoTengah and KG.aktif and not KG.reset and CLUSTER then   -- v0.76: HOLD-ke-tengah lewat toggle "AUTO TENGAH"
                    for uuid in pairs(modelByUuid) do
