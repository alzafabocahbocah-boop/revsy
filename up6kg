                if cfg.config then _G.ZenxKgConfig = cfg.config end
                _G.__ZenxKgAutoOnBoot = (cfg.autoOn == true)   -- kalau terakhir ON -> nanti auto-nyala lagi
            end
        end
    end)
end

-- ===== DENYUT — worker tau client hidup (guard disconnect) =====
do
    if not _G.__ZenxDenyutJalan then
        _G.__ZenxDenyutJalan = true
        -- DETEKSI DISCONNECT (port star_seed) — denyut BERHENTI + file DIHAPUS pas putus
        local function zenxCekDisconnect()
            local dc = false
            pcall(function()
                local GuiService = game:GetService("GuiService")
                local ec = GuiService:GetErrorCode()
                if ec and ec ~= Enum.ConnectionError.OK and ec ~= Enum.ConnectionError.None then dc = true end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                local pg = CoreGui:FindFirstChild("RobloxPromptGui")
                local overlay = pg and pg:FindFirstChild("promptOverlay")
                if overlay then
                    for _, child in ipairs(overlay:GetChildren()) do
                        if child:IsA("GuiObject") and child.Visible
                            and (child.Name:find("Error") or child.Name:find("Prompt")) then
                            for _, d in ipairs(child:GetDescendants()) do
                                if d:IsA("TextButton") or d:IsA("TextLabel") then
                                    local t = tostring(d.Text or ""):lower()
                                    if t:find("reconnect") or t:find("leave") or t:find("disconnect")
                                        or t:find("shut") or t:find("keluar") or t:find("sambung")
                                        or t:find("terputus") or t:find("dimatikan") or t:find("hubungkan") then
                                        dc = true; return
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            if dc then return true end
            pcall(function()
                local CoreGui = game:GetService("CoreGui")
                for _, d in ipairs(CoreGui:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        local vis = false
                        pcall(function() vis = d.Visible end)
                        if vis then
                            local t = tostring(d.Text or ""):lower()
                            local _hs = t:find("headset") or t:find("controller") or t:find("audio") or t:find("bluetooth") or t:find("mic") or t:find("earphone") or t:find("headphone")
                            if (not _hs) and (t:find("reconnect") or t:find("sambung ulang")
                                or t:find("terputus") or t:find("disconnected")
                                or t:find("dimatikan") or t:find("was shut down")
                                or t:find("lost connection") or t:find("kehilangan koneksi")
                                or t:find("error code") or t:find("kode error") or t:find("kode eror")
                                or t:find("id error") or t:find("(error)")) then
                                dc = true; return
                            end
                        end
                    end
                end
            end)
            return dc
        end
        -- deteksi STRICT: CUMA prompt reconnect Roblox yg BENERAN muncul (buat trigger self-rejoin).
        -- gak pake scan teks luas / error code (sumber false-positive) -> anti rejoin-loop.
        local function zenxDcStrict()
            local dc = false
            -- v-dc7: FOKUS JUDUL AJA. Cek CUMA judul prompt disconnect "Disconnected" /
            -- "Koneksi terputus" (TextLabel visible). Dulu pake GetErrorCode + tombol
            -- (leave/reconnect/keluar) + pesan (connection/same account) -> bisa FALSE-POSITIVE
            -- (tombol/kata nyangkut di UI game biasa, atau errorcode stale) -> denyut BEKU
            -- walau GAK disconnect. Judul paling spesifik -- cuma nongol di prompt disconnect asli.
            -- (SAMAIN PANEN v3.23 -- upkg dulu masih v-dc5 + GetErrorCode yg suka meleset.)
            pcall(function()
                local cg = game:GetService("CoreGui")
                for _, d in ipairs(cg:GetDescendants()) do
                    if d:IsA("TextLabel") and d.Visible then
                        local t = tostring(d.Text or ""):lower()
                        -- v-dc8 FIX false-positive: "headset disconnected"/"controller
                        -- disconnected"/audio bukan disconnect GAME -> exclude.
                        if (t:find("disconnected") or t:find("koneksi terputus"))
                           and not (t:find("headset") or t:find("controller") or t:find("audio")
                                    or t:find("bluetooth") or t:find("mic") or t:find("earphone")
                                    or t:find("headphone") or t:find("perangkat audio")) then
                            dc = true; return
                        end
                    end
                end
            end)
            return dc
        end
        _G.ZenxCekDisconnect = zenxCekDisconnect
        -- SELF-REJOIN: error kedeteksi tapi VM masih hidup (masih bisa denyut) -> rejoin SENDIRI (gak nunggu worker)
        _G.ZenxSelfRejoin = function(reason)
            if _G.ZenxRejoining then return end
            _G.ZenxRejoining = true
            _G.ZenxRejoinSisa = 0
            print("[SelfRejoin] " .. tostring(reason) .. " -> rejoin sendiri (VM masih hidup)")
            local TS = game:GetService("TeleportService")
            local plr = game:GetService("Players").LocalPlayer
            -- hide prompt error terus (biar Teleport gak keblok)
            task.spawn(function()
                local cg = game:GetService("CoreGui")
                local guiSvc = game:GetService("GuiService")
                for _ = 1, 120 do
                    pcall(function()
                        for _, g in ipairs(cg:GetChildren()) do
                            local n = tostring(g.Name):lower()
                            if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                if g:IsA("ScreenGui") then g.Enabled = false end
                                pcall(function() g.Parent = nil end)
                            end
                        end
                        guiSvc:ClearError()
                    end)
                    task.wait(0.5)
                end
            end)
            task.wait(8)   -- ghost slot bentar (udah putus duluan, jadi lebih pendek dari scheduled)
            while true do  -- Teleport gacor (matchmaking) balik ke PS SAMA, retry sampe berhasil
                pcall(function() TS:Teleport(game.PlaceId, plr) end)
                task.wait(8)
            end
        end
        -- loop cepat: hapus denyut pas disconnect (broad, harmless) + SELF-REJOIN cuma pas prompt reconnect BENERAN (strict)
        task.spawn(function()
            local dcStrict = 0
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if not plr or not plr.Name or _G.ZenxRejoining then dcStrict = 0; return end
                    -- denyut: hapus kalau ada sinyal disconnect apapun (worker tau putus)
                    -- v-dc4: JANGAN hapus file denyut pas disconnect. Cukup BERHENTI
                    -- nulis (write di-gate not zenxDcStrict) -> denyut basi -> worker rejoin
                    -- setelah 2 menit. Hapus file bikin "BELUM ADA FILE" (lebih ribet).
                    -- SELF-REJOIN: CUMA pas prompt reconnect Roblox muncul (strict), persist 4x + grace 60s
                    if zenxDcStrict() then
                        dcStrict = dcStrict + 1
                        local umur = os.time() - (_G.__ZenxBootT or os.time())
                        -- v-sr-off: SELF-REJOIN SCRIPT DIMATIIN. Worker + panel yg handle rejoin
                        -- (samain AUTO-REJOIN yg udah dimatiin). Dulu script teleport SENDIRI pas
                        -- dcStrict>=4 -> kalau zenxDcStrict false-positive / prompt 276 kena semua
                        -- client -> teleport BARENGAN (walau denyut fresh) -> "rejoin barengan".
                        -- Sekarang script cuma BERHENTI nulis denyut (basi) -> worker rejoin (1-1).
                        -- if dcStrict >= 4 and umur > 60 and _G.ZenxSelfRejoin then _G.ZenxSelfRejoin("dc") end
                    else
                        dcStrict = 0
                    end
                end)
                task.wait(3)
            end
        end)
        -- v0.81: FPS tracker -- denyut cuma kirim kalau render JALAN (>5 fps).
        -- Client PUTIH (fps ~1, GPU gak render) -> denyut GAK kekirim -> worker anggap mati -> REJOIN.
        if not _G.__ZenxFpsTrack then
            _G.__ZenxFpsTrack = true
            _G.__ZenxFps = 60   -- optimis dulu (sebelum keukur, biar gak salah-rejoin pas loading)
            local cnt = 0
            pcall(function()
                game:GetService("RunService").RenderStepped:Connect(function() cnt = cnt + 1 end)
            end)
            -- v0.84: indikator FPS pojok KANAN ATAS (biar keliatan render jalan / denyut nulis apa enggak)
            local fpsLbl
            pcall(function()
                local plr = game:GetService("Players").LocalPlayer
                local g = Instance.new("ScreenGui"); g.Name = "ZenxFpsHud"; g.ResetOnSpawn = false; g.IgnoreGuiInset = true
                pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
                if not g.Parent then g.Parent = plr:WaitForChild("PlayerGui") end
                fpsLbl = Instance.new("TextLabel", g)
                fpsLbl.Size = UDim2.new(0, 120, 0, 34)
                fpsLbl.Position = UDim2.new(1, -128, 0, 8)   -- pojok kanan atas
                fpsLbl.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
                fpsLbl.BackgroundTransparency = 0.25
                fpsLbl.Font = Enum.Font.GothamBold; fpsLbl.TextSize = 18
                fpsLbl.TextColor3 = Color3.fromRGB(120, 255, 140); fpsLbl.BorderSizePixel = 0
                fpsLbl.Text = "FPS --"
                Instance.new("UICorner", fpsLbl).CornerRadius = UDim.new(0, 8)
            end)
            task.spawn(function()
                while true do
                    task.wait(1); _G.__ZenxFps = cnt; cnt = 0
                    if fpsLbl then
                        local f = _G.__ZenxFps or 0
                        fpsLbl.Text = "FPS " .. f .. (f <= 5 and " (putih)" or "")
                        fpsLbl.TextColor3 = (f <= 5) and Color3.fromRGB(255, 90, 90)
                            or (f <= 20) and Color3.fromRGB(255, 210, 90)
                            or Color3.fromRGB(120, 255, 140)
                    end
                end
            end)
        end
        -- denyut tiap 20s (BAWA stat KG: pet yg udah 3.8kg) — SKIP kalau disconnect ATAU fps<=5 (putih)
        task.spawn(function()
            while true do
                pcall(function()
                    local plr = game:GetService("Players").LocalPlayer
                    if plr and plr.Name and writefile and not zenxDcStrict() then
                        local udah = (_G.ZenxKgStat and tonumber(_G.ZenxKgStat.udah)) or 0
                        local fps = math.floor(tonumber(_G.__ZenxFps) or 60)
                        -- v0.86: SELALU nulis denyut + bawa fps. format "ts;<udah>;kg;<fps>"
                        -- (worker: denyut ada + fps<=5 = PUTIH -> rejoin cepet; denyut gak ada = loading -> grace)
                        local skV = 0
                        pcall(function()
                            -- v1.26: GAG1 sheckles = StringValue BERFORMAT "257.964T\226\130\162" -> parse suffix.
                            local function parseSheck(raw)
                                raw = tostring(raw or ""):gsub("[%s,]", ""):gsub("\226\130\162", "")
                                local n = tonumber(raw:match("^(%-?[%d%.]+)"))
                                if not n then return 0 end
                                local suf = (raw:match("([KkMmBbTt])") or ""):lower()
                                local mult = ({ k=1e3, m=1e6, b=1e9, t=1e12 })[suf] or 1
                                return math.floor(n * mult)
                            end
                            local ls = plr:FindFirstChild("leaderstats")
                            if ls then
                                local sh = ls:FindFirstChild("Sheckles") or ls:FindFirstChild("Leaves")
                                           or ls:FindFirstChild("Cash") or ls:FindFirstChild("Coins") or ls:FindFirstChild("Money")
                                if sh and sh.Value then skV = parseSheck(sh.Value) end
                                if skV == 0 then
                                    for _, v in ipairs(ls:GetChildren()) do
                                        local nm = tostring(v.Name):lower()
                                        if (nm:find("sheck") or nm:find("cash") or nm:find("coin") or nm:find("money") or nm:find("leaves")) and v:IsA("ValueBase") then
                                            skV = parseSheck(v.Value); if skV > 0 then break end
                                        end
                                    end
                                end
                            end
                            if skV == 0 then
                                local a = plr:GetAttribute("Sheckles") or plr:GetAttribute("Cash")
                                          or plr:GetAttribute("Money") or plr:GetAttribute("Coins")
                                if a then skV = parseSheck(a) end
                            end
                        end)
                        writefile("zenx_denyut_" .. plr.Name .. ".txt", os.time() .. ";" .. udah .. ";kg;" .. fps .. ";S" .. skV .. ";N" .. (tonumber(_G.ZenxUpkgNight) or 0))
                    end
                end)
                task.wait(5)
            end
        end)
    end
end

-- ===== AUTO-REJOIN tiap N menit (KICK dulu -> rejoin server SAMA, countdown GLOBAL sync) =====
local REJOIN_MENIT = 30    -- <<< SETTING: rejoin tiap berapa menit (bisa override _G.ZenxRejoinMenit)
_G.ZenxRejoinMenit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT   -- DEFAULT 30, WAJIB nyala (gak ada toggle mati)
_G.__ZenxBootT = _G.__ZenxBootT or os.time()   -- waktu boot script (buat guard kick-pertama)
if false then   -- <<< AUTO-REJOIN SC DIMATIIN (worker + panel kick handle rejoin, gak perlu dobel)
    _G.__ZenxRejoinGen = (_G.__ZenxRejoinGen or 0) + 1
    local myGen = _G.__ZenxRejoinGen
    do
        local TS = game:GetService("TeleportService")
        task.spawn(function()
            while _G.__ZenxRejoinGen == myGen do
                -- countdown: recompute boundary TIAP DETIK -> ganti _G.ZenxRejoinMenit LIVE
                -- langsung re-align ke boundary baru (gak nunggu cycle selesai).
                while _G.__ZenxRejoinGen == myGen do
                    local menit = tonumber(_G.ZenxRejoinMenit) or REJOIN_MENIT
                    local interval = math.max(60, math.floor(menit * 60))
                    local offset = math.max(0, math.floor(menit / 10) - 1) * 60
                    local now = os.time()
                    local nextB = (math.floor((now - offset) / interval) + 1) * interval + offset
                    while nextB - (_G.__ZenxBootT or now) < 60 do nextB = nextB + interval end
                    _G.ZenxRejoinSisa = nextB - now
                    if _G.ZenxRejoinSisa <= 1 then break end
                    task.wait(1)
                end
                if _G.__ZenxRejoinGen ~= myGen then return end
                _G.ZenxRejoinSisa = 0
                local plr = game:GetService("Players").LocalPlayer
                if plr then
                    local jobId = game.JobId
                    _G.ZenxRejoining = true
                    pcall(function() plr:Kick("ZenxFreezeRejoin") end)
                    -- SEMBUNYIIN dialog "kicked/disconnect" biar TeleportToPlaceInstance gak ke-blok
                    task.spawn(function()
                        local cg = game:GetService("CoreGui")
                        local guiSvc = game:GetService("GuiService")
                        for _ = 1, 300 do
                            pcall(function()
                                for _, g in ipairs(cg:GetChildren()) do
                                    local n = tostring(g.Name):lower()
                                    if n:find("error") or n:find("prompt") or n:find("disconnect") then
                                        if g:IsA("ScreenGui") then g.Enabled = false end
                                        pcall(function() g.Parent = nil end)
                                    end
                                end
                                pcall(function() guiSvc:ClearError() end)
                            end)
                            task.wait(0.5)
                        end
                    end)
                    print("[Rejoin] KICK dilakukan. jobId=" .. tostring(jobId) .. " place=" .. tostring(game.PlaceId))
                    pcall(function()
                        TS.TeleportInitFailed:Connect(function(_, res, msg)
                            print("[Rejoin] teleport GAGAL: " .. tostring(res) .. " | " .. tostring(msg))
                        end)
                    end)
                    task.wait(40)   -- jeda abis kick dinaikin 30->40s
                    local tries = 0
                    while true do   -- rejoin sampe berhasil (VM mati pas teleport sukses)
                        tries = tries + 1
                        print("[Rejoin] coba teleport #" .. tries)
                        -- GACOR: Teleport polos (matchmaking) -> balik ke PS SAMA + LOLOS anti-scam.
                        -- (TeleportToPlaceInstance keblok anti-scam krn target jobId spesifik.
                        --  Teleport() polos dianggap "join balik" biasa -> otomatis ke PS lo.)
                        pcall(function() TS:Teleport(game.PlaceId, plr) end)
                        task.wait(8)
                    end
                end
            end
        end)
    end
end

