-- ============================================================
-- v0.95: AUTO DESTROY POHON (SELALU ON) — FPS naik (port dari sc panen)
-- Destroy semua Model di folder "Plants_Physical" (pohon/tanaman). Pet leveling BEDA folder
-- (model "{uuid}"), jadi GAK ke-destroy. Trigger: sekali start + tiap pohon baru + loop 30s.
-- ============================================================
do
    local WS = workspace
    local function semuaFarm()
        local roots = {}
        local farm = WS:FindFirstChild("Farm")
        if farm then
            for _, f in ipairs(farm:GetDescendants()) do
                if f.Name == "Plants_Physical" and (f:IsA("Folder") or f:IsA("Model")) then table.insert(roots, f) end
            end
        end
        if #roots == 0 then
            for _, f in ipairs(WS:GetDescendants()) do
                if f.Name == "Plants_Physical" and (f:IsA("Folder") or f:IsA("Model")) then table.insert(roots, f) end
            end
        end
        return roots
    end
