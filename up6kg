            -- Biar pool ke-lock LENGKAP dari awal (gak kurang gara2 pet belum ke-load).
            do
                local maxPer, cariMap = {}, {}
                for _, sup in ipairs(SUPPORT_S1_ELE) do maxPer[sup.nama] = math.max(maxPer[sup.nama] or 0, sup.jml); cariMap[sup.nama] = sup.cari end
                for _, sup in ipairs(SUPPORT_S2_ELE) do maxPer[sup.nama] = math.max(maxPer[sup.nama] or 0, sup.jml); cariMap[sup.nama] = sup.cari end
                for att = 1, 45 do
                    if not KG.aktif then break end
                    local pets = listPetsAll()   -- v6.8: SEMUA pet (equipped + backpack)
                    local cnt = {}
                    for _, p in ipairs(pets) do
                        for nm, cari in pairs(cariMap) do if cocokSemua(p.tipe, cari) then cnt[nm] = (cnt[nm] or 0) + 1 end end
                    end
                    local lengkap, kurangNm = true, ""
                    for nm, mx in pairs(maxPer) do if (cnt[nm] or 0) < mx then lengkap = false; kurangNm = nm .. " (" .. (cnt[nm] or 0) .. "/" .. mx .. ")" end end
                    if lengkap then kgLog("support READY -> kunci pool + equip"); break end
                    if att == 1 or att % 5 == 0 then kgLog("tunggu support ready... kurang: " .. kurangNm) end
                    task.wait(1)
                end
            end
            pasangSesi(KG.sesi, true)
            while KG.aktif do
                task.wait(3)
                if not KG.aktif then break end
                local mudaB = (_G.ZenxKgStat and _G.ZenxKgStat.mudaBelum) or 0
                local a50B  = (_G.ZenxKgStat and _G.ZenxKgStat.age50Belum) or 0
                local total = (_G.ZenxKgStat and _G.ZenxKgStat.total) or 0
                local udah6 = (_G.ZenxKgStat and _G.ZenxKgStat.udah) or 0
                local belum6 = (_G.ZenxKgStat and _G.ZenxKgStat.belum) or 0
