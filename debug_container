-- debug_container: print semua pet dari RC container
-- uuid, tipe, age (Level), kg (BaseWeight)

local RS = game:GetService("ReplicatedStorage")
local plr = game:GetService("Players").LocalPlayer

local ok, err = pcall(function()
    local RC = require(RS.Modules.ReplicationClass)
    local inst = RC.new("ActivePetsService_Replicator")
    local data = inst:GetData(plr.Name)
    local tbl  = rawget(data, "Table")
    local ppd  = rawget(tbl,  "PlayerPetData")
    local pd   = rawget(ppd,  plr.Name)
    local pi   = rawget(pd,   "PetInventory")
    local dat  = rawget(pi,   "Data")

    local count = 0
    for uuid, entry in pairs(dat) do
        if type(entry) == "table" then
            local petType = tostring(entry.PetType or (entry.PetData and entry.PetData.PetType) or "?")
            local age     = tonumber((entry.PetData or {}).Level)      or 0
            local kg      = tonumber((entry.PetData or {}).BaseWeight) or 0
            local ustr    = tostring(uuid)
            print(string.format("[debug_container] uuid=%s  tipe=%-20s  age=%-5d  kg=%.4f",
                ustr:sub(1,16), petType, age, kg))
            count = count + 1
        end
    end
    print("[debug_container] total: "..count.." pet")
end)

if not ok then print("[debug_container] ERROR: "..tostring(err)) end
