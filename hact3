                                wasFull = false
                                statL.Text = "nunggu backpack full..."
                                task.wait(2)
                            end
                        else
                            local sent = giftPetsByFilter(cfg)
                            statL.Text = sent > 0 and ("Terkirim "..sent.." pet") or "nunggu pet cocok..."
                            task.wait(1)
                        end
                    end
                end)
            else
                running = false
                cfg._running = false
                syncWaitFullFlag()
                gBtn.Text = "Auto Gift: OFF"
                gBtn.BackgroundColor3 = C.accent
                statL.Text = "dihentikan"
            end
        end)
