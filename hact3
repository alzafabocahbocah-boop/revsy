-- ║  DEBUG PetMover — nama pet placed + tes unequip               ║
-- ╚══════════════════════════════════════════════════════════════╝
local RS = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local player = game:GetService("Players").LocalPlayer
local ge = RS:FindFirstChild("GameEvents")
local equipRE = ge and ge:FindFirstChild("PetsService")
local leadRE = ge and ge:FindFirstChild("PetLeadService_RE")

local function L(...)
    local p = {}
    for _, v in ipairs({...}) do table.insert(p, tostring(v)) end
    print("[MOVER] " .. table.concat(p, " "))
end

L("===== DEBUG PetMover =====")
local pp = Workspace:FindFirstChild("PetsPhysical")
local mover = pp and pp:FindFirstChild("PetMover")
L("PetsPhysical ada? "..tostring(pp ~= nil))
L("PetMover ada? "..tostring(mover ~= nil))
if not mover then
    L("!! PetMover gak ada. cari container pet placed lain:")
    if pp then for _, c in ipairs(pp:GetChildren()) do L("  PetsPhysical child: "..c.Name) end end
    return
end

-- nama child PetMover (pet placed)
L("")
L("== child PetMover (pet placed) ==")
local n = 0
local firstUuid = nil
for _, child in ipairs(mover:GetChildren()) do
    n = n + 1
    if n <= 6 then
        L("  ["..n.."] '"..child.Name.."' ("..child.ClassName..")")
        -- atribut?
        for k, v in pairs(child:GetAttributes()) do L("       attr "..k.."="..tostring(v):sub(1,20)) end
        firstUuid = firstUuid or child.Name
    end
end
L("total pet placed = "..n)

-- tes unequip pet pertama (coba beberapa format)
if firstUuid then
    L("")
    L("== TES unequip pet pertama '"..firstUuid.."' ==")
    local raw = firstUuid
    local noBrace = raw:gsub("[{}]","")
    local withBrace = "{"..noBrace.."}"
    L("  coba format apa adanya: "..raw)
    pcall(function() equipRE:FireServer("UnequipPet", raw) end)
    pcall(function() leadRE:FireServer("UnequipPet", raw) end)
    task.wait(0.5)
    L("  coba format {uuid}: "..withBrace)
    pcall(function() equipRE:FireServer("UnequipPet", withBrace) end)
    pcall(function() leadRE:FireServer("UnequipPet", withBrace) end)
    task.wait(0.8)
    -- cek masih ada?
    local stillThere = mover:FindFirstChild(raw) ~= nil
    L("  pet masih di garden? "..tostring(stillThere))
    L(stillThere and ">>> unequip GAGAL" or ">>> unequip BERHASIL (pet ilang dari garden)")
end

L(">>> kirim screenshot")
